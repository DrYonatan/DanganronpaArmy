    - rid: 2649295523292643499
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D4\u05D1\u05D4 \u05E0\u05EA\u05D7\u05D9\u05DC \u05E2\u05DD
          \u05D4\u05E1\u05D1\u05E8 \u05E7\u05D8\u05DF \u05E2\u05DC \u05D4\u05DE\u05E9\u05E4\u05D8
          \u05D4\u05E6\u05D1\u05D0\u05D9! \u05D0\u05EA\u05DD \u05E2\u05DB\u05E9\u05D9\u05D5
          \u05EA\u05D3\u05D5\u05E0\u05D5 \u05D1\u05E0\u05D9\u05E1\u05D9\u05D5\u05DF
          \u05DC\u05D4\u05D1\u05D9\u05DF \u05DE\u05D9 \u05D4\u05D5\u05D0 \u05D4\u05E8\u05D5\u05E6\u05D7
          \u05D4\u05DE\u05D5\u05E9\u05D7\u05E8."
        commands: []
    - rid: 2649295523292643500
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E9\u05D9\u05D9\u05D2\u05DE\u05E8 \u05D4\u05D6\u05DE\u05DF
          \u05E9\u05DC \u05D4\u05DE\u05E9\u05E4\u05D8, \u05D0\u05EA\u05DD \u05EA\u05E6\u05D8\u05E8\u05DB\u05D5
          \u05DC\u05E2\u05E8\u05D5\u05DA \u05D4\u05E6\u05D1\u05E2\u05D4 \u05D1\u05D4
          \u05EA\u05D7\u05DC\u05D9\u05D8\u05D5 \u05DE\u05D9 \u05D6\u05D4."
        commands: []
    - rid: 2649295523292643501
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05E8\u05D5\u05D1 \u05E7\u05D5\u05D1\u05E2, \u05D0\u05D1\u05DC
          \u05EA\u05E0\u05E1\u05D5 \u05DC\u05D4\u05D2\u05D9\u05E2 \u05DC\u05D4\u05E1\u05DB\u05DE\u05D4
          \u05DB\u05DE\u05D4 \u05E9\u05D9\u05D5\u05EA\u05E8 \u05E8\u05D7\u05D1\u05D4!"
        commands: []
    - rid: 2649295523292643502
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05EA\u05E6\u05DC\u05D9\u05D7\u05D5 \u05DC\u05E2\u05E0\u05D5\u05EA
          \u05E0\u05DB\u05D5\u05DF \u05E2\u05DC \u05DE\u05D9 \u05D4\u05E4\u05D5\u05E9\u05E2,
          \u05E8\u05E7 \u05D4\u05D5\u05D0 \u05D9\u05E7\u05D1\u05DC \u05DE\u05E2\u05E0\u05D4
          \u05D5\u05D9\u05D5\u05E6\u05D0 \u05DC\u05D4\u05D5\u05E8\u05D2, \u05D5\u05D4\u05E9\u05D0\u05E8
          \u05D9\u05DE\u05E9\u05D9\u05DB\u05D5 \u05D1\u05D8\u05D9\u05E8\u05D5\u05E0\u05D5\u05EA
          \u05DB\u05E8\u05D2\u05D9\u05DC."
        commands: []
    - rid: 2649295523292643503
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D0\u05DD \u05EA\u05D1\u05D7\u05E8\u05D5 \u05D1\u05D0\u05D7\u05D3
          \u05D4\u05DC\u05D0 \u05E0\u05DB\u05D5\u05DF\u2026 \u05DB\u05D5\u05DC\u05DD
          \u05D7\u05D5\u05E5 \u05DE\u05D4\u05DE\u05D5\u05E9\u05D7\u05E8 \u05D9\u05D5\u05E6\u05D0\u05D5
          \u05DC\u05D4\u05D5\u05E8\u05D2, \u05D5\u05D0\u05D5\u05EA\u05D5 \u05D4\u05DE\u05D5\u05E9\u05D7\u05E8
          \u05D9\u05E1\u05D9\u05D9\u05DD \u05D0\u05EA \u05D4\u05D8\u05D9\u05E8\u05D5\u05E0\u05D5\u05EA
          \u05D5\u05D9\u05E6\u05D0 \u05DC\u05D7\u05D5\u05E4\u05E9\u05D9!"
        commands: []
    - rid: 2649295523292643506
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D4\u05E8\u05D5\u05E6\u05D7 \u05D4\u05D6\u05D4\u2026 \u05D4\u05D5\u05D0
          \u05D1\u05D0\u05DE\u05EA \u05D0\u05D7\u05D3 \u05DE\u05D0\u05D9\u05EA\u05E0\u05D5?"
        commands: []
    - rid: 2649295523292643507
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D3\u05D0\u05D9! \u05D0\u05D6 \u05E7\u05D3\u05D9\u05DE\u05D4,
          \u05D4\u05EA\u05D7\u05D9\u05DC\u05D5!"
        commands: []
    - rid: 2649295523292643508
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D2\u05E2, \u05E8\u05E7 \u05E9\u05E0\u05D9\u05D9\u05D4. \u05DE\u05D9\u05E9\u05D4\u05D5
          \u05E2\u05D5\u05DE\u05D3 \u05DC\u05D4\u05EA\u05D9\u05D9\u05D7\u05E1 \u05DC\u05E9\u05DC\u05D8
          \u05D4\u05D6\u05D4?"
        commands: []
    - rid: 2649295523292643509
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D4\u05E7\u05D8\u05E2?"
        commands: []
    - rid: 2649295523292643510
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D4 \u05D6\u05D4? \u05D8\u05D5\u05D1, \u05DC\u05D0 \u05E8\u05E6\u05D9\u05EA\u05D9
          \u05E9\u05EA\u05E9\u05DB\u05D7\u05D5 \u05DE\u05D9 \u05DC\u05DE\u05D9 \u05D4\u05E2\u05DE\u05D3\u05D4
          \u05D4\u05D6\u05D0\u05EA \u05D0\u05DE\u05D5\u05E8\u05D4 \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05E9\u05D9\u05D9\u05DB\u05EA!"
        commands: []
    - rid: 2649295523292643511
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D7\u05D5\u05E5 \u05DE\u05D6\u05D4, \u05D6\u05D4 \u05D1\u05DB\u05DC\u05DC
          \u05DC\u05D0 \u05D0\u05E1\u05EA\u05D8\u05D9 \u05DC\u05D4\u05E9\u05D0\u05D9\u05E8
          \u05DB\u05DB\u05D4 \u05DE\u05E7\u05D5\u05DD \u05E8\u05D9\u05E7, \u05D7\u05D9\u05D9\u05D1\u05D9\u05DD
          \u05DC\u05E9\u05D9\u05DD \u05E9\u05DD \u05DE\u05E9\u05D4\u05D5."
        commands: []
    - rid: 2649295523292643512
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D9\u05E9 \u05E9\u05DD \u05E2\u05D5\u05D3 \u05DE\u05E7\u05D5\u05DD
          \u05E9\u05DB\u05DF \u05E0\u05E9\u05D0\u05E8 \u05E8\u05D9\u05E7\u2026"
        commands: []
    - rid: 2649295523292643513
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D8\u05D5\u05D1, \u05D6\u05D4 \u05DB\u05D1\u05E8 \u05D1\u05D2\u05DC\u05DC
          \u05DB\u05E9\u05D4\u05D6\u05DE\u05E0\u05D5 51 \u05E2\u05DE\u05D3\u05D5\u05EA,
          \u05DC\u05D0 \u05D4\u05D1\u05E0\u05D5 \u05E9\u05D6\u05D4 \u05D0\u05D7\u05D3
          \u05E4\u05DC\u05D5\u05E1 \u05E2\u05D5\u05D3 51\u2026"
        commands: []
    - rid: 2649295523292643514
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D7\u05D3\u05DC \u05E7\u05E9\u05E7\u05E9\u05EA!
          \u05EA\u05EA\u05D7\u05D9\u05DC\u05D5 \u05DC\u05D3\u05D9\u05D9\u05DF!"
        commands: []
    - rid: 2649295523292643515
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D0\u05D9\u05E4\u05D4 \u05DE\u05EA\u05D7\u05D9\u05DC\u05D9\u05DD\u2026?"
        commands: []
    - rid: 2649295523292643516
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05D2\u05DE\u05E8\u05D5 \u05E2\u05DC\u05D9\u05E0\u05D5."
        commands: []
    - rid: 2649295523292643517
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D5\u05DE\u05D9! \u05D0\u05EA \u05E2\u05D5\u05E8\u05DB\u05EA
          \u05D3\u05D9\u05DF, \u05D0\u05EA \u05D0\u05DE\u05D5\u05E8\u05D4 \u05DC\u05D3\u05E2\u05EA
          \u05D0\u05D9\u05DA \u05DE\u05E9\u05E4\u05D8 \u05E6\u05D1\u05D0\u05D9 \u05D4\u05D5\u05DC\u05DA!"
        commands: []
    - rid: 2649295523292643518
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D3\u05D9 \u05E9\u05D5\u05E0\u05D4 \u05DE\u05DB\u05DC
          \u05DE\u05E9\u05E4\u05D8 \u05E9\u05D0\u05E0\u05D9 \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05D1\u05D5\u2026"
        commands: []
    - rid: 2649295523292643519
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D1\u05D3\u05E8\u05DA \u05DB\u05DC\u05DC \u05DE\u05EA\u05D7\u05D9\u05DC\u05D9\u05DD
          \u05E2\u05DD \u05DB\u05EA\u05D1 \u05D4\u05D0\u05D9\u05E9\u05D5\u05DD, \u05D5\u05E2\u05D5\u05D1\u05E8\u05D9\u05DD
          \u05E2\u05DC \u05D4\u05E2\u05D5\u05D1\u05D3\u05D5\u05EA."
        commands: []
    - rid: 2649295523292643520
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0\u05D7\u05E8 \u05DE\u05DB\u05DF, \u05E9\u05D5\u05D0\u05DC\u05D9\u05DD
          \u05D0\u05EA \u05D4\u05E0\u05D0\u05E9\u05DD \u05D0\u05DD \u05D4\u05D5\u05D0
          \u05DE\u05D5\u05D3\u05D4 \u05D1\u05E2\u05D5\u05D1\u05D3\u05D5\u05EA \u05D0\u05D5
          \u05D1\u05D0\u05E9\u05DE\u05D4\u2026 \u05D1\u05DE\u05E7\u05E8\u05D4 \u05E9\u05DC\u05E0\u05D5,
          \u05D0\u05D9\u05DF \u05DE\u05DE\u05E9 \u05E0\u05D0\u05E9\u05DD \u05E1\u05E4\u05D9\u05E6\u05E4\u05D9."
        commands: []
    - rid: 2649295523292643521
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D6\u05D0\u05EA \u05D0\u05D5\u05DE\u05E8\u05EA \u05D0\u05D9\u05DF
          \u05E0\u05D0\u05E9\u05DD \u05E1\u05E4\u05E6\u05D9\u05E4\u05D9? \u05D4\u05E8\u05D9
          \u05D6\u05D4 \u05D1\u05E8\u05D5\u05E8 \u05E9\u05D6\u05D4 \u05D0\u05DC\u05D5\u05DF!"
        commands: []
    - rid: 2649295523292643522
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D9\u05D4 \u05D1\u05E8\u05D5\u05E8 \u05E9\u05D9\u05D2\u05D9\u05E2\u05D5
          \u05DC\u05D6\u05D4 \u05DE\u05EA\u05D9\u05E9\u05D4\u05D5\u2026)"
        commands: []
    - rid: 2649295523292643523
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D2\u05E2, \u05D1\u05D5\u05D0\u05D5 \u05E0\u05D9\u05E7\u05D7
          \u05D0\u05EA \u05D6\u05D4 \u05E6\u05E2\u05D3 \u05E6\u05E2\u05D3."
        commands: []
    - rid: 2649295523292643524
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E7\u05D3\u05D9\u05DE\u05D4, \u05D4\u05E8\u05D5\u05E6\u05D7, \u05D0\u05EA\u05D4
          \u05DB\u05D5\u05E4\u05E8 \u05D1\u05E2\u05D5\u05D1\u05D3\u05D5\u05EA \u05D5\u05DB\u05D5\u05E4\u05E8
          \u05D1\u05D0\u05E9\u05DE\u05D4, \u05DB\u05D5\u05E4\u05E8 \u05D1\u05E2\u05D5\u05D1\u05D3\u05D5\u05EA
          \u05D5\u05DE\u05D5\u05D3\u05D4 \u05D1\u05D0\u05E9\u05DE\u05D4, \u05DE\u05D5\u05D3\u05D4
          \u05D1\u05E2\u05D5\u05D1\u05D3\u05D5\u05EA \u05D5\u05DB\u05D5\u05E4\u05E8
          \u05D1\u05D0\u05E9\u05DE\u05D4, \u05D0\u05D5 \u05DE\u05D5\u05D3\u05D4 \u05D1\u05E2\u05D5\u05D1\u05D3\u05D5\u05EA
          \u05D5\u05DE\u05D5\u05D3\u05D4 \u05D1\u05D0\u05E9\u05DE\u05D4?"
        commands: []
    - rid: 2649295523292643525
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05D4 \u05E6\u05E8\u05D9\u05DA \u05DC\u05D3\u05E2\u05EA
          \u05DE\u05D9 \u05D6\u05D4 \u05DB\u05D3\u05D9 \u05DC\u05E9\u05D0\u05D5\u05DC
          \u05D0\u05EA \u05D4\u05E9\u05D0\u05DC\u05D4 \u05D4\u05D6\u05D0\u05EA\u2026"

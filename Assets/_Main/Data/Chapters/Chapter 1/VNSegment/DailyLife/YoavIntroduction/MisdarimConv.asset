    - rid: 6008430184854716461
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D7\u05D1\u05E8\u05D9\u05DD, \u05D4\u05E7\u05E9\u05D1\u05D4 \u05D0\u05DC\u05D9\u05D9.
          \u05DB\u05D3\u05D9 \u05DC\u05E1\u05D9\u05D9\u05DD \u05D0\u05EA \u05D4\u05D9\u05D5\u05DD
          \u05D4\u05E8\u05D0\u05E9\u05D5\u05DF \u05E9\u05DC\u05DB\u05DD \u05DB\u05D0\u05DF,
          \u05D0\u05E0\u05D9 \u05D0\u05E6\u05D9\u05D2 \u05DC\u05DB\u05DD \u05E2\u05DB\u05E9\u05D9\u05D5
          \u05DE\u05E7\u05D5\u05DD \u05E0\u05D5\u05E1\u05E3."
        commands:
        - rid: 6008430184854716519
    - rid: 6008430184854716462
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05DD \u05E8\u05D5\u05D0\u05D9\u05DD \u05D0\u05EA \u05D4\u05DB\u05D9\u05EA\u05D5\u05EA
          \u05E4\u05D4 \u05DE\u05D0\u05D7\u05D5\u05E8\u05D4?"
        commands:
        - rid: 6008430184854716514
    - rid: 6008430184854716463
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05DF, \u05D9\u05E9 \u05E9\u05DD \u05E9\u05E0\u05D9 \u05DE\u05D1\u05E0\u05D9\u05DD
          \u05DB\u05D0\u05DC\u05D4 \u05DE\u05D0\u05D7\u05D5\u05E8\u05D9 \u05D4\u05E8\u05D7\u05D1\u05D4.)"
        commands: []
    - rid: 6008430184854716464
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05E6\u05D3 \u05E9\u05DE\u05D0\u05DC \u05D6\u05D5 \u05DB\u05D9\u05EA\u05D4
          \u05DE\u05D9\u05D5\u05D7\u05D3\u05EA, \u05D4\u05D9\u05D0 \u05E0\u05E2\u05D5\u05DC\u05D4
          \u05DB\u05E8\u05D2\u05E2."
        commands: []
    - rid: 6008430184854716465
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05DE\u05D4 \u05DE\u05D4 \u05D9\u05E9 \u05E9\u05DD?"
        commands: []
    - rid: 6008430184854716466
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05E8\u05DC\u05D5\u05D5\u05E0\u05D8\u05D9 \u05DB\u05E8\u05D2\u05E2!
          \u05E8\u05E7 \u05E8\u05E6\u05D9\u05EA\u05D9 \u05DC\u05D4\u05D5\u05E6\u05D9\u05D0
          \u05D0\u05D5\u05EA\u05D4 \u05DE\u05D4\u05D3\u05E8\u05DA."
        commands: []
    - rid: 6008430184854716467
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05E9\u05D1\u05D0\u05EA\u05D9 \u05DC\u05D4\u05E6\u05D9\u05D2
          \u05DC\u05DB\u05DD \u05D4\u05D9\u05D5\u05DD, \u05D4\u05D5\u05D0 *\u05D4\u05D9\u05D5\u05D0\u05D1*!"
        commands: []
    - rid: 6008430184854716468
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D9\u05D5\u05D0\u05D1?)"
        commands: []
    - rid: 6008430184854716469
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D9 \u05D6\u05D4 \u05D9\u05D5\u05D0\u05D1?"
        commands: []
    - rid: 6008430184854716470
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D9\u05D5\u05D0\u05D1 \u05D9\u05E9 \u05D0\u05EA \u05DB\u05DC
          \u05D4\u05E6\u05D9\u05D5\u05D3 \u05E9\u05D0\u05E0\u05D7\u05E0\u05D5 \u05E6\u05E8\u05D9\u05DB\u05D9\u05DD.
          \u05EA\u05D7\u05E9\u05D1\u05D5 \u05E2\u05DC \u05D6\u05D4 \u05DB\u05DE\u05D5
          \u05DE\u05D9\u05E0\u05D9 \u05DC\u05D5\u05D2\u05D9\u05E1\u05D8\u05D9\u05E7\u05D4
          \u05E4\u05DC\u05D5\u05D2\u05EA\u05D9\u05EA!"
        commands: []
    - rid: 6008430184854716471
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D7\u05E0\u05D5 \u05E2\u05DB\u05E9\u05D9\u05D5 \u05E0\u05D9\u05DB\u05E0\u05E1
          \u05E4\u05E0\u05D9\u05DE\u05D4, \u05DB\u05D3\u05D9 \u05DC\u05E7\u05D7\u05EA
          \u05DB\u05DE\u05D4 \u05D3\u05D1\u05E8\u05D9\u05DD \u05D1\u05E9\u05D1\u05D9\u05DC\u05DB\u05DD."
        commands: []
    - rid: 6008430184854716472
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D7\u05E8\u05D9\u05D9 \u05DB\u05D5\u05DC\u05DD!"
        commands:
        - rid: 6008430184854716515
        - rid: 6008430184854716520
    - rid: 6008430184854716473
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05D5\u05DC\u05DD \u05E2\u05E7\u05D1\u05D5 \u05D0\u05D7\u05E8\u05D9\u05D5
          \u05DC\u05DE\u05D1\u05E0\u05D4 \u05D1\u05E6\u05D3 \u05D9\u05DE\u05D9\u05DF.)"
        commands: []
    - rid: 6008430184854716474
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05D3\u05D0\u05D9 \u05E9\u05D0\u05E0\u05D9 \u05D0\u05D1\u05D5\u05D0
          \u05D2\u05DD\u2026"
        commands: []

    - rid: 6008430184854716495
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D1\u05EA\u05D5\u05DA \u05D4\"\u05D9\u05D5\u05D0\u05D1\" \u05E8\u05D0\u05D9\u05EA\u05D9
          \u05D4\u05DE\u05D5\u05DF \u05E6\u05D9\u05D5\u05D3.)"
        commands: []
    - rid: 6008430184854716496
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05D5\u05DC\u05DD \u05DB\u05D0\u05DF? \u05DE\u05E6\u05D5\u05D9\u05DF!"
        commands:
        - rid: 6008430184854716521
    - rid: 6008430184854716497
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E6\u05D5\u05D5\u05EA 1, \u05D6\u05D4 *\u05D4\u05D9\u05D5\u05D0\u05D1*!"
        commands: []
    - rid: 6008430184854716498
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E4\u05D9 \u05E9\u05D0\u05EA\u05DD \u05E8\u05D5\u05D0\u05D9\u05DD,
          \u05D9\u05E9 \u05DB\u05D0\u05DF \u05DE\u05D2\u05D5\u05D5\u05DF \u05D3\u05D1\u05E8\u05D9\u05DD."
        commands: []
    - rid: 6008430184854716499
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05DE\u05DE\u05E9 \u05DB\u05DE\u05D5 \u05DE\u05D6\u05E0\u05D5\u05DF
          \u05D0\u05DB\u05D5\u05DC \u05DB\u05E4\u05D9 \u05D9\u05DB\u05D5\u05DC\u05EA\u05DA
          \u05E9\u05DC \u05E6\u05D9\u05D5\u05D3 \u05E6\u05D4\"\u05DC\u05D9! \u05DE\u05DE\u05E9
          \u05D7\u05DC\u05D5\u05DD \u05E9\u05DE\u05EA\u05D2\u05E9\u05DD!"
        commands: []
    - rid: 6008430184854716500
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D7\u05D5\u05E9\u05D1 \u05E9\u05D6\u05D4
          \u05D4\u05D9\u05D4 \u05D7\u05DC\u05D5\u05DD \u05E9\u05DC \u05DE\u05D9\u05E9\u05D4\u05D5
          \u05D0\u05D9 \u05E4\u05E2\u05DD\u2026)"
        commands: []
    - rid: 6008430184854716501
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D7\u05E0\u05D5 \u05E2\u05DB\u05E9\u05D9\u05D5 \u05E0\u05D9\u05E7\u05D7
          *\u05D7\u05DC\u05E4\"\u05E1\u05D9\u05DD*, *\u05E7\u05E1\u05D3\u05D5\u05EA*
          \u05D5*\u05DE\u05D9\u05DE\u05D9\u05D5\u05EA*!"
        commands: []
    - rid: 6008430184854716502
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D7\u05D9 \u05D1\u05E1\u05E8\u05D8! \u05DB\u05D0\u05D9\u05DC\u05D5
          \u05E9\u05D0\u05E0\u05D9 \u05E0\u05D5\u05D2\u05E2\u05EA \u05D1\u05D3\u05D1\u05E8\u05D9\u05DD
          \u05D4\u05D0\u05DC\u05D4."
        commands: []
    - rid: 6008430184854716503
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA \u05D7\u05D9\u05D9\u05D1\u05EA \u05D7\u05DC\u05E4\"\u05E1!
          \u05DE\u05D4 \u05EA\u05E2\u05E9\u05D9 \u05D0\u05DD \u05E4\u05EA\u05D0\u05D5\u05DD
          \u05D9\u05E8\u05D3 \u05E2\u05DC\u05D9\u05DA \u05D2\u05E9\u05DD?"
        commands: []
    - rid: 6008430184854716504
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D3\u05D9 \u05E9\u05DE\u05E9\u05D9 \u05DB\u05E8\u05D2\u05E2, \u05D0\u05E0\u05D9
          \u05DC\u05D0 \u05D7\u05D5\u05E9\u05D1 \u05E9\u05D6\u05D0\u05EA \u05D4\u05E2\u05D5\u05E0\u05D4\u2026)"
        commands: []
    - rid: 6008430184854716505
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D6\u05D4 \u05DB\u05DC \u05D4\u05E9\u05D8\u05D5\u05D9\u05D5\u05EA
          \u05D4\u05D0\u05DC\u05D4? \u05DB\u05D0\u05D9\u05DC\u05D5 \u05E9\u05E0\u05E6\u05D8\u05E8\u05DA
          \u05E7\u05E1\u05D3\u05D5\u05EA! \u05D0\u05E4\u05E9\u05E8 \u05DC\u05D7\u05E9\u05D5\u05D1
          \u05DE\u05D4 \u05D0\u05E0\u05D7\u05E0\u05D5 \u05E2\u05D5\u05E9\u05D9\u05DD
          \u05DB\u05D0\u05DF."
        commands: []
    - rid: 6008430184854716506
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D7\u05D1\u05E8\u05D9\u05DD, \u05DC\u05D0 \u05E0\u05EA\u05E7\u05D3\u05DD
          \u05DC\u05E9\u05D5\u05DD \u05DE\u05E7\u05D5\u05DD \u05D0\u05DD \u05D0\u05EA\u05DD
          \u05DE\u05EA\u05DC\u05D5\u05E0\u05E0\u05D9\u05DD \u05DB\u05DB\u05D4 \u05E2\u05DC
          \u05DB\u05DC \u05D3\u05D1\u05E8. \u05DB\u05D3\u05D0\u05D9 \u05E9\u05EA\u05E0\u05E1\u05D5
          \u05DC\u05E9\u05E0\u05D5\u05EA \u05D2\u05D9\u05E9\u05D4."
        commands: []
    - rid: 6008430184854716507
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9 \u05E9\u05D4\u05D2\u05D9\u05E9\u05D4
          \u05E9\u05DC\u05E0\u05D5 \u05D4\u05D9\u05D0 \u05D4\u05D1\u05E2\u05D9\u05D4
          \u05DB\u05D0\u05DF\u2026"
        commands: []
    - rid: 6008430184854716508
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E7\u05D3\u05D9\u05DE\u05D4 \u05DB\u05D5\u05DC\u05DD! \u05EA\u05D9\u05E7\u05D7\u05D5
          \u05D0\u05EA \u05D4\u05D3\u05D1\u05E8\u05D9\u05DD \u05DC\u05D7\u05D3\u05E8\u05D9\u05DD,
          \u05D5\u05DC\u05D0\u05D7\u05E8 \u05DE\u05DB\u05DF \u05EA\u05E4\u05D2\u05E9\u05D5
          \u05D0\u05D5\u05EA\u05D9 \u05D1\u05E8\u05D7\u05D1\u05EA \u05D4\u05DE\u05E1\u05D3\u05E8\u05D9\u05DD
          \u05D5\u05D0\u05E0\u05D9 \u05D0\u05E9\u05D7\u05E8\u05E8 \u05D0\u05EA\u05DB\u05DD
          \u05DC\u05E9\u05E2\u05EA \u05D8\"\u05E9!"
        commands:
        - rid: 6008430184854716517
        - rid: 6008430184854716522
    - rid: 6008430184854716509
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:

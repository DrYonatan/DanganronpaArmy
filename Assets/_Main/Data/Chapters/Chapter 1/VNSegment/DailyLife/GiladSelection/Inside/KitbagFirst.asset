    - rid: 4526379622067601421
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05DB\u05D5\u05DF! \u05DB\u05DE\u05D4 \u05DE\u05EA\u05D7\u05E9\u05D1.
          \u05D5\u05D4\u05DB\u05DC \u05DB\u05D1\u05E8 \u05DE\u05D5\u05E0\u05D7 \u05DC\u05E0\u05D5

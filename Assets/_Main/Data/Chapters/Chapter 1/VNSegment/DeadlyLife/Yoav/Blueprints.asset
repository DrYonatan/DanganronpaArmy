    - rid: 6008429843967377442
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DE\u05D4 \u05D6\u05D4? \u05D9\u05E9 \u05DB\u05D0\u05DF \u05DB\u05DC
          \u05DE\u05D9\u05E0\u05D9 \u05EA\u05E8\u05E9\u05D9\u05DE\u05D9\u05DD.)"
        commands: []
    - rid: 6008429843967377443
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D9\u05D5\u05EA\u05E8 \u05E0\u05DB\u05D5\u05DF \u05E9\u05E8\u05D8\u05D5\u05D8\u05D9\u05DD.
          \u05DE\u05DE\u05D4 \u05E9\u05D0\u05E0\u05D9 \u05DE\u05E6\u05DC\u05D9\u05D7
          \u05DC\u05D4\u05D1\u05D9\u05DF, \u05D0\u05DC\u05D4 \u05E9\u05E8\u05D8\u05D5\u05D8\u05D9\u05DD
          \u05E9\u05DC \u05D7\u05DC\u05E7 \u05DE\u05D4\u05DE\u05D1\u05E0\u05D9\u05DD
          \u05D5\u05D4\u05D0\u05D6\u05D5\u05E8\u05D9\u05DD \u05D1\u05D1\u05E1\u05D9\u05E1.)"
        commands: []
    - rid: 6008429843967377444
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D4 \u05E0\u05E8\u05D0\u05D4 \u05DB\u05DE\u05D5 \u05E9\u05E8\u05D8\u05D5\u05D8\u05D9
          \u05EA\u05DB\u05E0\u05D5\u05DF, \u05DB\u05D0\u05DC\u05D4 \u05E9\u05DE\u05E9\u05EA\u05DE\u05E9\u05D9\u05DD
          \u05D1\u05D4\u05DD \u05DB\u05E9\u05D1\u05D5\u05E0\u05D9\u05DD \u05D1\u05EA\u05D9\u05DD.
          \u05DB\u05E0\u05E8\u05D0\u05D4 \u05E9\u05D4\u05E9\u05EA\u05DE\u05E9\u05D5
          \u05D1\u05D4\u05DD \u05DB\u05E9\u05D4\u05E7\u05D9\u05DE\u05D5 \u05D0\u05EA
          \u05D4\u05D1\u05E1\u05D9\u05E1.)"
        commands: []
    - rid: 6008429843967377445
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D9\u05E9 \u05E4\u05D4 \u05DB\u05DE\u05D4, \u05D0\u05E4\u05E9\u05E8
          \u05DC\u05D3\u05E4\u05D3\u05E3.)"
        commands: []
    - rid: 6008429843967377446
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D7\u05D3\"\u05D0, \u05D4\u05E4\u05DC\u05D5\u05D2\u05D4\u2026
          \u05D4\u05E9\u05E8\u05D8\u05D5\u05D8\u05D9\u05DD \u05D4\u05D0\u05DC\u05D4
          \u05DE\u05DE\u05E9 \u05DE\u05D3\u05D5\u05D9\u05E7\u05D9\u05DD. \u05E0\u05E8\u05D0\u05D4
          \u05E9\u05E2\u05E7\u05D1\u05D5 \u05D0\u05D7\u05E8\u05D9\u05D4\u05DD \u05DB\u05DE\u05D5
          \u05E9\u05E6\u05E8\u05D9\u05DA.)"
        commands: []
    - rid: 6008429843967377447
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D5\u05DC\u05D9 \u05D9\u05D4\u05D9\u05D4 \u05D0\u05E4\u05E9\u05E8
          \u05DC\u05E8\u05D0\u05D5\u05EA \u05DE\u05D9\u05D3\u05E2 \u05DC\u05D2\u05D1\u05D9
          \u05D4\u05DE\u05E7\u05D5\u05DD \u05D4\u05D6\u05D4? \u05DE\u05D9 \u05D1\u05E0\u05D4
          \u05D0\u05D5\u05EA\u05D5 \u05D5\u05DE\u05EA\u05D9?)"
        commands: []
    - rid: 6008429843967377448
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D7\u05D9\u05E4\u05E9\u05EA\u05D9, \u05D0\u05D1\u05DC \u05DC\u05D0
          \u05DE\u05E6\u05D0\u05EA\u05D9 \u05E9\u05D5\u05DD \u05D3\u05D1\u05E8 \u05E8\u05DC\u05D5\u05D5\u05E0\u05D8\u05D9.)"
        commands: []
    - rid: 6008429843967377449
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DE\u05E2\u05E0\u05D9\u05D9\u05DF \u05E9\u05D4\u05DD \u05E9\u05DE\u05E8\u05D5
          \u05D0\u05EA \u05D6\u05D4\u2026)"
        commands: []
    - rid: 6008429843967377450
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05DE\u05E9\u05DB\u05EA\u05D9 \u05DC\u05D3\u05E4\u05D3\u05E3,
          \u05D5\u05D4\u05D2\u05E2\u05EA\u05D9 \u05DC\u05E9\u05E8\u05D8\u05D5\u05D8
          \u05E9\u05DC \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD, \u05D4\u05E8\u05E6\u05D7
          \u05E7\u05E8\u05D4 \u05E9\u05DD\u2026 \u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7
          \u05E9\u05E9\u05D5\u05D5\u05D4 \u05DC\u05D6\u05DB\u05D5\u05E8 \u05D0\u05EA
          \u05D6\u05D4.)"
        commands:
        - rid: 6008429843967377487

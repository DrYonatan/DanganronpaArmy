    - rid: 6008429867673059741
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05DE\u05D0\u05D9\u05E4\u05D4 \u05DE\u05EA\u05D7\u05D9\u05DC\u05D9\u05DD?"
        commands:
        - rid: 6008429867673059759
    - rid: 6008429867673059742
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D5\u05D0\u05D5 \u05E0\u05E1\u05EA\u05DB\u05DC \u05E2\u05DC
          \u05D4\u05EA\u05E7\u05D9\u05D9\u05D4 \u05D4\u05D6\u05D0\u05EA \u05E9\u05D4\u05D5\u05D0
          \u05D4\u05D1\u05D9\u05D0."
        commands:
        - rid: 6008429867673059760
        - rid: 6008430184854716691
    - rid: 6008429867673059743
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "<G\"\u05EA\u05E7\u05D9\u05D9\u05EA \u05D4\u05D1\u05DE\u05D1\u05D4\".>"
        commands: []
    - rid: 6008429867673059744
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "<G\u05E9\u05DD \u05D4\u05E7\u05D5\u05E8\u05D1\u05DF: \u05E8\u05D5\u05E2\u05D9
          \u05D4\u05D3\u05E8. \u05E1\u05D9\u05D1\u05EA \u05D4\u05DE\u05D5\u05D5\u05EA:
          \u05E4\u05D2\u05D9\u05E2\u05D4 \u05D1\u05E8\u05D0\u05E9 \u05DE\u05DB\u05D5\u05D7
          \u05E7\u05D4\u05D4. \u05D6\u05DE\u05DF \u05D4\u05DE\u05D5\u05D5\u05EA:
          33:01. \u05E1\u05D5\u05D2 \u05D4\u05DE\u05D5\u05D5\u05EA: \u05DE\u05D9\u05D9\u05D3\u05D9.>"
        commands: []
    - rid: 6008429867673059745
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05E0\u05E8\u05D0\u05D4 \u05E9\u05D9\u05E9 \u05DB\u05D0\u05DF
          \u05D4\u05E8\u05D1\u05D4 \u05E9\u05D0\u05E0\u05D7\u05E0\u05D5 \u05DC\u05D0
          \u05D9\u05D5\u05D3\u05E2\u05D9\u05DD\u2026"
        commands:
        - rid: 6008430184854716692
    - rid: 6008429867673059746
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D4\u05D5\u05D0 \u05D1\u05D0\u05DE\u05EA \u05DE\u05EA
          \u05DE\u05DE\u05E9 \u05DC\u05E4\u05E0\u05D9 \u05DB\u05DE\u05D4 \u05D3\u05E7\u05D5\u05EA?"
        commands: []
    - rid: 6008429867673059747
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF\u2026 \u05D4\u05D5\u05D0 \u05E0\u05D9\u05E7\u05D4 \u05E4\u05D4
          \u05D0\u05D9\u05EA\u05D9 \u05E2\u05D3 \u05D4\u05E8\u05D2\u05E2."
        commands: []
    - rid: 6008429867673059748
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05E0\u05E8\u05D0\u05D4 \u05E9\u05D4\u05EA\u05E7\u05D9\u05D9\u05D4
          \u05D4\u05D6\u05D0\u05EA \u05DE\u05D7\u05D3\u05E9\u05EA \u05D4\u05E8\u05D1\u05D4,
          \u05D0\u05D1\u05DC \u05DB\u05D3\u05D0\u05D9 \u05E9\u05E0\u05E1\u05EA\u05DB\u05DC
          \u05E2\u05DC\u05D9\u05D5\u2026"
        commands: []
    - rid: 6008429867673059749
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E0\u05D9 \u05DC\u05D0 \u05DE\u05E6\u05E4\u05D4 \u05DC\u05D6\u05D4\u2026)\r\n"
        commands: []
    - rid: 6008429867673059750
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D0\u05D9\u05EA\u05D9 \u05D0\u05EA \u05D6\u05D4 \u05DB\u05D0\u05DF
          \u05DB\u05D1\u05E8 \u05DE\u05D4\u05D1\u05D5\u05E7\u05E8. \u05D0\u05DE\u05D5\u05E8\u05D4
          \u05DC\u05D4\u05D9\u05D5\u05EA \u05EA\u05E7\u05DC\u05D4 \u05D1\u05EA\u05D0
          \u05D4\u05D6\u05D4?"
        commands: []
    - rid: 6008429867673059751
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05DE\u05D4 \u05E9\u05D0\u05E0\u05D9 \u05D7\u05E9\u05D1\u05EA\u05D9,
          \u05D0\u05D1\u05DC \u05DB\u05E9\u05E9\u05D0\u05DC\u05E0\u05D5 \u05D0\u05D5\u05EA\u05D5
          \u05E2\u05DC \u05D6\u05D4 \u05D4\u05D5\u05D0 \u05D0\u05DE\u05E8\u2026"
        commands: []
    - rid: 6008429867673059752
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2 \u05DE\u05D4 \u05D6\u05D4 \u05D4\u05E9\u05D8\u05D5\u05D9\u05D5\u05EA
          \u05D4\u05D0\u05DC\u05D4! \u05D4\u05EA\u05D0 \u05D4\u05D6\u05D4 \u05DB\u05DE\u05D5
          \u05D7\u05D3\u05E9!"
        commands: []
    - rid: 6008429867673059753
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05DB\u05DB\u05D4, \u05DC\u05DE\u05D4 \u05E9\u05D9\u05D4\u05D9\u05D4
          \u05DB\u05D0\u05DF \u05E9\u05DC\u05D8 \u05E9\u05D0\u05D5\u05DE\u05E8 \u05E9\u05D4\u05EA\u05D0
          \u05DC\u05D0 \u05EA\u05E7\u05D9\u05DF?"
        commands: []
    - rid: 6008429867673059754
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA \u05DE\u05D5\u05D6\u05E8\u2026"
        commands: []
    - rid: 6008429867673059755
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D5\u05DC\u05D9 \u05DB\u05D3\u05D0\u05D9 \u05E9\u05D0\u05E0\u05D9
          \u05D0\u05D1\u05D3\u05D5\u05E7 \u05D0\u05DD \u05D1\u05D0\u05DE\u05EA \u05D4\u05DB\u05DC
          \u05EA\u05E7\u05D9\u05DF \u05D1\u05EA\u05D0 \u05D4\u05D6\u05D4?)"
        commands: []
    - rid: 6008429867673059756
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC \u05DC\u05E0\u05E1\u05D5\u05EA
          \u05DC\u05D4\u05D9\u05DB\u05E0\u05E1 \u05E4\u05E0\u05D9\u05DE\u05D4 \u05D5\u05DC\u05D4\u05D5\u05E8\u05D9\u05D3
          \u05D0\u05EA \u05D4\u05DE\u05D9\u05DD\u2026)"
        commands: []
    - rid: 6008429867673059757
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}

    - rid: 6008429867673059695
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05D4\u05DE\u05D5\u05E9\u05D7\u05E8 \u05D9\u05E6\u05DC\u05D9\u05D7

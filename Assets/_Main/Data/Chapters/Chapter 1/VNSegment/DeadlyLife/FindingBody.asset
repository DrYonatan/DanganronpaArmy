    - rid: 6008429867673059696
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4\u05D5. \u05D4\u05DB\u05DC \u05D1\u05E8\u05D5\u05E8?"

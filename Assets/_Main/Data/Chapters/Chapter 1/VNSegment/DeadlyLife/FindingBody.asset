        commands: []
    - rid: 6008429867673059693
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05DE\u05E9\u05E4\u05D8 \u05EA\u05E6\u05D8\u05E8\u05DB\u05D5

    - rid: 6008429867673059690
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E4\u05D9 \u05E9\u05D4\u05E1\u05D1\u05E8\u05EA\u05D9 \u05DC\u05DB\u05DD

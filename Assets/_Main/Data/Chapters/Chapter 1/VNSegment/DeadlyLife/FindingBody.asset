          \u05D4\u05D7\u05D9\u05D9\u05DD \u05E9\u05DC\u05DB\u05DD \u05EA\u05DC\u05D5\u05D9\u05D9\u05DD
          \u05D1\u05D6\u05D4!"
        commands: []
    - rid: 6008429867673059700
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6008429867673059701
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6008429867673059702
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D3\u05D1\u05E8 \u05D0\u05D7\u05E8\u05D5\u05DF. \u05D0\u05E0\u05D9
          \u05E2\u05DB\u05E9\u05D9\u05D5 \u05D0\u05E2\u05E0\u05D9\u05E7 \u05DC\u05DB\u05DD,
          \u05D0\u05EA *\u05EA\u05E7\u05D9\u05D9\u05EA \u05D4\u05D1\u05DE\u05D1\u05D4*!"
        commands: []
    - rid: 6008429867673059703
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05EA\u05E7\u05D9\u05D9\u05D4 \u05D4\u05D6\u05D5 \u05DE\u05DB\u05D9\u05DC\u05D4
          \u05E4\u05E8\u05D8\u05D9\u05DD \u05DC\u05D2\u05D1\u05D9 \u05D4\u05E8\u05E6\u05D7."
        commands: []
    - rid: 6008429867673059704
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05DB\u05DC \u05DE\u05E7\u05E8\u05D4, \u05E9\u05D9\u05D4\u05D9\u05D4
          \u05DC\u05DB\u05DD \u05D1\u05D4\u05E6\u05DC\u05D7\u05D4! \u05DB\u05E9\u05D9\u05D2\u05DE\u05E8
          \u05DC\u05DB\u05DD \u05D4\u05D6\u05DE\u05DF \u05DC\u05D7\u05E7\u05D5\u05E8,
          \u05D0\u05E0\u05D9 \u05D0\u05D5\u05D3\u05D9\u05E2 \u05DC\u05DB\u05DD \u05D1\u05DB\u05E8\u05D9\u05D6\u05D4."
        commands:
        - rid: 6008429988146839560
    - rid: 6008429867673059705
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D5\u05DB\u05DB\u05D4, \u05D4\u05D5\u05D0 \u05D4\u05E9\u05D0\u05D9\u05E8
          \u05D0\u05D5\u05EA\u05E0\u05D5 \u05E2\u05DD \u05E2\u05E6\u05DE\u05E0\u05D5,
          \u05D0\u05D1\u05D5\u05D3\u05D9\u05DD.)"
        commands: []
    - rid: 6008429867673059706
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6\u2026 \u05DE\u05D4 \u05D0\u05EA\u05DD \u05E8\u05D5\u05E6\u05D9\u05DD
          \u05DC\u05E2\u05E9\u05D5\u05EA? \u05E9\u05E0\u05E9\u05EA\u05E3 \u05E4\u05E2\u05D5\u05DC\u05D4
          \u05E2\u05DD \u05D6\u05D4\u2026?"
        commands: []
    - rid: 6008429867673059707
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05E9 \u05DC\u05E0\u05D5 \u05D1\u05E8\u05D9\u05E8\u05D4?"
        commands: []
    - rid: 6008429867673059708
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6008429867673059709
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D7\u05D5\u05E9\u05D1 \u05E9\u05D0\u05E0\u05D7\u05E0\u05D5
          \u05E6\u05E8\u05D9\u05DB\u05D9\u05DD \u05DC\u05D7\u05E7\u05D5\u05E8. \u05D0\u05E0\u05D7\u05E0\u05D5
          \u05D7\u05D9\u05D9\u05D1\u05D9\u05DD \u05DC\u05D4\u05D1\u05D9\u05DF \u05DE\u05D4
          \u05E7\u05D5\u05E8\u05D4 \u05DB\u05D0\u05DF, \u05D0\u05D9 \u05D0\u05E4\u05E9\u05E8
          \u05DC\u05EA\u05EA \u05DC\u05DE\u05D5\u05D5\u05EA \u05E9\u05DC\u05D5 \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05D7\u05E1\u05E8 \u05EA\u05D5\u05E2\u05DC\u05EA."
        commands: []
    - rid: 6008429867673059710
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DC\u05D4\u05D1\u05D9\u05DF \u05DE\u05D4 \u05E7\u05D5\u05E8\u05D4
          \u05E4\u05D4\u2026)"
        commands: []
    - rid: 6008429867673059711
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05E1\u05DB\u05D9\u05DE\u05D4\u2026 \u05E2\u05DD
          \u05DB\u05DE\u05D4 \u05E9\u05D6\u05D4 \u05E7\u05E9\u05D4, \u05D0\u05E0\u05D7\u05E0\u05D5
          \u05D7\u05D9\u05D9\u05D1\u05D9\u05DD \u05DC\u05D4\u05D1\u05D9\u05DF."
        commands: []
    - rid: 6008429867673059712
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05DF, \u05D4\u05DD \u05E6\u05D5\u05D3\u05E7\u05D9\u05DD\u2026)"
        commands: []
    - rid: 6008429867673059713
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05E8\u05D2\u05E2, \u05D0\u05DC\u05D5\u05DF \u05D4\u05D5\u05D0
          \u05D4\u05D9\u05D7\u05D9\u05D3 \u05E9\u05D4\u05D9\u05D4 \u05D0\u05D9\u05EA\u05D5,
          \u05E0\u05DB\u05D5\u05DF? \u05D6\u05D4 \u05DC\u05D0 \u05D0\u05D5\u05DE\u05E8
          \u05E9\u05D4\u05D5\u05D0 \u05D4\u05E8\u05D5\u05E6\u05D7?"
        commands: []
    - rid: 6008429867673059714
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: (...)
        commands: []
    - rid: 6008429867673059715
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DE\u05D0\u05DC'\u05D4! \u05D6\u05D4 \u05E0\u05DB\u05D5\u05DF
          \u05D0\u05DC\u05D5\u05DF?"
        commands: []
    - rid: 6008429867673059716
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0\u2026 \u05D6\u05D4 \u05DC\u05D0 \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05D0\u05E0\u05D9."
        commands: []
    - rid: 6008429867673059717
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05DC\u05DE\u05D4 \u05E9\u05E0\u05D0\u05DE\u05D9\u05DF \u05DC\u05D6\u05D4?"
        commands: []
    - rid: 6008429867673059718
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D2\u05E2 \u05E8\u05D2\u05E2 \u05D7\u05D1\u05E8'\u05D4\u2026
          \u05D1\u05D5\u05D0\u05D5 \u05DC\u05D0 \u05E0\u05E7\u05E4\u05D5\u05E5 \u05DC\u05DE\u05E1\u05E7\u05E0\u05D5\u05EA."
        commands: []
    - rid: 6008429867673059719
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05E9 \u05DC\u05E0\u05D5 \u05DB\u05DE\u05D4 \u05E9\u05E2\u05D5\u05EA
          \u05DC\u05D7\u05E7\u05D5\u05E8 \u05D4\u05DB\u05DC. \u05E0\u05D3\u05D1\u05E8
          \u05E2\u05DC \u05D6\u05D4 \u05D0\u05D7\u05E8 \u05DB\u05DA. \u05D1\u05DB\u05DC
          \u05DE\u05E7\u05E8\u05D4, \u05D1\u05D9\u05E0\u05EA\u05D9\u05D9\u05DD \u05D0\u05E0\u05D9
          \u05D7\u05D5\u05E9\u05D1 \u05E9\u05E2\u05D3\u05D9\u05E3 \u05E9\u05E0\u05EA\u05E4\u05E6\u05DC."
        commands: []
    - rid: 6008429867673059720
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05E1\u05D3\u05E8, \u05D0\u05D1\u05DC \u05DB\u05D3\u05D0\u05D9
          \u05E9\u05DC\u05D0 \u05EA\u05E9\u05D0\u05D9\u05E8 \u05D0\u05D5\u05EA\u05D5
          \u05DC\u05D1\u05D3 \u05E4\u05D4, \u05E9\u05DC\u05D0 \u05D9\u05E2\u05DC\u05D9\u05DD
          \u05E8\u05D0\u05D9\u05D5\u05EA."
        commands: []
    - rid: 6008429867673059721
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF \u05DB\u05DF\u2026"
        commands: []
    - rid: 6008429867673059722
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05D5\u05DC\u05DD \u05D4\u05DC\u05DB\u05D5, \u05E0\u05E9\u05D0\u05E8\u05E0\u05D5
          \u05E8\u05E7 \u05D0\u05E0\u05D9, \u05D2\u05D9\u05D0 \u05D5\u05E2\u05D5\u05DE\u05E8.)"
        commands:
        - rid: 6008429988146839561
    - rid: 6008429867673059723
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E0\u05D9 \u05D0\u05D4\u05D9\u05D4 \u05D7\u05D9\u05D9\u05D1
          \u05DC\u05D4\u05EA\u05D7\u05D9\u05DC \u05DC\u05D7\u05E7\u05D5\u05E8.)"
        commands: []
    - rid: 6008429867673059724
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D9\u05DB\u05D5\u05DC \u05DC\u05DE\u05D5\u05EA
          \u05DB\u05D0\u05DF!)"
        commands: []

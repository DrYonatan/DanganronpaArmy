    - rid: 6008429843967377506
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E9\u05DC\u05D5\u05DD \u05DC\u05DB\u05D5\u05DC\u05DD! \u05D0\u05E0\u05D9
          \u05DE\u05E7\u05D5\u05D5\u05D4 \u05E9\u05E1\u05D9\u05D9\u05DE\u05EA\u05DD
          \u05DC\u05D7\u05E7\u05D5\u05E8, \u05DB\u05D9 \u05E0\u05D2\u05DE\u05E8 \u05D4\u05D6\u05DE\u05DF!"
        commands:
        - rid: 6008429843967377514
        - rid: 6008429843967377515
    - rid: 6008429843967377507
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05E0\u05E8\u05D2\u05E9 \u05DC\u05D4\u05D6\u05DE\u05D9\u05DF
          \u05D0\u05EA\u05DB\u05DD \u05DC*\u05DE\u05E9\u05E4\u05D8 \u05D4\u05E6\u05D1\u05D0\u05D9*!"
        commands: []
    - rid: 6008429843967377508
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05D5\u05DC\u05DD, \u05EA\u05E4\u05D2\u05E9\u05D5 \u05D0\u05D5\u05EA\u05D9
          \u05DE\u05D5\u05DC \u05D4\u05DB\u05D9\u05EA\u05D4 \u05E9\u05E0\u05DE\u05E6\u05D0\u05EA
          \u05D1\u05E8\u05D7\u05D1\u05EA \u05D4\u05DE\u05E1\u05D3\u05E8\u05D9\u05DD!"
        commands: []
    - rid: 6008429843967377509
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E9\u05DB\u05D5\u05DC\u05DD \u05D9\u05D2\u05D9\u05E2\u05D5,
          \u05D0\u05E0\u05D9 \u05D0\u05E1\u05D1\u05D9\u05E8 \u05DE\u05D4 \u05D4\u05D5\u05DC\u05DA
          \u05DC\u05E7\u05E8\u05D5\u05EA \u05DE\u05DB\u05D0\u05DF!"
        commands: []
    - rid: 6008429843967377510
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E7\u05D3\u05D9\u05DE\u05D4! \u05D0\u05DD \u05D0\u05EA\u05DD \u05E6\u05E8\u05D9\u05DB\u05D9\u05DD
          \u05E4\u05D9\u05E4\u05D9, \u05D6\u05D4 \u05D4\u05D6\u05DE\u05DF! \u05D0\u05D1\u05DC
          \u05DC\u05D0 \u05DC\u05D4\u05EA\u05E2\u05DB\u05D1 \u05D9\u05D5\u05EA\u05E8
          \u05DE\u05D3\u05D9!"
        commands: []
    - rid: 6008429843967377511
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E0\u05D2\u05DE\u05E8 \u05D4\u05D6\u05DE\u05DF\u2026 \u05D0\u05E0\u05D9
          \u05DE\u05E7\u05D5\u05D5\u05D4 \u05E9\u05DC\u05D0 \u05E4\u05E1\u05E4\u05E1\u05EA\u05D9
          \u05DB\u05DC\u05D5\u05DD.)"
        commands:
        - rid: 6008429843967377516
    - rid: 6008429843967377512
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D8\u05D5\u05D1, \u05D0\u05D9\u05DF \u05D8\u05E2\u05DD \u05DC\u05D7\u05E9\u05D5\u05D1
          \u05E2\u05DC \u05D6\u05D4 \u05D9\u05D5\u05EA\u05E8.)"
        commands: []
    - rid: 6008429843967377513
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7 \u05E9\u05DB\u05D3\u05D0\u05D9
          \u05E9\u05D0\u05E0\u05D9 \u05D0\u05D2\u05D9\u05E2 \u05DC\u05E8\u05D7\u05D1\u05EA
          \u05D4\u05DE\u05E1\u05D3\u05E8\u05D9\u05DD \u05DB\u05DE\u05D5 \u05E9\u05D4\u05D5\u05D0
          \u05D0\u05DE\u05E8.)"
        commands: []

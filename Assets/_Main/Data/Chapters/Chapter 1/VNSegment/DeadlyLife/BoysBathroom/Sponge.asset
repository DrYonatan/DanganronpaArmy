    - rid: 6008430184854716707
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D4 \u05E0\u05DB\u05D5\u05DF, \u05D6\u05D4 \u05D4\u05E1\u05E4\u05D5\u05D2
          \u05D4\u05D4\u05D5\u05D0 \u05E9\u05D4\u05D5\u05D0 \u05E0\u05EA\u05DF \u05DC\u05D9."
        commands: []
    - rid: 6008430184854716708
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DC\u05D0 \u05D4\u05D9\u05D4 \u05DC\u05D9 \u05D6\u05DE\u05DF \u05DC\u05D4\u05E9\u05EA\u05DE\u05E9
          \u05D1\u05D6\u05D4 \u05D0\u05E4\u05D9\u05DC\u05D5\u2026)"
        commands: []
    - rid: 6008430184854716709
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D5\u05D0 \u05E0\u05EA\u05DF \u05DC\u05DA \u05D0\u05EA \u05D4\u05E1\u05E4\u05D5\u05D2
          \u05D4\u05D6\u05D4 \u05D1\u05E9\u05D1\u05D9\u05DC \u05D4\u05D0\u05DC\"\u05D1?"
        commands:
        - rid: 6008430184854716719
    - rid: 6008430184854716710
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D4\u05E0\u05D7\u05EA\u05D9 \u05D0\u05D5\u05EA\u05D5
          \u05DB\u05D0\u05DF \u05DB\u05E0\u05E8\u05D0\u05D4. \u05D0\u05E4\u05D9\u05DC\u05D5
          \u05DC\u05D0 \u05E9\u05DE\u05EA\u05D9 \u05DC\u05D1 \u05DE\u05D4 \u05E2\u05E9\u05D9\u05EA\u05D9
          \u05D0\u05D9\u05EA\u05D5, \u05E2\u05DD \u05DB\u05DC \u05D4\u05E9\u05D5\u05E7\u2026"
        commands: []
    - rid: 6008430184854716711
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D6\u05D4 \u05D4\u05D2\u05D9\u05D5\u05E0\u05D9. \u05D4\u05D5\u05D0
          \u05D0\u05DE\u05E8 \u05E9\u05D6\u05D4 \u05E1\u05E4\u05D5\u05D2 \u05DE\u05D9\u05D5\u05D7\u05D3?"
        commands: []
    - rid: 6008430184854716712
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D5\u05D0 \u05DC\u05D0 \u05DE\u05DE\u05E9 \u05D0\u05DE\u05E8
          \u05DE\u05D4 \u05DE\u05D9\u05D5\u05D7\u05D3 \u05D1\u05D5, \u05E8\u05E7
          \u05D8\u05E2\u05DF \u05E9\u05D6\u05D4 \u05D0\u05D7\u05DC\u05D4 \u05E1\u05E4\u05D5\u05D2."
        commands: []
    - rid: 6008430184854716713
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05DB\u05DC \u05DE\u05E7\u05E8\u05D4, \u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7
          \u05E9\u05D6\u05D4 \u05DC\u05D0 \u05DE\u05E2\u05E0\u05D9\u05D9\u05DF \u05DB\u05DC
          \u05DB\u05DA \u05DB\u05E8\u05D2\u05E2\u2026"
        commands: []
    - rid: 6008430184854716714
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9 \u05D0\u05E4\u05E9\u05E8 \u05DC\u05D3\u05E2\u05EA\u2026
          \u05DB\u05D3\u05D0\u05D9 \u05E9\u05E0\u05D6\u05DB\u05D5\u05E8 \u05D0\u05EA
          \u05D6\u05D4."
        commands: []
    - rid: 6008430184854716715
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D1\u05E1\u05D3\u05E8\u2026)"
        commands: []

    - rid: 6008430184854716763
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05E8\u05D5\u05DB\u05D9\u05DD \u05D4\u05D1\u05D0\u05D9\u05DD
          \u05DC\u05D1\u05D5\u05E8!"
        commands:
        - rid: 6008430213963448322
    - rid: 6008430184854716764
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D1\u05D5\u05E8\u2026?"
        commands: []
    - rid: 6008430184854716765
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05DE\u05D4 \u05D7\u05E9\u05D1\u05EA\u05DD \u05E9\u05D4\u05D9\u05D9\u05E0\u05D5
          \u05E6\u05E8\u05D9\u05DB\u05D9\u05DD \u05DC\u05E8\u05D3\u05EA \u05D1\u05DE\u05E2\u05DC\u05D9\u05EA?"
        commands: []
    - rid: 6008430184854716766
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DE\u05D0\u05DC\u05D4, \u05D6\u05D4 \u05D4\u05D1\u05D5\u05E8
          \u05E9\u05DC \u05E6\u05D4\"\u05DC? \u05D1\u05D9\u05D1\u05D9 \u05E4\u05D4?"
        commands: []
    - rid: 6008430184854716767
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D1\u05D9\u05E8\u05D5\u05E8, \u05D6\u05D4 \u05DC\u05D0 \u05D4\u05D1\u05D5\u05E8
          \u05E9\u05DC \u05E6\u05D4\"\u05DC. \u05D6\u05D4 \u05DB\u05E0\u05E8\u05D0\u05D4
          \u05E1\u05D5\u05D2 \u05E9\u05DC \u05DB\u05D9\u05E0\u05D5\u05D9."
        commands: []
    - rid: 6008430184854716768
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05DB\u05D5\u05DF \u05DE\u05D0\u05D5\u05D3! \u05D4\u05DE\u05E7\u05D5\u05DD
          \u05D4\u05D6\u05D4 \u05D0\u05E4\u05D9\u05DC\u05D5 \u05D9\u05D5\u05EA\u05E8
          \u05D7\u05E9\u05D5\u05D1 \u05DE\u05D4\u05D1\u05D5\u05E8 \u05E9\u05DC \u05E6\u05D4\"\u05DC.
          \u05D6\u05D4 \u05D4\u05D1\u05D5\u05E8 \u05E9\u05DC \u05D9\u05D7\u05D9\u05D3\u05EA
          \u05EA\u05E7\u05D5\u05D5\u05D4!"
        commands: []
    - rid: 6008430184854716769
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DF \u05DC\u05D9 \u05EA\u05D7\u05D5\u05E9\u05D4 \u05D8\u05D5\u05D1\u05D4
          \u05DE\u05D4\u05DE\u05E7\u05D5\u05DD \u05D4\u05D6\u05D4\u2026"
        commands: []
    - rid: 6008430184854716770
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D2\u05DD \u05DC\u05D9."
        commands: []
    - rid: 6008430184854716771
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05D0\u05DF \u05D0\u05E0\u05D7\u05E0\u05D5 \u05E0\u05E7\u05D9\u05D9\u05DD
          \u05D0\u05EA \u05D4\u05DE\u05E9\u05E4\u05D8! \u05E0\u05D0 \u05DC\u05D4\u05D9\u05DB\u05E0\u05E1
          \u05DC\u05E2\u05DE\u05D3\u05D5\u05EA!"
        commands: []
    - rid: 6008430184854716772
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D1\u05DE\u05E8\u05DB\u05D6 \u05D4\u05D7\u05D3\u05E8, \u05D4\u05D9\u05D4
          \u05DE\u05E2\u05D2\u05DC \u05E9\u05DC \u05E2\u05DE\u05D3\u05D5\u05EA. \u05DB\u05DC
          \u05D0\u05D7\u05D3 \u05DE\u05D0\u05D9\u05EA\u05E0\u05D5 \u05E0\u05DB\u05E0\u05E1
          \u05DC\u05D0\u05D7\u05EA, \u05DB\u05DB\u05D4 \u05E9\u05E2\u05DE\u05D3\u05E0\u05D5
          \u05D0\u05D7\u05D3 \u05DE\u05D5\u05DC \u05D4\u05E9\u05E0\u05D9.)"
        commands:
        - rid: 6008430184854716779
    - rid: 6008430184854716773
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D4\u05D5 \u05D6\u05D4. \u05D6\u05D4 \u05E8\u05D2\u05E2
          \u05D4\u05D0\u05DE\u05EA. \u05D0\u05E0\u05D9 \u05D4\u05D5\u05DC\u05DA \u05DC\u05D2\u05DC\u05D5\u05EA
          \u05DE\u05D4 \u05E7\u05E8\u05D4 \u05DB\u05D0\u05DF \u05D4\u05D9\u05D5\u05DD.
          \u05D4\u05D7\u05D9\u05D9\u05DD \u05E9\u05DC\u05D9 \u05D5\u05E9\u05DC \u05D4\u05E9\u05D0\u05E8
          \u05EA\u05DC\u05D5\u05D9\u05D9\u05DD \u05D1\u05D6\u05D4.)"
        commands:
        - rid: 6008430184854716778
    - rid: 6008430184854716774
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D7\u05D3 \u05DE\u05D0\u05D9\u05EA\u05E0\u05D5 \u05E8\u05E6\u05D7
          \u05D0\u05EA \u05E8\u05D5\u05E2\u05D9. \u05D6\u05D4 \u05DC\u05D0 \u05E2\u05D5\u05D1\u05D3\u05D4
          \u05E9\u05D0\u05E0\u05D9 \u05D0\u05E6\u05DC\u05D9\u05D7 \u05DC\u05EA\u05E4\u05D5\u05E1,
          \u05DC\u05D0 \u05DE\u05E9\u05E0\u05D4 \u05DB\u05DE\u05D4 \u05E4\u05E2\u05DE\u05D9\u05DD
          \u05D0\u05E0\u05D9 \u05D0\u05D7\u05D6\u05D5\u05E8 \u05E2\u05DC\u05D9\u05D4.)"
        commands: []
    - rid: 6008430184854716775
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DE\u05E9\u05E4\u05D8 \u05E6\u05D1\u05D0\u05D9\u2026 \u05E9\u05DC
          \u05D7\u05D9\u05D9\u05DD \u05D5\u05DE\u05D5\u05D5\u05EA.)"
        commands: []
    - rid: 6008430184854716776
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D9\u05DF \u05D3\u05E8\u05DA \u05D0\u05D7\u05D5\u05E8\u05D4.)"
        commands: []
    - rid: 6008430184854716778
      type: {class: FadeBlackUnderTextBox, ns: , asm: Assembly-CSharp}

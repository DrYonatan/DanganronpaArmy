    - rid: 6299374382971355155
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D6\u05D4? \u05D2\u05DD \u05E4\u05D4 \u05E0\u05E4\u05DC
          \u05D0\u05E8\u05D9\u05D7?"
        commands: []
    - rid: 6299374382971355156
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF! \u05D0\u05E0\u05D9 \u05D4\u05E1\u05EA\u05DB\u05DC\u05EA\u05D9
          \u05E4\u05D4 \u05E7\u05E6\u05EA \u05E7\u05D5\u05D3\u05DD, \u05D5\u05E4\u05EA\u05D0\u05D5\u05DD
          \u05D6\u05D4 \u05E0\u05E4\u05DC \u05DE\u05D4\u05EA\u05E7\u05E8\u05D4!"
        commands:
        - rid: 6299374382971355168
        - rid: 6299374382971355180
    - rid: 6299374382971355157
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05E0\u05D4, \u05D6\u05D4 \u05E0\u05E4\u05DC \u05DE\u05E9\u05DD,
          \u05EA\u05E8\u05D0\u05D4."
        commands: []
    - rid: 6299374382971355158
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DE\u05E2\u05DC \u05D4\u05D0\u05E8\u05D9\u05D7 \u05D9\u05E9 \u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA.
          \u05D6\u05D4 \u05E0\u05E8\u05D0\u05D4 \u05D1\u05D3\u05D9\u05D5\u05E7 \u05D0\u05D5\u05EA\u05D5
          \u05D3\u05D1\u05E8 \u05DB\u05DE\u05D5 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9
          \u05D1\u05E0\u05D9\u05DD.)"
        commands:
        - rid: 6299374382971355178
        - rid: 6299374382971355179
    - rid: 6299374382971355159
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E8\u05E7 \u05D4\u05D2\u05D9\u05D5\u05E0\u05D9, \u05D6\u05D4 \u05E0\u05E8\u05D0\u05D4
          \u05DB\u05DE\u05D5 \u05D1\u05D3\u05D9\u05D5\u05E7 \u05D0\u05D5\u05EA\u05D5
          \u05DE\u05D1\u05E0\u05D4 \u05D0\u05D1\u05DC \u05D4\u05E4\u05D5\u05DA.)"
        commands: []
    - rid: 6299374382971355160
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D1\u05DC \u05DE\u05D4 \u05D4\u05D9\u05D4 \u05D9\u05DB\u05D5\u05DC
          \u05DC\u05D2\u05E8\u05D5\u05DD \u05DC\u05D6\u05D4 \u05DC\u05D9\u05E4\u05D5\u05DC
          \u05DB\u05DB\u05D4?)"
        commands: []
    - rid: 6299374382971355161
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E9\u05DE\u05E2\u05E0\u05D5 \u05E4\u05EA\u05D0\u05D5\u05DD \u05E8\u05E2\u05E9,
          \u05D5\u05D0\u05D6 \u05D4\u05E1\u05EA\u05DB\u05DC\u05E0\u05D5 \u05D1\u05EA\u05D5\u05DA
          \u05D4\u05EA\u05D0 \u05D5\u05E8\u05D0\u05D9\u05E0\u05D5 \u05E9\u05D4\u05D0\u05E8\u05D9\u05D7
          \u05E4\u05E9\u05D5\u05D8 \u05E0\u05E4\u05DC!"
        commands:
        - rid: 6299374382971355171
    - rid: 6299374382971355162
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D5\u05E6\u05D0\u05E0\u05D5 \u05D0\u05EA \u05D6\u05D4 \u05DE\u05D4\u05EA\u05D0
          \u05DB\u05D3\u05D9 \u05DC\u05D4\u05E1\u05EA\u05DB\u05DC \u05E2\u05DC\u05D9\u05D5
          \u05D9\u05D5\u05EA\u05E8 \u05D8\u05D5\u05D1, \u05E0\u05E8\u05D0\u05D4 \u05E9\u05D4\u05D5\u05D0
          \u05D0\u05DE\u05D5\u05E8 \u05DC\u05D4\u05D9\u05D5\u05EA \u05DE\u05D7\u05D5\u05D1\u05E8
          \u05DC\u05EA\u05E7\u05E8\u05D4 \u05E2\u05DD \u05D1\u05E8\u05D2\u05D9\u05DD."
        commands:
        - rid: 6299374382971355172
    - rid: 6299374382971355163
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05E7 \u05D0\u05EA\u05DF \u05D4\u05D9\u05D9\u05EA \u05E4\u05D4?"
        commands: []
    - rid: 6299374382971355164
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF\u2026 \u05DC\u05D0 \u05E8\u05D0\u05D9\u05EA\u05D9 \u05D0\u05E3
          \u05D0\u05D7\u05D3 \u05D0\u05D7\u05E8."
        commands: []
    - rid: 6299374382971355165
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D6\u05DC \u05E9\u05D0\u05E3 \u05D0\u05D7\u05EA \u05DE\u05D0\u05D9\u05EA\u05E0\u05D5
          \u05DC\u05D0 \u05D4\u05D9\u05D9\u05EA\u05D4 \u05D1\u05EA\u05D0 \u05D4\u05D6\u05D4
          \u05DB\u05E9\u05D6\u05D4 \u05E0\u05E4\u05DC\u2026"
        commands:
        - rid: 6299374382971355173
    - rid: 6299374382971355166
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D1\u05D0\u05DE\u05EA \u05DE\u05D6\u05DC\u2026 \u05D0\u05E0\u05D9
          \u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2 \u05DE\u05D4 \u05D4\u05D9\u05D9\u05E0\u05D5
          \u05E2\u05D5\u05E9\u05D9\u05DD \u05D0\u05DD \u05E2\u05D5\u05D3 \u05DE\u05D9\u05E9\u05D4\u05D5
          \u05D4\u05D9\u05D4 \u05DE\u05EA\u2026)"
        commands: []
    - rid: 6299374382971355167
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D1\u05DC \u05DE\u05D4 \u05D4\u05E7\u05D8\u05E2 \u05E2\u05DD
          \u05D4\u05D0\u05E8\u05D9\u05D7\u05D9\u05DD \u05D4\u05D0\u05DC\u05D4\u2026?)"
        commands:
        - rid: 6299374382971355174

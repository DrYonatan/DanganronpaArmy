    - rid: 6299374382971355198
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D2\u05E2, \u05D2\u05DD \u05E4\u05D4 \u05D9\u05E9 \u05E9\u05DC\u05D8
          \u05DB\u05D6\u05D4?"
        commands: []
    - rid: 6299374382971355199
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D6\u05D4 \u05D4\u05D9\u05D4 \u05E4\u05D4 \u05D4\u05D1\u05D5\u05E7\u05E8
          \u05DB\u05E9\u05D4\u05DC\u05DB\u05EA\u05D9 \u05DC\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD."
        commands:
        - rid: 6299374382971355210
        - rid: 6299374382971355212
    - rid: 6299374382971355200
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D4 \u05E0\u05E8\u05D0\u05D4 \u05D1\u05D3\u05D9\u05D5\u05E7
          \u05DB\u05DE\u05D5 \u05D4\u05E9\u05DC\u05D8 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9
          \u05D1\u05E0\u05D9\u05DD\u2026 \u05D6\u05D4 \u05D0\u05D5\u05EA\u05D5 \u05D0\u05D7\u05D3
          \u05E9\u05E9\u05DD \u05D0\u05EA \u05E9\u05E0\u05D9 \u05D4\u05E9\u05DC\u05D8\u05D9\u05DD
          \u05D4\u05D0\u05DC\u05D4?)"
        commands: []
    - rid: 6299374382971355201
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA \u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9
          \u05DE\u05D5\u05D6\u05E8\u2026 \u05D6\u05D4 \u05E8\u05E7 \u05D0\u05E0\u05D7\u05E0\u05D5
          \u05E4\u05D4, \u05D0\u05D9\u05DA \u05DB\u05D1\u05E8 \u05D4\u05E1\u05E4\u05D9\u05E7\u05D4
          \u05DC\u05D4\u05D9\u05D5\u05EA \u05EA\u05E7\u05DC\u05D4 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD?"
        commands: []
    - rid: 6299374382971355202
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05DC\u05D0 \u05D1\u05D3\u05E7\u05EA \u05D0\u05DD
          \u05D4\u05EA\u05D0 \u05E2\u05D5\u05D1\u05D3, \u05E0\u05DB\u05D5\u05DF?"
        commands: []
    - rid: 6299374382971355203
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D4\u05D9\u05D4 \u05D0\u05DE\u05E6\u05E2 \u05D4\u05DC\u05D9\u05DC\u05D4,
          \u05DC\u05D0 \u05D4\u05D9\u05D4 \u05DC\u05D9 \u05DB\u05D5\u05D7 \u05DC\u05D4\u05EA\u05E2\u05E1\u05E7
          \u05E2\u05DD \u05D6\u05D4. \u05D0\u05DD \u05D6\u05D4 \u05D4\u05D9\u05D4
          \u05DE\u05E9\u05D4\u05D5 \u05E9\u05DC \u05D0\u05DC\u05D4 \u05E9\u05DE\u05D0\u05E8\u05D2\u05E0\u05D9\u05DD
          \u05D0\u05EA \u05D6\u05D4, \u05DC\u05D0 \u05E8\u05E6\u05D9\u05EA\u05D9
          \u05E9\u05D4\u05EA\u05D9\u05E0\u05D5\u05E7 \u05D9\u05D1\u05D5\u05D0 \u05D5\u05D9\u05EA\u05D7\u05D9\u05DC
          \u05DC\u05E0\u05D6\u05D5\u05E3 \u05D1\u05D9 \u05E9\u05D0\u05E0\u05D9 \u05E0\u05D5\u05D2\u05E2\u05EA."
        commands: []
    - rid: 6299374382971355204
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D2\u05E2, \u05D0\u05DE\u05E6\u05E2 \u05D4\u05DC\u05D9\u05DC\u05D4?
          \u05DE\u05EA\u05D9 \u05DB\u05D1\u05E8 \u05E8\u05D0\u05D9\u05EA \u05D0\u05EA
          \u05D4\u05E9\u05DC\u05D8 \u05D4\u05D6\u05D4?"
        commands:
        - rid: 6299374382971355211
    - rid: 6299374382971355205
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05E8\u05D0\u05D9\u05EA\u05D9 \u05D0\u05EA \u05D4\u05E9\u05DC\u05D8
          \u05E4\u05E2\u05DD \u05E8\u05D0\u05E9\u05D5\u05E0\u05D4 \u05E8\u05E7 \u05D1\u05D1\u05D5\u05E7\u05E8."
        commands: []
    - rid: 6299374382971355206
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D4\u05DC\u05DB\u05EA\u05D9 \u05DC\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD
          \u05D1\u05D0\u05DE\u05E6\u05E2 \u05D4\u05DC\u05D9\u05DC\u05D4, \u05D5\u05D4\u05E9\u05DC\u05D8
          \u05DB\u05D1\u05E8 \u05D4\u05D9\u05D4 \u05E9\u05DD."
        commands: []
    - rid: 6299374382971355207
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D6\u05D5 \u05E4\u05E2\u05DD \u05E8\u05D0\u05E9\u05D5\u05E0\u05D4
          \u05E9\u05E8\u05D0\u05D9\u05EA \u05D0\u05EA \u05D6\u05D4?"
        commands: []
    - rid: 6299374382971355208
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05DC\u05D6\u05DB\u05E8\u05D5\u05E0\u05D9 \u05D4\u05E9\u05DC\u05D8
          \u05DC\u05D0 \u05D4\u05D9\u05D4 \u05E9\u05DD \u05D1\u05E9\u05E2\u05EA \u05D8\"\u05E9.
          \u05E8\u05D0\u05D9\u05EA\u05D9 \u05D0\u05D5\u05EA\u05D5 \u05E8\u05E7 \u05DB\u05E9\u05D4\u05DC\u05DB\u05EA\u05D9
          \u05D1\u05D0\u05DE\u05E6\u05E2 \u05D4\u05DC\u05D9\u05DC\u05D4."
        commands: []
    - rid: 6299374382971355209
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D6 \u05DE\u05D9\u05E9\u05D4\u05D5 \u05E9\u05DD \u05D0\u05EA
          \u05D4\u05E9\u05DC\u05D8\u05D9\u05DD \u05D4\u05D0\u05DC\u05D4 \u05DB\u05D1\u05E8
          \u05D1\u05DC\u05D9\u05DC\u05D4.)"
        commands: []

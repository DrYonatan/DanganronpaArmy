    - rid: 6008429867673059466
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05E9\u05D7\u05D6\u05E8\u05EA\u05D9 \u05DC\u05E2\u05E6\u05DE\u05D9,

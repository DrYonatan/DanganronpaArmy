        commands: []
    - rid: 6008429867673059467
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05E7\u05E8\u05D4?"
        commands: []
    - rid: 6008429867673059468
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05DB\u05DC \u05D1\u05E1\u05D3\u05E8?"
        commands: []
    - rid: 6008429867673059469
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6008429867673059470
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6008429867673059471
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DE\u05D0\u05D9\u05D4 \u05D5\u05E2\u05E0\u05D1\u05DC \u05D4\u05EA\u05E1\u05DB\u05DC\u05D5
          \u05D1\u05E9\u05D5\u05E7 \u05E2\u05DC \u05D4\u05EA\u05D0 \u05E2\u05DD \u05E8\u05D5\u05E2\u05D9
          \u05D1\u05EA\u05D5\u05DB\u05D5, \u05D5\u05E9\u05E0\u05D9\u05D9\u05D4 \u05D0\u05D7\u05E8
          \u05DB\u05DA\u2026)"
        commands: []
    - rid: 6008429867673059472
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05DE\u05E6\u05D0\u05D4 \u05D2\u05D5\u05E4\u05D4!"
        commands:
        - rid: 6008429896134033471
        - rid: 6008429896134033472
    - rid: 6008429867673059473
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05E2\u05D5\u05D3 \u05DB\u05DE\u05D4 \u05E9\u05E2\u05D5\u05EA
          \u05DE\u05E2\u05DB\u05E9\u05D9\u05D5, \u05D9\u05EA\u05D7\u05D9\u05DC *\u05D4\u05DE\u05E9\u05E4\u05D8
          \u05D4\u05E6\u05D1\u05D0\u05D9*. \u05D1\u05D4\u05E6\u05DC\u05D7\u05D4!"
        commands: []
    - rid: 6008429867673059474
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands:
        - rid: 6008429896134033473
    - rid: 6008429867673059475
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4?"
        commands: []
    - rid: 6008429867673059476
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D2\u05D5\u05E4\u05D4?! \u05DB\u05DC\u05D5\u05DE\u05E8\u2026?"
        commands: []
    - rid: 6008429867673059477
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E8\u05D5\u05E2\u05D9\u2026 \u05D4\u05D5\u05D0 \u05D1\u05D0\u05DE\u05EA\u2026
          \u05DE\u05EA?)"
        commands: []
    - rid: 6008429867673059478
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E9\u05DC\u05D5\u05E9\u05EA\u05E0\u05D5 \u05E2\u05DE\u05D3\u05E0\u05D5
          \u05D1\u05DE\u05E7\u05D5\u05DD, \u05D4\u05DE\u05D5\u05DE\u05D9\u05DD.)"
        commands: []
    - rid: 6008429867673059479
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05EA\u05D5\u05DA \u05D6\u05DE\u05DF \u05E7\u05E6\u05E8, \u05DB\u05D1\u05E8
          \u05D4\u05D2\u05D9\u05E2\u05D5 \u05D4\u05D0\u05D7\u05E8\u05D9\u05DD.)"
        commands: []
    - rid: 6008429867673059480
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05E7\u05E8\u05D4? \u05E9\u05DE\u05E2\u05E0\u05D5 \u05D1\u05E8\u05DE\u05E7\u05D5\u05DC
          \u05D0\u05EA \u05DE\u05D4 \u05E9\u05D4\u05D5\u05D0 \u05D0\u05DE\u05E8,
          \u05D0\u05D1\u05DC \u05DB\u05D5\u05DC\u05DD \u05D1\u05E1\u05D3\u05E8 \u05D1\u05D2\u05DC\u05E2\u05D3\u05D9\u05DD."
        commands: []
    - rid: 6008429867673059481
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E9\u05DC\u05D5\u05E9\u05D4 \u05E4\u05D4\u2026 \u05DE\u05D9 \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF?"
        commands: []
    - rid: 6008429867673059482
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D5\u05E2\u05D9! \u05D0\u05D9\u05E4\u05D4 \u05D4\u05D5\u05D0?"
        commands: []
    - rid: 6008429867673059483
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026\u05DE\u05D4 \u05D6\u05D4 \u05E9\u05DD?"
        commands: []
    - rid: 6008429867673059484
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E2\u05D5\u05DE\u05E8 \u05E4\u05EA\u05D7 \u05D0\u05EA \u05D4\u05EA\u05D0\u2026)"
        commands: []
    - rid: 6008429867673059485
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6008429867673059486
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u2026 \u05DE\u05D4 \u05D6\u05D4?!"
        commands: []
    - rid: 6008429867673059487
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6008429867673059488
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D6\u05D4 \u05DB\u05DC \u05D4\u05E8\u05D7\u05E9? \u05D6\u05D4
          \u05E4\u05E9\u05D5\u05D8-"
        commands: []
    - rid: 6008429867673059489
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands:
        - rid: 6008429988146839553
    - rid: 6008429867673059490
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DE\u05D0\u05DC\u05D4!! \u05DE\u05D4 \u05E7\u05E8\u05D4 \u05DC\u05D5?"
        commands: []
    - rid: 6008429867673059491
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E1\u05E2\u05DE\u05E7\u2026"
        commands: []
    - rid: 6008429867673059492
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E3 \u05D0\u05D7\u05D3 \u05DC\u05D0 \u05D9\u05D3\u05E2 \u05D0\u05D9\u05DA
          \u05DC\u05D4\u05D2\u05D9\u05D1 \u05D1\u05E1\u05D9\u05D8\u05D5\u05D0\u05E6\u05D9\u05D4
          \u05DB\u05D6\u05D0\u05EA.)"
        commands: []
    - rid: 6008429867673059493
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E0\u05D9 \u05D0\u05E3 \u05E4\u05E2\u05DD \u05DC\u05D0 \u05E8\u05D0\u05D9\u05EA\u05D9
          \u05DE\u05D9\u05E9\u05D4\u05D5 \u05DE\u05EA \u05DB\u05DB\u05D4, \u05D5\u05D0\u05E0\u05D9
          \u05DE\u05E0\u05D9\u05D7 \u05E9\u05E8\u05D5\u05D1 \u05D4\u05D0\u05D7\u05E8\u05D9\u05DD
          \u05D2\u05DD \u05DC\u05D0\u2026)"
        commands: []
    - rid: 6008429867673059494
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E0\u05D9\u05E1\u05D9\u05EA\u05D9 \u05DC\u05E8\u05D0\u05D5\u05EA
          \u05D0\u05DD \u05DC\u05DE\u05D9\u05E9\u05D4\u05D5 \u05D9\u05E9 \u05DE\u05E9\u05D4\u05D5
          \u05DC\u05D5\u05DE\u05E8\u2026)"
        commands: []
    - rid: 6008429867673059495
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6008429867673059496
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6008429867673059497
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E9\u05DE\u05E2 \u05D9\u05E9\u05E8\u05D0\u05DC \u05D0\u05D3\u05D5\u05E0\u05D9
          \u05D0\u05DC\u05D5\u05D4\u05D9\u05E0\u05D5\u2026"
        commands: []
    - rid: 6008429867673059498
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D7\u05E8\u05D9 \u05DE\u05D4 \u05E9\u05D4\u05E8\u05D2\u05D9\u05E9
          \u05DB\u05DE\u05D5 \u05D3\u05E7\u05D5\u05EA \u05D0\u05E8\u05D5\u05DB\u05D5\u05EA
          \u05E9\u05DB\u05D5\u05DC\u05E0\u05D5 \u05E2\u05DE\u05D3\u05E0\u05D5 \u05E9\u05DD,
          \u05D4\u05D5\u05D0 \u05D4\u05D2\u05D9\u05E2.)"
        commands: []
    - rid: 6008429867673059499
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E1\u05D1\u05DE\u05D1\u05D4! \u05DB\u05D5\u05DC\u05DB\u05DD \u05DB\u05D1\u05E8
          \u05E4\u05D4."
        commands: []
    - rid: 6008429867673059500
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05E1\u05D1\u05DE\u05D1\u05D4? \u05D0\u05D9\u05DA \u05D0\u05EA\u05D4
          \u05DE\u05E1\u05D1\u05D9\u05E8 \u05D0\u05EA \u05D6\u05D4?!"
        commands: []
    - rid: 6008429867673059501
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05E1\u05D1\u05D9\u05E8 \u05D0\u05EA \u05DE\u05D4?"
        commands: []
    - rid: 6008429867673059502
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D6\u05D0\u05EA \u05D0\u05D5\u05DE\u05E8\u05EA \"\u05D0\u05EA
          \u05DE\u05D4\"?! \u05DE\u05D4 \u05E7\u05E8\u05D4 \u05DC\u05E8\u05D5\u05E2\u05D9?!"
        commands: []
    - rid: 6008429867673059503
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D4, \u05D6\u05D4! \u05E0\u05E8\u05D0\u05D4 \u05E9\u05DE\u05D9\u05E9\u05D4\u05D5
          \u05D4\u05D9\u05D4 \u05DE\u05D5\u05E9\u05D7\u05E8 \u05DE\u05E1\u05E4\u05D9\u05E7
          \u05DB\u05D3\u05D9 \u05DC\u05E8\u05E6\u05D5\u05D7 \u05D1\u05E0\u05E1\u05D9\u05D5\u05DF
          \u05DC\u05E6\u05D0\u05EA \u05DE\u05E4\u05D4!"
        commands: []
    - rid: 6008429867673059504
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D0\u05EA\u05D4 \u05D0\u05D5\u05DE\u05E8 \u05E9\u05DE\u05D9
          \u05E9\u05D4\u05E8\u05D2 \u05D0\u05D5\u05EA\u05D5, \u05D6\u05D4 \u05D0\u05D7\u05D3
          \u05DE\u05D0\u05D9\u05EA\u05E0\u05D5?"
        commands: []
    - rid: 6008429867673059505
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05E8\u05D2\u05E9\u05EA\u05D9 \u05DB\u05D0\u05D9\u05DC\u05D5
          \u05D9\u05E9 \u05DC\u05D9 \u05E6\u05E4\u05E8\u05D3\u05E2 \u05D1\u05D2\u05E8\u05D5\u05DF.)"
        commands: []
    - rid: 6008429867673059506
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D7\u05D3 \u05DE\u05D0\u05D9\u05EA\u05E0\u05D5?)"
        commands: []
    - rid: 6008429867673059507
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DE\u05D5\u05D1\u05DF! \u05D0\u05DC\u05D4 \u05D4\u05D7\u05D5\u05E7\u05D9\u05DD,
          \u05D0\u05D7\u05E8\u05D9 \u05D4\u05DB\u05DC."
        commands: []
    - rid: 6008429867673059508
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05D5 \u05D1\u05D0\u05DE\u05EA, \u05D0\u05EA\u05D4 \u05D1\u05D0\u05DE\u05EA
          \u05D7\u05D5\u05E9\u05D1 \u05E9\u05D0\u05E0\u05D7\u05E0\u05D5 \u05E1\u05D5\u05DE\u05DB\u05D9\u05DD
          \u05E2\u05DC\u05D9\u05DB\u05DD \u05E9\u05DD? \u05D0\u05D9\u05DA \u05D0\u05E0\u05D7\u05E0\u05D5
          \u05D9\u05D5\u05D3\u05E2\u05D9\u05DD \u05E9\u05D6\u05D4 \u05DC\u05D0 \u05D0\u05D7\u05D3
          \u05DE\u05DB\u05DD?"
        commands: []
    - rid: 6008429867673059509
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05DD \u05D0\u05DC\u05D4 \u05E9\u05DE\u05D0\u05E8\u05D2\u05E0\u05D9\u05DD
          \u05D0\u05EA \u05DB\u05DC \u05D6\u05D4, \u05DB\u05D1\u05E8 \u05DB\u05DC\u05D0\u05EA\u05DD
          \u05D0\u05D5\u05EA\u05E0\u05D5 \u05DB\u05D0\u05DF, \u05DC\u05DE\u05D4 \u05E9\u05DC\u05D0
          \u05D2\u05DD \u05EA\u05D4\u05E8\u05D2\u05D5 \u05D0\u05EA \u05D0\u05D7\u05D3
          \u05DE\u05D0\u05D9\u05EA\u05E0\u05D5?"
        commands: []
    - rid: 6008429867673059510
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05D5\u05DC\u05D0! \u05D0\u05E0\u05D7\u05E0\u05D5 \u05DE\u05DE\u05E9
          \u05DC\u05D0 \u05DE\u05EA\u05E2\u05E8\u05D1\u05D9\u05DD, \u05D4\u05E8\u05E6\u05D7
          \u05D4\u05D9\u05D7\u05D9\u05D3 \u05E9\u05D9\u05DB\u05D5\u05DC \u05DC\u05E7\u05E8\u05D5\u05EA
          \u05E4\u05D4, \u05D4\u05D5\u05D0 \u05E2\u05DC \u05D9\u05D3\u05D9 \u05D0\u05D7\u05D3
          \u05DE\u05DB\u05DD."
        commands: []
    - rid: 6008429867673059511
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05E2\u05D3\u05D9\u05D9\u05DF \u05D9\u05E9 \u05DC\u05DB\u05DD
          \u05E1\u05E4\u05E7\u05D5\u05EA, \u05D6\u05D0\u05EA \u05D1\u05D3\u05D9\u05D5\u05E7
          \u05D4\u05E1\u05D9\u05D1\u05D4 \u05E9\u05E2\u05DB\u05E9\u05D9\u05D5 \u05EA\u05E7\u05D1\u05DC\u05D5
          \u05D6\u05DE\u05DF *\u05DC\u05D7\u05E7\u05D5\u05E8*!"
        commands: []
    - rid: 6008429867673059512
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DC\u05D7\u05E7\u05D5\u05E8\u2026?)"
        commands: []
    - rid: 6008429867673059513
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05DD \u05EA\u05E7\u05D1\u05DC\u05D5 \u05DB\u05DE\u05D4
          \u05E9\u05E2\u05D5\u05EA \u05DC\u05D4\u05E1\u05EA\u05DB\u05DC \u05E2\u05DC
          \u05DB\u05DC \u05DE\u05E7\u05D5\u05DD \u05E9\u05E0\u05E8\u05D0\u05D4 \u05DC\u05DB\u05DD
          \u05E8\u05DC\u05D5\u05D5\u05E0\u05D8\u05D9 \u05DC\u05EA\u05D9\u05E7 \u05D4\u05D6\u05D4,
          \u05DB\u05D3\u05D9 \u05DC\u05D4\u05E1\u05D9\u05E7 \u05DE\u05D4 \u05D1\u05D0\u05DE\u05EA
          \u05E7\u05E8\u05D4 \u05DB\u05D0\u05DF!"
        commands: []
    - rid: 6008429867673059514
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E2\u05DC \u05DE\u05D4 \u05D0\u05EA\u05D4 \u05DE\u05D3\u05D1\u05E8?!
          \u05DC\u05D7\u05E7\u05D5\u05E8 \u05D0\u05EA \u05D4\u05E8\u05E6\u05D7?!"
        commands: []
    - rid: 6008429867673059515
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05E8\u05D0\u05D4 \u05E9\u05D0\u05EA\u05DD \u05E2\u05D3\u05D9\u05D9\u05DF
          \u05E7\u05E6\u05EA \u05DE\u05D1\u05D5\u05DC\u05D1\u05DC\u05D9\u05DD. \u05D0\u05E0\u05D9
          \u05D0\u05E1\u05D1\u05D9\u05E8 \u05E9\u05D5\u05D1 \u05DE\u05D4\u05EA\u05D7\u05DC\u05D4."
        commands:
        - rid: 6008429988146839554
    - rid: 6008429867673059516
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E4\u05D9 \u05E9\u05D4\u05E1\u05D1\u05E8\u05EA\u05D9 \u05DC\u05DB\u05DD
          \u05DB\u05E9\u05D4\u05D2\u05E2\u05EA\u05DD, \u05D4\u05D3\u05E8\u05DA \u05D4\u05D9\u05D7\u05D9\u05D3\u05D4
          \u05DC\u05E6\u05D0\u05EA \u05DE\u05D4\u05D1\u05E1\u05D9\u05E1 \u05D4\u05D9\u05D0
          \u05DC\u05E8\u05E6\u05D5\u05D7 \u05D0\u05EA \u05D0\u05D7\u05D3 \u05DE\u05D7\u05D1\u05E8\u05D9\u05DB\u05DD
          \u05DC\u05E6\u05D5\u05D5\u05EA."
        commands: []
    - rid: 6008429867673059517
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05DE\u05E7\u05E8\u05D4 \u05D4\u05D6\u05D4, \u05E0\u05E7\u05E8\u05D0
          \u05DC\u05E8\u05D5\u05E6\u05D7 \u05D1\u05E9\u05DD *\u05D4\u05DE\u05D5\u05E9\u05D7\u05E8*."
        commands: []
    - rid: 6008429867673059518
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05EA\u05EA\u05D1\u05E6\u05E2 \u05DB\u05E2\u05EA \u05D7\u05E7\u05D9\u05E8\u05D4
          \u05DE\u05E7\u05D9\u05E4\u05D4 \u05DB\u05D3\u05D9 \u05E9\u05EA\u05D5\u05DB\u05DC\u05D5
          \u05DC\u05D4\u05E9\u05D9\u05D2 \u05D0\u05EA \u05DB\u05DC \u05D4\u05DE\u05D9\u05D3\u05E2
          \u05E9\u05D0\u05EA\u05DD \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD \u05E2\u05DC
          \u05D4\u05E8\u05E6\u05D7, \u05D5\u05D1\u05E2\u05D5\u05D3 \u05DB\u05DE\u05D4
          \u05E9\u05E2\u05D5\u05EA \u05E0\u05E7\u05D9\u05D9\u05DD *\u05DE\u05E9\u05E4\u05D8
          \u05E6\u05D1\u05D0\u05D9*."
        commands: []
    - rid: 6008429867673059519
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05DE\u05E9\u05E4\u05D8 \u05EA\u05E6\u05D8\u05E8\u05DB\u05D5
          \u05DC\u05D4\u05D2\u05D9\u05E2 \u05DC\u05DE\u05E1\u05E7\u05E0\u05D4 \u05DC\u05D2\u05D1\u05D9
          \u05DE\u05D9 \u05D4\u05D5\u05D0 \u05D4\u05DE\u05D5\u05E9\u05D7\u05E8. \u05D1\u05E1\u05D5\u05E3
          \u05D4\u05DE\u05E9\u05E4\u05D8 \u05EA\u05EA\u05D1\u05E6\u05E2 \u05D4\u05E6\u05D1\u05E2\u05D4."
        commands: []
    - rid: 6008429867673059520
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05EA\u05E6\u05D1\u05D9\u05E2\u05D5 \u05DC\u05DE\u05D5\u05E9\u05D7\u05E8
          \u05D4\u05D0\u05DE\u05D9\u05EA\u05D9, \u05D4\u05D5\u05D0 \u05D9\u05D5\u05E6\u05D0
          \u05DC\u05D4\u05D5\u05E8\u05D2 \u05D5\u05DB\u05DC \u05D4\u05E9\u05D0\u05E8
          \u05D9\u05DE\u05E9\u05D9\u05DB\u05D5 \u05D1\u05D7\u05D9\u05D9 \u05D4\u05D1\u05E1\u05D9\u05E1."
        commands: []
    - rid: 6008429867673059521
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05D4\u05DE\u05D5\u05E9\u05D7\u05E8 \u05D9\u05E6\u05DC\u05D9\u05D7
          \u05DC\u05D4\u05D8\u05E2\u05D5\u05EA \u05D0\u05EA \u05DB\u05D5\u05DC\u05DD
          \u05D5\u05DC\u05D2\u05E8\u05D5\u05DD \u05DC\u05D4\u05DD \u05DC\u05D4\u05E6\u05D1\u05D9\u05E2
          \u05DC\u05DE\u05D9\u05E9\u05D4\u05D5 \u05D0\u05D7\u05E8, \u05DB\u05D5\u05DC\u05DB\u05DD
          \u05EA\u05D5\u05E6\u05D0\u05D5 \u05DC\u05D4\u05D5\u05E8\u05D2, \u05D5\u05E8\u05E7
          \u05D4\u05DE\u05D5\u05E9\u05D7\u05E8 \u05D9\u05E6\u05D0 \u05DE\u05DB\u05D0\u05DF."
        commands: []
    - rid: 6008429867673059522
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4\u05D5. \u05D4\u05DB\u05DC \u05D1\u05E8\u05D5\u05E8?"
        commands: []
    - rid: 6008429867673059523
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05D1\u05E8 \u05E9\u05DE\u05E2\u05EA\u05D9 \u05D0\u05EA \u05DB\u05DC
          \u05D6\u05D4\u2026 \u05D0\u05D1\u05DC \u05D6\u05D4 \u05DC\u05D0 \u05D2\u05D5\u05E8\u05DD
          \u05DC\u05D6\u05D4 \u05DC\u05D4\u05D9\u05D5\u05EA \u05E4\u05D7\u05D5\u05EA
          \u05D2\u05E8\u05D5\u05E2.)"
        commands: []
    - rid: 6008429867673059524
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D7\u05E0\u05D5 \u05DC\u05D0 \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD
          \u05DC\u05E2\u05E9\u05D5\u05EA \u05D0\u05EA \u05D6\u05D4! \u05D6\u05D4..
          \u05D6\u05D4 \u05D9\u05D5\u05EA\u05E8 \u05DE\u05D3\u05D9!"
        commands: []
    - rid: 6008429867673059525
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA \u05DC\u05D0 \u05D7\u05D9\u05D9\u05D1\u05EA \u05DC\u05EA\u05E8\u05D5\u05DD
          \u05DC\u05D7\u05E7\u05D9\u05E8\u05D4. \u05E2\u05DD \u05D6\u05D0\u05EA,
          \u05D0\u05E0\u05D9 \u05DE\u05DE\u05DC\u05D9\u05E5 \u05DC\u05DB\u05D5\u05DC\u05DD
          \u05DC\u05EA\u05EA \u05D0\u05EA \u05DB\u05DC \u05DB\u05D5\u05DC\u05DD,
          \u05D4\u05D7\u05D9\u05D9\u05DD \u05E9\u05DC\u05DB\u05DD \u05EA\u05DC\u05D5\u05D9\u05D9\u05DD
          \u05D1\u05D6\u05D4!"
        commands: []
    - rid: 6008429867673059526
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6008429867673059527
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6008429867673059528
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D3\u05D1\u05E8 \u05D0\u05D7\u05E8\u05D5\u05DF. \u05D0\u05E0\u05D9
          \u05E2\u05DB\u05E9\u05D9\u05D5 \u05D0\u05E2\u05E0\u05D9\u05E7 \u05DC\u05DB\u05DD,
          \u05D0\u05EA *\u05EA\u05E7\u05D9\u05D9\u05EA \u05D4\u05D1\u05DE\u05D1\u05D4*!"
        commands:
        - rid: 6008429988146839555
    - rid: 6008429867673059529
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05EA\u05E7\u05D9\u05D9\u05D4 \u05D4\u05D6\u05D5 \u05DE\u05DB\u05D9\u05DC\u05D4
          \u05E4\u05E8\u05D8\u05D9\u05DD \u05DC\u05D2\u05D1\u05D9 \u05D4\u05E8\u05E6\u05D7."
        commands: []
    - rid: 6008429867673059530
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05DB\u05DC \u05DE\u05E7\u05E8\u05D4, \u05E9\u05D9\u05D4\u05D9\u05D4
          \u05DC\u05DB\u05DD \u05D1\u05D4\u05E6\u05DC\u05D7\u05D4! \u05DB\u05E9\u05D9\u05D2\u05DE\u05E8
          \u05DC\u05DB\u05DD \u05D4\u05D6\u05DE\u05DF \u05DC\u05D7\u05E7\u05D5\u05E8,
          \u05D0\u05E0\u05D9 \u05D0\u05D5\u05D3\u05D9\u05E2 \u05DC\u05DB\u05DD \u05D1\u05DB\u05E8\u05D9\u05D6\u05D4."
        commands:
        - rid: 6008429988146839556
    - rid: 6008429867673059531
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D5\u05DB\u05DB\u05D4, \u05D4\u05D5\u05D0 \u05D4\u05E9\u05D0\u05D9\u05E8
          \u05D0\u05D5\u05EA\u05E0\u05D5 \u05E2\u05DD \u05E2\u05E6\u05DE\u05E0\u05D5,
          \u05D0\u05D1\u05D5\u05D3\u05D9\u05DD.)"
        commands: []
    - rid: 6008429867673059532
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6\u2026 \u05DE\u05D4 \u05D0\u05EA\u05DD \u05E8\u05D5\u05E6\u05D9\u05DD
          \u05DC\u05E2\u05E9\u05D5\u05EA? \u05E9\u05E0\u05E9\u05EA\u05E3 \u05E4\u05E2\u05D5\u05DC\u05D4
          \u05E2\u05DD \u05D6\u05D4\u2026?"
        commands: []
    - rid: 6008429867673059533
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05E9 \u05DC\u05E0\u05D5 \u05D1\u05E8\u05D9\u05E8\u05D4?"
        commands: []
    - rid: 6008429867673059534
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6008429867673059535
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D7\u05D5\u05E9\u05D1 \u05E9\u05D0\u05E0\u05D7\u05E0\u05D5
          \u05E6\u05E8\u05D9\u05DB\u05D9\u05DD \u05DC\u05D7\u05E7\u05D5\u05E8. \u05D0\u05E0\u05D7\u05E0\u05D5
          \u05D7\u05D9\u05D9\u05D1\u05D9\u05DD \u05DC\u05D4\u05D1\u05D9\u05DF \u05DE\u05D4
          \u05E7\u05D5\u05E8\u05D4 \u05DB\u05D0\u05DF, \u05D0\u05D9 \u05D0\u05E4\u05E9\u05E8
          \u05DC\u05EA\u05EA \u05DC\u05DE\u05D5\u05D5\u05EA \u05E9\u05DC\u05D5 \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05D7\u05E1\u05E8 \u05EA\u05D5\u05E2\u05DC\u05EA."
        commands: []
    - rid: 6008429867673059536
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DC\u05D4\u05D1\u05D9\u05DF \u05DE\u05D4 \u05E7\u05D5\u05E8\u05D4
          \u05E4\u05D4\u2026)"
        commands: []
    - rid: 6008429867673059537
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05E1\u05DB\u05D9\u05DE\u05D4\u2026 \u05E2\u05DD
          \u05DB\u05DE\u05D4 \u05E9\u05D6\u05D4 \u05E7\u05E9\u05D4, \u05D0\u05E0\u05D7\u05E0\u05D5
          \u05D7\u05D9\u05D9\u05D1\u05D9\u05DD \u05DC\u05D4\u05D1\u05D9\u05DF."
        commands: []
    - rid: 6008429867673059538
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05DF, \u05D4\u05DD \u05E6\u05D5\u05D3\u05E7\u05D9\u05DD\u2026)"
        commands: []
    - rid: 6008429867673059539
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D2\u05E8\u05EA\u05D9 \u05D0\u05EA \u05DB\u05DC \u05D4\u05D0\u05E0\u05E8\u05D2\u05D9\u05D5\u05EA
          \u05D1\u05D2\u05D5\u05E3 \u05E9\u05DC\u05D9, \u05D5\u05E9\u05D7\u05E8\u05E8\u05EA\u05D9
          \u05D0\u05E0\u05D7\u05D4.)"
        commands: []

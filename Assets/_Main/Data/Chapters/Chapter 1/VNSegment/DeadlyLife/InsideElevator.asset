    - rid: 6008430184854716737
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05D5\u05DC\u05DD \u05E0\u05DB\u05E0\u05E1\u05D5 \u05DC\u05DE\u05E2\u05DC\u05D9\u05EA,
          \u05D5\u05D4\u05D3\u05DC\u05EA\u05D5\u05EA \u05E0\u05E1\u05D2\u05E8\u05D5.)"
        commands: []
    - rid: 6008430184854716738
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E4\u05EA\u05D0\u05D5\u05DD \u05D4\u05EA\u05D7\u05D9\u05DC \u05E8\u05E2\u05E9,
          \u05D5\u05D4\u05DE\u05E2\u05DC\u05D9\u05EA \u05E9\u05E7\u05E9\u05E7\u05D4.
          \u05D4\u05EA\u05D7\u05DC\u05E0\u05D5 \u05DC\u05E8\u05D3\u05EA.)"
        commands: []
    - rid: 6008430184854716739
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D9\u05D0 \u05D9\u05D5\u05E8\u05D3\u05EA \u05D4\u05E8\u05D1\u05D4\u2026
          \u05DB\u05DE\u05D4 \u05E0\u05DE\u05D5\u05DA \u05D0\u05E0\u05D7\u05E0\u05D5
          \u05D9\u05D5\u05E8\u05D3\u05D9\u05DD?)"
        commands: []
    - rid: 6008430184854716740
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D7\u05D5\u05E5 \u05DE\u05D4\u05E8\u05E2\u05E9 \u05E9\u05DC \u05D4\u05DE\u05E2\u05DC\u05D9\u05EA,
          \u05D4\u05D9\u05D9\u05EA\u05D4 \u05D3\u05DE\u05DE\u05D4.)"
        commands: []
    - rid: 6008430184854716741
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E9\u05EA\u05D9\u05E7\u05D4 \u05D1\u05DE\u05E2\u05DC\u05D9\u05EA
          \u05D6\u05D4 \u05DE\u05D1\u05D9\u05DA \u05D1\u05D3\u05E8\u05DA \u05DB\u05DC\u05DC,
          \u05D0\u05D1\u05DC \u05D4\u05E4\u05E2\u05DD \u05D6\u05D4 \u05D4\u05E8\u05D1\u05D4
          \u05D9\u05D5\u05EA\u05E8 \u05D2\u05E8\u05D5\u05E2.)"
        commands: []
    - rid: 6008430184854716742
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E4\u05E9\u05E8 \u05DC\u05D4\u05E8\u05D2\u05D9\u05E9 \u05D0\u05EA
          \u05D6\u05D4 \u05D1\u05D0\u05D5\u05D5\u05D9\u05E8. \u05DC\u05D7\u05E5,
          \u05D7\u05E9\u05D3, \u05E4\u05D7\u05D3\u2026 \u05D0\u05E3 \u05D0\u05D7\u05D3
          \u05DC\u05D0 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D0\u05DE\u05D9\u05DF
          \u05DC\u05E1\u05D9\u05D8\u05D5\u05D0\u05E6\u05D9\u05D4 \u05E9\u05E0\u05E7\u05DC\u05E2\u05E0\u05D5
          \u05D0\u05DC\u05D9\u05D4.)"
        commands: []
    - rid: 6008430184854716743
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E8\u05D5\u05E2\u05D9 \u05E0\u05E8\u05E6\u05D7\u2026 \u05E2\u05DC
          \u05D9\u05D3\u05D9 \u05D0\u05D7\u05D3 \u05DE\u05D0\u05D9\u05EA\u05E0\u05D5?
          \u05D6\u05D4 \u05DE\u05E8\u05D2\u05D9\u05E9 \u05D1\u05DC\u05EA\u05D9 \u05D0\u05E4\u05E9\u05E8\u05D9.)"
        commands: []
    - rid: 6008430184854716744
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D5\u05E2\u05DB\u05E9\u05D9\u05D5 \u05D0\u05E0\u05D7\u05E0\u05D5
          \u05D4\u05D5\u05DC\u05DB\u05D9\u05DD \u05DC\u05D4\u05E6\u05D8\u05E8\u05DA
          \u05DC\u05D4\u05D1\u05D9\u05DF \u05DE\u05D9 \u05D6\u05D4.)"
        commands: []
    - rid: 6008430184854716745
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D9\u05DF \u05DC\u05E0\u05D5 \u05D1\u05E8\u05D9\u05E8\u05D4.
          \u05D0\u05E0\u05D7\u05E0\u05D5 \u05D7\u05D9\u05D9\u05D1\u05D9\u05DD \u05DC\u05D2\u05DC\u05D5\u05EA
          \u05D0\u05EA \u05D4\u05D0\u05DE\u05EA \u05D1\u05E9\u05D1\u05D9\u05DC \u05DC\u05E9\u05E8\u05D5\u05D3.
          \u05D0\u05D1\u05DC \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D9\u05DB\u05D5\u05DC
          \u05E9\u05DC\u05D0 \u05DC\u05D4\u05E8\u05D2\u05D9\u05E9 \u05DB\u05DE\u05D5
          \u05E6\u05D0\u05DF \u05DC\u05D8\u05D1\u05D7.)"
        commands: []
    - rid: 6008430184854716746
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D7\u05E8\u05D9 \u05DE\u05D4 \u05E9\u05D4\u05E8\u05D2\u05D9\u05E9
          \u05DB\u05DE\u05D5 \u05E0\u05E6\u05D7, \u05D4\u05DE\u05E2\u05DC\u05D9\u05EA
          \u05E2\u05E6\u05E8\u05D4, \u05D5\u05D4\u05D3\u05DC\u05EA\u05D5\u05EA \u05E0\u05E4\u05EA\u05D7\u05D5.)"
        commands: []

    - rid: 6008429843967377531
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D4, \u05E1\u05D5\u05E3 \u05E1\u05D5\u05E3 \u05D4\u05D2\u05E2\u05EA
          \u05D0\u05DC\u05D5\u05DF."
        commands: []
    - rid: 6008429843967377532
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05E9\u05D4\u05D2\u05E2\u05EA\u05D9, \u05D4\u05E9\u05D0\u05E8
          \u05DB\u05D1\u05E8 \u05D7\u05D9\u05DB\u05D5 \u05DC\u05D9.)"
        commands: []
    - rid: 6008429843967377533
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6008429843967377534
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6008429843967377535
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands:
        - rid: 6008429843967377559
    - rid: 6008429843967377536
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05D5\u05DC\u05DD \u05E0\u05E8\u05D0\u05D9\u05DD \u05DE\u05D5\u05D8\u05E8\u05D3\u05D9\u05DD\u2026
          \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2 \u05D0\u05DD \u05D6\u05D4
          \u05D1\u05D2\u05DC\u05DC \u05D4\u05E1\u05D9\u05D8\u05D5\u05D0\u05E6\u05D9\u05D4
          \u05D0\u05D5 \u05D1\u05D2\u05DC\u05DC \u05E9\u05D4\u05DD \u05D7\u05D5\u05E9\u05D1\u05D9\u05DD
          \u05E9\u05D6\u05D4 \u05D0\u05E0\u05D9.)"
        commands: []
    - rid: 6008429843967377537
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05E2\u05E0\u05D9\u05D9\u05DF \u05D0\u05D9\u05DA \u05D9\u05EA\u05E0\u05D4\u05DC
          \u05D4\u05DE\u05E9\u05E4\u05D8 \u05D4\u05E6\u05D1\u05D0\u05D9 \u05D4\u05D6\u05D4.
          \u05D4\u05E8\u05D1\u05D4 \u05D7\u05D9\u05D9\u05DC\u05D9\u05DD \u05DE\u05E4\u05E8\u05D9
          \u05D7\u05D5\u05E7 \u05E2\u05D1\u05E8\u05D5 \u05DE\u05E9\u05E4\u05D8 \u05D0\u05D7\u05E8\u05D9
          \u05E9\u05EA\u05E4\u05E1\u05EA\u05D9 \u05D0\u05D5\u05EA\u05DD, \u05D0\u05D1\u05DC
          \u05DE\u05E2\u05D5\u05DC\u05DD \u05DC\u05D0 \u05D9\u05E6\u05D0 \u05DC\u05D9
          \u05DC\u05E0\u05DB\u05D5\u05D7 \u05D1\u05D0\u05D7\u05D3."
        commands: []
    - rid: 6008429843967377538
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05D6\u05D4 \u05D6\u05D9\u05DF. \u05DE\u05D4 \u05DE\u05E9\u05E4\u05D8
          \u05E6\u05D1\u05D0\u05D9 \u05E2\u05DB\u05E9\u05D9\u05D5."
        commands:
        - rid: 6008429843967377560
    - rid: 6008429843967377539
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D1\u05E1\u05E4\u05E7 \u05E9\u05D6\u05D4 \u05D9\u05D4\u05D9\u05D4
          \u05D3\u05D5\u05DE\u05D4 \u05DC\u05DE\u05E9\u05E4\u05D8 \u05E6\u05D1\u05D0\u05D9
          \u05D0\u05DE\u05D9\u05EA\u05D9."
        commands:
        - rid: 6008429843967377561
    - rid: 6008429843967377540
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05D5\u05DC\u05DD \u05DB\u05D0\u05DF? \u05E1\u05D1\u05DE\u05D1\u05D4!"
        commands:
        - rid: 6008429843967377562
    - rid: 6008429843967377541
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05D3\u05D9 \u05E9\u05E0\u05D5\u05DB\u05DC \u05DC\u05D4\u05EA\u05D7\u05D9\u05DC
          \u05D1\u05DE\u05E9\u05E4\u05D8, \u05E0\u05D0 \u05DC\u05D4\u05D9\u05DB\u05E0\u05E1
          \u05DC\u05DB\u05D9\u05EA\u05D4!"
        commands: []
    - rid: 6008429843967377542
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D1\u05D4\u05D9\u05E1\u05D5\u05E1, \u05DB\u05D5\u05DC\u05DD \u05E0\u05DB\u05E0\u05E1\u05D5
          \u05E4\u05E0\u05D9\u05DE\u05D4 \u05D0\u05D7\u05D3 \u05D0\u05D7\u05E8\u05D9
          \u05D4\u05E9\u05E0\u05D9.)"
        commands:
        - rid: 6008429843967377563

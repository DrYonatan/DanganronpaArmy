    - rid: 6299374365904994352
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05E2\u05D3\u05D9\u05D9\u05DF \u05DC\u05D0 \u05DE\u05D0\u05DE\u05D9\u05E0\u05D4
          \u05E9\u05D6\u05D4 \u05D0\u05E9\u05DB\u05E8\u05D4 \u05E7\u05D5\u05E8\u05D4\u2026"
        commands:
        - rid: 6299374365904994363
    - rid: 6299374365904994353
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D2\u05E2 \u05D0\u05D7\u05D3 \u05E0\u05D9\u05E7\u05D9\u05E0\u05D5,
          \u05D5\u05E4\u05EA\u05D0\u05D5\u05DD \u05E9\u05DE\u05E2\u05E0\u05D5 \u05D0\u05D5\u05EA\u05DA
          \u05E6\u05D5\u05E2\u05E7\u2026"
        commands: []
    - rid: 6299374365904994354
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05DF \u05D4\u05D9\u05D9\u05EA\u05DF \u05D1\u05EA\u05D5\u05DA
          \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9 \u05D1\u05E0\u05D5\u05EA \u05DB\u05DC
          \u05D4\u05D6\u05DE\u05DF?"
        commands: []
    - rid: 6299374365904994356
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05E0\u05DB\u05E0\u05E1\u05E0\u05D5 \u05DC\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9
          \u05D1\u05E0\u05D5\u05EA, \u05D5\u05D4\u05EA\u05D7\u05DC\u05E0\u05D5 \u05DC\u05E0\u05E7\u05D5\u05EA
          \u05D9\u05E9\u05E8\u2026 \u05D4\u05E1\u05E4\u05E7\u05EA\u05D9 \u05DC\u05E0\u05E7\u05D5\u05EA
          \u05E8\u05E7 \u05D0\u05EA \u05D4\u05DB\u05D9\u05D5\u05E8\u05D9\u05DD, \u05D5\u05DE\u05D0\u05D9\u05D4
          \u05E0\u05D9\u05E7\u05EA\u05D4 \u05DB\u05DE\u05D4 \u05DE\u05D4\u05EA\u05D0\u05D9\u05DD\u2026
          \u05DC\u05D0 \u05D4\u05E1\u05E4\u05E7\u05E0\u05D5 \u05DC\u05E9\u05D8\u05D5\u05E3
          \u05D0\u05EA \u05D4\u05E8\u05E6\u05E4\u05D4 \u05E2\u05D3\u05D9\u05D9\u05DF."
        commands: []
    - rid: 6299374365904994357
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05E9\u05EA\u05D9\u05E0\u05D5 \u05D4\u05D9\u05D9\u05E0\u05D5
          \u05D1\u05E4\u05E0\u05D9\u05DD \u05DB\u05DC \u05D4\u05D6\u05DE\u05DF. \u05D0\u05D1\u05DC
          \u05EA\u05D5\u05DA \u05DB\u05DE\u05D4 \u05D3\u05E7\u05D5\u05EA, \u05DB\u05D1\u05E8
          \u05E9\u05DE\u05E2\u05E0\u05D5 \u05D0\u05D5\u05EA\u05DA\u2026"
        commands: []
    - rid: 6299374365904994358
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D6 \u05E9\u05EA\u05D9\u05D4\u05DF \u05DC\u05D0 \u05D9\u05E6\u05D0\u05D5
          \u05DE\u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD \u05D1\u05DB\u05DC\u05DC
          \u05DE\u05D0\u05D6 \u05E9\u05D4\u05DF \u05E0\u05DB\u05E0\u05E1\u05D5\u2026)"
        commands: []
    - rid: 6299374365904994359
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        nodeRect:
          serializedVersion: 2
          x: 0
          y: 0

    - rid: 6008429832750497811
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D6\u05D4 \u05DB\u05D0\u05DF?"
        commands: []
    - rid: 6008429832750497812
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D0\u05EA \u05E0\u05E8\u05D0\u05D9\u05EA \u05DB\u05DE\u05D5
          \u05E8\u05DB\u05D6\u05EA \u05D1\u05E7\u05E8\u05EA \u05DE\u05D9\u05DD."
        commands: []
    - rid: 6008429832750497813
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05DB\u05D6\u05EA \u05D1\u05E7\u05E8\u05D4?"
        commands: []
    - rid: 6008429832750497814
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05E9\u05DE\u05E8\u05DB\u05D6 \u05D0\u05EA \u05DB\u05DC
          \u05D4\u05E6\u05E0\u05E8\u05EA \u05E9\u05DC \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD.
          \u05EA\u05E8\u05D0\u05D4, \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA
          \u05E9\u05D9\u05D5\u05E6\u05D0\u05D9\u05DD \u05DE\u05E9\u05E0\u05D9 \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD
          \u05DE\u05EA\u05D7\u05D1\u05E8\u05D9\u05DD \u05DC\u05DB\u05D0\u05DF."
        commands: []
    - rid: 6008429832750497815
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05D5, \u05D4\u05D3\u05D1\u05E8 \u05D4\u05D6\u05D4
          \u05D3\u05D9 \u05D2\u05D3\u05D5\u05DC\u2026"
        commands: []
    - rid: 6008429832750497816
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05EA\u05E8\u05D0\u05D4, \u05D0\u05E4\u05E9\u05E8 \u05DC\u05E4\u05EA\u05D5\u05D7
          \u05E4\u05D4 \u05D0\u05EA \u05D4\u05D3\u05DC\u05EA."
        commands: []
    - rid: 6008429832750497817
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E8\u05D5\u05DE\u05D9 \u05E4\u05EA\u05D7\u05D4 \u05D0\u05EA \u05D4\u05D3\u05DC\u05EA
          \u05E9\u05DC \u05D4\u05E8\u05DB\u05D6\u05EA, \u05D5\u05D1\u05E4\u05E0\u05D9\u05DD
          \u05E8\u05D0\u05D9\u05EA\u05D9\u2026)"
        commands: []
    - rid: 6008429832750497818
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05DE\u05D5\u05DF \u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA.)"
        commands:
        - rid: 6008429832750497825
    - rid: 6008429832750497819
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026\u05DE\u05D4 \u05D6\u05D4 \u05D4\u05D1\u05DC\u05D0\u05D2\u05DF
          \u05D4\u05D6\u05D4?"
        commands: []
    - rid: 6008429832750497820
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05DE\u05D4 \u05E9\u05D0\u05E0\u05D9 \u05D7\u05E9\u05D1\u05EA\u05D9.
          \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05E9\u05E8\u05D1\u05E8\u05D1\u05D9\u05EA,
          \u05D0\u05D1\u05DC \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA \u05D4\u05D0\u05DC\u05D4
          \u05E0\u05E8\u05D0\u05D9\u05DD \u05DB\u05D0\u05D9\u05DC\u05D5 \u05D4\u05DD
          \u05E2\u05D5\u05DE\u05D3\u05D9\u05DD \u05DC\u05D4\u05EA\u05E4\u05D5\u05E6\u05E5
          \u05D1\u05DB\u05DC \u05E8\u05D2\u05E2."
        commands:
        - rid: 6008429843967377430
    - rid: 6008429832750497821
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DC\u05D0 \u05D1\u05E6\u05D7\u05D5\u05E7 \u05D0\u05E4\u05D9\u05DC\u05D5\u2026
          \u05D7\u05D5\u05E5 \u05DE\u05D6\u05D4, \u05D4\u05DD \u05DE\u05D1\u05D5\u05DC\u05D2\u05E0\u05D9\u05DD
          \u05DC\u05D2\u05DE\u05E8\u05D9, \u05D0\u05D7\u05D3 \u05D1\u05EA\u05D5\u05DA
          \u05D4\u05E9\u05E0\u05D9\u2026 \u05D6\u05D4 \u05D1\u05D8\u05D7 \u05E1\u05D9\u05D5\u05D8
          \u05DC\u05EA\u05E7\u05DF \u05EA\u05E7\u05DC\u05D5\u05EA \u05D1\u05D3\u05D1\u05E8
          \u05D4\u05D6\u05D4.)"
        commands: []

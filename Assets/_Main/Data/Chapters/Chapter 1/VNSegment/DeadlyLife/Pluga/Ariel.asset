    - rid: 6299374365904994324
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D9\u05D9 \u05D0\u05DC\u05D5\u05DF\u2026"
        commands: []
    - rid: 6299374365904994325
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D7\u05D9\u05D9\u05D1 \u05DC\u05D5\u05DE\u05E8,
          \u05D7\u05D5\u05D5\u05D9\u05EA \u05D4\u05D0\u05DC\"\u05D1 \u05E9\u05DC\u05DA
          \u05D0\u05D5\u05DC\u05D9 \u05D0\u05E4\u05D9\u05DC\u05D5 \u05D9\u05D5\u05EA\u05E8
          \u05D8\u05E8\u05D0\u05D5\u05DE\u05D8\u05D9\u05EA \u05DE\u05E9\u05DC\u05D9!"
        commands:
        - rid: 6299374365904994336
    - rid: 6299374365904994326
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D0\u05D4\u2026"
        commands: []
    - rid: 6299374365904994327
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6299374365904994328
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D5\u05DC\u05D9 \u05D0\u05E0\u05D9 \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05E6\u05E8\u05D9\u05DA \u05DC\u05DC\u05DB\u05EA \u05E9\u05D5\u05D1 \u05D1\u05DB\u05DC
          \u05D6\u05D0\u05EA, \u05D1\u05E7\u05D5\u05E9\u05D9 \u05D4\u05E1\u05EA\u05D3\u05E8\u05E0\u05D5
          \u05D1\u05DC\u05E2\u05D3\u05D9\u05DA \u05D1\u05D2\u05DC\u05E2\u05D3."
        commands: []
    - rid: 6299374365904994329
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2 \u05DE\u05D4
          \u05D4\u05D5\u05D0 \u05D4\u05D9\u05D4 \u05E2\u05D5\u05E9\u05D4 \u05DC\u05E0\u05D5
          \u05D0\u05DD \u05DC\u05D0 \u05D4\u05E8\u05E6\u05D7 \u05D4\u05D6\u05D4."
        commands: []
    - rid: 6299374365904994330
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D0\u05DE\u05EA? \u05DE\u05D4 \u05DB\u05D1\u05E8 \u05E7\u05E8\u05D4?"
        commands: []
    - rid: 6299374365904994331
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D8\u05D5\u05D1, \u05D0\u05D5\u05D4\u05D1 \u05D9\u05E9\u05DF \u05DB\u05E8\u05D2\u05D9\u05DC,
          \u05D5\u05DB\u05E4\u05D9\u05E8 \u05D4\u05D1\u05E8\u05D9\u05D6 \u05DC\u05D9."
        commands: []
    - rid: 6299374365904994332
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D1\u05E8\u05D9\u05D6?"
        commands:
        - rid: 6299374365904994338
    - rid: 6299374365904994333
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D4\u05D5\u05D0 \u05D4\u05DC\u05DA \u05DC\u05D4\u05D1\u05D9\u05D0
          \u05E6\u05D9\u05D5\u05D3, \u05D5\u05E4\u05E9\u05D5\u05D8 \u05DC\u05D0 \u05D7\u05D6\u05E8\u2026
          \u05D4\u05E4\u05E2\u05DD \u05D4\u05E8\u05D0\u05E9\u05D5\u05E0\u05D4 \u05E9\u05E8\u05D0\u05D9\u05EA\u05D9
          \u05D0\u05D5\u05EA\u05D5 \u05DE\u05D0\u05D6 \u05D4\u05D9\u05D9\u05EA\u05D4
          \u05DB\u05E9\u05D1\u05D0\u05E0\u05D5 \u05DC\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD
          \u05D0\u05D7\u05E8\u05D9 \u05D4\u05D4\u05D5\u05D3\u05E2\u05D4 \u05E2\u05DC
          \u05D4\u05D2\u05D5\u05E4\u05D4."
        commands: []
    - rid: 6299374365904994334
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D4 \u05DE\u05D5\u05D6\u05E8\u2026 \u05DC\u05D0\u05DF \u05DB\u05E4\u05D9\u05E8
          \u05D4\u05DC\u05DA?)"
        commands: []
    - rid: 6299374365904994335
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05DB\u05DC \u05DE\u05E7\u05E8\u05D4, \u05D0\u05E0\u05D9 \u05DC\u05D0
          \u05D0\u05DE\u05E9\u05D9\u05DA \u05DC\u05E7\u05D7\u05EA \u05DE\u05D6\u05DE\u05E0\u05DA
          \u05D0\u05DC\u05D5\u05DF, \u05D0\u05EA\u05D4 \u05D7\u05E9\u05D5\u05D1 \u05DE\u05D0\u05D5\u05D3
          \u05DC\u05D7\u05E7\u05D9\u05E8\u05D4!"
        commands: []

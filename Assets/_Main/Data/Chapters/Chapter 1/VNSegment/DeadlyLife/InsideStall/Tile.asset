    - rid: 6299374361138954260
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D0\u05E8\u05D9\u05D7 \u05D4\u05D6\u05D4 \u05E0\u05E8\u05D0\u05D4
          \u05D3\u05D9 \u05DB\u05D1\u05D3\u2026"
        commands: []
    - rid: 6299374361138954261
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E0\u05E8\u05D0\u05D4 \u05E9\u05D9\u05E9 \u05E2\u05DC\u05D9\u05D5
          \u05E7\u05E6\u05EA \u05D3\u05DD\u2026)"
        commands: []
    - rid: 6299374361138954262
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05DD \u05D6\u05D4 \u05E0\u05E4\u05DC \u05E2\u05DC\u05D9\u05D5
          \u05DE\u05D2\u05D5\u05D1\u05D4, \u05D0\u05D9\u05DF \u05E4\u05DC\u05D0 \u05E9\u05D4\u05D5\u05D0
          \u05DE\u05EA \u05E2\u05DC \u05D4\u05DE\u05E7\u05D5\u05DD.)"
        commands: []
    - rid: 6299374361138954263
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D1\u05D5\u05D0\u05D5 \u05E0\u05E8\u05D0\u05D4, \u05DB\u05EA\u05D5\u05D1
          \u05D1\u05EA\u05E7\u05D9\u05D9\u05D4 \u05E9\u05D4\u05D5\u05D0 \u05D4\u05D1\u05D9\u05D0
          \u05DC\u05E0\u05D5 \u05E9\u05E1\u05D9\u05D1\u05EA \u05D4\u05DE\u05D5\u05D5\u05EA
          \u05D4\u05D9\u05D0 \u05DB\u05D5\u05D7 \u05DE\u05E2\u05E6\u05DD \u05DB\u05D1\u05D3.
          \u05DB\u05DF, \u05E0\u05E8\u05D0\u05D4 \u05DE\u05EA\u05D0\u05D9\u05DD.)"
        commands: []
    - rid: 6299374361138954264
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D1\u05DC \u05E8\u05E7 \u05D0\u05E0\u05D9 \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05D0\u05D9\u05EA\u05D5 \u05E4\u05D4\u2026 \u05DE\u05D9 \u05D4\u05E6\u05DC\u05D9\u05D7
          \u05DC\u05D4\u05E4\u05D9\u05DC \u05E2\u05DC\u05D9\u05D5 \u05D0\u05EA \u05D6\u05D4?)"
        commands:
        - rid: 6299374361138954266
    - rid: 6299374361138954265
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D1\u05D8\u05D7 \u05D4\u05D0\u05D7\u05E8\u05D9\u05DD \u05D9\u05D7\u05E9\u05D1\u05D5
          \u05E9*\u05D0\u05E0\u05D9*...)"

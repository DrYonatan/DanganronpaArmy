    - rid: 6299374343484342289
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05EA\u05D9\u05E0\u05D5\u05E7 \u05D0\u05DE\u05E8 \u05E9\u05D4\u05EA\u05D0
          \u05EA\u05E7\u05D9\u05DF\u2026"
        commands: []
    - rid: 6299374343484342290
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7 \u05E9\u05D0\u05E0\u05D9
          \u05D9\u05DB\u05D5\u05DC \u05DC\u05E0\u05E1\u05D5\u05EA \u05DC\u05D4\u05D5\u05E8\u05D9\u05D3
          \u05D0\u05EA \u05D4\u05DE\u05D9\u05DD \u05DB\u05D3\u05D9 \u05DC\u05D1\u05D3\u05D5\u05E7.)"
        commands: []
    - rid: 6299374343484342291
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DC\u05D7\u05E6\u05EA\u05D9 \u05E2\u05DC \u05D4\u05D9\u05D3\u05D9\u05EA,
          \u05D5\u05D4\u05DE\u05D9\u05DD \u05D9\u05E8\u05D3\u05D5 \u05DB\u05E8\u05D2\u05D9\u05DC.)"
        commands: []
    - rid: 6299374343484342292
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05E8\u05D0\u05D4 \u05EA\u05E7\u05D9\u05DF\u2026"
        commands: []
    - rid: 6299374343484342293
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D6 \u05DE\u05D4 \u05D4\u05E7\u05D8\u05E2 \u05E9\u05DC \u05D4\u05E9\u05DC\u05D8?
          \u05DE\u05D9\u05E9\u05D4\u05D5 \u05E9\u05DD \u05D0\u05EA \u05D6\u05D4 \u05E9\u05DD?)"

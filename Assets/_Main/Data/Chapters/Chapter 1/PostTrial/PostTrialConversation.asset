    - rid: 2649295747132948692
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DC \u05D4\u05DB\u05D1\u05D5\u05D3! \u05E2\u05E9\u05D9\u05EA\u05DD
          \u05D0\u05EA \u05D4\u05D1\u05D7\u05D9\u05E8\u05D4 \u05D4\u05E0\u05DB\u05D5\u05E0\u05D4!"
        commands: []
    - rid: 2649295747132948693
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D0\u05D9\u05D4 \u05D5\u05E7\u05E0\u05D9\u05DF \u05D4\u05D9\u05D0
          \u05D4\u05DE\u05D5\u05E9\u05D7\u05E8\u05EA \u05D1\u05EA\u05D9\u05E7 \u05D4\u05D6\u05D4!"
        commands: []
    - rid: 2649295747132948694
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0\u2026"
        commands: []
    - rid: 2649295747132948695
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05E6\u05D8\u05E2\u05E8\u05EA."
        commands: []
    - rid: 2649295747132948696
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05DE\u05D4 \u05E9\u05DC\u05D4\u05D9\u05D5\u05EA \u05DE\u05D5\u05E9\u05D7\u05E8
          \u05E2\u05D5\u05E9\u05D4 \u05DC\u05D0\u05E0\u05E9\u05D9\u05DD! \u05EA\u05E4\u05D2\u05D9\u05E0\u05D5
          \u05E7\u05E6\u05EA \u05D0\u05DE\u05E4\u05EA\u05D9\u05D4!"
        commands: []
    - rid: 2649295747132948697
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E1\u05EA\u05D5\u05DD \u05EA'\u05E4\u05D4 \u05D0\u05EA\u05D4 \u05D2\u05DD
          \u05DB\u05DF, \u05D9\u05D0 \u05D6\u05D9\u05DF!"
        commands: []
    - rid: 2649295747132948698
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05DE\u05D4 \u05D0\u05EA\u05D4 \u05E2\u05D5\u05E9\u05D4 \u05DC\u05E0\u05D5
          \u05D0\u05EA \u05D6\u05D4? \u05DE\u05D4 \u05D4\u05E4\u05D5\u05D0\u05E0\u05D8\u05D4?"
        commands: []
    - rid: 2649295747132948699
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DC \u05D3\u05D1\u05E8 \u05D1\u05E2\u05EA\u05D5! \u05D0\u05D5\u05DC\u05D9
          \u05DB\u05E9\u05EA\u05E2\u05D1\u05E8\u05D5 \u05DC\u05E9\u05DC\u05D1 \u05D1'
          \u05E9\u05DC \u05D4\u05D8\u05D9\u05E8\u05D5\u05E0\u05D5\u05EA, \u05D0\u05E0\u05D9
          \u05D0\u05D2\u05D9\u05D3 \u05DC\u05DB\u05DD."
        commands: []
    - rid: 2649295747132948700
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05DE\u05D4 \u05E2\u05E9\u05D9\u05EA \u05D0\u05EA \u05D6\u05D4
          \u05DE\u05D0\u05D9\u05D4\u2026? \u05DB\u05DC \u05DB\u05DA \u05E8\u05E6\u05D9\u05EA
          \u05DC\u05E6\u05D0\u05EA \u05D4\u05D1\u05D9\u05EA\u05D4\u2026?"
        commands: []
    - rid: 2649295747132948701
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D7\u05E0\u05D5 \u05DC\u05D0 \u05E4\u05D4 \u05D4\u05E8\u05D1\u05D4
          \u05D6\u05DE\u05DF, \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05E9\u05DE\u05D9\u05E9\u05D4\u05D5 \u05D1\u05D3\u05E8\u05DA \u05DC\u05D4\u05E6\u05D9\u05DC

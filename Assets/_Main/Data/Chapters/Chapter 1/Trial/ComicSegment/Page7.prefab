          \u05DB\u05E0\u05D9\u05E1\u05D4* \u05E2\u05DC \u05D4\u05EA\u05D0\u05D9\u05DD
          \u05D4\u05D0\u05DC\u05D4, \u05DB\u05D3\u05D9 \u05DC\u05D5\u05D5\u05D3\u05D0

    - rid: 2649295605456438116
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D2\u05E2 \u05D0\u05D7\u05D3! \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05E9\u05DB\u05DF \u05D9\u05E9 \u05D3\u05E8\u05DA \u05DC\u05D3\u05E2\u05EA
          \u05D0\u05DD \u05E2\u05E0\u05D1\u05DC \u05D0\u05D5\u05DE\u05E8\u05EA \u05D0\u05EA
          \u05D4\u05D0\u05DE\u05EA."
        commands:
        - rid: 2649295605456438161
    - rid: 2649295605456438117
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05E9 \u05D3\u05E8\u05DA \u05DB\u05D6\u05D0\u05EA? \u05EA\u05E9\u05EA\u05E3
          \u05D0\u05D5\u05EA\u05E0\u05D5 \u05D1\u05D1\u05E7\u05E9\u05D4."
        commands: []
    - rid: 2649295605456438118
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA \u05E9\u05D0\u05EA\u05D4
          \u05E7\u05D5\u05E8\u05D0 \u05DE\u05D7\u05E9\u05D1\u05D5\u05EA \u05D0\u05DC\u05D5\u05DF?"
        commands: []
    - rid: 2649295605456438119
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DE\u05D0\u05DC\u05D4 \u05D0\u05DC\u05D5\u05DF, \u05D6\u05D4
          \u05E0\u05DB\u05D5\u05DF? \u05E2\u05DC \u05DE\u05D4 \u05D0\u05E0\u05D9
          \u05D7\u05D5\u05E9\u05D1\u05EA \u05E2\u05DB\u05E9\u05D9\u05D5?"
        commands: []
    - rid: 2649295605456438120
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0, \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05E7\u05D5\u05E8\u05D0
          \u05DE\u05D7\u05E9\u05D1\u05D5\u05EA\u2026"
        commands: []
    - rid: 2649295605456438121
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05DE\u05DE\u05E9 \u05E7\u05E6\u05EA \u05DC\u05E4\u05E0\u05D9
          \u05D4\u05E8\u05E6\u05D7, \u05EA\u05D9\u05E0\u05D5\u05E7 \u05D4\u05D1\u05DE\u05D1\u05D4
          \u05D4\u05D2\u05D9\u05E2 \u05DC\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD
          \u05E4\u05E2\u05DD \u05E0\u05D5\u05E1\u05E4\u05EA."
        commands: []
    - rid: 2649295605456438122
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D5\u05D0 \u05DC\u05D0 \u05E2\u05D6\u05D1 \u05D0\u05D7\u05E8\u05D9
          \u05D4\u05EA\u05D3\u05E8\u05D9\u05DA?"
        commands: []
    - rid: 2649295605456438123
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D5\u05D0 \u05E2\u05D6\u05D1, \u05D0\u05D1\u05DC \u05D0\u05D7\u05E8\u05D9
          \u05DB\u05DE\u05D4 \u05D3\u05E7\u05D5\u05EA \u05D4\u05D5\u05D0 \u05D7\u05D6\u05E8
          \u05E2\u05DD \u05E2\u05D2\u05DC\u05D4 \u05DE\u05DC\u05D0\u05D4 \u05D1\u05DE\u05E9\u05D4\u05D5
          \u05DE\u05E1\u05D5\u05D9\u05DD."
        commands: []
    - rid: 2649295605456438124
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05E9\u05D4\u05D5 \u05DE\u05E1\u05D5\u05D9\u05DD?"
        commands: []
    - rid: 2649295605456438125
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05DE\u05E9\u05D4\u05D5 \u05DC\u05E0\u05E7\u05D9\u05D5\u05E0\u05D5\u05EA\u2026
          \u05D4\u05D5\u05D0 \u05D4\u05D1\u05D9\u05D0 \u05DC\u05D9 \u05D0\u05EA \u05D4\u05D3\u05D1\u05E8
          \u05D4\u05D6\u05D4, \u05D5\u05D0\u05D7\u05E8\u05D9 \u05D6\u05D4 \u05D4\u05D5\u05D0
          \u05D0\u05DE\u05E8\u2026"
        commands: []
    - rid: 2649295605456438126
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D4\u05D5\u05DC\u05DA \u05DC\u05D4\u05D1\u05D9\u05D0
          \u05DC\u05D1\u05E0\u05D5\u05EA \u05D0\u05D7\u05D3 \u05D2\u05DD. \u05D4\u05DE\u05E9\u05DA
          \u05E0\u05D9\u05E7\u05D9\u05D5\u05E0\u05D5\u05EA \u05E0\u05E2\u05D9\u05DD!"
        commands: []
    - rid: 2649295605456438127
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05E8\u05E6\u05D7 \u05E7\u05E8\u05D4 \u05E4\u05D7\u05D5\u05EA
          \u05DE\u05D3\u05E7\u05D4 \u05DC\u05D0\u05D7\u05E8 \u05DE\u05DB\u05DF! \u05DE\u05D9
          \u05E9\u05D4\u05D5\u05E8\u05D9\u05D3 \u05D0\u05EA \u05D4\u05DE\u05D9\u05DD
          \u05D4\u05D9\u05D4 \u05D7\u05D9\u05D9\u05D1 \u05DC\u05D4\u05EA\u05DB\u05D5\u05E0\u05DF
          \u05E2\u05DC \u05D6\u05D4 \u05DE\u05E8\u05D0\u05E9, \u05D0\u05D6 \u05DC\u05D0
          \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA \u05E9\u05D4\u05D5\u05D0
          \u05D4\u05E1\u05E4\u05D9\u05E7 \u05DC\u05E6\u05D0\u05EA \u05D4\u05D7\u05D5\u05E6\u05D4,
          \u05DC\u05D3\u05D1\u05E8 \u05E2\u05DD \u05D4\u05EA\u05D9\u05E0\u05D5\u05E7
          \u05D5\u05DC\u05D7\u05D6\u05D5\u05E8 \u05DC\u05D1\u05E6\u05E2 \u05D0\u05EA
          \u05D4\u05E8\u05E6\u05D7."
        commands: []
    - rid: 2649295605456438128
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D6\u05D4 \u05D4\u05D5\u05DC\u05DA \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05D4\u05DE\u05D1\u05D7\u05DF \u05E9\u05DC\u05D9! \u05DE\u05D0\u05D9\u05D4,
          \u05D4\u05D0\u05DD \u05D0\u05EA \u05D9\u05D5\u05D3\u05E2\u05EA \u05DE\u05D4
          \u05D6\u05D4 \u05D4\u05D3\u05D1\u05E8 \u05E9\u05D4\u05EA\u05D9\u05E0\u05D5\u05E7
          \u05D4\u05D1\u05D9\u05D0?"
        commands: []
    - rid: 2649295605456438129
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05D6\u05E9\u05D4\u05D5 \u05E1\u05E4\u05D5\u05D2 \u05DE\u05E1\u05D5\u05D9\u05DD,
          \u05DC\u05D0\u2026?"
        commands: []
    - rid: 2649295605456438130
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D9\u05D0 \u05D9\u05D5\u05D3\u05E2\u05EA \u05E9\u05D6\u05D4
          \u05E1\u05E4\u05D5\u05D2, \u05D0\u05D9\u05DF \u05E1\u05E4\u05E7 \u05E9\u05D9\u05E9
          \u05DC\u05D4 \u05EA\u05E9\u05D5\u05DE\u05EA \u05DC\u05D1\u2026 \u05D0\u05D1\u05DC
          \u05D0\u05DD \u05D4\u05D9\u05D0 \u05D4\u05D9\u05D9\u05EA\u05D4 \u05D1\u05EA\u05D0,
          \u05DC\u05D0 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA \u05E9\u05D4\u05D9\u05D0
          \u05EA\u05D3\u05E2 \u05DC\u05D2\u05D1\u05D9\u2026)"
        commands: []
    - rid: 2649295605456438131
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E1\u05E4\u05D5\u05D2 \u05DE\u05E1\u05D5\u05D9\u05DD\u2026 \u05D0\u05D1\u05DC
          \u05D0\u05D9\u05DA \u05E7\u05E8\u05D0\u05D5 \u05DC\u05D5?"
        commands: []
    - rid: 2649295605456438132
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DA \u05E7\u05E8\u05D0\u05D5 \u05DC\u05D5\u2026?"
        commands: []
    - rid: 2649295605456438133
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D9\u05D3\u05E2\u05EA\u05D9\u2026 \u05D4\u05D9\u05D0 \u05DC\u05D0
          \u05D9\u05D5\u05D3\u05E2\u05EA \u05D0\u05EA \u05D4\u05E4\u05E8\u05D8 \u05D4\u05D6\u05D4.)"
        commands: []
    - rid: 2649295605456438134
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D0\u05D9\u05EA\u05DA \u05E2\u05E0\u05D1\u05DC?"
        commands: []
    - rid: 2649295605456438135
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DA \u05E7\u05E8\u05D0\u05D5 \u05DC\u05E1\u05E4\u05D5\u05D2\u2026?
          \u05E1\u05E4\u05D5\u05D2 \u05D4\u05E4\u05DC\u05D0 0003\u2026 \u05DC\u05D0?"
        commands: []
    - rid: 2649295605456438136
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D4 \u05D4\u05E9\u05DD \u05D4\u05E0\u05DB\u05D5\u05DF. \u05D4\u05D9\u05D0
          \u05DC\u05D0 \u05DE\u05E9\u05E7\u05E8\u05EA.)"
        commands: []
    - rid: 2649295605456438137
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E2\u05E0\u05D1\u05DC \u05E6\u05D5\u05D3\u05E7\u05EA. \u05D6\u05D4
          \u05D4\u05E9\u05DD \u05E9\u05DC \u05D4\u05E1\u05E4\u05D5\u05D2 \u05D4\u05D6\u05D4.
          \u05D0\u05E0\u05D9 \u05D7\u05D5\u05E9\u05D1 \u05E9\u05D0\u05E4\u05E9\u05E8
          \u05DC\u05D4\u05E0\u05D9\u05D7 \u05D0\u05DD \u05DB\u05DB\u05D4, \u05E9\u05D4\u05D9\u05D0
          \u05D0\u05DE\u05E8\u05D4 \u05D0\u05EA \u05D4\u05D0\u05DE\u05EA. \u05DE\u05D0\u05D9\u05D4
          \u05D1\u05D0\u05DE\u05EA \u05D4\u05D0\u05D7\u05EA \u05E9\u05D4\u05D9\u05D9\u05EA\u05D4
          \u05D1\u05EA\u05D0\u05D9\u05DD \u05D1\u05D0\u05D5\u05EA\u05D5 \u05D4\u05E8\u05D2\u05E2!"
        commands: []
    - rid: 2649295605456438138
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 2649295605456438139
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D0\u05E0\u05D7\u05E0\u05D5 \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD
          \u05DC\u05D4\u05D9\u05D5\u05EA \u05D1\u05D8\u05D5\u05D7\u05D9\u05DD \u05E9\u05E2\u05E0\u05D1\u05DC
          \u05D0\u05D5\u05DE\u05E8\u05EA \u05D0\u05EA \u05D4\u05D0\u05DE\u05EA, \u05E0\u05DB\u05D5\u05DF\u2026?"
        commands: []
    - rid: 2649295605456438140
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DC\u05D5\u05DF, \u05D7\u05D9\u05D9\u05DD \u05E9\u05DC\u05D9,
          \u05E2\u05D3\u05D9\u05D9\u05DF \u05DC\u05D0 \u05D4\u05E9\u05EA\u05DB\u05E0\u05E2\u05EA\u05D9."
        commands: []
    - rid: 2649295605456438141
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E2\u05D3\u05D9\u05D9\u05DF \u05DC\u05D0 \u05D4\u05E9\u05EA\u05DB\u05E0\u05E2\u05EA?"
        commands: []
    - rid: 2649295605456438142
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D5\u05DC\u05D9 \u05D4\u05D9\u05D0 \u05E2\u05E9\u05EA\u05D4
          \u05DC\u05DA \u05E7\u05E6\u05EA \u05E4\u05D5\u05E6\u05D9 \u05DE\u05D5\u05E6\u05D9,
          \u05D5\u05E2\u05DB\u05E9\u05D9\u05D5 \u05D0\u05EA\u05D4 \u05D5\u05D4\u05D9\u05D0
          \u05DE\u05E9\u05EA\u05E4\u05D9\u05DD \u05E4\u05E2\u05D5\u05DC\u05D4, \u05D5\u05DE\u05E0\u05E1\u05D9\u05DD
          \u05DC\u05E2\u05E9\u05D5\u05EA \u05D4\u05DC\u05D0\u05D5\u05DD \u05E2\u05DC
          \u05DE\u05D0\u05D9\u05D4!"
        commands: []
    - rid: 2649295605456438143
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05DB\u05DC \u05D6\u05D0\u05EA, \u05D1\u05D7\u05D5\u05E8\u05D4
          \u05E0\u05D0\u05D4. \u05D1\u05D7\u05D5\u05E8 \u05DB\u05DE\u05D5\u05DA \u05DC\u05D0
          \u05D4\u05D9\u05D4 \u05D9\u05DB\u05D5\u05DC \u05DC\u05E1\u05E8\u05D1."
        commands: []
    - rid: 2649295605456438144
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05E9\u05EA\"\u05E4\u2026? \u05DC\u05D0 \u05D4\u05E2\u05DC\u05EA\u05D9
          \u05D0\u05EA \u05D6\u05D4 \u05E2\u05DC \u05D3\u05E2\u05EA\u05D9 \u05D0\u05E4\u05D9\u05DC\u05D5."
        commands: []
    - rid: 2649295605456438145
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D7\u05D5\u05E7\u05D9 \u05D1\u05DB\u05DC\u05DC?"
        commands: []
    - rid: 2649295605456438146
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0, \u05D6\u05D4 \u05DC\u05D0 \u05D7\u05D5\u05E7\u05D9.
          \u05DC\u05D0 \u05D4\u05E1\u05EA\u05DB\u05DC\u05EA\u05DD \u05D1\u05E0\u05D4\u05DC\u05D9\u05DD?"
        commands: []
    - rid: 2649295605456438147
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D5\u05D0 \u05E6\u05D5\u05D3\u05E7. \u05DB\u05EA\u05D5\u05D1
          \u05D0\u05EA \u05D6\u05D4 \u05D1\u05DE\u05E4\u05D5\u05E8\u05E9 \u05D1\u05E0\u05D5\u05D4\u05DC
          8#."
        commands: []
    - rid: 2649295605456438148
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\"\u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA \u05E8\u05E7
          \u05E8\u05D5\u05E6\u05D7 \u05D0\u05D7\u05D3 \u05DC\u05DB\u05DC \u05E7\u05D5\u05E8\u05D1\u05DF.
          \u05D0\u05DD \u05E9\u05E0\u05D9\u05D9\u05DD \u05D0\u05D5 \u05D9\u05D5\u05EA\u05E8
          \u05DE\u05E9\u05EA\u05E4\u05D9\u05DD \u05E4\u05E2\u05D5\u05DC\u05D4 \u05D1\u05E9\u05D1\u05D9\u05DC
          \u05E8\u05E6\u05D7 \u05D0\u05D7\u05D3, \u05E8\u05E7 \u05DE\u05D9 \u05E9\u05D1\u05D9\u05E6\u05E2
          \u05D0\u05EA \u05D4\u05E8\u05E6\u05D7 \u05D9\u05D9\u05D7\u05E9\u05D1 \u05D4\u05E8\u05D5\u05E6\u05D7.\""
        commands: []
    - rid: 2649295605456438149
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05E7 \u05DE\u05D9 \u05E9\u05D1\u05D9\u05E6\u05E2 \u05D0\u05EA
          \u05D4\u05E8\u05E6\u05D7 \u05D9\u05D9\u05D7\u05E9\u05D1 \u05DC\u05E8\u05D5\u05E6\u05D7\u2026
          \u05D6\u05D4 \u05D0\u05D5\u05DE\u05E8 \u05E9\u05D0\u05DD \u05D1\u05D5\u05D7\u05E8\u05D9\u05DD
          \u05D1\u05D1\u05DF \u05D0\u05D3\u05DD \u05D4\u05DC\u05D0 \u05E0\u05DB\u05D5\u05DF,
          \u05D2\u05DD \u05D0\u05E0\u05D9 \u05D0\u05DE\u05D5\u05EA, \u05D2\u05DD
          \u05D0\u05DD \u05D0\u05E0\u05D9 \u05E2\u05D5\u05D6\u05E8 \u05DC\u05E8\u05D5\u05E6\u05D7.
          \u05E0\u05DB\u05D5\u05DF?"
        commands: []
    - rid: 2649295605456438150
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05DB\u05D5\u05DF \u05DE\u05D0\u05D5\u05D3! \u05D0\u05EA\u05DD
          \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD \u05DC\u05E2\u05D6\u05D5\u05E8 \u05D0\u05D7\u05D3
          \u05DC\u05E9\u05E0\u05D9 \u05D1\u05E8\u05E6\u05D7, \u05D0\u05D1\u05DC \u05D0\u05D9\u05DF
          \u05DC\u05DB\u05DD \u05DE\u05D4 \u05DC\u05D4\u05E9\u05D9\u05D2 \u05DE\u05D6\u05D4.
          \u05E8\u05E7 \u05D1\u05DF \u05D0\u05D3\u05DD \u05D0\u05D7\u05D3 \u05DE\u05E7\u05D1\u05DC
          \u05D0\u05EA \u05EA\u05D5\u05D0\u05E8 \"\u05D4\u05DE\u05D5\u05E9\u05D7\u05E8\"!"
        commands: []
    - rid: 2649295605456438151
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}

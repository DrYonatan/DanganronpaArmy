    - rid: 2649295605456437978
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05E7 \u05E8\u05D2\u05E2 \u05DE\u05D0\u05D9\u05D4. \u05D6\u05D4
          \u05DC\u05D0 \u05E8\u05E7 \u05E1\u05E4\u05E7\u05D5\u05DC\u05E6\u05D9\u05D4,
          \u05D9\u05E9 \u05DC\u05E0\u05D5 \u05E1\u05D9\u05D1\u05D4 \u05DE\u05DE\u05E9\u05D9\u05EA
          \u05DC\u05D7\u05E9\u05D5\u05D1 \u05E9\u05D4\u05D5\u05E8\u05D3\u05EA \u05DE\u05D9\u05DD
          \u05EA\u05E4\u05D9\u05DC \u05D0\u05EA \u05D4\u05D0\u05E8\u05D9\u05D7."
        commands:
        - rid: 2649295605456438002
        - rid: 6008430280376320081
    - rid: 2649295605456437979
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DA \u05D0\u05EA\u05D4 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05D1\u05D8\u05D5\u05D7?"
        commands: []
    - rid: 2649295605456437980
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05DC\u05D3\u05E2\u05EA\u05DB\u05DD \u05D2\u05E8\u05DD
          \u05DC\u05D0\u05E8\u05D9\u05D7 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9
          \u05D1\u05E0\u05D5\u05EA \u05DC\u05D9\u05E4\u05D5\u05DC? \u05DE\u05D4 \u05D4\u05D9\u05D4
          \u05D4\u05D8\u05E8\u05D9\u05D2\u05E8?"
        commands: []
    - rid: 2649295605456437981
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D0\u05EA\u05D4 \u05DE\u05E0\u05E1\u05D4 \u05DC\u05D4\u05D2\u05D9\u05D3?
          \u05D0\u05EA\u05D4 \u05D7\u05D5\u05E9\u05D1 \u05E9\u05DE\u05D9\u05E9\u05D4\u05D5
          \u05D4\u05D5\u05E8\u05D9\u05D3 \u05D0\u05EA \u05D4\u05DE\u05D9\u05DD \u05D1\u05EA\u05D0
          \u05E9\u05D0\u05DC\u05D9\u05D5 \u05DE\u05D7\u05D5\u05D1\u05E8 \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8
          \u05D4\u05D6\u05D4, \u05D5\u05DC\u05DB\u05DF \u05D4\u05D0\u05E8\u05D9\u05D7
          \u05E0\u05E4\u05DC?"
        commands: []
    - rid: 2649295605456437982
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D7\u05D5\u05E9\u05D1 \u05D0\u05EA
          \u05D6\u05D4, \u05D0\u05E0\u05D9 \u05D9\u05D5\u05D3\u05E2. \u05DB\u05D9
          \u05D0\u05E0\u05D9 \u05D4\u05D5\u05E8\u05D3\u05EA\u05D9 \u05D0\u05EA \u05D4\u05DE\u05D9\u05DD."
        commands: []
    - rid: 2649295605456437983
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05D4 \u05D4\u05D5\u05E8\u05D3\u05EA \u05D0\u05EA \u05D4\u05DE\u05D9\u05DD?"
        commands: []
    - rid: 2649295605456437984
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05DE\u05D4 \u05E2\u05E9\u05D9\u05EA \u05D0\u05EA \u05D6\u05D4?"
        commands: []
    - rid: 2649295605456437985
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05E6\u05D9\u05EA\u05D9 \u05DC\u05D3\u05E2\u05EA \u05D0\u05DD
          \u05D4\u05D4\u05D5\u05E8\u05D3\u05D4 \u05E2\u05D5\u05D1\u05D3\u05EA \u05D1\u05D0\u05D5\u05E4\u05DF
          \u05EA\u05E7\u05D9\u05DF\u2026 \u05DC\u05D0 \u05D9\u05D3\u05E2\u05EA\u05D9
          \u05E9\u05D9\u05D4\u05D9\u05D5 \u05DC\u05D6\u05D4 \u05D4\u05E9\u05DC\u05DB\u05D5\u05EA
          \u05E2\u05DC \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD \u05D4\u05E9\u05E0\u05D9\u05D9\u05DD."
        commands: []
    - rid: 2649295605456437986
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D1\u05D6\u05DE\u05DF \u05E9\u05D0\u05EA\u05D4 \u05E2\u05E9\u05D9\u05EA
          \u05D0\u05EA \u05D6\u05D4, \u05D0\u05E0\u05D9 \u05D5\u05E0\u05D5\u05D9\u05D4
          \u05D4\u05D9\u05D9\u05E0\u05D5 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9
          \u05D1\u05E0\u05D5\u05EA, \u05D5\u05D4\u05D0\u05E8\u05D9\u05D7 \u05E4\u05EA\u05D0\u05D5\u05DD
          \u05E0\u05E4\u05DC!"
        commands: []
    - rid: 2649295605456437987
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DE\u05D0\u05DC\u05D4 \u05D0\u05DC\u05D5\u05DF, \u05DB\u05DE\u05E2\u05D8
          \u05E0\u05D4\u05D9\u05D9\u05EA \u05E8\u05D5\u05E6\u05D7 \u05D1\u05E2\u05E6\u05DE\u05DA!"
        commands: []
    - rid: 2649295605456437988
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D0\u05DE\u05EA \u05E9\u05D4\u05D9\u05D0 \u05E6\u05D5\u05D3\u05E7\u05EA\u2026
          \u05DE\u05D6\u05DC \u05E9\u05D4\u05D0\u05E8\u05D9\u05D7 \u05DC\u05D0 \u05E0\u05E4\u05DC
          \u05E2\u05DC \u05D0\u05E3 \u05D0\u05D7\u05D3. \u05D0\u05D7\u05E8\u05EA
          \u05D4\u05D9\u05D9\u05EA\u05D4 \u05D8\u05E8\u05D2\u05D3\u05D9\u05D4 \u05DB\u05E4\u05D5\u05DC\u05D4...)"
        commands: []
    - rid: 2649295605456437989
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05D4\u05E8\u05D2\u05EA\u05DD \u05D0\u05D5\u05EA\u05D9
          \u05E2\u05DD \u05DB\u05DC \u05D4\u05E1\u05D9\u05D1\u05D5\u05DA \u05D4\u05D6\u05D4."
        commands: []
    - rid: 2649295605456437990
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D0\u05DC\u05D5\u05DF \u05D4\u05D5\u05E8\u05D9\u05D3
          \u05D0\u05EA \u05D4\u05DE\u05D9\u05DD \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9
          \u05D1\u05E0\u05D9\u05DD, \u05DE\u05D4 \u05E9\u05D2\u05E8\u05DD \u05DC\u05D0\u05E8\u05D9\u05D7
          \u05DC\u05D9\u05E4\u05D5\u05DC \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9
          \u05D1\u05E0\u05D5\u05EA. \u05D0\u05DD \u05E0\u05DE\u05E9\u05D9\u05DA \u05D0\u05EA
          \u05E7\u05D5 \u05D4\u05DE\u05D7\u05E9\u05D1\u05D4 \u05D4\u05D6\u05D4\u2026"
        commands: []
    - rid: 2649295605456437991
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E4\u05E9\u05E8 \u05DC\u05D4\u05E0\u05D9\u05D7 \u05E9\u05D4\u05E8\u05E6\u05D7
          \u05D4\u05EA\u05D1\u05E6\u05E2 \u05D1\u05D0\u05D5\u05EA\u05D5 \u05D0\u05D5\u05E4\u05DF.
          \u05DE\u05D9\u05E9\u05D4\u05D5 \u05D4\u05D5\u05E8\u05D9\u05D3 \u05D0\u05EA
          \u05D4\u05DE\u05D9\u05DD \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9 \u05D1\u05E0\u05D5\u05EA,
          \u05DE\u05D4 \u05E9\u05D2\u05E8\u05DD \u05DC\u05D0\u05E8\u05D9\u05D7 \u05DC\u05D9\u05E4\u05D5\u05DC
          \u05E2\u05DC \u05D4\u05E8\u05D0\u05E9 \u05E9\u05DC \u05E8\u05D5\u05E2\u05D9."
        commands:
        - rid: 2649295605456438003
    - rid: 2649295605456437992
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D4\u05D0\u05DD \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA
          \u05D4\u05D9\u05D5 \u05DE\u05D7\u05D5\u05D1\u05E8\u05D9\u05DD \u05D1\u05E6\u05D5\u05E8\u05D4
          \u05D4\u05D6\u05D0\u05EA \u05D2\u05DD \u05D1\u05DB\u05D9\u05D5\u05D5\u05DF
          \u05D4\u05D4\u05E4\u05D5\u05DA?"
        commands: []
    - rid: 2649295605456437993
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D7\u05D5\u05E9\u05D1\u05EA \u05E9\u05DB\u05DF.
          \u05D0\u05E4\u05E9\u05E8 \u05DC\u05E8\u05D0\u05D5\u05EA \u05D1\u05E8\u05DB\u05D6\u05EA,
          \u05E9\u05D4\u05E6\u05D9\u05E0\u05D5\u05E8 8-UB \u05E9\u05D4\u05D5\u05D0
          \u05D6\u05D4 \u05E9\u05E2\u05D5\u05D1\u05E8 \u05DE\u05E2\u05DC \u05D4\u05EA\u05D0\u05D9\u05DD
          \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9 \u05D1\u05E0\u05D9\u05DD, \u05DE\u05D7\u05D5\u05D1\u05E8
          \u05DC\u05D0\u05D7\u05D3 \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA
          \u05E9\u05DC \u05D4\u05EA\u05D0\u05D9\u05DD \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9
          \u05D1\u05E0\u05D5\u05EA."
        commands:
        - rid: 6008430280376320082
    - rid: 2649295605456437994
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D6\u05D5 \u05E9\u05D9\u05D8\u05EA \u05D4\u05E8\u05E6\u05D7?
          \u05D4\u05E8\u05D5\u05E6\u05D7 \u05D4\u05D5\u05E8\u05D9\u05D3 \u05D0\u05EA
          \u05D4\u05DE\u05D9\u05DD \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9 \u05D1\u05E0\u05D5\u05EA,
          \u05D5\u05D2\u05E8\u05DD \u05DC\u05D0\u05E8\u05D9\u05D7 \u05DC\u05D9\u05E4\u05D5\u05DC?"

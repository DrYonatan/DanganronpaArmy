    - rid: 2649295605456438000
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05DF \u05D4\u05E9\u05EA\u05D9\u05D9\u05DD \u05E9\u05D4\u05D9\u05D9\u05EA\u05DF

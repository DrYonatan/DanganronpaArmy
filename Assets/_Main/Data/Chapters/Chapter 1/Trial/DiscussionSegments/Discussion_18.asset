        commands: []
    - rid: 2649295747132948598
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9 \u05E9\u05DB\u05D3\u05D0\u05D9
          \u05E9\u05D0\u05E0\u05D9 \u05D0\u05E2\u05D1\u05D5\u05E8 \u05E2\u05DC \u05DB\u05DC

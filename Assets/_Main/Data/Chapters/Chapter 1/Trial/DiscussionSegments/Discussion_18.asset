      data:
        text: "(\u05D4\u05D9\u05D0 \u05DC\u05D0 \u05D4\u05D5\u05DC\u05DB\u05EA \u05DC\u05D4\u05D5\u05D3\u05D5\u05EA
          \u05D1\u05D6\u05D4.)"
        commands: []
    - rid: 2649295747132948597
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D0\u05D9\u05D4\u2026 \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05E8\u05D5\u05E6\u05D4
          \u05DC\u05D4\u05D0\u05DE\u05D9\u05DF \u05D1\u05D6\u05D4 \u05D1\u05E2\u05E6\u05DE\u05D9,

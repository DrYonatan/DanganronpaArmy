    - rid: 2649295747132948576
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D0\u05D9\u05D4\u2026 \u05D4\u05D9\u05D4 \u05D4\u05E7\u05E9\u05E8,
          \u05DE\u05E9\u05D4\u05D5 \u05E9\u05D1\u05D2\u05DC\u05DC\u05D5 \u05D7\u05E9\u05D1\u05EA
          \u05DC\u05D7\u05E7\u05D5\u05E8 \u05D3\u05D5\u05D5\u05E7\u05D0 \u05D0\u05EA
          \u05D4\u05DE\u05D1\u05E0\u05D4 \u05E9\u05DC \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD."
        commands: []
    - rid: 2649295747132948577
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 2649295747132948578
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E9\u05DB\u05D5\u05DC\u05E0\u05D5 \u05D7\u05E7\u05E8\u05E0\u05D5
          \u05D0\u05EA \u05D4\u05D1\u05E1\u05D9\u05E1, \u05D4\u05EA\u05D7\u05DC\u05E7\u05E0\u05D5
          \u05DC\u05E7\u05D1\u05D5\u05E6\u05D5\u05EA. \u05D6\u05D5\u05DB\u05E8\u05D9\u05DD?"
        commands: []
    - rid: 2649295747132948579
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D0\u05EA\u05D4 \u05D7\u05D5\u05E9\u05D1 \u05E9\u05E0\u05D4\u05D9\u05D9\u05E0\u05D5
          \u05E1\u05E0\u05D9\u05DC\u05D9\u05DD? \u05D1\u05E8\u05D5\u05E8 \u05E9\u05D0\u05E0\u05D7\u05E0\u05D5
          \u05D6\u05D5\u05DB\u05E8\u05D9\u05DD."
        commands: []
    - rid: 2649295747132948580
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05EA\u05D6\u05DB\u05E8\u05D5 \u05D0\u05D9\u05DA \u05D1\u05D3\u05D9\u05D5\u05E7
          \u05D4\u05EA\u05D7\u05DC\u05E7\u05E0\u05D5\u2026"
        commands: []
    - rid: 2649295747132948581
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D0\u05E0\u05D9, \u05D0\u05EA\u05D4, \u05D0\u05E8\u05D9\u05D0\u05DC
          \u05D5\u05DB\u05E4\u05D9\u05E8 \u05D4\u05DC\u05DB\u05E0\u05D5 \u05DC\u05D7\u05E7\u05D5\u05E8
          \u05D0\u05EA \u05D4\u05E9\"\u05D2\u2026"
        commands: []
    - rid: 2649295747132948582
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9, \u05E0\u05E2\u05D4 \u05D5\u05E7\u05D5\u05D1\u05D9
          \u05D7\u05E7\u05E8\u05E0\u05D5 \u05D0\u05EA \u05D4\u05D9\u05D5\u05D0\u05D1\u2026"
        commands: []
    - rid: 2649295747132948583
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D5\u05E9\u05D9\u05E8\u05D6 \u05D7\u05E7\u05E8\u05E0\u05D5
          \u05D0\u05EA \u05D4\u05E8\u05D7\u05D1\u05D4 \u05E9\u05DC \u05D4\u05D7\u05D3\"\u05D0."
        commands: []
    - rid: 2649295747132948584
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9, \u05E8\u05D5\u05E2\u05D9, \u05D0\u05D5\u05D4\u05D1
          \u05D5\u05D2\u05D9\u05D0 \u05D7\u05E7\u05E8\u05E0\u05D5 \u05D0\u05EA \u05D4\u05D0\u05D9\u05D6\u05D5\u05E8
          \u05E9\u05DC \u05D4\u05D2\u05DC\u05E2\u05D3\u05D9\u05DD\u2026"
        commands: []
    - rid: 2649295747132948585
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05DE\u05D9 \u05E9\u05D7\u05E7\u05E8\u05D5 \u05D0\u05EA \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD
          \u05D4\u05D9\u05D5\u2026 *\u05E0\u05D5\u05D9\u05D4 \u05D5\u05DE\u05D0\u05D9\u05D4*."
        commands:
        - rid: 2649295747132948600
    - rid: 2649295747132948586
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05DB\u05D5\u05DF, \u05E9\u05EA\u05D9\u05E0\u05D5 \u05D7\u05E7\u05E8\u05E0\u05D5
          \u05D0\u05EA \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD."
        commands: []
    - rid: 2649295747132948587
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05D5\u05EA\u05E8 \u05DE\u05D6\u05D4, \u05D0\u05EA \u05D6\u05D5\u05DB\u05E8\u05EA
          \u05DE\u05D4 \u05D0\u05DE\u05E8\u05EA \u05DB\u05E9\u05D3\u05D9\u05D1\u05E8\u05E0\u05D5
          \u05E2\u05DC \u05D4\u05DE\u05DE\u05E6\u05D0\u05D9\u05DD?"
        commands: []
    - rid: 2649295747132948588
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05DC\u05D0 \u05DE\u05E6\u05D0\u05EA\u05DF \u05E9\u05D5\u05DD
          \u05D3\u05D1\u05E8 \u05D7\u05D5\u05E5 \u05DE\u05D6\u05D4?"
        commands: []
    - rid: 2649295747132948589
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0. \u05D5\u05EA\u05D0\u05DE\u05D9\u05DF \u05DC\u05D9 \u05E9\u05D7\u05D9\u05E4\u05E9\u05E0\u05D5.
          \u05DE\u05D0\u05D9\u05D4 \u05D4\u05E1\u05EA\u05DB\u05DC\u05D4 \u05D1\u05DB\u05DC
          \u05E4\u05D9\u05E0\u05D4 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD
          \u05D4\u05D0\u05DC\u05D4."
        commands: []
    - rid: 2649295747132948590
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF\u2026 \u05DB\u05E9\u05D7\u05E7\u05E8\u05E0\u05D5 \u05D0\u05EA
          \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD, \u05DE\u05D0\u05D9\u05D4
          \u05D1\u05D7\u05E0\u05D4 \u05D0\u05EA \u05D4\u05DE\u05E7\u05D5\u05DD \u05DE\u05DE\u05E9
          \u05D8\u05D5\u05D1. \u05E8\u05D0\u05D9\u05E0\u05D5 \u05E9\u05DD \u05D2\u05DD
          \u05D0\u05EA \u05D4\u05E8\u05DB\u05D6\u05EA, \u05D5\u05D0\u05D9\u05DA \u05E9\u05D4\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA
          \u05DE\u05D7\u05D5\u05D1\u05E8\u05D9\u05DD \u05E9\u05DD."
        commands: []
    - rid: 2649295747132948591
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9 \u05DB\u05DE\u05D5
          \u05D1\u05DC\u05D0\u05D2\u05DF \u05D0\u05D7\u05D3 \u05D2\u05D3\u05D5\u05DC
          \u05D5\u05DC\u05D0 \u05D7\u05E9\u05D1\u05EA\u05D9 \u05DC\u05D4\u05E1\u05EA\u05DB\u05DC
          \u05E2\u05D5\u05D3 \u05DC\u05D2\u05D1\u05D9 \u05D6\u05D4, \u05D0\u05D1\u05DC
          \u05DE\u05D0\u05D9\u05D4 \u05D4\u05D9\u05D9\u05EA\u05D4 \u05DE\u05DE\u05E9
          \u05DE\u05E8\u05D5\u05DB\u05D6\u05EA \u05D5\u05D9\u05E1\u05D5\u05D3\u05D9\u05EA.
          \u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05D4\u05D0\u05DE\u05D9\u05DF
          \u05E9\u05D4\u05D9\u05D0 \u05D6\u05DB\u05E8\u05D4 \u05D0\u05EA \u05D6\u05D4."
        commands: []
    - rid: 2649295747132948592
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05DE\u05D0\u05D9\u05D4 \u05D1\u05D0\u05DE\u05EA \u05D6\u05DB\u05E8\u05D4
          \u05D0\u05EA \u05DE\u05D4 \u05E9\u05D4\u05D5\u05DC\u05DA \u05E9\u05DD,
          \u05D6\u05D4 \u05D4\u05D2\u05D9\u05D5\u05E0\u05D9 \u05E9\u05D4\u05D9\u05D0
          \u05D7\u05E9\u05D1\u05D4 \u05DC\u05D7\u05D6\u05D5\u05E8 \u05D5\u05DC\u05D1\u05D3\u05D5\u05E7
          \u05E2\u05D5\u05D3 \u05E2\u05DC \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD
          \u05DB\u05E9\u05D4\u05D9\u05D0 \u05D4\u05EA\u05D7\u05D9\u05DC\u05D4 \u05DC\u05EA\u05DB\u05E0\u05DF
          \u05D0\u05EA \u05D4\u05E8\u05E6\u05D7 \u05D4\u05D6\u05D4."
        commands: []
    - rid: 2649295747132948593
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DC\u05EA\u05DB\u05E0\u05DF \u05D0\u05EA \u05D4\u05E8\u05E6\u05D7
          \u05D4\u05D6\u05D4\u2026 \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05DE\u05D0\u05DE\u05D9\u05DF
          \u05E9\u05D0\u05E0\u05D9 \u05D0\u05D5\u05DE\u05E8 \u05D0\u05EA \u05D6\u05D4.)"
        commands: []
    - rid: 2649295747132948594
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D0\u05D9\u05D4\u2026 \u05DB\u05DC \u05D6\u05D4 \u05E0\u05DB\u05D5\u05DF?"
        commands: []

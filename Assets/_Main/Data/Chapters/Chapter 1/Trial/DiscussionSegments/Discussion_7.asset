    - rid: 2649295605456437326
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D2\u05E2, \u05D4\u05D0\u05DD \u05D1\u05D0\u05DE\u05EA \u05DB\u05D5\u05DC\u05DD
          \u05D4\u05D9\u05D5 \u05D1\u05D7\u05D3\u05E8\u05D9\u05DD?"
        commands:
        - rid: 2649295605456437343
    - rid: 2649295605456437327
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D6\u05D0\u05EA \u05D0\u05D5\u05DE\u05E8\u05EA? \u05D7\u05D5\u05E5
          \u05DE\u05D0\u05DC\u05D4 \u05E9\u05E0\u05D9\u05E7\u05D5 \u05D0\u05EA \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD,
          \u05DB\u05D5\u05DC\u05DD \u05D4\u05D9\u05D5 \u05D0\u05DE\u05D5\u05E8\u05D9\u05DD
          \u05DC\u05D4\u05D9\u05D5\u05EA \u05D1\u05D7\u05D3\u05E8\u05D9\u05DD \u05D5\u05DC\u05E0\u05E7\u05D5\u05EA,
          \u05DC\u05D0?"
        commands:
        - rid: 2649295605456437344
    - rid: 2649295605456437328
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D6\u05D4 \u05D4\u05E7\u05D5\u05E0\u05E6\u05E4\u05D8,
          \u05DC\u05DE\u05E7\u05E8\u05D4 \u05E9\u05DC\u05D0 \u05D4\u05D1\u05E0\u05EA."
        commands:
        - rid: 2649295605456437345
    - rid: 2649295605456437329
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05DB\u05D0\u05D5\u05E8\u05D4, \u05D6\u05D4 \u05D4\u05D9\u05D4
          \u05D0\u05DE\u05D5\u05E8 \u05DC\u05D4\u05D9\u05D5\u05EA \u05D4\u05DE\u05E6\u05D1.
          \u05D0\u05D1\u05DC \u05DE\u05D5\u05E7\u05D3\u05DD \u05D9\u05D5\u05EA\u05E8,
          \u05D0\u05E8\u05D9\u05D0\u05DC \u05D0\u05DE\u05E8 \u05DC\u05D9 \u05DE\u05E9\u05D4\u05D5
          \u05DE\u05E2\u05E0\u05D9\u05D9\u05DF."
        commands:
        - rid: 2649295605456437346
    - rid: 2649295605456437330
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D4\u05D5\u05D0 \u05D4\u05DC\u05DA \u05DC\u05D4\u05D1\u05D9\u05D0
          \u05E6\u05D9\u05D5\u05D3, \u05D5\u05E4\u05E9\u05D5\u05D8 \u05DC\u05D0 \u05D7\u05D6\u05E8\u2026
          \u05D4\u05E4\u05E2\u05DD \u05D4\u05E8\u05D0\u05E9\u05D5\u05E0\u05D4 \u05E9\u05E8\u05D0\u05D9\u05EA\u05D9
          \u05D0\u05D5\u05EA\u05D5 \u05DE\u05D0\u05D6 \u05D4\u05D9\u05D9\u05EA\u05D4
          \u05DB\u05E9\u05D1\u05D0\u05E0\u05D5 \u05DC\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD
          \u05D0\u05D7\u05E8\u05D9 \u05D4\u05D4\u05D5\u05D3\u05E2\u05D4 \u05E2\u05DC
          \u05D4\u05D2\u05D5\u05E4\u05D4."
        commands:
        - rid: 2649295605456437347
    - rid: 2649295605456437331
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05D6\u05D4 \u05E0\u05DB\u05D5\u05DF, \u05D0\u05D6 \u05DB\u05E4\u05D9\u05E8
          \u05DC\u05D0 \u05D4\u05D9\u05D4 \u05D1\u05D2\u05DC\u05E2\u05D3 \u05D1\u05D6\u05DE\u05DF
          \u05D4\u05D0\u05DC\"\u05D1!"
        commands:
        - rid: 2649295605456437348
        - rid: 2649295605456437349
    - rid: 2649295605456437332
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05E2\u05D9\u05D3
          \u05E9\u05D0\u05DB\u05DF \u05D4\u05E2\u05D3\u05EA\u05D9 \u05D0\u05EA \u05D6\u05D4!"
        commands:
        - rid: 2649295605456437350
    - rid: 2649295605456437333
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DC\u05D0 \u05E2\u05D5\u05E7\u05D1\u05EA. \u05D0\u05D6
          \u05DE\u05D4?"
        commands:
        - rid: 2649295605456437351
    - rid: 2649295605456437334
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05DB\u05E4\u05D9\u05E8 \u05DC\u05D0 \u05D4\u05D9\u05D4
          \u05D1\u05D2\u05DC\u05E2\u05D3, \u05D0\u05D6 \u05DC\u05D0 \u05DC\u05DB\u05D5\u05DC\u05DD
          \u05D9\u05E9 \u05D0\u05DC\u05D9\u05D1\u05D9. \u05D6\u05D4 \u05D0\u05D5\u05DE\u05E8
          \u05E9-"
        commands:
        - rid: 2649295605456437352
    - rid: 2649295605456437335
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D5\u05D0\u05E0\u05D4 \u05D9\u05D6\u05D9\u05DF! \u05DE\u05D4
          \u05E0\u05E4\u05DC\u05EA \u05E2\u05DC\u05D9\u05D9?"
        commands:
        - rid: 2649295605456437342
        - rid: 2649295605456437353
        - rid: 2649295605456437359
    - rid: 2649295605456437336
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05E4\u05D9\u05E8\u2026?)"
        commands: []
    - rid: 2649295605456437337

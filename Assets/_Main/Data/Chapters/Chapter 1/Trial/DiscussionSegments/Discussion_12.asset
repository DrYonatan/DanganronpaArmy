    - rid: 2649295605456437874
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D6\u05D4 \u05D1\u05D3\u05D9\u05D5\u05E7 \u05DE\u05D4 \u05E9\u05DB\u05EA\u05D5\u05D1
          \u05E2\u05DC \u05D0\u05D7\u05D3 \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA
          \u05D1\u05E8\u05DB\u05D6\u05EA!"
        commands: []
    - rid: 2649295605456437875
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D0\u05EA\u05D4 \u05D1\u05E2\u05E6\u05DD \u05D0\u05D5\u05DE\u05E8
          \u05E9\u05D4\u05E6\u05D9\u05E0\u05D5\u05E8 \u05E9\u05E8\u05E9\u05D5\u05DD
          \u05E2\u05DC\u05D9\u05D5 *4-UG* \u05D1\u05E8\u05DB\u05D6\u05EA \u05D4\u05D5\u05D0
          \u05D6\u05D4 \u05E9\u05E2\u05D5\u05D1\u05E8 \u05DE\u05E2\u05DC \u05D4\u05D0\u05E8\u05D9\u05D7\u05D9\u05DD
          \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9 \u05D1\u05E0\u05D5\u05EA?"
        commands: []
    - rid: 2649295605456437876
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF."
        commands: []
    - rid: 2649295605456437877
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DE\u05D0\u05DC\u05D4, \u05D1\u05D7\u05D9\u05D9\u05DD \u05DC\u05D0
          \u05D4\u05D9\u05D9\u05EA\u05D9 \u05E2\u05D5\u05DC\u05D4 \u05E2\u05DC \u05D6\u05D4.
          \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D0\u05D9\u05E0\u05D2\u05DC\u05D9\u05E9
          \u05E1\u05E4\u05D9\u05E7\u05E8."
        commands: []
    - rid: 2649295605456437878
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05E8\u05D2\u05E2, \u05D0\u05DD \u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA
          \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8 \u05D4\u05D6\u05D4, \u05D0\u05E0\u05D7\u05E0\u05D5
          \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD \u05DC\u05E8\u05D0\u05D5\u05EA \u05DC\u05D0\u05DF
          \u05D4\u05D5\u05D0 \u05DE\u05EA\u05D7\u05D1\u05E8!"
        commands: []
    - rid: 2649295605456437879
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DC\u05D0\u05DF \u05D4\u05D5\u05D0 \u05DE\u05EA\u05D7\u05D1\u05E8\u2026
          \u05D6\u05D4 \u05E8\u05E7 \u05E2\u05E0\u05D9\u05D9\u05DF \u05E9\u05DC \u05DC\u05E2\u05E7\u05D5\u05D1
          \u05D0\u05D7\u05E8\u05D9 \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA.)"
        commands: []
    - rid: 2649295605456437881
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05E6\u05D9\u05E0\u05D5\u05E8 \u05D4\u05D6\u05D4 \u05DE\u05EA\u05D7\u05D1\u05E8
          \u05DC\u05E6\u05D9\u05E0\u05D5\u05E8 *01-BB*."
        commands: []
    - rid: 2649295605456437882
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05DB\u05D5\u05DF! \u05D0\u05E0\u05D9 \u05E8\u05D5\u05D0\u05D4
          \u05E9\u05D6\u05D4 \u05DE\u05EA\u05D7\u05D1\u05E8 \u05DC\u05E9\u05DD."
        commands: []
    - rid: 2649295605456437883
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D0\u05D9\u05DA \u05D6\u05D4 \u05E2\u05D5\u05D6\u05E8
          \u05DC\u05E0\u05D5? \u05D0\u05E0\u05D7\u05E0\u05D5 \u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2\u05D9\u05DD
          \u05DE\u05D4 \u05D6\u05D4 \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8 *01-BB*
          \u05D4\u05D6\u05D4, \u05D5\u05DC\u05D0 \u05DB\u05EA\u05D5\u05D1\u05D9\u05DD
          \u05E2\u05D5\u05D3 \u05E9\u05DE\u05D5\u05EA \u05E2\u05DC \u05D4\u05D3\u05D9\u05D0\u05D2\u05E8\u05DE\u05D4\u2026"
        commands: []
    - rid: 2649295605456437884
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D7\u05E0\u05D5 \u05D0\u05DE\u05E0\u05DD \u05DC\u05D0
          \u05D9\u05D5\u05D3\u05E2\u05D9\u05DD \u05DC\u05D0\u05DF \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8
          *01-BB* \u05DE\u05EA\u05D7\u05D1\u05E8, \u05D0\u05D1\u05DC \u05D0\u05D5\u05DC\u05D9
          \u05D0\u05E0\u05D7\u05E0\u05D5 \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD \u05DC\u05E9\u05DC\u05D5\u05DC
          \u05D7\u05DC\u05E7 \u05DE\u05D4\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA
          \u05D1\u05E2\u05D6\u05E8\u05EA \u05D4\u05EA\u05E8\u05E9\u05D9\u05DD."
        commands: []
    - rid: 2649295605456437885
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05DB\u05D5\u05DF. \u05D0\u05E4\u05E9\u05E8 \u05DC\u05E8\u05D0\u05D5\u05EA
          \u05E9\u05D9\u05E9 \u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD
          \u05E9\u05DC\u05D0 \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD \u05DC\u05D4\u05EA\u05D7\u05D1\u05E8
          \u05DC\u05E6\u05D9\u05E0\u05D5\u05E8 \u05D4\u05D6\u05D4."
        commands: []
    - rid: 2649295605456437887
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05D4 \u05DE\u05D3\u05D1\u05E8 \u05E2\u05DC \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA
          \u05E9\u05DC \u05D4\u05DE\u05E7\u05DC\u05D7\u05D5\u05EA \u05D5\u05D4\u05DB\u05D9\u05D5\u05E8\u05D9\u05DD,
          \u05E0\u05DB\u05D5\u05DF?"
        commands: []
    - rid: 2649295605456437888
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF. \u05D1\u05EA\u05E8\u05E9\u05D9\u05DD \u05D0\u05E4\u05E9\u05E8
          \u05DC\u05E8\u05D0\u05D5\u05EA \u05E9\u05D4\u05DD \u05D1\u05DB\u05DC\u05DC
          \u05D4\u05D5\u05DC\u05DB\u05D9\u05DD \u05DC\u05DB\u05D9\u05D5\u05D5\u05DF
          \u05D4\u05D4\u05E4\u05D5\u05DA, \u05DB\u05DC\u05D5\u05DE\u05E8 \u05D4\u05DD
          \u05DC\u05D0 \u05DE\u05EA\u05D7\u05D1\u05E8\u05D9\u05DD \u05DC\u05E8\u05DB\u05D6\u05EA.
          \u05D0\u05D6 \u05D4\u05DD \u05D1\u05D1\u05D9\u05E8\u05D5\u05E8 \u05DC\u05D0
          \u05E8\u05DC\u05D5\u05D5\u05E0\u05D8\u05D9\u05DD."
        commands: []
    - rid: 2649295605456437889
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D6\u05D4 \u05DE\u05E9\u05D0\u05D9\u05E8 \u05D0\u05D5\u05EA\u05E0\u05D5
          \u05E2\u05DD \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA \u05E9\u05DE\u05EA\u05D7\u05EA
          \u05DC\u05EA\u05D0\u05D9\u05DD \u05D5\u05D4\u05E6\u05D9\u05E0\u05D5\u05E8
          \u05E9\u05E2\u05D5\u05D1\u05E8 \u05DE\u05E2\u05DC \u05D4\u05EA\u05D0\u05D9\u05DD\u2026
          \u05D0\u05D9\u05DA \u05D0\u05E0\u05D7\u05E0\u05D5 \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD
          \u05DC\u05D3\u05E2\u05EA \u05D0\u05D9\u05D6\u05D4 \u05DE\u05D4\u05DD \u05D6\u05D4?"
        commands: []
    - rid: 2649295605456437890
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D7\u05E0\u05D5 \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD
          \u05DC\u05E9\u05DC\u05D5\u05DC \u05E6\u05D9\u05E0\u05D5\u05E8 \u05E0\u05D5\u05E1\u05E3
          \u05E2\u05DD \u05D5\u05D3\u05D0\u05D5\u05EA \u05D9\u05D7\u05E1\u05D9\u05EA
          \u05D2\u05D1\u05D5\u05D4\u05D4."
        commands: []
    - rid: 2649295605456437891
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DA \u05EA\u05E2\u05E9\u05D9 \u05D0\u05EA \u05D6\u05D4
          \u05D7\u05D9\u05D9\u05DD? \u05DC\u05D0 \u05DB\u05EA\u05D5\u05D1 \u05DB\u05DC\u05D5\u05DD
          \u05E2\u05DC \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA \u05D1\u05EA\u05E8\u05E9\u05D9\u05DD
          \u05E9\u05DC \u05D4\u05D1\u05E0\u05D9\u05DD.\r\n "
        commands: []
    - rid: 2649295605456437893
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9 \u05D0\u05E4\u05E9\u05E8 \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05D1\u05D8\u05D5\u05D7\u05D9\u05DD, \u05D0\u05D1\u05DC \u05E1\u05D1\u05D9\u05E8
          \u05DC\u05D4\u05E0\u05D9\u05D7 \u05E9\u05D4\u05E6\u05D9\u05E0\u05D5\u05E8
          \u05E9\u05E2\u05D5\u05D1\u05E8 \u05DE\u05E2\u05DC \u05D4\u05EA\u05D0\u05D9\u05DD
          \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9 \u05D1\u05E0\u05D9\u05DD \u05D4\u05D5\u05D0
          \u05DC\u05D0 *01-BB*."
        commands: []
    - rid: 2649295605456437894
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DA \u05D0\u05EA\u05D4 \u05D9\u05D5\u05D3\u05E2?"
        commands: []
    - rid: 2649295605456437895
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05D5\u05EA\u05E8 \u05E0\u05DB\u05D5\u05DF \u05DC\u05D5\u05DE\u05E8,
          \u05E9\u05D9\u05E9 \u05E6\u05D9\u05E0\u05D5\u05E8 \u05E9\u05D0\u05E0\u05D7\u05E0\u05D5
          \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD \u05DC\u05D4\u05E0\u05D9\u05D7 \u05E9\u05D4\u05D5\u05D0
          \u05DB\u05DF *8-UB*."
        commands: []
    - rid: 2649295605456437896
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4\u05EA\u05E8\u05E9\u05D9\u05DD \u05D0\u05E0\u05D7\u05E0\u05D5
          \u05D9\u05D5\u05D3\u05E2\u05D9\u05DD \u05E94-UG \u05D4\u05D5\u05D0 \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8
          \u05E9\u05E2\u05D5\u05D1\u05E8 \u05DE\u05E2\u05DC \u05D4\u05EA\u05D0\u05D9\u05DD
          \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9 \u05D1\u05E0\u05D5\u05EA. \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8
          \u05D4\u05D6\u05D4 \u05D4\u05D5\u05D0 \u05D4\u05D9\u05D7\u05D9\u05D3 \u05E2\u05DD
          \u05D0\u05D5\u05EA\u05D5 \u05E4\u05D5\u05E8\u05DE\u05D0\u05D8 \u05D1\u05E9\u05DD
          \u05E9\u05DC\u05D5."
        commands: []
    - rid: 2649295605456437897
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D7\u05D5\u05E5 \u05DE\u05D6\u05D4, \u05D1\u05D4\u05E0\u05D7\u05D4
          \u05E9\u05D4G \u05D1\u05D0\u05D4 \u05DC\u05D5\u05DE\u05E8 slrig, \u05E8\u05E7
          \u05D4\u05D2\u05D9\u05D5\u05E0\u05D9 \u05E98-UB \u05D4\u05D5\u05D0 \u05D4\u05DE\u05E7\u05D1\u05D9\u05DC
          \u05E9\u05DC\u05D5 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9 \u05D1\u05E0\u05D9\u05DD,
          \u05D5\u05D4B \u05D4\u05D9\u05D0 \u05E2\u05D1\u05D5\u05E8 syob."
        commands: []
    - rid: 2649295605456437898
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05D0\u05EA\u05D4 \u05D2\u05D0\u05D5\u05DF
          \u05D1\u05E8\u05D2\u05E8."
        commands: []
    - rid: 2649295605456437899
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05DB\u05DB\u05D4, \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8
          *01-BB* \u05E6\u05E8\u05D9\u05DA \u05DC\u05D4\u05D9\u05D5\u05EA \u05D0\u05D7\u05D3
          \u05DE\u05D4\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA \u05E9\u05DE\u05EA\u05D7\u05EA
          \u05DC\u05EA\u05D0\u05D9\u05DD."
        commands: []
    - rid: 2649295605456437900
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D4\u05E8\u05D5\u05E6\u05D7 \u05D7\u05D9\u05D1\u05E8
          \u05D0\u05EA \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8 \u05E9\u05DE\u05E2\u05DC
          \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9 \u05D1\u05E0\u05D5\u05EA \u05DC\u05E6\u05D9\u05E0\u05D5\u05E8
          \u05E9\u05DC \u05D0\u05D7\u05D3 \u05D4\u05EA\u05D0\u05D9\u05DD \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9
          \u05D1\u05E0\u05D9\u05DD?"
        commands: []
    - rid: 2649295605456437901
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D4\u05D4\u05E9\u05DC\u05DB\u05D5\u05EA \u05E9\u05DC
          \u05E4\u05E2\u05D5\u05DC\u05D4 \u05DB\u05D6\u05D0\u05EA\u2026?"
        commands: []
    - rid: 2649295605456437902
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D2\u05D5\u05E8\u05DD \u05E9\u05D4\u05D6\u05E8\u05D9\u05DE\u05D4
          \u05DC\u05D0 \u05EA\u05D2\u05D9\u05E2 \u05DC\u05D1\u05E8\u05D6 \u05E9\u05DC
          \u05D4\u05E6\u05E0\u05E8\u05EA, \u05E9\u05D6\u05D4 \u05DE\u05D4 \u05E9\u05E8\u05D0\u05D9\u05E0\u05D5
          \u05E9\u05E7\u05E8\u05D4."
        commands: []
    - rid: 2649295605456437903
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D2\u05DD \u05D0\u05D5\u05DE\u05E8 \u05E9\u05DB\u05D0\u05E9\u05E8
          \u05DE\u05D5\u05E8\u05D9\u05D3\u05D9\u05DD \u05D0\u05EA \u05D4\u05DE\u05D9\u05DD
          \u05D1\u05EA\u05D0 \u05D4\u05DE\u05D3\u05D5\u05D1\u05E8, \u05D1\u05DE\u05E7\u05D5\u05DD
          \u05DC\u05E8\u05D3\u05EA \u05DC\u05D1\u05D9\u05D5\u05D1 \u05D4\u05DD \u05D4\u05D5\u05DC\u05DB\u05D9\u05DD
          \u05DC\u05E6\u05D9\u05E0\u05D5\u05E8 \u05E9\u05DE\u05E2\u05DC \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9
          \u05D1\u05E0\u05D5\u05EA."
        commands: []
    - rid: 2649295605456437904
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D6\u05D4 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D2\u05E8\u05D5\u05DD
          \u05DC\u05E2\u05D5\u05DE\u05E1 \u05DE\u05D9\u05DD \u05D1\u05E6\u05D9\u05E0\u05D5\u05E8!"
        commands: []
    - rid: 2649295605456437905
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DB\u05DC \u05E9\u05D0\u05E0\u05D7\u05E0\u05D5 \u05DE\u05D3\u05D1\u05E8\u05D9\u05DD
          \u05E2\u05DC \u05D6\u05D4, \u05D6\u05D4 \u05D9\u05D5\u05EA\u05E8 \u05DE\u05E4\u05EA\u05D9\u05E2
          \u05E9\u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD \u05D4\u05D0\u05DC\u05D4
          \u05DC\u05D0 \u05D4\u05EA\u05E4\u05E8\u05E7\u05D5 \u05DE\u05D6\u05DE\u05DF\u2026"
        commands: []
    - rid: 2649295605456437906
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05D4\u05D0\u05E8\u05D9\u05D7 \u05D4\u05D9\u05D4 \u05DE\u05E9\u05D5\u05D7\u05E8\u05E8,
          \u05E8\u05D8\u05D8 \u05D1\u05E6\u05D9\u05E0\u05D5\u05E8 \u05E9\u05E2\u05D5\u05D1\u05E8
          \u05DE\u05E2\u05DC\u05D9\u05D5 \u05D4\u05D9\u05D4 \u05D9\u05DB\u05D5\u05DC
          \u05DC\u05D2\u05E8\u05D5\u05DD \u05DC\u05D5 \u05DC\u05D9\u05E4\u05D5\u05DC.
          \u05D1\u05E2\u05D6\u05E8\u05EA \u05D4\u05D7\u05D9\u05D1\u05D5\u05E8 \u05D4\u05D6\u05D4
          \u05E9\u05DC \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA, \u05D4\u05D5\u05E8\u05D3\u05EA
          \u05DE\u05D9\u05DD \u05E4\u05E9\u05D5\u05D8\u05D4 \u05D9\u05DB\u05D5\u05DC\u05D4
          \u05DC\u05D4\u05E4\u05D9\u05DC \u05D0\u05EA \u05D4\u05D0\u05E8\u05D9\u05D7
          \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD \u05D4\u05D0\u05D7\u05E8\u05D9\u05DD!"
        commands: []
    - rid: 2649295605456437907
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05E8\u05D2\u05E2, \u05D2\u05DD \u05D0\u05DD \u05D4\u05D9\u05D4

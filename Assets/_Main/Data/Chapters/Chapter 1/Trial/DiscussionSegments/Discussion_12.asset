    - rid: 2649295605456437859
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05E0\u05DB\u05D5\u05DF \u05E9\u05D4\u05E8\u05DB\u05D6\u05EA
          \u05D4\u05D6\u05D0\u05EA \u05E0\u05E8\u05D0\u05D9\u05EA \u05DB\u05DE\u05D5
          \u05D1\u05DC\u05D0\u05D2\u05DF \u05E9\u05DC \u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA\u2026"
        commands: []
    - rid: 2649295605456437860
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D9\u05E9 \u05D3\u05E8\u05DA \u05DC\u05D3\u05E2\u05EA
          \u05D0\u05D9\u05D6\u05D4 \u05E6\u05D9\u05E0\u05D5\u05E8 \u05D4\u05D5\u05D0
          \u05D4\u05D0\u05D7\u05D3 \u05E9\u05E2\u05D5\u05D1\u05E8 \u05DE\u05E2\u05DC
          \u05D4\u05D0\u05E8\u05D9\u05D7."
        commands:
        - rid: 2649295605456437910
    - rid: 2649295605456437861
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05D5 \u05D0\u05D6 \u05D0\u05DC \u05EA\u05E9\u05D0\u05D9\u05E8
          \u05D0\u05D5\u05EA\u05D9 \u05D1\u05DE\u05EA\u05D7, \u05DE\u05D4 \u05D4\u05D3\u05E8\u05DA?"
        commands: []
    - rid: 2649295605456437862
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D9\u05D5\u05D0\u05D1, \u05EA\u05DC\u05D5\u05D9\u05D9\u05DD
          \u05E2\u05DC \u05D4\u05E7\u05D9\u05E8 \u05E9\u05E8\u05D8\u05D5\u05D8\u05D9\u05DD
          \u05E9\u05DC \u05D7\u05D3\u05E8\u05D9\u05DD \u05E9\u05D5\u05E0\u05D9\u05DD
          \u05D1\u05D1\u05E1\u05D9\u05E1. \u05E9\u05DD \u05DE\u05E6\u05D0\u05EA\u05D9
          \u05D0\u05EA \u05D4\u05E4\u05EA\u05E7\u05D9\u05DD \u05E9\u05E4\u05D9\u05E8\u05D8\u05D5
          \u05E2\u05DC \u05D4\u05E6\u05E0\u05E8\u05EA \u05E9\u05DC \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD."
        commands: []
    - rid: 2649295605456437863
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05DE\u05D4 \u05DC\u05D2\u05D1\u05D9\u05D4\u05DD? \u05DB\u05D1\u05E8
          \u05D3\u05D9\u05D1\u05E8\u05E0\u05D5 \u05E2\u05DC \u05D4\u05E4\u05EA\u05E7\u05D9\u05DD."
        commands: []
    - rid: 2649295605456437864
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D9\u05DF \u05D4\u05E9\u05E8\u05D8\u05D5\u05D8\u05D9\u05DD,
          \u05D9\u05E9 \u05D2\u05DD \u05E9\u05E8\u05D8\u05D5\u05D8 \u05E9\u05DC \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD.\r"
        commands: []
    - rid: 2649295605456437865
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DC\u05D5 \u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD?
          \u05D9\u05E9 \u05E9\u05E0\u05D9\u05D9\u05DD."
        commands: []
    - rid: 2649295605456437867
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05E9\u05E8\u05D8\u05D5\u05D8 \u05E9\u05DC \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9
          \u05D1\u05E0\u05D5\u05EA, \u05D0\u05E4\u05E9\u05E8 \u05DC\u05E8\u05D0\u05D5\u05EA
          \u05D0\u05EA \u05D6\u05D4 \u05DC\u05E4\u05D9 \u05D4\u05DB\u05D9\u05D5\u05D5\u05DF
          \u05E9\u05DC \u05D4\u05EA\u05D0\u05D9\u05DD. \u05D4\u05E8\u05D9 \u05E9\u05E0\u05D9
          \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD \u05D4\u05DD \u05EA\u05DE\u05D5\u05E0\u05EA
          \u05DE\u05E8\u05D0\u05D4 \u05D0\u05D7\u05D3 \u05E9\u05DC \u05D4\u05E9\u05E0\u05D9."
        commands: []
    - rid: 2649295605456437868
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D1\u05E9\u05E8\u05D8\u05D5\u05D8 \u05D4\u05D6\u05D4 \u05D0\u05E4\u05E9\u05E8
          \u05DC\u05E8\u05D0\u05D5\u05EA \u05D0\u05EA \u05DB\u05DC \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA
          \u05E9\u05DC \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD."
        commands: []
    - rid: 2649295605456437869
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E4\u05E9\u05E8 \u05DC\u05DE\u05E9\u05DC \u05DC\u05E8\u05D0\u05D5\u05EA
          \u05E9\u05DB\u05DC \u05D0\u05E1\u05DC\u05D4 \u05DE\u05D5\u05D1\u05D9\u05DC\u05D4
          \u05DC\u05E6\u05D9\u05E0\u05D5\u05E8 \u05DE\u05E9\u05DC\u05D4, \u05D5\u05E9\u05D9\u05E9
          \u05E6\u05D9\u05E0\u05D5\u05E8 \u05E9\u05E2\u05D5\u05D1\u05E8 \u05DE\u05E2\u05DC
          \u05D4\u05EA\u05D0\u05D9\u05DD."
        commands: []
    - rid: 2649295605456437870
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05E2\u05DC \u05D4\u05EA\u05D0\u05D9\u05DD!"
        commands: []
    - rid: 2649295605456437871
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D3\u05D9\u05D5\u05E7. \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8
          \u05D4\u05E2\u05DC\u05D9\u05D5\u05DF \u05D1\u05D3\u05D9\u05D0\u05D2\u05E8\u05DE\u05D4
          \u05D4\u05D6\u05D0\u05EA \u05D7\u05D9\u05D9\u05D1 \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8 \u05E9\u05E2\u05D5\u05D1\u05E8 \u05DE\u05E2\u05DC
          \u05D4\u05D0\u05E8\u05D9\u05D7 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9
          \u05D1\u05E0\u05D5\u05EA."
        commands: []
    - rid: 2649295605456437872
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D0\u05DD \u05E0\u05E9\u05D9\u05DD \u05DC\u05D1\u2026 \u05E0\u05E8\u05D0\u05D4
          \u05E9\u05DB\u05EA\u05D5\u05D1 \u05DE\u05E9\u05D4\u05D5 \u05DC\u05D9\u05D3\u05D5."
        commands: []
    - rid: 2649295605456437873
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "*4-UG*\u2026"
        commands:

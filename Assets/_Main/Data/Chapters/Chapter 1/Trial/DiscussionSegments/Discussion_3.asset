    - rid: 6008430398466949125
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "<G\u05E2\u05D3 \u05E2\u05DB\u05E9\u05D9\u05D5, \u05D4\u05D9\u05D9\u05EA\u05D4
          \u05D8\u05E2\u05D5\u05E0\u05D4 \u05E8\u05E7 \u05E8\u05D0\u05D9\u05D4 \u05D0\u05D7\u05EA

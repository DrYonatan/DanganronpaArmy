    - rid: 2649295587089055845
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D2\u05E2 \u05D0\u05E8\u05D9\u05D0\u05DC, \u05D0\u05E0\u05D7\u05E0\u05D5
          \u05D9\u05D5\u05D3\u05E2\u05D9\u05DD \u05DE\u05D4 \u05D4\u05D9\u05D4 \u05D4\u05E0\u05E9\u05E7."
        commands:
        - rid: 2649295587089055858
        - rid: 6008430257998659588
    - rid: 2649295587089055846
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D9\u05D3 \u05E8\u05D5\u05E2\u05D9, \u05DE\u05E6\u05D0\u05E0\u05D5
          \u05D0\u05EA \u05D4\u05D0\u05E8\u05D9\u05D7 \u05D4\u05D6\u05D4, \u05D5\u05D0\u05E4\u05D9\u05DC\u05D5
          \u05D9\u05E9 \u05E2\u05DC\u05D9\u05D5 \u05D3\u05DD."
        commands:
        - rid: 2649295587089055859
        - rid: 6008430257998659595
    - rid: 2649295587089055847
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D0\u05EA\u05D4 \u05D0\u05D5\u05DE\u05E8 \u05E9\u05D4\u05E8\u05D5\u05E6\u05D7
          \u05D4\u05E9\u05EA\u05DE\u05E9 \u05D1\u05D6\u05D4?"
        commands:
        - rid: 2649295587089055861
        - rid: 6008430257998659596
    - rid: 2649295587089055848
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05DF \u05D4\u05E1\u05EA\u05DD \u05E9\u05D6\u05D4 \u05DE\u05D4
          \u05E9\u05D4\u05D5\u05D0 \u05D0\u05D5\u05DE\u05E8. \u05D4\u05E1\u05EA\u05DB\u05DC\u05EA
          \u05D0\u05E4\u05D9\u05DC\u05D5 \u05E2\u05DC \u05D6\u05D9\u05E8\u05EA \u05D4\u05E4\u05E9\u05E2?"
        commands:
        - rid: 2649295587089055862
    - rid: 2649295587089055849
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05DE\u05DF \u05D4\u05E1\u05EA\u05DD \u05E9\u05D9\u05D3\u05E2\u05EA\u05D9
          \u05E9\u05D4\u05D0\u05E8\u05D9\u05D7 \u05D4\u05D6\u05D4 \u05D4\u05D5\u05D0
          \u05D4\u05E0\u05E9\u05E7! \u05E1\u05EA\u05DD \u05D7\u05E9\u05D1\u05EA\u05D9
          \u05E9\u05D6\u05D4 \u05D9\u05D4\u05D9\u05D4 \u05DE\u05E6\u05D7\u05D9\u05E7
          \u05DC\u05D5\u05DE\u05E8 \u05E9\u05D6\u05D4 \u05DE\u05E9\u05D4\u05D5 \u05D0\u05D7\u05E8."
        commands:
        - rid: 2649295587089055863
    - rid: 2649295587089055850
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 2649295587089055851
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D8\u05D5\u05D1, \u05D6\u05D4 \u05D4\u05D9\u05D4 \u05D3\u05D9 \u05D1\u05E8\u05D5\u05E8\u2026
          \u05DE\u05D4 \u05DE\u05DB\u05D0\u05DF?"
        commands:
        - rid: 2649295587089055864
        - rid: 6008430257998659590
    - rid: 2649295587089055852
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DC\u05D0 \u05DE\u05D1\u05D9\u05E0\u05D4 \u05DE\u05D4
          \u05DC\u05D0 \u05D1\u05E8\u05D5\u05E8. \u05D6\u05D4 \u05D0\u05DC\u05D5\u05DF,
          \u05D4\u05D5\u05D0 \u05D4\u05D9\u05D7\u05D9\u05D3 \u05E9\u05D4\u05D9\u05D4
          \u05D0\u05D9\u05EA\u05D5 \u05E9\u05DD!"
        commands:
        - rid: 2649295587089055865
        - rid: 6008430257998659591
    - rid: 2649295587089055853
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05DC\u05D0 \u05E7\u05E6\u05EA \u05DE\u05D5\u05E7\u05D3\u05DD
          \u05DB\u05D3\u05D9 \u05DC\u05E7\u05D1\u05D5\u05E2 \u05D0\u05EA \u05D6\u05D4?"
        commands:
        - rid: 2649295587089055866
    - rid: 2649295587089055854
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05E1\u05DB\u05D9\u05DD \u05E9\u05D4\u05D7\u05E9\u05D5\u05D3
          \u05D4\u05DE\u05E8\u05DB\u05D6\u05D9 \u05E4\u05D4 \u05D4\u05D5\u05D0 \u05D0\u05DC\u05D5\u05DF."
        commands:
        - rid: 2649295587089055867
    - rid: 2649295587089055855
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05D0\u05DC\u05DC\u05D4 \u05D0\u05DC\u05D5\u05DF \u05DC\u05D0
          \u05DC\u05D4\u05DE\u05E6\u05D9\u05D0!"
        commands:
        - rid: 2649295587089055868
    - rid: 2649295587089055856
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(...\u05D4\u05DD \u05E2\u05D3\u05D9\u05D9\u05DF \u05D7\u05D5\u05E9\u05D3\u05D9\u05DD
          \u05D1\u05D9.)"
        commands: []
    - rid: 2649295587089055857
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E0\u05D9 \u05D1\u05D0\u05DE\u05EA \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05D4\u05D9\u05D7\u05D9\u05D3 \u05D0\u05D9\u05EA\u05D5 \u05E9\u05DD\u2026
          \u05D0\u05D1\u05DC \u05D0\u05E0\u05D9 \u05D7\u05D9\u05D9\u05D1 \u05DC\u05D4\u05E8\u05D0\u05D5\u05EA
          \u05DC\u05D4\u05DD \u05E9\u05D6\u05D4 \u05DC\u05D0 \u05D0\u05E0\u05D9!)"
        commands:
        - rid: 2649295587089055869

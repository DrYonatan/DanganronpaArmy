          \u05DC\u05DB\u05DD \u05DB\u05DE\u05D4 \u05E8\u05D0\u05D9\u05D5\u05EA \u05D0\u05E4\u05E9\u05E8\u05D9\u05D5\u05EA,
          \u05E9\u05EA\u05D5\u05DB\u05DC\u05D5 \u05DC\u05D4\u05D7\u05DC\u05D9\u05E3
          \u05D1\u05D9\u05E0\u05D9\u05D4\u05DF.>"

    - rid: 2649295605456438263
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA \u05E6\u05D5\u05D3\u05E7\u05EA \u05DE\u05D0\u05D9\u05D4,
          \u05D0\u05DD \u05DE\u05D9\u05E9\u05D4\u05D5 \u05D4\u05D9\u05D4 \u05DE\u05D5\u05E8\u05D9\u05D3
          \u05D0\u05EA \u05D4\u05DE\u05D9\u05DD \u05D1\u05EA\u05D0 \u05D4\u05D6\u05D4
          \u05DC\u05E4\u05E0\u05D9 \u05D4\u05D6\u05DE\u05DF, \u05D6\u05D4 \u05D4\u05D9\u05D4
          \u05D4\u05D5\u05E8\u05E1 \u05D4\u05DB\u05DC."
        commands:
        - rid: 6008430280376320093
    - rid: 2649295605456438264
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05D4 \u05E8\u05D5\u05D0\u05D4? \u05DB\u05DC \u05D4\u05EA\u05D5\u05DB\u05E0\u05D9\u05EA
          \u05D4\u05D6\u05D0\u05EA \u05EA\u05DC\u05D5\u05D9\u05D4 \u05D1\u05DE\u05D6\u05DC.
          \u05DC\u05DE\u05D4 \u05E9\u05DE\u05D9\u05E9\u05D4\u05D5 \u05D9\u05D1\u05E0\u05D4
          \u05E2\u05DC \u05D6\u05D4?"
        commands: []
    - rid: 2649295605456438265
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D5\u05DC\u05D9 \u05D4\u05D9\u05D0 \u05D1\u05E2\u05E6\u05DD
          \u05E8\u05E2\"\u05E6\u05D9\u05EA \u05DE\u05D6\u05DC?"
        commands: []
    - rid: 2649295605456438266
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D1\u05D3\u05D9\u05D5\u05E7 \u05D1\u05E9\u05D1\u05D9\u05DC
          \u05D6\u05D4, \u05D0\u05EA \u05DE\u05E6\u05D0\u05EA \u05D3\u05E8\u05DA
          \u05DC\u05D5\u05D5\u05D3\u05D0 \u05E9\u05D0\u05E3 \u05D0\u05D7\u05D3 \u05DC\u05D0
          \u05D9\u05D5\u05E8\u05D9\u05D3 \u05D0\u05EA \u05D4\u05DE\u05D9\u05DD \u05D1\u05EA\u05D0
          \u05D4\u05D6\u05D4."
        commands: []
    - rid: 2649295605456438267
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DC \u05DE\u05D9 \u05E9\u05D1\u05D9\u05E7\u05E8 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD
          \u05DC\u05D0\u05D7\u05E8\u05D5\u05E0\u05D4 \u05D1\u05D8\u05D7 \u05D6\u05D5\u05DB\u05E8\u2026
          \u05D0\u05EA \u05D4\u05E9\u05DC\u05D8\u05D9\u05DD \u05D4\u05D0\u05DC\u05D4."
        commands:
        - rid: 2649295747132948499
    - rid: 2649295605456438268
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05DB\u05D5\u05DF, \u05D4\u05D9\u05D4 \u05E9\u05DC\u05D8 \u05E2\u05DC
          \u05D0\u05D7\u05D3 \u05D4\u05EA\u05D0\u05D9\u05DD\u2026 \u05D4\u05D5\u05D0
          \u05D0\u05DE\u05E8 \u05E9\u05D4\u05EA\u05D0 \u05DC\u05D0 \u05EA\u05E7\u05D9\u05DF."
        commands:
        - rid: 2649295747132948501
    - rid: 2649295605456438269
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05DB\u05E9\u05E9\u05D0\u05DC\u05EA\u05D9 \u05D0\u05EA
          \u05D4\u05EA\u05D9\u05E0\u05D5\u05E7 \u05DC\u05D2\u05D1\u05D9 \u05D6\u05D4\u2026"
        commands: []
    - rid: 2649295605456438270
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2 \u05DE\u05D4 \u05D6\u05D4 \u05D4\u05E9\u05D8\u05D5\u05D9\u05D5\u05EA
          \u05D4\u05D0\u05DC\u05D4! \u05D4\u05EA\u05D0 \u05D4\u05D6\u05D4 \u05DB\u05DE\u05D5
          \u05D7\u05D3\u05E9!"
        commands:
        - rid: 6008430280376320094
    - rid: 2649295605456438271
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05D5\u05D9\u05D4 \u05D0\u05DE\u05E8\u05D4 \u05DC\u05D9 \u05E9\u05D4\u05D9\u05D0
          \u05E8\u05D0\u05EA\u05D4 \u05D0\u05EA \u05D4\u05E9\u05DC\u05D8\u05D9\u05DD
          \u05D4\u05D0\u05DC\u05D4 \u05DB\u05D1\u05E8 \u05DC\u05D9\u05DC\u05D4 \u05DC\u05E4\u05E0\u05D9.
          \u05E0\u05DB\u05D5\u05DF \u05E0\u05D5\u05D9\u05D4?"
        commands:
        - rid: 2649295747132948502
        - rid: 6008430280376320095
    - rid: 2649295747132948480
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF. \u05DB\u05E9\u05D4\u05DC\u05DB\u05EA\u05D9 \u05DC\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD
          \u05D1\u05DC\u05D9\u05DC\u05D4, \u05DB\u05D1\u05E8 \u05D4\u05D9\u05D4 \u05EA\u05DC\u05D5\u05D9
          \u05E9\u05DD \u05D4\u05E9\u05DC\u05D8."
        commands: []
    - rid: 2649295747132948481
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D5\u05D1\u05E0\u05D5 \u05E4\u05E9\u05D5\u05D8 \u05E9\u05D9\u05E2\u05E8\u05E0\u05D5
          \u05E9\u05D1\u05D0\u05DE\u05EA \u05D9\u05E9 \u05D1\u05E2\u05D9\u05D4 \u05D1\u05EA\u05D0\u2026
          \u05D0\u05E3 \u05D0\u05D7\u05D3 \u05DC\u05D0 \u05D7\u05E9\u05D1 \u05DC\u05D1\u05D3\u05D5\u05E7
          \u05D0\u05EA \u05D6\u05D4. \u05EA\u05D0 \u05DE\u05E7\u05D5\u05DC\u05E7\u05DC
          \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD \u05E9\u05DC \u05D1\u05E1\u05D9\u05E1
          \u05D6\u05D4 \u05DC\u05D0 \u05DE\u05E9\u05D4\u05D5 \u05D7\u05D3\u05E9 \u05DC\u05D0\u05E3
          \u05D0\u05D7\u05D3 \u05DE\u05D0\u05D9\u05EA\u05E0\u05D5, \u05D0\u05E0\u05D9
          \u05D1\u05D8\u05D5\u05D7."
        commands: []
    - rid: 2649295747132948482
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D6\u05D4 \u05E0\u05E4\u05D5\u05E5 \u05E9\u05D0\u05D9\u05D6\u05D4
          \u05E2\u05E8\u05E1 \u05DE\u05E9\u05D7\u05D9\u05EA \u05D0\u05EA \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD.
          \u05D0\u05E0\u05D9 \u05D4\u05E0\u05D7\u05EA\u05D9 \u05E9\u05DB\u05E4\u05D9\u05E8
          \u05E9\u05DD \u05D1\u05E7\u05D1\u05D5\u05E7 \u05D1\u05D0\u05E1\u05DC\u05D4
          \u05D0\u05D5 \u05DE\u05E9\u05D4\u05D5!"
        commands: []
    - rid: 2649295747132948483
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05DE\u05D9 \u05D0\u05EA\u05D4 \u05E7\u05D5\u05E8\u05D0 \u05E2\u05E8\u05E1
          \u05D9\u05D0 \u05D1\u05DF \u05E9\u05E8\u05DE\u05D5\u05D8\u05D4?"
        commands:
        - rid: 2649295747132948503
    - rid: 2649295747132948484
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05E0\u05E7\u05D5\u05D3\u05D4 \u05D4\u05D9\u05D0\u2026 \u05DC\u05D0\u05E3
          \u05D0\u05D7\u05D3 \u05D6\u05D4 \u05DC\u05D0 \u05E0\u05E8\u05D0\u05D4 \u05D7\u05E9\u05D5\u05D3
          \u05E9\u05DB\u05DE\u05D4 \u05DE\u05D4\u05EA\u05D0\u05D9\u05DD \u05D4\u05EA\u05E7\u05DC\u05E7\u05DC\u05D5."
        commands: []
    - rid: 2649295747132948485
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05E7 \u05D1\u05D7\u05E7\u05D9\u05E8\u05D4 \u05D1\u05D3\u05E7\u05EA\u05D9
          \u05D0\u05EA \u05D4\u05EA\u05D0 \u05D5\u05E8\u05D0\u05D9\u05EA\u05D9 \u05E9\u05D4\u05D5\u05D0
          \u05E2\u05D5\u05D1\u05D3. \u05D4\u05EA\u05D0 \u05D4\u05D9\u05D4 \u05EA\u05E7\u05D9\u05DF,
          \u05D4\u05E9\u05DC\u05D8\u05D9\u05DD \u05D4\u05D0\u05DC\u05D4 \u05D4\u05D9\u05D5
          \u05E8\u05E7 \u05D3\u05E8\u05DA \u05DC\u05D1\u05D8\u05D7 \u05D0\u05EA \u05D4\u05EA\u05DB\u05E0\u05D9\u05EA."
        commands: []
    - rid: 2649295747132948486
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D6\u05D4 \u05E2\u05D1\u05D3 \u05D8\u05D5\u05D1. \u05D1\u05D6\u05DB\u05D5\u05EA
          \u05D4\u05E9\u05DC\u05D8\u05D9\u05DD, \u05D0\u05E3 \u05D0\u05D7\u05D3 \u05DC\u05D0
          \u05E0\u05DB\u05E0\u05E1 \u05DC\u05EA\u05D0\u05D9\u05DD \u05D4\u05D0\u05DC\u05D4!"
        commands:
        - rid: 2649295747132948504
    - rid: 2649295747132948487
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D6\u05D4\u05D5\u2026? \u05D0\u05E0\u05D7\u05E0\u05D5
          \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD \u05DC\u05D4\u05D9\u05D5\u05EA \u05D1\u05D8\u05D5\u05D7\u05D9\u05DD
          \u05E9\u05D6\u05D0\u05EA \u05DE\u05D0\u05D9\u05D4?"
        commands: []
    - rid: 2649295747132948488
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D1\u05D5\u05D0\u05D5 \u05E0\u05E6\u05D1\u05D9\u05E2
          \u05D5-"
        commands: []
    - rid: 2649295747132948489
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D2\u05E2 \u05D0\u05D7\u05D3. \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D0\u05EA\u05DD
          \u05DE\u05D7\u05DC\u05D9\u05D8\u05D9\u05DD \u05E9\u05D6\u05D0\u05EA \u05D0\u05E0\u05D9,
          \u05EA\u05D7\u05E9\u05D1\u05D5 \u05E2\u05DC \u05D6\u05D4 \u05E9\u05E0\u05D9\u05D9\u05D4."
        commands:
        - rid: 6008430280376320096
    - rid: 2649295747132948490
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DC \u05D4\u05D4\u05E0\u05D7\u05D5\u05EA \u05D4\u05D0\u05DC\u05D4
          \u05D4\u05DF \u05E8\u05E7 \u05E1\u05E4\u05E7\u05D5\u05DC\u05E6\u05D9\u05D4.
          \u05D5\u05D0\u05EA\u05DD \u05DE\u05EA\u05E2\u05DC\u05DE\u05D9\u05DD \u05DE\u05D4\u05E4\u05D9\u05DC
          \u05E9\u05D1\u05D7\u05D3\u05E8."
        commands:
        - rid: 6008430280376320097
    - rid: 2649295747132948491
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05E4\u05D9\u05DC \u05E9\u05D1\u05D7\u05D3\u05E8?"
        commands: []
    - rid: 2649295747132948492
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DE\u05D5\u05EA \u05D4\u05DE\u05D7\u05E7\u05E8 \u05E9\u05D4\u05EA\u05D5\u05DB\u05E0\u05D9\u05EA
          \u05D4\u05D6\u05D0\u05EA \u05D3\u05E8\u05E9\u05D4\u2026 \u05DE\u05D0\u05D9\u05E4\u05D4
          \u05DC\u05D9 \u05DC\u05D3\u05E2\u05EA \u05D0\u05EA \u05DB\u05DC \u05D6\u05D4?"
        commands: []
    - rid: 2649295747132948493
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05DE\u05D4 \u05E9\u05D0\u05E0\u05D9 \u05D0\u05D3\u05E2 \u05DB\u05DC
          \u05DB\u05DA \u05D4\u05E8\u05D1\u05D4 \u05E2\u05DC \u05D4\u05DE\u05D1\u05E0\u05D4
          \u05E9\u05DC \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD? \u05D0\u05EA\u05DD
          \u05D7\u05D5\u05E9\u05D1\u05D9\u05DD \u05E9\u05E4\u05E9\u05D5\u05D8 \u05E7\u05DE\u05EA\u05D9
          \u05D1\u05D1\u05D5\u05E7\u05E8 \u05D5\u05D4\u05D7\u05DC\u05D8\u05EA\u05D9
          \u05DC\u05D4\u05E1\u05EA\u05DB\u05DC \u05E2\u05DC \u05D4\u05EA\u05E8\u05E9\u05D9\u05DE\u05D9\u05DD
          \u05D5\u05E2\u05DC \u05DB\u05DC \u05D4\u05DE\u05D1\u05E0\u05D4 \u05E9\u05DD?"
        commands: []
    - rid: 2649295747132948494
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D2\u05DD \u05D0\u05DD \u05D4\u05D9\u05D9\u05EA\u05D9 \u05DE\u05EA\u05DB\u05E0\u05E0\u05EA
          \u05DE\u05E9\u05D4\u05D5, \u05DC\u05DE\u05D4 \u05E9\u05D0\u05E0\u05D9 \u05D0\u05D1\u05D7\u05E8
          \u05D3\u05D5\u05D5\u05E7\u05D0 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD?
          \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05D9\u05D9\u05EA\u05D9 \u05DE\u05D1\u05D9\u05E0\u05D4
          \u05E9\u05D4\u05E8\u05E6\u05D7 \u05D4\u05D6\u05D4 \u05D0\u05E4\u05E9\u05E8\u05D9
          \u05D1\u05DB\u05DC\u05DC, \u05D4\u05D9\u05D9\u05EA\u05D9 \u05DE\u05D5\u05E6\u05D0\u05EA
          \u05E9\u05D9\u05D8\u05D4 \u05D0\u05D7\u05E8\u05EA."
        commands: []
    - rid: 2649295747132948495
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05D9\u05E9 \u05D1\u05D6\u05D4 \u05DE\u05E9\u05D4\u05D5."
        commands: []
    - rid: 2649295747132948496
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D5\u05DC\u05D9 \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D0\u05EA\u05DD
          \u05E7\u05D5\u05E4\u05E6\u05D9\u05DD \u05DC\u05DE\u05E1\u05E7\u05E0\u05D5\u05EA,
          \u05EA\u05D7\u05E9\u05D1\u05D5 \u05E2\u05DC \u05D4\u05D3\u05D1\u05E8\u05D9\u05DD
          \u05E9\u05E0\u05D9\u05D9\u05D4?"
        commands: []
    - rid: 2649295747132948497
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05E8\u05E6\u05D7 \u05D4\u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA
          \u05D3\u05E8\u05E9 \u05D4\u05E8\u05D1\u05D4 \u05E2\u05D1\u05D5\u05D3\u05EA
          \u05D7\u05E7\u05E8 \u05E2\u05DC \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD\u2026
          \u05E7\u05E9\u05D4 \u05DC\u05D4\u05D0\u05DE\u05D9\u05DF \u05E9\u05DE\u05D9\u05E9\u05D4\u05D5
          \u05D4\u05D9\u05D4 \u05DE\u05D7\u05DC\u05D9\u05D8 \u05DC\u05D4\u05E9\u05EA\u05DE\u05E9
          \u05D3\u05D5\u05D5\u05E7\u05D0 \u05D1\u05D6\u05D4 \u05E1\u05EA\u05DD \u05DB\u05DB\u05D4\u2026)"
        commands: []
    - rid: 2649295747132948498
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E0\u05E8\u05D0\u05D4 \u05E9\u05D6\u05D4 \u05D4\u05DE\u05D0\u05DE\u05E5
          \u05D4\u05D0\u05D7\u05E8\u05D5\u05DF \u05E9\u05DC \u05DE\u05D0\u05D9\u05D4.
          \u05D0\u05E0\u05D9 \u05D0\u05E6\u05D8\u05E8\u05DA \u05DC\u05D4\u05E8\u05D0\u05D5\u05EA
          \u05E9\u05D4\u05D9\u05D0 \u05D4\u05D9\u05D7\u05D9\u05D3\u05D4 \u05E9\u05D4\u05D9\u05D9\u05EA\u05D4
          \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05D7\u05E9\u05D5\u05D1 \u05E2\u05DC
          \u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05DB\u05D6\u05D0\u05EA!)"
        commands:

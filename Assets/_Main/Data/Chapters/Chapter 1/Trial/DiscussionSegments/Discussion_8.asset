    - rid: 2649295605456437408
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D2\u05E2 \u05DB\u05E4\u05D9\u05E8, \u05DC\u05D0 \u05D0\u05DE\u05E8\u05EA\u05D9
          \u05E9\u05D0\u05EA\u05D4 \u05E8\u05E6\u05D7\u05EA \u05D0\u05EA \u05E8\u05D5\u05E2\u05D9\u2026"
        commands:
        - rid: 2649295605456437452
    - rid: 2649295605456437409
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4, \u05DC\u05D0?"
        commands:
        - rid: 2649295605456437453
    - rid: 2649295605456437410
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05DE\u05D4 \u05D0\u05EA\u05D4 \u05D7\u05D5\u05E9\u05D1
          \u05E9\u05D4\u05D5\u05D0 \u05E2\u05E9\u05D4??"
        commands:
        - rid: 2649295605456437454
    - rid: 2649295605456437412
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E4\u05D9\u05E8 \u05D4\u05D9\u05D4 \u05D1\u05E4\u05D9\u05E0\u05EA
          \u05E4\u05E8\u05D9\u05E1\u05D4 \u05D1\u05D6\u05DE\u05DF \u05D4\u05D0\u05DC\"\u05D1."
        commands: []
    - rid: 2649295605456437413
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DA \u05D0\u05EA\u05D4 \u05D9\u05D5\u05D3\u05E2?"
        commands:
        - rid: 2649295605456437469
    - rid: 2649295605456437414
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E4\u05D9\u05E8 \u05D4\u05E9\u05D0\u05D9\u05E8 \u05D0\u05D7\u05E8\u05D9\u05D5
          \u05DE\u05E9\u05D4\u05D5 \u05D1\u05E4\u05D9\u05E0\u05EA \u05E4\u05E8\u05D9\u05E1\u05D4.
          \u05D0\u05E0\u05D9 \u05DE\u05D3\u05D1\u05E8 \u05E2\u05DC\u2026"
        commands:
        - rid: 2649295605456437470
        - rid: 2649295605456437472
    - rid: 2649295605456437415
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05EA\u05E8\u05D0\u05D5 \u05D0\u05EA \u05D4\u05D1\u05D3\u05DC\u05D9
          \u05E1\u05D9\u05D2\u05E8\u05D9\u05D4 \u05D4\u05D0\u05DC\u05D4. \u05DE\u05E6\u05D0\u05EA\u05D9
          \u05D0\u05D5\u05EA\u05DD \u05E2\u05DC \u05D4\u05E8\u05E6\u05E4\u05D4 \u05D1\u05E4\u05D9\u05E0\u05EA
          \u05E4\u05E8\u05D9\u05E1\u05D4."
        commands: []
    - rid: 2649295605456437416
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05DE\u05D4? \u05D4\u05D1\u05DF \u05D0\u05D3\u05DD \u05D4\u05D6\u05D4
          \u05E7\u05D8\u05E8 \u05DE\u05D4\u05DC\u05DA. \u05D0\u05E0\u05D9 \u05D1\u05D8\u05D5\u05D7
          \u05E9\u05D4\u05D5\u05D0 \u05E2\u05D9\u05E9\u05DF \u05E9\u05DD \u05DC\u05D0
          \u05E4\u05E2\u05DD \u05D5\u05DC\u05D0 \u05E4\u05E2\u05DE\u05D9\u05D9\u05DD
          \u05DC\u05E4\u05E0\u05D9 \u05DB\u05DF. \u05D0\u05D9 \u05D0\u05E4\u05E9\u05E8
          \u05DC\u05D3\u05E2\u05EA \u05D0\u05DD \u05D6\u05D4 \u05E7\u05E9\u05D5\u05E8
          \u05DC\u05D0\u05D9\u05E8\u05D5\u05E2\u05D9\u05DD \u05E9\u05D0\u05E0\u05D7\u05E0\u05D5
          \u05DE\u05D3\u05D1\u05E8\u05D9\u05DD \u05E2\u05DC\u05D9\u05D4\u05DD."
        commands:
        - rid: 2649295605456437473
    - rid: 2649295605456437417
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05E1\u05DB\u05D9\u05DE\u05D4. \u05DB\u05DE\u05D4
          \u05D1\u05D3\u05DC\u05D9 \u05E1\u05D9\u05D2\u05E8\u05D9\u05D4 \u05E2\u05DC
          \u05D4\u05E8\u05E6\u05E4\u05D4 \u05DC\u05D0 \u05D0\u05D5\u05DE\u05E8\u05D9\u05DD
          \u05DB\u05DC\u05D5\u05DD."
        commands:
        - rid: 2649295605456437474
    - rid: 2649295605456437418
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D3\u05E8\u05DA \u05DB\u05DC\u05DC \u05D4\u05D9\u05D9\u05EA\u05DD
          \u05E6\u05D5\u05D3\u05E7\u05D9\u05DD, \u05D0\u05D1\u05DC \u05DB\u05E9\u05D4\u05E1\u05EA\u05DB\u05DC\u05EA\u05D9
          \u05E2\u05DC \u05D6\u05D4, \u05E7\u05D5\u05D1\u05D9 \u05D0\u05DE\u05E8
          \u05DC\u05D9 \u05DE\u05E9\u05D4\u05D5."
        commands:
        - rid: 2649295605456437475
    - rid: 2649295605456437419
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05E0\u05D9\u05E7\u05D9\u05EA\u05D9 \u05D0\u05EA
          \u05DB\u05DC \u05D4\u05D0\u05D6\u05D5\u05E8 \u05D4\u05D6\u05D4 \u05DE\u05DE\u05E9
          \u05D4\u05D1\u05D5\u05E7\u05E8, \u05DC\u05E4\u05E0\u05D9 \u05D4\u05DE\u05E1\u05D3\u05E8!"
        commands:
        - rid: 2649295605456437505
    - rid: 2649295605456437420
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D0\u05DE\u05EA?"
        commands: []
    - rid: 2649295605456437421
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05DB\u05DC \u05D9\u05D5\u05DD \u05DB\u05E9\u05D0\u05E0\u05D9
          \u05E7\u05DD \u05D1\u05D1\u05D5\u05E7\u05E8, \u05D0\u05E0\u05D9 \u05D4\u05D5\u05DC\u05DA
          \u05DC\u05D5\u05D5\u05D3\u05D0 \u05E9\u05D4\u05DB\u05DC \u05E0\u05E7\u05D9."
        commands: []
    - rid: 2649295605456437422
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E7\u05D5\u05D1\u05D9 \u05E0\u05D9\u05E7\u05D4 \u05D0\u05EA \u05D4\u05E4\u05D9\u05E0\u05EA
          \u05E4\u05E8\u05D9\u05E1\u05D4 \u05DE\u05DE\u05E9 \u05D1\u05D0\u05D5\u05EA\u05D5
          \u05D1\u05D5\u05E7\u05E8. \u05DC\u05D0 \u05D4\u05D9\u05D4 \u05D6\u05DE\u05DF
          \u05D0\u05D7\u05E8 \u05E9\u05DB\u05E4\u05D9\u05E8 \u05D9\u05DB\u05D5\u05DC
          \u05D4\u05D9\u05D4 \u05DC\u05E2\u05E9\u05DF, \u05D1\u05DE\u05D9\u05D5\u05D7\u05D3
          \u05DC\u05D0 \u05D1\u05D0\u05D6\u05D5\u05E8 \u05D4\u05D6\u05D4."
        commands:
        - rid: 2649295605456437476
        - rid: 2649295605456437506
    - rid: 2649295605456437423
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05DB\u05D5\u05DF! \u05D0\u05D6 \u05D6\u05D4 \u05D4\u05E4\u05E8\u05D7\u05D7
          \u05E9\u05D6\u05D9\u05D4\u05DD \u05D0\u05EA \u05D4\u05D0\u05D6\u05D5\u05E8?"
        commands:
        - rid: 2649295605456437477
        - rid: 2649295605456437478
    - rid: 2649295605456437424
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05D0\u05DC\u05DC\u05D4 \u05D2\u05DD \u05DB\u05DF \u05D0\u05EA\u05D4."
        commands:
        - rid: 2649295605456437479
    - rid: 2649295605456437425
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D0\u05D5\u05DE\u05E8 \u05E9\u05DB\u05E4\u05D9\u05E8
          \u05E2\u05D9\u05E9\u05DF \u05D1\u05E4\u05D9\u05E0\u05EA \u05E4\u05E8\u05D9\u05E1\u05D4
          \u05D1\u05D6\u05DE\u05DF \u05D4\u05E8\u05E6\u05D7."
        commands: []
    - rid: 2649295605456437426
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC\u2026 \u05D0\u05DD \u05DB\u05DB\u05D4, \u05D2\u05DD
          \u05DC\u05DB\u05E4\u05D9\u05E8 \u05D9\u05E9 \u05D0\u05DC\u05D9\u05D1\u05D9.
          \u05D0\u05D6 \u05DC\u05DE\u05D4 \u05D1\u05E2\u05E6\u05DD \u05D4\u05D9\u05D4
          \u05DB\u05DC \u05D4\u05D3\u05D9\u05D5\u05DF \u05D4\u05D6\u05D4?"
        commands:
        - rid: 2649295605456437481
    - rid: 2649295605456437427
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05DC\u05D0 \u05D4\u05D1\u05E0\u05EA\u05D9 \u05DE\u05D4
          \u05D4\u05E7\u05E9\u05E8?"
        commands:
        - rid: 2649295605456437482
    - rid: 2649295605456437428
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D9\u05E9 \u05DC\u05D4 \u05E0\u05E7\u05D5\u05D3\u05D4\u2026 \u05D0\u05D6
          \u05DC\u05D0 \u05D4\u05D9\u05D4 \u05D8\u05E2\u05DD \u05D1\u05D3\u05D9\u05D5\u05DF
          \u05D4\u05D6\u05D4\u2026?)"
        commands: []
    - rid: 2649295605456437429
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05E1\u05EA\u05DD \u05E0\u05D9\u05E1\u05D9\u05EA
          \u05DC\u05D6\u05D9\u05D9\u05DF \u05D0\u05D5\u05EA\u05D9 \u05D1\u05E8\u05D2\u05E8."
        commands:
        - rid: 2649295605456437483
    - rid: 2649295605456437430
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D2\u05E2 \u05D0\u05D7\u05D3. \u05D0\u05DE\u05E0\u05DD \u05D6\u05D4
          \u05DC\u05D0 \u05E7\u05D9\u05D3\u05DD \u05D0\u05D5\u05EA\u05E0\u05D5 \u05DE\u05D1\u05D7\u05D9\u05E0\u05EA
          \u05D0\u05DC\u05D9\u05D1\u05D9, \u05D0\u05D1\u05DC \u05D6\u05D4 \u05E2\u05D3\u05D9\u05D9\u05DF
          \u05D9\u05DB\u05D5\u05DC \u05DC\u05E2\u05D6\u05D5\u05E8 \u05DC\u05E0\u05D5
          \u05DC\u05D2\u05DC\u05D5\u05EA \u05E2\u05D5\u05D3 \u05E4\u05E8\u05D8\u05D9\u05DD."
        commands:
        - rid: 2649295605456437484
    - rid: 2649295605456437431
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E4\u05D9\u05E8, \u05DC\u05D0 \u05E8\u05D0\u05D9\u05EA \u05D1\u05DE\u05E7\u05E8\u05D4
          \u05DE\u05E9\u05D4\u05D5 \u05D1\u05D6\u05DE\u05DF \u05E9\u05D4\u05D9\u05D9\u05EA
          \u05D1\u05D7\u05D5\u05E5?"
        commands: []
    - rid: 2649295605456437432
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D0 \u05E2\u05D0\u05E8\u05E3\u2026 \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05E2\u05E1\u05D5\u05E7 \u05D1\u05E1\u05D9\u05D2\u05E8\u05D9\u05D4. \u05D1\u05DB\u05DC
          \u05DE\u05E7\u05E8\u05D4 \u05DB\u05D1\u05E8 \u05D4\u05D1\u05D9\u05D0 \u05DC\u05D9
          \u05D0\u05EA \u05D4\u05E1\u05E2\u05D9\u05E3 \u05D4\u05D1\u05E8\u05D6 \u05D4\u05DE\u05D6\u05D3\u05D9\u05D9\u05DF
          \u05D4\u05D6\u05D4."
        commands:
        - rid: 2649295605456437485
    - rid: 2649295605456437433
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D1\u05E8\u05D6?"
        commands:
        - rid: 2649295605456437486
    - rid: 2649295605456437434
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E9\u05D0\u05E0\u05D9 \u05D7\u05D5\u05E9\u05D1 \u05E2\u05DC
          \u05D6\u05D4, \u05DC\u05DE\u05D4 \u05D1\u05D0\u05DE\u05EA \u05D4\u05D7\u05DC\u05D8\u05EA
          \u05E4\u05EA\u05D0\u05D5\u05DD \u05DC\u05D4\u05D1\u05E8\u05D9\u05D6 \u05DE\u05D4\u05D0\u05DC\"\u05D1?"
        commands:
        - rid: 2649295605456437487
    - rid: 2649295605456437435
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05DB\u05E9\u05D1\u05D0\u05EA\u05D9
          \u05DC\u05E7\u05D7\u05EA \u05E6\u05D9\u05D5\u05D3 \u05E9\u05DB\u05D7\u05EA\u05D9
          \u05DC\u05DE\u05DC\u05D0 \u05DE\u05D9\u05DD \u05D1\u05D3\u05DC\u05D9. \u05E7\u05DC\u05D8\u05EA\u05D9
          \u05D0\u05EA \u05D6\u05D4 \u05D0\u05D7\u05E8\u05D9 \u05E9\u05D9\u05E6\u05D0\u05EA\u05D9
          \u05DE\u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD, \u05D0\u05D1\u05DC
          \u05D4\u05EA\u05D9\u05E0\u05D5\u05E7 \u05D4\u05D6\u05D4 \u05D4\u05EA\u05D7\u05D9\u05DC
          \u05DC\u05E2\u05E9\u05D5\u05EA \u05DC\u05D4\u05DD \u05EA\u05D3\u05E8\u05D9\u05DA,
          \u05D0\u05D6 \u05DC\u05D0 \u05E8\u05E6\u05D9\u05EA\u05D9 \u05DC\u05D4\u05D9\u05DB\u05E0\u05E1
          \u05D7\u05D6\u05E8\u05D4."
        commands:
        - rid: 2649295605456437488
    - rid: 2649295605456437436
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05D9\u05E1\u05D9\u05EA\u05D9 \u05DC\u05DE\u05DC\u05D0 \u05DE\u05D9\u05DD
          \u05DE\u05D4\u05D1\u05E8\u05D6 \u05D1\u05D7\u05D5\u05E5, \u05D0\u05D1\u05DC
          \u05D4\u05D5\u05D0 \u05DC\u05D0 \u05E2\u05D1\u05D3. \u05D0\u05D6 \u05D5\u05D9\u05EA\u05E8\u05EA\u05D9."
        commands: []
    - rid: 2649295605456437437
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E4\u05E9\u05D5\u05D8 \u05D5\u05D9\u05EA\u05E8\u05EA\u2026?"
        commands:
        - rid: 2649295605456437490
    - rid: 2649295605456437438
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05DE\u05D4 \u05DE\u05D4 \u05D0\u05EA \u05E8\u05D5\u05E6\u05D4
          \u05DE\u05DE\u05E0\u05D9? \u05D0\u05DE\u05E8\u05EA\u05D9 \u05E9\u05D9\u05D6\u05D3\u05D9\u05D9\u05E0\u05D5,
          \u05D4\u05D9\u05D9\u05EA\u05D9 \u05D0\u05D5\u05DE\u05E8 \u05DC\u05EA\u05D9\u05E0\u05D5\u05E7
          \u05E9\u05D4\u05D1\u05E8\u05D6 \u05DC\u05D0 \u05E2\u05D1\u05D3 \u05D0\u05D6
          \u05DC\u05D0 \u05D9\u05DB\u05D5\u05DC\u05E0\u05D5 \u05DC\u05E0\u05E7\u05D5\u05EA.\r"
        commands:
        - rid: 2649295605456437491
    - rid: 2649295605456437439
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05DC\u05D2\u05D9\u05D8\u05D9\u05DE\u05D9."
        commands:
        - rid: 2649295605456437492
    - rid: 2649295605456437440
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05DC\u05D2\u05D9\u05D8\u05D9\u05DE\u05D9! \u05D4\u05D9\u05D9\u05E0\u05D5
          \u05DE\u05D1\u05D5\u05E9\u05DC\u05D9\u05DD \u05D0\u05DD \u05D4\u05D9\u05D9\u05E0\u05D5
          \u05DE\u05E4\u05D9\u05DC\u05D9\u05DD \u05D0\u05EA \u05D4\u05DE\u05E1\u05D3\u05E8
          \u05E4\u05E2\u05DD \u05E9\u05E0\u05D9\u05D9\u05D4 \u05D1\u05E8\u05E6\u05E3!"
        commands:
        - rid: 2649295605456437493
        - rid: 2649295605456437494
    - rid: 2649295605456437441
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05DB\u05D5\u05DF, \u05DC\u05D0 \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05E2\u05D5\u05D1\u05E8 \u05E2\u05DC \u05D6\u05D4 \u05D1\u05E9\u05EA\u05D9\u05E7\u05D4!
          \u05D6\u05D5 \u05D0\u05D7\u05E8\u05D9\u05D5\u05EA \u05E9\u05DC\u05DA \u05DC\u05D6\u05DB\u05D5\u05E8
          \u05DC\u05DE\u05DC\u05D0 \u05DE\u05D9\u05DD \u05D1\u05D6\u05DE\u05DF! \u05D5\u05EA\u05DE\u05D9\u05D3
          \u05D4\u05D9\u05D9\u05EA \u05D9\u05DB\u05D5\u05DC \u05DC\u05D1\u05E7\u05E9
          \u05D4\u05D0\u05E8\u05DB\u05D4!"
        commands:
        - rid: 2649295605456437495
    - rid: 2649295605456437442
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D1\u05E8\u05D6 \u05DC\u05D0 \u05E2\u05D1\u05D3? \u05D6\u05D4
          \u05E8\u05D2\u05D9\u05DC?"
        commands:
        - rid: 2649295605456437496
    - rid: 2649295605456437443
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05E0\u05E9\u05DE\u05E2 \u05DC\u05D9 \u05D4\u05D2\u05D9\u05D5\u05E0\u05D9.
          \u05EA\u05D2\u05D9\u05D3 \u05D4\u05EA\u05D9\u05E0\u05D5\u05E7, \u05D4\u05D1\u05E8\u05D6
          \u05D4\u05D6\u05D4 \u05DC\u05D0 \u05E2\u05D5\u05D1\u05D3 \u05D1\u05D3\u05E8\u05DA
          \u05DB\u05DC\u05DC?"
        commands:
        - rid: 2649295605456437497
    - rid: 2649295605456437444
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05DD \u05EA\u05E7\u05E8\u05D0\u05D5 \u05DC\u05D9 \u05D4\u05DE\u05E4\u05E7\u05D3!
          \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D0\u05D5\u05D4\u05D1 \u05DC\u05E2\u05E0\u05D5\u05EA
          \u05E2\u05DC \u05E9\u05D0\u05DC\u05D5\u05EA \u05D1\u05DE\u05E9\u05E4\u05D8
          \u05E6\u05D1\u05D0\u05D9, \u05D0\u05D1\u05DC \u05D0\u05E0\u05D9 \u05DC\u05D0
          \u05E8\u05D5\u05E6\u05D4 \u05E9\u05D9\u05D7\u05E9\u05D1\u05D5 \u05E9\u05D4\u05EA\u05E9\u05EA\u05D9\u05D5\u05EA
          \u05E9\u05DC\u05E0\u05D5 \u05DC\u05D0 \u05DE\u05EA\u05E4\u05E7\u05D3\u05D5\u05EA!"
        commands:
        - rid: 2649295605456437498
    - rid: 2649295605456437445
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D1\u05E8\u05D6 \u05D4\u05D6\u05D4 \u05D4\u05D5\u05D0 \u05D1\u05E8\u05D6
          \u05EA\u05E7\u05D9\u05DF! \u05D4\u05D5\u05D0 \u05D0\u05DE\u05D5\u05E8 \u05DC\u05E2\u05D1\u05D5\u05D3
          \u05DB\u05E9\u05D5\u05E8\u05D4."
        commands:
        - rid: 2649295605456437499
    - rid: 2649295605456437446
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05DE\u05D4 \u05D2\u05E8\u05DD \u05DC\u05D5 \u05DC\u05D4\u05EA\u05E7\u05DC\u05E7\u05DC
          \u05E4\u05EA\u05D0\u05D5\u05DD?"
        commands:
        - rid: 2649295605456437500
    - rid: 2649295605456437447
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D4\u05D5\u05DC\u05DA \u05DC\u05D4\u05D5\u05D1\u05D9\u05DC
          \u05D0\u05EA\u05DB\u05DD \u05D9\u05D3 \u05D1\u05D9\u05D3! \u05D1\u05D7\u05D9\u05D9\u05DD
          \u05DC\u05D0 \u05EA\u05E2\u05D1\u05E8\u05D5 \u05DC\u05E9\u05DC\u05D1 \u05D1'
          \u05E9\u05DC \u05D4\u05D8\u05D9\u05E8\u05D5\u05E0\u05D5\u05EA \u05D0\u05DD
          \u05DC\u05D0 \u05EA\u05DC\u05DE\u05D3\u05D5 \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05E2\u05E6\u05DE\u05D0\u05D9\u05D9\u05DD."
        commands:
        - rid: 2649295605456437501
    - rid: 2649295605456437448
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA \u05E9\u05DE\u05D9\u05E9\u05D4\u05D5
          \u05D4\u05EA\u05E2\u05E1\u05E7 \u05D1\u05D1\u05E8\u05D6 \u05D4\u05D6\u05D4?
          \u05DE\u05D0\u05D9\u05E4\u05D4 \u05D4\u05DE\u05D9\u05DD \u05E9\u05DC\u05D5
          \u05D0\u05DE\u05D5\u05E8\u05D9\u05DD \u05DC\u05D4\u05D2\u05D9\u05E2?"
        commands:
        - rid: 2649295605456437502
    - rid: 2649295605456437449
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05DF \u05D4\u05E1\u05EA\u05DD, \u05D4\u05DE\u05D9\u05DD \u05DE\u05D2\u05D9\u05E2\u05D9\u05DD
          \u05DE\u05D4\u05E8\u05DB\u05D6\u05EA \u05DE\u05D9\u05DD \u05D4\u05E2\u05E0\u05E7\u05D9\u05EA
          \u05E9\u05D0\u05DC\u05D9\u05D4 \u05D4\u05D1\u05E8\u05D6 \u05DE\u05D7\u05D5\u05D1\u05E8."
        commands:
        - rid: 2649295605456437503
    - rid: 2649295605456437450
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D1\u05EA\u05D5\u05DA \u05D4\u05E8\u05DB\u05D6\u05EA \u05D9\u05E9
          \u05DE\u05DC\u05D0 \u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA. \u05D0\u05D5\u05DC\u05D9
          \u05DE\u05D9\u05E9\u05D4\u05D5 \u05D4\u05EA\u05E2\u05E1\u05E7 \u05D1\u05D4\u05DD
          \u05D5\u05D4\u05E6\u05DC\u05D9\u05D7 \u05DC\u05E2\u05E6\u05D5\u05E8 \u05D0\u05EA
          \u05D4\u05D6\u05E8\u05D9\u05DE\u05EA \u05DE\u05D9\u05DD \u05DC\u05D1\u05E8\u05D6?"

    - rid: 2649295592630780044
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D7\u05DC\u05D5\u05DF! \u05D1\u05E7\u05D9\u05E8 \u05E9\u05E6\u05DE\u05D5\u05D3
          \u05DC\u05EA\u05D0, \u05D9\u05E9 \u05D7\u05DC\u05D5\u05DF \u05D2\u05D1\u05D5\u05D4!"
        commands:
        - rid: 2649295592630780087
        - rid: 2649295592630780088
    - rid: 2649295592630780045
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D7\u05DC\u05D5\u05DF?"
        commands:
        - rid: 2649295592630780089
    - rid: 2649295592630780046
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D7\u05DC\u05D5\u05DF \u05E0\u05DE\u05E6\u05D0 \u05D1\u05D2\u05D5\u05D1\u05D4
          \u05DE\u05E2\u05DC \u05D4\u05EA\u05D0, \u05D0\u05DD \u05DE\u05D9\u05E9\u05D4\u05D5
          \u05D1\u05D0 \u05DE\u05D1\u05D7\u05D5\u05E5, \u05D4\u05D5\u05D0 \u05D4\u05D9\u05D4
          \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05E4\u05D9\u05DC \u05E2\u05DC\u05D9\u05D5
          \u05D0\u05EA \u05D4\u05D0\u05E8\u05D9\u05D7!"
        commands:
        - rid: 2649295592630780090
    - rid: 2649295592630780047
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D4\u05D9\u05D4 \u05DE\u05E1\u05D1\u05D9\u05E8 \u05DC\u05DE\u05D4
          \u05D0\u05DC\u05D5\u05DF \u05DC\u05D0 \u05E8\u05D0\u05D4 \u05D0\u05D5\u05EA\u05D5\u2026
          \u05D5\u05D0\u05D5\u05DC\u05D9 \u05D2\u05DD \u05E8\u05D5\u05E2\u05D9 \u05DC\u05D0
          \u05E9\u05DD \u05DC\u05D1."
        commands:
        - rid: 2649295592630780091
    - rid: 2649295592630780048
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D6\u05D4 \u05DE\u05E2\u05DC\u05D4 \u05E9\u05D0\u05DC\u05D4
          \u05E0\u05D5\u05E1\u05E4\u05EA\u2026"
        commands:
        - rid: 2649295592630780092
    - rid: 2649295592630780049
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D0\u05E8\u05D9\u05D7 \u05D4\u05D6\u05D4 \u05D4\u05D9\u05D4
          \u05D1\u05DE\u05E7\u05D5\u05DD \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05DB\u05DC
          \u05D4\u05EA\u05D7\u05D9\u05DC, \u05E0\u05DB\u05D5\u05DF?"
        commands: []
    - rid: 2649295592630780050
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9\u2026"
        commands:
        - rid: 2649295592630780094
    - rid: 2649295592630780051
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E9\u05D1\u05D0\u05EA\u05D9 \u05DC\u05D4\u05D1\u05D9\u05D0
          \u05E6\u05D9\u05D5\u05D3, \u05DC\u05D0 \u05D6\u05DB\u05D5\u05E8 \u05DC\u05D9
          \u05E9\u05E8\u05D0\u05D9\u05EA\u05D9 \u05E9\u05D4\u05D0\u05E8\u05D9\u05D7
          \u05DC\u05D0 \u05D1\u05DE\u05E7\u05D5\u05DD."
        commands:
        - rid: 2649295592630780095
    - rid: 2649295592630780052
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05DC\u05D2\u05D1\u05D9 \u05D4\u05E9\u05D0\u05E8? \u05DE\u05D9
          \u05E9\u05D4\u05D9\u05D0 \u05E6\u05D9\u05D5\u05D3, \u05D0\u05EA\u05DD \u05D6\u05D5\u05DB\u05E8\u05D9\u05DD
          \u05D0\u05DD \u05E8\u05D0\u05D9\u05EA\u05DD \u05DE\u05E9\u05D4\u05D5?"
        commands:
        - rid: 2649295592630780096
    - rid: 2649295592630780053
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DC\u05D0 \u05E8\u05D0\u05D9\u05EA\u05D9."
        commands:
        - rid: 2649295592630780099
    - rid: 2649295592630780054
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05DE\u05D4 \u05E9\u05D0\u05E0\u05D9 \u05D6\u05D5\u05DB\u05E8\u05EA,
          \u05D6\u05D4 \u05D4\u05D9\u05D4 \u05D1\u05DE\u05E7\u05D5\u05DD."
        commands:
        - rid: 2649295592630780100
    - rid: 2649295592630780055
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05DB\u05DF."
        commands:
        - rid: 2649295592630780101
    - rid: 2649295592630780056
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D0\u05E8\u05D9\u05D7 \u05D4\u05D7\u05E1\u05E8 \u05D3\u05D9
          \u05D1\u05D5\u05DC\u05D8. \u05D0\u05DD \u05D0\u05E3 \u05D0\u05D7\u05D3
          \u05DC\u05D0 \u05E9\u05DD \u05DC\u05D1, \u05D0\u05E0\u05D9 \u05D7\u05D5\u05E9\u05D1\u05EA
          \u05E9\u05D4\u05D2\u05D9\u05D5\u05E0\u05D9 \u05DC\u05E9\u05E2\u05E8 \u05E9\u05D4\u05D5\u05D0
          \u05E2\u05D5\u05D3 \u05D4\u05D9\u05D4 \u05E9\u05DD."
        commands:
        - rid: 2649295592630780102
    - rid: 2649295592630780057
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05D5 \u05D0\u05D1\u05DC \u05DE\u05D4 \u05E7\u05E9\u05D5\u05E8?
          \u05D0\u05D6 \u05DE\u05D9 \u05E9\u05E2\u05E9\u05D4 \u05D0\u05EA \u05D6\u05D4
          \u05E0\u05D9\u05EA\u05E7 \u05D0\u05EA \u05D6\u05D4 \u05DE\u05D4\u05EA\u05E7\u05E8\u05D4
          \u05E4\u05E9\u05D5\u05D8!"
        commands:
        - rid: 2649295592630780103
    - rid: 2649295592630780058
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D0\u05D9\u05DA \u05D1\u05D3\u05D9\u05D5\u05E7 \u05D4\u05D5\u05D0
          \u05E0\u05D9\u05EA\u05E7 \u05D0\u05EA \u05D6\u05D4?"
        commands:
        - rid: 2649295592630780104
    - rid: 2649295592630780059
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D0\u05D9\u05E4\u05D4 \u05DC\u05D9? \u05DE\u05D4 \u05D0\u05E0\u05D9
          \u05D0\u05D9\u05E0\u05E1\u05D8\u05DC\u05D8\u05D5\u05E8\u05D9\u05EA?"
        commands:
        - rid: 2649295592630780105
    - rid: 2649295592630780060
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D9\u05DA \u05D4\u05D5\u05D0 \u05E0\u05D9\u05EA\u05E7 \u05D0\u05EA
          \u05D4\u05D0\u05E8\u05D9\u05D7? \u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9 \u05E9\u05D0\u05E0\u05D7\u05E0\u05D5
          \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD \u05DC\u05D3\u05E2\u05EA\u2026)"
        commands: []
    - rid: 2649295592630780061
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D2\u05E2, \u05D0\u05E0\u05D7\u05E0\u05D5 \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD
          \u05DC\u05D3\u05E2\u05EA \u05D0\u05D9\u05DA \u05D4\u05D5\u05D0 \u05E0\u05D9\u05EA\u05E7
          \u05D0\u05EA \u05D4\u05D0\u05E8\u05D9\u05D7."
        commands:
        - rid: 2649295592630780107
    - rid: 2649295592630780062
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DA \u05D6\u05D4?"
        commands:
        - rid: 2649295592630780108
    - rid: 2649295592630780063
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D9\u05D3 \u05D4\u05D0\u05E8\u05D9\u05D7, \u05D4\u05D9\u05D5
          \u05DB\u05DE\u05D4 \u05D1\u05E8\u05D2\u05D9\u05DD. \u05D4\u05D0\u05E8\u05D9\u05D7\u05D9\u05DD
          \u05DE\u05D7\u05D5\u05D1\u05E8\u05D9\u05DD \u05DC\u05EA\u05E7\u05E8\u05D4
          \u05E2\u05DD \u05D1\u05E8\u05D2\u05D9\u05DD, \u05D0\u05D6 \u05DB\u05DC
          \u05DE\u05D4 \u05E9\u05D4\u05E8\u05D5\u05E6\u05D7 \u05D4\u05D9\u05D4 \u05E6\u05E8\u05D9\u05DA
          \u05DC\u05E2\u05E9\u05D5\u05EA \u05D6\u05D4 \u05DC\u05D4\u05D5\u05E6\u05D9\u05D0
          \u05D0\u05EA \u05D4\u05D1\u05E8\u05D2\u05D9\u05DD, \u05D5\u05DB\u05DB\u05D4
          \u05D4\u05D5\u05D0 \u05D4\u05D9\u05D4 \u05D9\u05DB\u05D5\u05DC \u05DC\u05E0\u05EA\u05E7
          \u05D0\u05EA \u05D4\u05D0\u05E8\u05D9\u05D7 \u05DE\u05D4\u05EA\u05E7\u05E8\u05D4."
        commands:
        - rid: 2649295592630780109
    - rid: 2649295592630780064
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D0\u05DD \u05DB\u05DB\u05D4, \u05D0\u05D9\u05DA
          \u05D1\u05D3\u05D9\u05D5\u05E7 \u05D4\u05D5\u05D0 \u05D4\u05D5\u05E6\u05D9\u05D0
          \u05D0\u05EA \u05D4\u05D1\u05E8\u05D2\u05D9\u05DD?"
        commands:
        - rid: 2649295592630780110
    - rid: 2649295592630780065
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D5\u05DC\u05D9 \u05D4\u05D5\u05D0 \u05E4\u05E9\u05D5\u05D8
          \u05E9\u05DC\u05E7 \u05D0\u05D5\u05EA\u05DD \u05D4\u05D7\u05D5\u05E6\u05D4
          \u05E2\u05DD \u05D4\u05DB\u05D5\u05D7 \u05D4\u05E2\u05DC \u05D0\u05E0\u05D5\u05E9\u05D9
          \u05E9\u05DC\u05D5?"
        commands:
        - rid: 2649295592630780111
    - rid: 2649295592630780066
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D4 \u05D3\u05D5\u05D5\u05E7\u05D0 \u05E4\u05E9\u05D5\u05D8\u2026
          \u05D4\u05D5\u05D0 \u05E4\u05E9\u05D5\u05D8 \u05D4\u05E9\u05EA\u05DE\u05E9
          \u05D1\u2026)"
        commands: []
    - rid: 2649295592630780067
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D7\u05D5\u05E9\u05D1 \u05E9\u05D4\u05D5\u05D0
          \u05D4\u05E9\u05EA\u05DE\u05E9 \u05D1\u05D3\u05E8\u05DA \u05D4\u05E7\u05DC\u05D4\u2026"
        commands:
        - rid: 2649295592630780113
    - rid: 2649295592630780068
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E9\u05D4\u05DC\u05DB\u05EA\u05D9 \u05DC\u05D9\u05D5\u05D0\u05D1,
          \u05DE\u05E6\u05D0\u05EA\u05D9 \u05E7\u05D5\u05E4\u05E1\u05D4 \u05E2\u05DD
          \u05DB\u05DE\u05D4 \u05DE\u05D1\u05E8\u05D2\u05D9\u05DD, \u05D0\u05D1\u05DC
          \u05D4\u05D9\u05D4 \u05D7\u05E1\u05E8 \u05D0\u05D7\u05D3. \u05D4\u05E8\u05D5\u05E6\u05D7
          \u05D1\u05D8\u05D7 \u05DC\u05E7\u05D7 \u05D0\u05EA \u05D0\u05D7\u05D3 \u05D4\u05DE\u05D1\u05E8\u05D2\u05D9\u05DD
          \u05D5\u05D4\u05D1\u05E8\u05D9\u05D2 \u05D4\u05D7\u05D5\u05E6\u05D4 \u05D0\u05EA
          \u05D4\u05D0\u05E8\u05D9\u05D7."
        commands: []
    - rid: 2649295592630780069
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D3\u05D9\u05D5\u05E7\u2026 \u05DB\u05DC \u05D4\u05DE\u05D1\u05E0\u05D4
          \u05D4\u05D6\u05D4 \u05D1\u05E0\u05D5\u05D9 \u05D1\u05E6\u05D5\u05E8\u05D4
          \u05DE\u05D2\u05D5\u05D7\u05DB\u05EA. \u05DB\u05DC \u05D4\u05D0\u05E8\u05D9\u05D7\u05D9\u05DD
          \u05DE\u05D7\u05D5\u05D1\u05E8\u05D9\u05DD \u05E2\u05DD \u05D1\u05E8\u05D2\u05D9\u05DD
          \u05DC\u05EA\u05E7\u05E8\u05D4, \u05D4\u05E8\u05D5\u05E6\u05D7 \u05DB\u05E0\u05E8\u05D0\u05D4
          \u05D1\u05D0\u05DE\u05EA \u05D4\u05D1\u05E8\u05D9\u05D2 \u05D0\u05D7\u05D3
          \u05D4\u05D7\u05D5\u05E6\u05D4\u2026"
        commands:
        - rid: 2649295592630780114
    - rid: 2649295592630780070
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05E2\u05D3\u05D9\u05D9\u05DF \u05D9\u05E9 \u05D1\u05E2\u05D9\u05D4."
        commands:
        - rid: 2649295592630780115
    - rid: 2649295592630780071
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05E2\u05D9\u05D4?"
        commands:
        - rid: 2649295592630780116
    - rid: 2649295592630780072
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DA \u05D4\u05D5\u05D0 \u05D4\u05D9\u05D4 \u05D9\u05DB\u05D5\u05DC
          \u05DC\u05E2\u05E9\u05D5\u05EA \u05D0\u05EA \u05DB\u05DC \u05D6\u05D4 \u05D3\u05E8\u05DA
          \u05D4\u05D7\u05DC\u05D5\u05DF \u05D4\u05D2\u05D1\u05D5\u05D4 \u05D4\u05D6\u05D4?"
        commands:
        - rid: 2649295592630780117
    - rid: 2649295592630780073
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 2649295592630780074
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF \u05D6\u05D4 \u05E0\u05DB\u05D5\u05DF\u2026 \u05D4\u05D7\u05DC\u05D5\u05DF
          \u05D4\u05D6\u05D4 \u05D3\u05D9 \u05D2\u05D1\u05D5\u05D4, \u05DC\u05E4\u05D7\u05D5\u05EA
          \u05E9\u05E0\u05D9 \u05DE\u05D8\u05E8 \u05DE\u05E2\u05DC \u05D4\u05D0\u05D3\u05DE\u05D4."
        commands:
        - rid: 2649295592630780118
    - rid: 2649295592630780075
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D4\u05E8\u05D5\u05E6\u05D7 \u05D4\u05D5\u05D0 \u05DE\u05D9\u05E9\u05D4\u05D5
          \u05DE\u05DE\u05E9 \u05D2\u05D1\u05D5\u05D4? \u05D6\u05D0\u05EA \u05DC\u05D0
          \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05D4\u05D9\u05D5\u05EA \u05D0\u05E0\u05D9,
          \u05D0\u05E0\u05D9 \u05DE\u05D8\u05E8 \u05E9\u05D9\u05E9\u05D9\u05DD."
        commands:
        - rid: 2649295592630780119
    - rid: 2649295592630780076
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D2\u05DD \u05D1\u05E9\u05D1\u05D9\u05DC \u05D1\u05DF \u05D0\u05D3\u05DD
          \u05D2\u05D1\u05D5\u05D4, \u05D6\u05D4 \u05D9\u05D4\u05D9\u05D4 \u05E7\u05E9\u05D4
          \u05DE\u05D3\u05D9, \u05D0\u05E3 \u05D0\u05D7\u05D3 \u05E4\u05D4 \u05DC\u05D0
          \u05D1\u05D2\u05D5\u05D1\u05D4 \u05E9\u05E0\u05D9 \u05DE\u05D8\u05E8\u2026"
        commands:
        - rid: 2649295592630780120
    - rid: 2649295592630780077
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D5\u05DC\u05D9 \u05DE\u05D9\u05E9\u05D4\u05D5 \u05D1\u05D9\u05E7\u05E9
          \u05DE\u05D4\u05E7\u05D5\u05E1\u05DD \u05E9\u05D9\u05E7\u05D5\u05D9 \u05D2\u05D5\u05D1\u05D4?"
        commands:
        - rid: 2649295592630780121
    - rid: 2649295592630780078
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05DE\u05EA\u05D9 \u05D9\u05E9 \u05E4\u05D4 \u05E7\u05D5\u05E1\u05DD?"
        commands:
        - rid: 2649295592630780122
    - rid: 2649295592630780079
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D0\u05DD \u05D4\u05D9\u05D9\u05EA\u05D4 \u05D3\u05E8\u05DA
          \u05E9\u05DE\u05D9\u05E9\u05D4\u05D5 \u05D9\u05D2\u05D9\u05E2 \u05DC\u05D2\u05D5\u05D1\u05D4
          \u05D4\u05D6\u05D4? \u05D0\u05D5\u05DC\u05D9 \u05D1\u05E2\u05D6\u05E8\u05EA\u2026)"
        commands: []
    - rid: 2649295592630780080
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05DC\u05D2\u05D1\u05D9 \u05D4\u05E8\u05DB\u05D6\u05EA
          \u05DE\u05D9\u05DD?"
        commands:
        - rid: 2649295592630780124
    - rid: 2649295592630780081
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05E8\u05DB\u05D6\u05EA?"
        commands:
        - rid: 2649295592630780125
    - rid: 2649295592630780082
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05E8\u05DB\u05D6\u05EA \u05E0\u05DE\u05E6\u05D0\u05EA \u05DE\u05DE\u05E9
          \u05D1\u05D9\u05DF \u05E9\u05E0\u05D9 \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD,
          \u05D4\u05D9\u05D0 \u05D3\u05D9 \u05D2\u05D3\u05D5\u05DC\u05D4, \u05D5\u05E7\u05E8\u05D5\u05D1\u05D4
          \u05DC\u05E7\u05D9\u05E8 \u05E9\u05DC \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD."
        commands:
        - rid: 2649295592630780126
    - rid: 2649295592630780083
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D9\u05E9\u05D4\u05D5 \u05D4\u05D9\u05D4 \u05D9\u05DB\u05D5\u05DC
          \u05DC\u05D8\u05E4\u05E1 \u05E2\u05DC \u05D4\u05E8\u05DB\u05D6\u05EA, \u05D5\u05DE\u05E9\u05DD
          \u05DC\u05D4\u05D2\u05D9\u05E2 \u05DC\u05D7\u05DC\u05D5\u05DF \u05D1\u05D4\u05E8\u05D1\u05D4
          \u05D9\u05D5\u05EA\u05E8 \u05E7\u05DC\u05D5\u05EA."
        commands: []
    - rid: 2649295592630780084
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA\u2026"
        commands: []
    - rid: 2649295592630780085
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05DB\u05D0\u05DF \u05E2\u05D5\u05DC\u05D4 \u05D4\u05E9\u05D0\u05DC\u05D4,
          \u05DE\u05D9 \u05D4\u05D9\u05D4 \u05D9\u05DB\u05D5\u05DC \u05DC\u05E2\u05E9\u05D5\u05EA
          \u05D0\u05EA \u05D6\u05D4?"
        commands:
        - rid: 2649295592630780127
    - rid: 2649295592630780086
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:

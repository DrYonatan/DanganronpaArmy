    - rid: 2649295605456438036
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E8\u05D2\u05E2 \u05D0\u05D7\u05D3. \u05D6\u05D4 \u05D0\u05D5\u05DE\u05E8
          \u05E9\u2026)"
        commands:
        - rid: 6008430280376320086
    - rid: 2649295605456438037
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DC\u05D5\u05DF?"
        commands: []
    - rid: 2649295605456438038
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA \u05E9\u05D0\u05E0\u05D7\u05E0\u05D5
          \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD \u05DC\u05D3\u05E2\u05EA \u05DE\u05D9
          \u05D4\u05E8\u05D5\u05E6\u05D7\u05EA \u05D1\u05EA\u05D9\u05E7 \u05D4\u05D6\u05D4\u2026"
        commands: []
    - rid: 2649295605456438039
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4? \u05D0\u05D9\u05DA?"
        commands: []
    - rid: 2649295605456438040
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05D4 \u05D1\u05D0\u05DE\u05EA \u05D9\u05D5\u05D3\u05E2
          \u05D0\u05DC\u05D5\u05DF?"
        commands: []
    - rid: 2649295605456438041
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05E8\u05D5\u05E6\u05D7\u05EA \u05D4\u05D9\u05D0\u2026 \u05DE\u05D0\u05D9\u05D4."
        commands:
        - rid: 2649295605456438055
    - rid: 2649295605456438042
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026\u05D0\u05E0\u05D9?"
        commands: []
    - rid: 2649295605456438043
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D0\u05D9\u05D4\u2026?"
        commands: []
    - rid: 2649295605456438044
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D0\u05EA\u05D4 \u05DE\u05D6\u05D9\u05D9\u05DF."
        commands: []
    - rid: 2649295605456438045
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05E7\u05D5\u05D5\u05D4 \u05E9\u05D9\u05E9
          \u05DC\u05DA \u05D4\u05D5\u05DB\u05D7\u05D5\u05EA \u05DE\u05E1\u05E4\u05E7\u05D5\u05EA
          \u05DB\u05D3\u05D9 \u05DC\u05E2\u05E9\u05D5\u05EA \u05D4\u05D0\u05E9\u05DE\u05D5\u05EA
          \u05DB\u05D0\u05DC\u05D4 \u05D0\u05DC\u05D5\u05DF! \u05D0\u05E0\u05D9 \u05DC\u05D0
          \u05DE\u05D1\u05D9\u05D0 \u05DC\u05D7\u05D9\u05D9\u05DC \u05D3\u05D5\"\u05D7
          \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D0\u05E0\u05D9 \u05DE\u05D5\u05D5\u05D3\u05D0
          \u05E2\u05DD \u05E1\u05E8\u05D2\u05DC \u05E9\u05D4\u05E9\u05D9\u05E2\u05E8
          \u05E9\u05DC\u05D5 \u05DC\u05D0 \u05EA\u05E7\u05E0\u05D9."
        commands: []
    - rid: 2649295605456438046
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E7\u05D5\u05D3\u05DD, \u05D1\u05D6\u05DE\u05DF \u05D4\u05D7\u05E7\u05D9\u05E8\u05D4,
          \u05D3\u05D9\u05D1\u05E8\u05EA\u05D9 \u05E2\u05DD \u05E2\u05E0\u05D1\u05DC.
          \u05D5\u05D4\u05D9\u05D0 \u05D0\u05DE\u05E8\u05D4 \u05DC\u05D9 \u05DE\u05E9\u05D4\u05D5
          \u05DE\u05E2\u05E0\u05D9\u05D9\u05DF."
        commands: []
    - rid: 2649295605456438047
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05E0\u05DB\u05E0\u05E1\u05E0\u05D5 \u05DC\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9
          \u05D1\u05E0\u05D5\u05EA, \u05D5\u05D4\u05EA\u05D7\u05DC\u05E0\u05D5 \u05DC\u05E0\u05E7\u05D5\u05EA
          \u05D9\u05E9\u05E8\u2026 \u05D4\u05E1\u05E4\u05E7\u05EA\u05D9 \u05DC\u05E0\u05E7\u05D5\u05EA
          \u05E8\u05E7 \u05D0\u05EA \u05D4\u05DB\u05D9\u05D5\u05E8\u05D9\u05DD, \u05D5\u05DE\u05D0\u05D9\u05D4
          \u05E0\u05D9\u05E7\u05EA\u05D4 \u05DB\u05DE\u05D4 \u05DE\u05D4\u05EA\u05D0\u05D9\u05DD\u2026
          \u05DC\u05D0 \u05D4\u05E1\u05E4\u05E7\u05E0\u05D5 \u05DC\u05E9\u05D8\u05D5\u05E3
          \u05D0\u05EA \u05D4\u05E8\u05E6\u05E4\u05D4 \u05E2\u05D3\u05D9\u05D9\u05DF."
        commands:
        - rid: 6008430280376320088
    - rid: 2649295605456438048
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05D0\u05E0\u05D7\u05E0\u05D5 \u05DE\u05D0\u05DE\u05D9\u05E0\u05D9\u05DD
          \u05DC\u05DE\u05D4 \u05E9\u05D4\u05D9\u05D0 \u05D0\u05D5\u05DE\u05E8\u05EA,
          \u05D6\u05D4 \u05D0\u05D5\u05DE\u05E8 \u05E9\u05DE\u05D0\u05D9\u05D4 \u05D4\u05D9\u05D9\u05EA\u05D4
          \u05D1\u05EA\u05D5\u05DA \u05D4\u05EA\u05D0\u05D9\u05DD \u05D1\u05D6\u05DE\u05DF
          \u05D4\u05E8\u05E6\u05D7. \u05D0\u05D6 \u05D4\u05D9\u05D0 \u05D4\u05D9\u05D7\u05D9\u05D3\u05D4
          \u05E9\u05D9\u05DB\u05DC\u05D4 \u05DC\u05D4\u05D5\u05E8\u05D9\u05D3 \u05D0\u05EA
          \u05D4\u05DE\u05D9\u05DD!"
        commands:
        - rid: 6008430280376320089
    - rid: 2649295605456438049
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D0\u05EA\u05D4 \u05DE\u05E4\u05D2\u05E8? \u05DC\u05DE\u05D4
          \u05E9\u05E0\u05D0\u05DE\u05D9\u05DF \u05DC\u05D4? \u05D4\u05D9\u05D0 \u05D9\u05DB\u05D5\u05DC\u05D4
          \u05DC\u05D4\u05D9\u05D5\u05EA \u05D4\u05E8\u05D5\u05E6\u05D7\u05EA \u05D1\u05D0\u05D5\u05EA\u05D4
          \u05DE\u05D9\u05D3\u05D4!\r"
        commands: []
    - rid: 2649295605456438050
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF\u2026 \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2\u05EA
          \u05D0\u05DD \u05E2\u05D3\u05D5\u05EA \u05E9\u05DC \u05D0\u05D7\u05EA \u05D4\u05D7\u05E9\u05D5\u05D3\u05D5\u05EA

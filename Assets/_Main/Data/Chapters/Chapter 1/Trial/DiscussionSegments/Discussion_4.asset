    - rid: 2649295587089055887
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05D9\u05E6\u05DF, \u05DC\u05D0 \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05EA\u05D2\u05E0\u05D1 \u05DC\u05EA\u05D5\u05DA
          \u05D4\u05EA\u05D0\u2026"
        commands:
        - rid: 2649295587089055902
    - rid: 2649295587089055888
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05DE? \u05DC\u05DE\u05D4?"
        commands:
        - rid: 2649295587089055903
    - rid: 2649295587089055889
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05EA\u05D6\u05DB\u05E8\u05D9 \u05D0\u05D9\u05E4\u05D4 \u05DE\u05E6\u05D0\u05E0\u05D5
          \u05D0\u05EA \u05D4\u05D2\u05D5\u05E4\u05D4."
        commands: []
    - rid: 2649295587089055890
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D4\u05D9\u05D4 \u05D1\u05EA\u05D5\u05DA \u05D4\u05EA\u05D0.
          \u05D0\u05DD \u05D4\u05D9\u05D9\u05EA\u05D9 \u05DC\u05D5\u05E7\u05D7 \u05D0\u05EA
          \u05D4\u05D0\u05E8\u05D9\u05D7 \u05DE\u05D4\u05EA\u05D0 \u05D5\u05D9\u05D5\u05E6\u05D0,
          \u05D4\u05D9\u05D9\u05EA\u05D9 \u05E6\u05E8\u05D9\u05DA \u05DC\u05D4\u05E8\u05D5\u05D2
          \u05D0\u05D5\u05EA\u05D5 \u05D1\u05D7\u05D5\u05E5, \u05D5\u05D0\u05D6 \u05D4\u05D2\u05D5\u05E4\u05D4
          \u05DC\u05D0 \u05D4\u05D9\u05D9\u05EA\u05D4 \u05E0\u05DE\u05E6\u05D0\u05EA
          \u05D1\u05EA\u05D5\u05DA \u05D4\u05EA\u05D0!"
        commands:
        - rid: 2649295587089055905
    - rid: 2649295587089055891
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 2649295587089055892
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05DB\u05D5\u05DC\u05EA \u05E4\u05E9\u05D5\u05D8 \u05DC\u05D4\u05D6\u05D9\u05D6
          \u05D0\u05EA \u05D4\u05D2\u05D5\u05E4\u05D4 \u05E4\u05E0\u05D9\u05DE\u05D4
          \u05D0\u05D7\u05E8\u05D9 \u05D4\u05E8\u05E6\u05D7."
        commands:
        - rid: 2649295587089055906
    - rid: 2649295587089055893
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D9\u05D0 \u05E2\u05D3\u05D9\u05D9\u05DF \u05DC\u05D0 \u05D4\u05E9\u05EA\u05DB\u05E0\u05E2\u05D4\u2026?)"
        commands: []
    - rid: 2649295587089055894
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05D2\u05DE\u05E8\u05EA \u05E2\u05DC
          \u05D1\u05E8\u05D2\u05E8."
        commands:
        - rid: 2649295587089055907
    - rid: 2649295587089055895
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D4\u05D9\u05D0 \u05E6\u05D5\u05D3\u05E7\u05EA!
          \u05E2\u05E0\u05D1\u05DC \u05D5\u05DE\u05D0\u05D9\u05D4 \u05D1\u05D0\u05D5
          \u05DC\u05E8\u05D0\u05D5\u05EA \u05E8\u05E7 \u05DB\u05E9\u05D0\u05DC\u05D5\u05DF
          \u05E6\u05E2\u05E7, \u05E0\u05DB\u05D5\u05DF?"
        commands:
        - rid: 2649295587089055908
    - rid: 2649295587089055896
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF\u2026"
        commands:
        - rid: 2649295587089055909
    - rid: 2649295587089055897
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DB\u05DF."
        commands:
        - rid: 2649295587089055910
    - rid: 2649295587089055898
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D4\u05D5\u05D0 \u05D4\u05D9\u05D4 \u05D9\u05DB\u05D5\u05DC
          \u05DC\u05E8\u05E6\u05D5\u05D7 \u05D0\u05D5\u05EA\u05D5, \u05DC\u05D4\u05D6\u05D9\u05D6
          \u05D0\u05EA \u05D4\u05D2\u05D5\u05E4\u05D4 \u05DC\u05EA\u05D5\u05DA \u05D4\u05EA\u05D0,
          \u05D5\u05E8\u05E7 \u05D0\u05D6 \u05DC\u05E6\u05E2\u05D5\u05E7 \u05DC\u05D4\u05DF."
        commands:
        - rid: 2649295587089055911
    - rid: 2649295587089055899
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05D4\u05D9\u05D9\u05EA\u05D9 \u05E6\u05E8\u05D9\u05DA
          \u05DC\u05E2\u05E9\u05D5\u05EA \u05D0\u05EA \u05DB\u05DC \u05D6\u05D4 \u05D0\u05D9\u05DF
          \u05D0\u05D5\u05EA\u05D9."
        commands:
        - rid: 2649295587089055912
    - rid: 2649295587089055900
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E2\u05D3\u05D9\u05D9\u05DF \u05D7\u05D5\u05E9\u05D3\u05D9\u05DD
          \u05D1\u05D9\u2026)"
        commands: []
    - rid: 2649295587089055901
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D1\u05DC \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D9\u05DB\u05D5\u05DC
          \u05DC\u05D5\u05D5\u05EA\u05E8. \u05D0\u05E0\u05D7\u05E0\u05D5 \u05D7\u05D9\u05D9\u05D1\u05D9\u05DD
          \u05DC\u05D2\u05DC\u05D5\u05EA \u05D0\u05EA \u05D4\u05D0\u05DE\u05EA!)"
        commands: []
    - rid: 2649295587089055902
      type: {class: PlaySoundEffectCommand, ns: , asm: Assembly-CSharp}

    - rid: 2649295587089055774
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D7\u05D1\u05E8\u05D9\u05DD, \u05D7\u05D1\u05E8\u05D9\u05DD! \u05D0\u05D9\u05E4\u05D4
          \u05E0\u05E8\u05D0\u05D4 \u05DC\u05DB\u05DD \u05E9\u05D0\u05EA\u05DD \u05E0\u05DE\u05E6\u05D0\u05D9\u05DD,
          \u05D1\u05D2\u05E0\u05D5\u05DF? \u05D0\u05D9\u05DF \u05DC\u05D3\u05D1\u05E8
          \u05D4\u05D6\u05D4 \u05E6\u05D5\u05E8\u05D4."
        commands:
        - rid: 2649295587089055783
    - rid: 2649295587089055775
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E7\u05E6\u05EA \u05EA\u05E8\u05D1\u05D5\u05EA \u05D3\u05D9\u05D5\u05DF!
          \u05DC\u05D0 \u05E0\u05EA\u05E7\u05D3\u05DD \u05DC\u05E9\u05D5\u05DD \u05DE\u05E7\u05D5\u05DD
          \u05D0\u05DD \u05D0\u05EA\u05DD \u05E7\u05D5\u05D8\u05E2\u05D9\u05DD \u05D0\u05D7\u05D3
          \u05D0\u05EA \u05D4\u05E9\u05E0\u05D9."
        commands: []
    - rid: 2649295587089055776
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05DD \u05D9\u05D5\u05D3\u05E2\u05D9\u05DD, \u05D4\u05D9\u05E4\u05E0\u05D9\u05DD
          \u05DE\u05D7\u05DB\u05D9\u05DD 3 \u05E9\u05E0\u05D9\u05D5\u05EA \u05D0\u05D7\u05E8\u05D9
          \u05E9\u05D0\u05D7\u05D3 \u05DE\u05E1\u05D9\u05D9\u05DD \u05DC\u05D3\u05D1\u05E8
          \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05E9\u05E0\u05D9 \u05DE\u05D3\u05D1\u05E8.
          \u05D0\u05D5\u05DC\u05D9 \u05EA\u05D5\u05DB\u05DC\u05D5 \u05DC\u05DC\u05DE\u05D5\u05D3
          \u05DE\u05D4\u05DD \u05D3\u05D1\u05E8 \u05D0\u05D5 \u05E9\u05E0\u05D9\u05D9\u05DD."
        commands:
        - rid: 2649295587089055784
    - rid: 2649295587089055777
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05E7\u05D3\u05D9\u05DE\u05D4! \u05DC\u05E0\u05E1\u05D5\u05EA
          \u05E9\u05D5\u05D1. \u05DB\u05D3\u05D0\u05D9 \u05DE\u05D0\u05D5\u05D3 \u05E9\u05D4\u05D3\u05D1\u05E8
          \u05D4\u05D6\u05D4 \u05DC\u05D0 \u05D9\u05D7\u05D6\u05D5\u05E8 \u05E2\u05DC
          \u05E2\u05E6\u05DE\u05D5."
        commands:
        - rid: 2649295587089055785
    - rid: 2649295587089055778
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E2\u05D3 \u05DB\u05DE\u05D4 \u05E9\u05D0\u05E0\u05D9 \u05E9\u05D5\u05E0\u05D0
          \u05DC\u05D4\u05E1\u05DB\u05D9\u05DD \u05D0\u05D9\u05EA\u05D5, \u05D1\u05D0\u05DE\u05EA
          \u05DC\u05D0 \u05E0\u05EA\u05E7\u05D3\u05DD \u05DC\u05E9\u05D5\u05DD \u05DE\u05E7\u05D5\u05DD
          \u05D0\u05DD \u05D0\u05E0\u05D7\u05E0\u05D5 \u05DC\u05D0 \u05DE\u05E6\u05DC\u05D9\u05D7\u05D9\u05DD
          \u05DC\u05D3\u05D1\u05E8."
        commands:
        - rid: 2649295587089055786
    - rid: 2649295587089055779
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D8\u05D5\u05D1, \u05DE\u05E2\u05DB\u05E9\u05D9\u05D5 \u05DB\u05D5\u05DC\u05DD
          \u05DC\u05D4\u05E9\u05EA\u05D3\u05DC \u05DC\u05D7\u05DB\u05D5\u05EA \u05D1\u05E1\u05D1\u05DC\u05E0\u05D5\u05EA
          \u05D5\u05DC\u05EA\u05EA \u05DC\u05D0\u05E0\u05E9\u05D9\u05DD \u05DC\u05E1\u05D9\u05D9\u05DD
          \u05D0\u05EA \u05D4\u05DE\u05E9\u05E4\u05D8."
        commands:
        - rid: 2649295587089055787
    - rid: 2649295587089055780
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05D0\u05DC\u05DC\u05D4 \u05D2\u05DD \u05DB\u05DF, \u05DE\u05D9
          \u05D0\u05EA\u05DD \u05E9\u05EA\u05D2\u05D9\u05D3\u05D5 \u05DC\u05D9 \u05D0\u05D9\u05DA
          \u05DC\u05D3\u05D1\u05E8?"
        commands:
        - rid: 2649295587089055788
    - rid: 2649295587089055781
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E7\u05D3\u05D9\u05DE\u05D4 \u05D7\u05D1\u05E8\u05D9\u05DD! \u05EA\u05D7\u05D6\u05E8\u05D5
          \u05DC\u05D3\u05D5\u05DF, \u05D5\u05D4\u05E4\u05E2\u05DD \u05D0\u05E0\u05D9
          \u05DE\u05E6\u05E4\u05D4 \u05DE\u05DB\u05DD \u05DC\u05D4\u05D9\u05E9\u05D0\u05E8
          \u05DE\u05EA\u05D5\u05E8\u05D1\u05EA\u05D9\u05DD."
        commands:
        - rid: 2649295587089055789
    - rid: 2649295587089055782
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D1\u05E9\u05DC\u05D1 \u05D4\u05D6\u05D4 \u05D0\u05D9\u05DF \u05DE\u05D4
          \u05DC\u05E2\u05E9\u05D5\u05EA \u05D7\u05D5\u05E5 \u05DE\u05DC\u05D4\u05EA\u05E4\u05DC\u05DC\u2026)"
        commands: []

    - rid: 2649295747132948617
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05E9 \u05DE\u05E9\u05D4\u05D5 \u05E9\u05E9\u05DB\u05D7\u05EA\u05D9\u2026?"
        commands: []
    - rid: 2649295747132948618
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0, \u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9 \u05E9\u05D6\u05D4
          \u05D4\u05DB\u05DC\u2026"
        commands: []
    - rid: 2649295747132948619
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D0\u05D9\u05D4, \u05D9\u05E9 \u05DC\u05DA \u05D4\u05EA\u05E0\u05D2\u05D3\u05D5\u05D9\u05D5\u05EA
          \u05DB\u05DC\u05E9\u05D4\u05DF?"
        commands: []
    - rid: 2649295747132948620
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 2649295747132948621
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D0\u05D9\u05D4\u2026?"
        commands: []
    - rid: 2649295747132948622
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 2649295747132948623
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0. \u05D0\u05D9\u05DF \u05DC\u05D9 \u05DE\u05D4 \u05DC\u05D5\u05DE\u05E8."
        commands: []
    - rid: 2649295747132948624
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0\u2026 \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D9\u05DB\u05D5\u05DC\u05D4
          \u05DC\u05D4\u05D0\u05DE\u05D9\u05DF \u05DC\u05D6\u05D4\u2026"
        commands: []
    - rid: 2649295747132948625
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DE\u05D0\u05D9\u05D4\u2026 \u05DE\u05D4 \u05E7\u05E8\u05D4?)"
        commands: []
    - rid: 2649295747132948626
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05DB\u05D5\u05DC\u05DB\u05DD \u05D4\u05D7\u05DC\u05D8\u05EA\u05DD,
          \u05D4\u05D2\u05D9\u05E2 \u05D4\u05D6\u05DE\u05DF \u05DC\u05D4\u05E6\u05D1\u05E2\u05D4!"
        commands: []
    - rid: 2649295747132948627
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05DB\u05D5\u05DC\u05DB\u05DD \u05D9\u05E9 \u05DB\u05E4\u05EA\u05D5\u05E8
          \u05DC\u05E4\u05E0\u05D9\u05DB\u05DD. \u05D0\u05E0\u05D0 \u05D1\u05D7\u05E8\u05D5
          \u05D0\u05EA \u05DE\u05D9 \u05E9\u05D0\u05EA\u05DD \u05D7\u05D5\u05E9\u05D1\u05D9\u05DD
          \u05E9\u05D4\u05D5\u05D0 \u05D4\u05DE\u05D5\u05E9\u05D7\u05E8!"
        commands: []
    - rid: 2649295747132948628
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D9\u05E7\u05E8\u05D4 \u05DE\u05D4 \u05D9\u05E7\u05E8\u05D4?
          \u05DE\u05D9 \u05D4\u05D5\u05D0 \u05D4\u05DE\u05D5\u05E9\u05D7\u05E8? \u05D4\u05D0\u05DD
          \u05D1\u05D7\u05E8\u05EA\u05DD \u05E0\u05DB\u05D5\u05DF?"
        commands: []
    - rid: 2649295747132948629
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05D6\u05D4 \u05DE\u05EA\u05D7!"
        commands: []

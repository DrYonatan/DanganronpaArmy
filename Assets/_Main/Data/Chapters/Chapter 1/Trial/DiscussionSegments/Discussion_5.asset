    - rid: 2649295592630779940
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05DC\u05D0 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA."
        commands:
        - rid: 2649295592630779971
        - rid: 2649295592630779973
        - rid: 6008430257998659597
    - rid: 2649295592630779941
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E1\u05DC\u05D9\u05D7\u05D4?"
        commands:
        - rid: 2649295592630779972
    - rid: 2649295592630779942
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05E8\u05E6\u05D7\u05EA\u05D9 \u05D0\u05EA \u05E8\u05D5\u05E2\u05D9
          \u05DE\u05D7\u05D5\u05E5 \u05DC\u05EA\u05D0, \u05D5\u05D0\u05D6 \u05D2\u05E8\u05E8\u05EA\u05D9
          \u05D0\u05D5\u05EA\u05D5 \u05E4\u05E0\u05D9\u05DE\u05D4\u2026"
        commands:
        - rid: 2649295592630779975
    - rid: 2649295592630779943
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05DC\u05DE\u05D4 \u05D9\u05E9 \u05E1\u05D9\u05DE\u05E0\u05D9
          \u05D3\u05DD \u05E2\u05DC \u05D4\u05E7\u05D9\u05E8\u05D5\u05EA \u05E9\u05DC
          \u05D4\u05EA\u05D0?"
        commands:
        - rid: 2649295592630779974
    - rid: 2649295592630779944
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E1\u05D9\u05DE\u05E0\u05D9 \u05D3\u05DD\u2026?"
        commands: []
    - rid: 2649295592630779945
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05EA\u05D5\u05DA \u05D4\u05EA\u05D0, \u05DE\u05DE\u05E9 \u05DC\u05D9\u05D3
          \u05D4\u05D2\u05D5\u05E4\u05D4\u2026 \u05D4\u05D9\u05D5 \u05E9\u05E4\u05E8\u05D9\u05E6\u05D9\u05DD
          \u05E7\u05D8\u05E0\u05D9\u05DD \u05E9\u05DC \u05D3\u05DD \u05E2\u05DC \u05D4\u05E7\u05D9\u05E8\u05D5\u05EA."
        commands: []
    - rid: 2649295592630779946
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05DE\u05E8\u05D0\u05D4 \u05E9\u05D4\u05E4\u05D2\u05D9\u05E2\u05D4
          \u05E7\u05E8\u05EA\u05D4 \u05D1\u05EA\u05D5\u05DA \u05D4\u05EA\u05D0!"
        commands:
        - rid: 2649295592630779976
    - rid: 2649295592630779947
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05DC\u05D0 \u05D9\u05DB\u05D5\u05DC\u05EA \u05E4\u05E9\u05D5\u05D8
          \u05DC\u05D6\u05D9\u05D9\u05E3 \u05D0\u05EA \u05D6\u05D4 \u05DB\u05D3\u05D9
          \u05E9\u05D6\u05D4 \u05D9\u05E8\u05D0\u05D4 \u05DB\u05D0\u05D9\u05DC\u05D5
          \u05D4\u05E8\u05E6\u05D7 \u05E7\u05E8\u05D4 \u05E9\u05DD?"
        commands:
        - rid: 2649295592630779977
    - rid: 2649295592630779948
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D9\u05D9\u05EA \u05D9\u05DB\u05D5\u05DC \u05DC\u05E7\u05D7\u05EA
          \u05E7\u05E6\u05EA \u05D3\u05DD \u05DE\u05DE\u05E0\u05D5, \u05D5\u05DC\u05DE\u05E8\u05D5\u05D7
          \u05E2\u05DC \u05D4\u05E7\u05D9\u05E8\u05D5\u05EA. \u05D9\u05E9 \u05E9\u05DD
          \u05D0\u05E4\u05D9\u05DC\u05D5 \u05DB\u05D9\u05D5\u05E8\u05D9\u05DD \u05DC\u05E9\u05D8\u05D5\u05E3
          \u05D9\u05D3\u05D9\u05D9\u05DD \u05D0\u05D7\u05E8\u05D9."
        commands:
        - rid: 2649295592630779978
    - rid: 2649295592630779949
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DB\u05E1\u05D4!!"
        commands:
        - rid: 2649295592630779979
    - rid: 2649295592630779950
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05DC\u05D0 \u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9 \u05D4\u05D2\u05D9\u05D5\u05E0\u05D9
          \u05DB\u05DC \u05DB\u05DA\u2026"
        commands:
        - rid: 2649295592630779980
    - rid: 2649295592630779951
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05E9 \u05D4\u05DE\u05D5\u05DF \u05E9\u05E4\u05E8\u05D9\u05E6\u05D9\u05DD
          \u05E7\u05D8\u05E0\u05D9\u05DD\u2026 \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D7\u05D5\u05E9\u05D1
          \u05E9\u05DB\u05DC \u05DB\u05DA \u05E7\u05DC \u05DC\u05D6\u05D9\u05D9\u05E3
          \u05D0\u05EA \u05D6\u05D4."
        commands: []
    - rid: 2649295592630779952
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D9\u05D4 \u05E6\u05E8\u05D9\u05DA \u05D0\u05D5\u05DE\u05DF
          \u05DE\u05E0\u05D5\u05E1\u05D4 \u05D1\u05E9\u05D1\u05D9\u05DC \u05D3\u05D1\u05E8
          \u05DB\u05D6\u05D4\u2026"
        commands:
        - rid: 2649295592630779981
    - rid: 2649295592630779953
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D1\u05E0\u05D5\u05E1\u05E3, \u05D4\u05D9\u05D4 \u05E6\u05E8\u05D9\u05DA
          \u05DC\u05E0\u05E7\u05D5\u05EA \u05D0\u05EA \u05D4\u05D3\u05DD \u05D1\u05D7\u05D5\u05E5\u2026"
        commands:
        - rid: 2649295592630779982
    - rid: 2649295592630779954
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D2\u05DD \u05D0\u05DD \u05D0\u05DC\u05D5\u05DF \u05D4\u05D9\u05D4
          \u05E2\u05D3 \u05DB\u05D3\u05D9 \u05DB\u05DA \u05DE\u05D5\u05DB\u05E9\u05E8,
          \u05E9\u05D0\u05E0\u05D9 \u05DE\u05EA\u05E7\u05E9\u05D4 \u05DC\u05D4\u05D0\u05DE\u05D9\u05DF
          \u05D1\u05D6\u05D4\u2026"
        commands:
        - rid: 2649295592630779983
    - rid: 2649295592630779955
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D4\u05D9\u05D4 \u05DC\u05D5\u05E7\u05D7 \u05DC\u05D5
          \u05D3\u05D9 \u05D4\u05E8\u05D1\u05D4 \u05D6\u05DE\u05DF \u05DC\u05D0\u05E8\u05D2\u05DF
          \u05DB\u05DB\u05D4 \u05D0\u05EA \u05DB\u05DC \u05D4\u05E1\u05E6\u05E0\u05D4."
        commands: []
    - rid: 2649295592630779956
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DE\u05D4 \u05D6\u05DE\u05DF \u05DE\u05D0\u05D6 \u05E9\u05D4\u05EA\u05D7\u05DC\u05EA\u05DD
          \u05D0\u05EA \u05D4\u05E0\u05E7\u05D9\u05D5\u05E0\u05D5\u05EA \u05DB\u05DC
          \u05D6\u05D4 \u05E7\u05E8\u05D4?"
        commands:
        - rid: 2649295592630779984
    - rid: 2649295592630779957
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05E7 \u05DB\u05DE\u05D4 \u05D3\u05E7\u05D5\u05EA\u2026"
        commands: []
    - rid: 2649295592630779958
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05DC\u05D0 \u05E1\u05D1\u05D9\u05E8 \u05E9\u05D4\u05D9\u05D9\u05EA\u05D9
          \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05E1\u05E4\u05D9\u05E7 \u05DC\u05D4\u05EA\u05D2\u05E0\u05D1,
          \u05DC\u05D4\u05E8\u05D5\u05D2 \u05D0\u05EA \u05E8\u05D5\u05E2\u05D9, \u05DC\u05E0\u05E7\u05D5\u05EA
          \u05D0\u05EA \u05D4\u05D3\u05DD, \u05D5\u05DC\u05DE\u05E8\u05D5\u05D7 \u05D3\u05DD
          \u05D1\u05D0\u05D5\u05E4\u05DF \u05D0\u05DE\u05D9\u05DF \u05E2\u05DC \u05D4\u05EA\u05D0."
        commands:
        - rid: 2649295592630779986
    - rid: 2649295592630779959
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026\u05D1\u05E1\u05D3\u05E8."
        commands:
        - rid: 2649295592630779987
        - rid: 6008430257998659598
    - rid: 2649295592630779960
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA \u05E9\u05D4\u05E6\u05DC\u05D7\u05EA\u05D9
          \u05DC\u05E9\u05DB\u05E0\u05E2 \u05D0\u05D5\u05EA\u05D4 \u05E1\u05D5\u05E3
          \u05E1\u05D5\u05E3 \u05E9\u05D6\u05D4 \u05DC\u05D0 \u05D1\u05D4\u05DB\u05E8\u05D7
          \u05D0\u05E0\u05D9?)"
        commands: []
    - rid: 2649295592630779961
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05DE\u05D9 \u05E2\u05D5\u05D3 \u05D6\u05D4 \u05D4\u05D9\u05D4
          \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA?"
        commands:
        - rid: 2649295592630779989
        - rid: 6008430257998659599
    - rid: 2649295592630779962
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05E8\u05E6\u05D7 \u05E7\u05E8\u05D4 \u05D1\u05D6\u05DE\u05DF
          \u05D4\u05D0\u05DC\"\u05D1\u2026 \u05D7\u05D5\u05E5 \u05DE\u05D0\u05DC\u05D5\u05DF,
          \u05E2\u05E0\u05D1\u05DC \u05D5\u05DE\u05D0\u05D9\u05D4, \u05D0\u05E3 \u05D0\u05D7\u05D3
          \u05DC\u05D0 \u05D4\u05D9\u05D4 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD."
        commands:
        - rid: 2649295592630779990
    - rid: 2649295592630779963
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DC\u05D5\u05DF, \u05D0\u05EA\u05D4 \u05DC\u05D0 \u05E8\u05D0\u05D9\u05EA
          \u05D0\u05E3 \u05D0\u05D7\u05D3 \u05E0\u05DB\u05E0\u05E1 \u05DC\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD,
          \u05E0\u05DB\u05D5\u05DF?"
        commands:
        - rid: 2649295592630779991
    - rid: 2649295592630779964
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026\u05DC\u05D0. \u05DE\u05DE\u05D4 \u05E9\u05E8\u05D0\u05D9\u05EA\u05D9,
          \u05E8\u05E7 \u05D0\u05E0\u05D9 \u05D5\u05E8\u05D5\u05E2\u05D9 \u05D4\u05D9\u05D9\u05E0\u05D5
          \u05E9\u05DD\u2026"
        commands:
        - rid: 2649295592630779992
    - rid: 2649295592630779965
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D0\u05D9\u05DA \u05D6\u05D4 \u05D9\u05DB\u05D5\u05DC
          \u05DC\u05D4\u05D9\u05D5\u05EA?"
        commands:
        - rid: 2649295592630779993
    - rid: 2649295592630779966
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D0\u05E4\u05E9\u05E8\u05D9 \u05E9\u05D0\u05DC\u05D5\u05DF
          \u05D4\u05D5\u05E6\u05D9\u05D0 \u05D0\u05EA \u05D4\u05D0\u05E8\u05D9\u05D7,
          \u05D9\u05E6\u05D0 \u05D0\u05D9\u05EA\u05D5, \u05D7\u05D9\u05DB\u05D4 \u05E9\u05E8\u05D5\u05E2\u05D9
          \u05D9\u05D9\u05DB\u05E0\u05E1 \u05D5\u05D0\u05D6 \u05E0\u05DB\u05E0\u05E1
          \u05D5\u05D4\u05E8\u05D2 \u05D0\u05D5\u05EA\u05D5\u2026"
        commands:
        - rid: 2649295592630779994
    - rid: 2649295592630779967
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D6\u05D4 \u05DB\u05D1\u05E8 \u05E0\u05E8\u05D0\u05D4
          \u05E7\u05E6\u05EA \u05DC\u05D0 \u05D0\u05DE\u05D9\u05DF. \u05D0\u05E0\u05D9
          \u05D0\u05D9\u05E9\u05D9\u05EA \u05DC\u05D0 \u05EA\u05D5\u05E4\u05E1 \u05DE\u05D0\u05DC\u05D5\u05DF
          \u05E2\u05D3 \u05DB\u05D3\u05D9 \u05DB\u05DA \u05E9\u05D0\u05E0\u05D9 \u05D7\u05D5\u05E9\u05D1
          \u05E9\u05D4\u05D5\u05D0 \u05D4\u05D9\u05D4 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D1\u05E6\u05E2
          \u05D0\u05EA \u05DB\u05DC \u05D6\u05D4."
        commands:
        - rid: 2649295592630779995
    - rid: 2649295592630779968
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D0\u05E3 \u05D0\u05D7\u05D3 \u05D0\u05D7\u05E8
          \u05DC\u05D0 \u05D4\u05D9\u05D4 \u05E9\u05DD. \u05D9\u05E9 \u05D0\u05E4\u05E9\u05E8\u05D5\u05EA
          \u05D0\u05D7\u05E8\u05EA?"
        commands:
        - rid: 2649295592630779996
    - rid: 2649295592630779969
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E4\u05E9\u05E8\u05D5\u05EA \u05D0\u05D7\u05E8\u05EA\u2026)"
        commands: []
    - rid: 2649295592630779970
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D0\u05DD \u05D4\u05D9\u05D9\u05EA\u05D4 \u05D3\u05E8\u05DA
          \u05E9\u05DE\u05D9\u05E9\u05D4\u05D5 \u05D9\u05E8\u05E6\u05D7 \u05D0\u05EA
          \u05E8\u05D5\u05E2\u05D9 \u05D1\u05DC\u05D9 \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05D0\u05D9\u05EA\u05D5 \u05E4\u05D9\u05D6\u05D9\u05EA \u05D1\u05E4\u05E0\u05D9\u05DD?)"

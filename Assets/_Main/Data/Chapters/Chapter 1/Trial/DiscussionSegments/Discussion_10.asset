    - rid: 2649295605456437677
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D2\u05E2 \u05D0\u05D7\u05D3 \u05E0\u05D9\u05E6\u05DF, \u05DC\u05D0
          \u05D4\u05D9\u05D9\u05EA\u05D9 \u05D0\u05D5\u05DE\u05E8 \u05E9\u05DC\u05D4\u05EA\u05E2\u05E1\u05E7
          \u05D1\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA \u05DC\u05D0 \u05D4\u05D9\u05D4
          \u05E2\u05D5\u05E9\u05D4 \u05DB\u05DC\u05D5\u05DD."
        commands: []
    - rid: 2649295605456437678
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D6\u05D0\u05EA \u05D0\u05D5\u05DE\u05E8\u05EA? \u05D0\u05D9\u05DA
          \u05D6\u05D4 \u05E2\u05D5\u05D6\u05E8 \u05DC\u05D5?"
        commands: []
    - rid: 2649295605456437679
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D9\u05D4 \u05E4\u05EA\u05E7 \u05E0\u05D5\u05E1\u05E3 \u05D1\u05D9\u05D5\u05D0\u05D1.
          *\"\u05D0\u05D6\u05D4\u05E8\u05D4! \u05E2\u05D5\u05DE\u05E1 \u05DE\u05D9\u05DD
          \u05D1\u05E6\u05D9\u05E0\u05D5\u05E8 \u05E2\u05DC\u05D5\u05DC \u05DC\u05D2\u05E8\u05D5\u05DD
          \u05E8\u05E2\u05E9 \u05D5\u05E8\u05D8\u05D8 \u05DB\u05D1\u05D3, \u05E2\u05DD
          \u05E1\u05DB\u05E0\u05D4 \u05DC\u05E7\u05E8\u05D9\u05E1\u05D4\"*."
        commands: []
    - rid: 2649295605456437680
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05D4\u05D1\u05E0\u05EA\u05D9, \u05DE\u05D4 \u05E7\u05E9\u05D5\u05E8
          \u05D0\u05D7\u05D3 \u05DC\u05E9\u05E0\u05D9?"
        commands: []
    - rid: 2649295605456437681
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05DE\u05D9\u05E9\u05D4\u05D5 \u05E9\u05D9\u05E0\u05D4
          \u05D0\u05EA \u05DB\u05D9\u05D5\u05D5\u05DF \u05D4\u05D6\u05E8\u05D9\u05DE\u05D4,
          \u05D0\u05D5\u05DC\u05D9 \u05D4\u05D5\u05D0 \u05D4\u05D9\u05D4 \u05D9\u05DB\u05D5\u05DC
          \u05DC\u05D9\u05E6\u05D5\u05E8 \u05E2\u05D5\u05DE\u05E1 \u05DE\u05D9\u05DD
          \u05D1\u05E6\u05D9\u05E0\u05D5\u05E8!"
        commands: []
    - rid: 2649295605456437682
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D6\u05D4 \u05D4\u05D9\u05D4 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D2\u05E8\u05D5\u05DD
          \u05DC\"\u05E8\u05E2\u05E9 \u05D5\u05E8\u05D8\u05D8 \u05DB\u05D1\u05D3,
          \u05E2\u05DD \u05E1\u05DB\u05E0\u05D4 \u05DC\u05E7\u05E8\u05D9\u05E1\u05D4\"?"
        commands: []
    - rid: 2649295605456437683
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05E1\u05EA\u05D5\u05D1\u05D1 \u05DB\u05D0\u05DF \u05D5\u05E0\u05D3\u05DC\u05D9\u05E1\u05D8
          \u05E1\u05D3\u05E8\u05EA\u05D9!"
        commands: []
    - rid: 2649295605456437684
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D8\u05D5\u05D1, \u05DB\u05DC \u05D6\u05D4 \u05D8\u05D5\u05D1 \u05D5\u05D9\u05E4\u05D4\u2026
          \u05D0\u05D1\u05DC \u05D4\u05D0\u05DD \u05D6\u05D4 \u05E8\u05DC\u05D5\u05D5\u05E0\u05D8\u05D9?"
        commands: []
    - rid: 2649295605456437685
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05DC\u05D5\u05D5\u05E0\u05D8\u05D9? \u05EA\u05E4\u05E8\u05D8\u05D9!"
        commands: []
    - rid: 2649295605456437686
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DA \u05D0\u05E0\u05D7\u05E0\u05D5 \u05D9\u05D5\u05D3\u05E2\u05D9\u05DD
          \u05E9\u05D9\u05E9 \u05E7\u05E9\u05E8 \u05D1\u05D9\u05DF \u05E8\u05E2\u05E9
          \u05D5\u05E8\u05D8\u05D8 \u05D1\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA
          \u05DC\u05EA\u05D9\u05E7 \u05D4\u05D6\u05D4?"
        commands: []
    - rid: 2649295605456437687
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E7\u05E9\u05E8 \u05D1\u05D9\u05DF \u05E8\u05E2\u05E9 \u05D5\u05E8\u05D8\u05D8
          \u05D1\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA \u05DC\u05EA\u05D9\u05E7
          \u05D4\u05D6\u05D4\u2026 \u05D0\u05E0\u05D9 \u05D7\u05D5\u05E9\u05D1 \u05E9\u05D3\u05D5\u05D5\u05E7\u05D0
          \u05D0\u05E0\u05D7\u05E0\u05D5 \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD \u05DC\u05E8\u05D0\u05D5\u05EA
          \u05D0\u05EA \u05D4\u05E7\u05E9\u05E8.)"
        commands: []
    - rid: 2649295605456437688
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E0\u05D9 \u05E6\u05E8\u05D9\u05DA \u05DC\u05D4\u05E8\u05D0\u05D5\u05EA
          \u05DC\u05D4\u05DD \u05E9\u05D6\u05D4 \u05E8\u05DC\u05D5\u05D5\u05E0\u05D8\u05D9\u2026)"
        commands:
        - rid: 2649295605456437706
    - rid: 2649295605456437689
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05DB\u05DF \u05E8\u05DC\u05D5\u05D5\u05E0\u05D8\u05D9."
        commands:
        - rid: 2649295605456437707
    - rid: 2649295605456437690
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D0\u05D9\u05DA \u05D6\u05D4?"
        commands: []
    - rid: 2649295605456437691
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D6\u05DE\u05DF \u05E9\u05D7\u05E7\u05E8\u05E0\u05D5, \u05E0\u05E2\u05D4
          \u05D0\u05DE\u05E8\u05D4 \u05DE\u05E9\u05D4\u05D5 \u05DE\u05E2\u05E0\u05D9\u05D9\u05DF."
        commands: []
    - rid: 2649295605456437692
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E9\u05DE\u05E2\u05E0\u05D5 \u05E4\u05EA\u05D0\u05D5\u05DD \u05E8\u05E2\u05E9,
          \u05D5\u05D0\u05D6 \u05D4\u05E1\u05EA\u05DB\u05DC\u05E0\u05D5 \u05D1\u05EA\u05D5\u05DA
          \u05D4\u05EA\u05D0 \u05D5\u05E8\u05D0\u05D9\u05E0\u05D5 \u05E9\u05D4\u05D0\u05E8\u05D9\u05D7
          \u05E4\u05E9\u05D5\u05D8 \u05E0\u05E4\u05DC!"
        commands: []
    - rid: 2649295605456437693
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D4\u05D9\u05D4 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9
          \u05D1\u05E0\u05D5\u05EA. \u05D2\u05DD \u05E9\u05DD \u05D4\u05D0\u05E8\u05D9\u05D7
          \u05D1\u05EA\u05D0 \u05D4\u05DE\u05E7\u05D1\u05D9\u05DC \u05E0\u05E4\u05DC,
          \u05D0\u05D7\u05E8\u05D9 \u05E9\u05E0\u05E2\u05D4 \u05D5\u05E0\u05D5\u05D9\u05D4
          \u05E9\u05DE\u05E2\u05D5 \u05E8\u05E2\u05E9."
        commands: []
    - rid: 2649295605456437694
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05DB\u05D5\u05DF \u05E0\u05E2\u05D4?"
        commands: []
    - rid: 2649295605456437695
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05E0\u05DB\u05D5\u05DF! \u05DE\u05D0\u05DE\u05E6\u05E2
          \u05E9\u05D5\u05DD \u05DE\u05E7\u05D5\u05DD \u05D4\u05D9\u05D4 \u05E8\u05E2\u05E9
          \u05E0\u05D5\u05E8\u05D0\u05D9 \u05D5\u05D0\u05D7\u05D3 \u05D4\u05D0\u05E8\u05D9\u05D7\u05D9\u05DD
          \u05E0\u05E4\u05DC!"
        commands: []
    - rid: 2649295605456437696
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D4\u05E8\u05E2\u05E9 \u05D4\u05D6\u05D4 \u05E9\u05E9\u05DE\u05E2\u05EA\u05DF,
          \u05D4\u05D5\u05D0 \u05E0\u05E9\u05DE\u05E2 \u05DB\u05DE\u05D5 \u05E8\u05D8\u05D8
          \u05E9\u05DC \u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA?"
        commands: []
    - rid: 2649295605456437697
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E2\u05DB\u05E9\u05D9\u05D5 \u05E9\u05D0\u05E0\u05D9 \u05D7\u05D5\u05E9\u05D1\u05EA
          \u05E2\u05DC \u05D6\u05D4, \u05D9\u05DB\u05D5\u05DC \u05DE\u05D0\u05D5\u05D3
          \u05DC\u05D4\u05D9\u05D5\u05EA! \u05D1\u05D0\u05D5\u05EA\u05D5 \u05E8\u05D2\u05E2
          \u05DC\u05D0 \u05DE\u05DE\u05E9 \u05D4\u05D1\u05E0\u05EA\u05D9 \u05DE\u05D4
          \u05D6\u05D4 \u05D4\u05E8\u05E2\u05E9 \u05D4\u05D6\u05D4, \u05D0\u05D1\u05DC
          \u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA \u05E0\u05E9\u05DE\u05E2 \u05E7\u05E6\u05EA
          \u05DB\u05DE\u05D5 \u05DE\u05D9\u05DD \u05D6\u05D5\u05E8\u05DE\u05D9\u05DD."
        commands: []
    - rid: 2649295605456437698
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA \u05D6\u05D5\u05DB\u05E8\u05EA \u05D0\u05D9\u05DA \u05D6\u05D4
          \u05E0\u05E9\u05DE\u05E2 \u05E0\u05D5\u05D9\u05D4?"
        commands: []
    - rid: 2649295605456437699
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05D6\u05D5\u05DB\u05E8\u05EA \u05D1\u05D3\u05D9\u05D5\u05E7,
          \u05D0\u05D1\u05DC \u05D0\u05E0\u05D9 \u05D7\u05D5\u05E9\u05D1\u05EA \u05E9\u05D6\u05D4
          \u05D4\u05D9\u05D4 \u05DE\u05E9\u05D4\u05D5 \u05D1\u05E1\u05D2\u05E0\u05D5\u05DF."
        commands: []
    - rid: 2649295605456437700
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D7\u05D5\u05E9\u05D1 \u05E9\u05DE\u05D3\u05D5\u05D1\u05E8
          \u05D1\u05E6\u05D9\u05E8\u05D5\u05E3 \u05DE\u05E7\u05E8\u05D9\u05DD, \u05E9\u05D4\u05D0\u05E8\u05D9\u05D7
          \u05E0\u05E4\u05DC \u05DE\u05D9\u05D3 \u05D0\u05D7\u05E8\u05D9 \u05E9\u05D4\u05DF
          \u05E9\u05DE\u05E2\u05D5 \u05D0\u05EA \u05D4\u05E8\u05E2\u05E9."
        commands: []
    - rid: 2649295605456437701
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05E9 \u05E1\u05D9\u05DB\u05D5\u05D9 \u05D2\u05D1\u05D5\u05D4
          \u05E9\u05D4\u05E8\u05D5\u05E6\u05D7 \u05D4\u05E9\u05EA\u05DE\u05E9 \u05D1\u05E9\u05D9\u05D8\u05D4
          \u05D3\u05D5\u05DE\u05D4 \u05DB\u05D3\u05D9 \u05DC\u05D4\u05E4\u05D9\u05DC
          \u05D0\u05EA \u05D4\u05D0\u05E8\u05D9\u05D7 \u05E2\u05DC \u05E8\u05D5\u05E2\u05D9!"

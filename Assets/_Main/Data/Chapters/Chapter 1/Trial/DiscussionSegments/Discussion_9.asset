    - rid: 2649295605456437543
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D7\u05DB\u05D5 \u05E8\u05D2\u05E2 \u05D0\u05D7\u05D3. \u05D4\u05D9\u05D9\u05EA\u05D4
          \u05D3\u05E8\u05DA \u05E9\u05DE\u05D9\u05E9\u05D4\u05D5 \u05D9\u05DB\u05D5\u05DC
          \u05DC\u05E9\u05DC\u05D5\u05D8 \u05D1\u05D6\u05E8\u05D9\u05DE\u05D4 \u05E9\u05DC
          \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8."
        commands:
        - rid: 2649295605456437563
        - rid: 6008430280376320061
    - rid: 2649295605456437544
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DA?"
        commands:
        - rid: 2649295605456437564
    - rid: 2649295605456437545
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4, \u05D0\u05D6 \u05D1\u05D0\u05DE\u05EA \u05D9\u05E9 \u05E4\u05D4
          \u05D0\u05D9\u05E0\u05E1\u05D8\u05DC\u05D8\u05D5\u05E8?\r\n"
        commands:
        - rid: 2649295605456437565
    - rid: 2649295605456437546
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "*\"\u05E0\u05D9\u05EA\u05DF \u05DC\u05E1\u05D2\u05D5\u05E8 \u05D5\u05DC\u05E4\u05EA\u05D5\u05D7
          \u05D0\u05EA \u05DB\u05DC \u05D0\u05D7\u05D3 \u05DE\u05D4\u05DB\u05D9\u05D5\u05D5\u05E0\u05D9\u05DD
          \u05DB\u05D3\u05D9 \u05DC\u05E9\u05E0\u05D5\u05EA \u05D0\u05EA \u05DB\u05D9\u05D5\u05D5\u05DF
          \u05D6\u05E8\u05D9\u05DE\u05EA \u05D4\u05DE\u05D9\u05DD\"*."
        commands: []
    - rid: 2649295605456437547
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D7\u05D9\u05D9\u05DD \u05E9\u05DC\u05D9, \u05D0\u05D9\u05E4\u05D4
          \u05D0\u05EA\u05D4 \u05D7\u05D9? \u05E0\u05E8\u05D0\u05D4 \u05DC\u05DA
          \u05E9\u05DE\u05D9\u05E9\u05D4\u05D5 \u05D4\u05D9\u05D4 \u05DE\u05E9\u05D5\u05E2\u05DE\u05DD
          \u05DE\u05E1\u05E4\u05D9\u05E7 \u05DB\u05D3\u05D9 \u05DC\u05E7\u05E8\u05D5\u05D0
          \u05D0\u05EA \u05D6\u05D4?"
        commands:
        - rid: 2649295605456437569
        - rid: 6008430280376320063
    - rid: 2649295605456437548
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05E9\u05DE\u05E2 \u05DC\u05D9 \u05E1\u05D1\u05D9\u05E8 \u05D3\u05D5\u05D5\u05E7\u05D0.
          \u05D1\u05D1\u05D9\u05E8\u05D5\u05E8 \u05D6\u05D5 \u05D4\u05D3\u05E8\u05DA
          \u05D4\u05D9\u05D7\u05D9\u05D3\u05D4 \u05E9\u05D1\u05D4 \u05DE\u05D9\u05E9\u05D4\u05D5
          \u05D4\u05D9\u05D4 \u05D9\u05DB\u05D5\u05DC \u05DC\u05E2\u05E6\u05D5\u05E8
          \u05D0\u05EA \u05D4\u05D6\u05E8\u05D9\u05DE\u05D4 \u05DC\u05D1\u05E8\u05D6."
        commands:
        - rid: 2649295605456437570
    - rid: 2649295605456437549
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05DE\u05D4 \u05E9\u05D0\u05DE\u05E8\u05EA\u05D9 \u05DE\u05D4\u05D4\u05EA\u05D7\u05DC\u05D4!"
        commands:
        - rid: 2649295605456437571
    - rid: 2649295605456437550
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DC\u05D0 \u05D4\u05D5\u05D0 \u05DC\u05D0\u2026)"
        commands: []
    - rid: 2649295605456437551
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05E0\u05E1\u05EA\u05DB\u05DC \u05E2\u05DC \u05D4\u05EA\u05DE\u05D5\u05E0\u05D4
          \u05E9\u05DC \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA \u05D1\u05EA\u05D5\u05DA
          \u05D4\u05E8\u05DB\u05D6\u05EA\u2026"
        commands:
        - rid: 2649295605456437572
    - rid: 2649295605456437552
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E4\u05E9\u05E8 \u05DC\u05E8\u05D0\u05D5\u05EA \u05E9\u05D9\u05E9
          \u05D0\u05D5\u05E8\u05D5\u05EA \u05D9\u05E8\u05D5\u05E7\u05D9\u05DD \u05E2\u05DC
          \u05D4\u05E6\u05DE\u05EA\u05D9\u05DD \u05D4\u05D0\u05DC\u05D4 \u05E9\u05D1\u05D9\u05DF
          \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA."
        commands: []
    - rid: 2649295605456437553
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05DE\u05D4 \u05E9\u05DB\u05EA\u05D5\u05D1 \u05D1\u05E4\u05EA\u05E7
          \u05D4\u05D4\u05D5\u05D0 \u05E0\u05DB\u05D5\u05DF, \u05D0\u05E4\u05E9\u05E8
          \u05DC\u05D4\u05E4\u05E2\u05D9\u05DC \u05D0\u05D5\u05E8\u05D5\u05EA \u05E9\u05D5\u05E0\u05D9\u05DD
          \u05DB\u05D3\u05D9 \u05DC\u05D7\u05E1\u05D5\u05DD \u05D0\u05D5 \u05DC\u05E4\u05EA\u05D5\u05D7
          \u05D3\u05E8\u05DB\u05D9\u05DD \u05E9\u05D5\u05E0\u05D5\u05EA \u05DC\u05DE\u05D9\u05DD."
        commands:
        - rid: 2649295605456437573
    - rid: 2649295605456437554
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D6\u05D0\u05EA \u05D4\u05E6\u05E0\u05E8\u05EA \u05D4\u05D4\u05D6\u05D5\u05D9\u05D4
          \u05D4\u05D6\u05D0\u05EA? \u05DE\u05DE\u05EA\u05D9 \u05D6\u05D5 \u05D0\u05DE\u05D5\u05E8\u05D4
          \u05DC\u05D4\u05D9\u05D5\u05EA \u05D0\u05D5\u05E4\u05E6\u05D9\u05D4?"
        commands:
        - rid: 2649295605456437574
    - rid: 2649295605456437555
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4\u05E0\u05D9\u05E1\u05D9\u05D5\u05DF \u05E9\u05DC\u05D9,
          \u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05D4\u05D2\u05D9\u05D3
          \u05E9\u05DE\u05DE\u05E9 \u05DC\u05D0 \u05DB\u05DB\u05D4 \u05D0\u05DE\u05D5\u05E8\u05D9\u05DD
          \u05DC\u05D1\u05E0\u05D5\u05EA \u05E6\u05E0\u05E8\u05EA\u2026 \u05D6\u05D4
          \u05DC\u05D0 \u05D1\u05D8\u05D9\u05D7\u05D5\u05EA\u05D9, \u05DC\u05D0 \u05E4\u05E8\u05E7\u05D8\u05D9
          \u05D5\u05DC\u05D0 \u05D4\u05D2\u05D9\u05D5\u05E0\u05D9."
        commands:
        - rid: 2649295605456437575
    - rid: 2649295605456437556
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05E6\u05E8\u05D9\u05DA \u05E0\u05D9\u05E1\u05D9\u05D5\u05DF
          \u05DB\u05D3\u05D9 \u05DC\u05D4\u05D1\u05D9\u05DF \u05D0\u05EA \u05D6\u05D4\u2026"
        commands:
        - rid: 2649295605456437576
    - rid: 2649295605456437557
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D9 \u05D1\u05E0\u05D4 \u05D0\u05EA \u05D4\u05D7\u05E8\u05D0
          \u05D4\u05D6\u05D4 \u05DB\u05DB\u05D4?"
        commands:
        - rid: 2649295605456437577
    - rid: 2649295605456437558
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E2\u05D5\u05D3 \u05DE\u05D9\u05E9\u05D4\u05D5? \u05D0\u05D5 \u05E9\u05E0\u05D2\u05DE\u05E8\u05D4
          \u05DC\u05DB\u05DD \u05D4\u05D1\u05D9\u05E7\u05D5\u05E8\u05EA?"
        commands:
        - rid: 2649295605456437578
    - rid: 2649295605456437559
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D5\u05E7\u05D9\u05D9, \u05D0\u05D6 \u05DE\u05D9\u05E9\u05D4\u05D5
          \u05DC\u05D7\u05E5 \u05E9\u05DD \u05E2\u05DC \u05D4\u05DB\u05E4\u05EA\u05D5\u05E8\u05D9\u05DD
          \u05D5\u05D7\u05E1\u05DD \u05D0\u05EA \u05D4\u05D6\u05E8\u05D9\u05DE\u05D4."
        commands:
        - rid: 2649295605456437579
    - rid: 2649295605456437560
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D6\u05D4 \u05DE\u05D4 \u05E9\u05D0\u05DE\u05E8\u05E0\u05D5.
          \u05EA\u05D5\u05D3\u05D4 \u05E9\u05D0\u05EA \u05D7\u05D5\u05D6\u05E8\u05EA
          \u05E2\u05DC \u05D6\u05D4."
        commands:
        - rid: 2649295605456437580
    - rid: 2649295605456437561
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D2\u05DD \u05D0\u05DD \u05D6\u05D4 \u05DE\u05D4 \u05E9\u05E7\u05E8\u05D4,
          \u05DC\u05DE\u05D4 \u05E9\u05DE\u05D9\u05E9\u05D4\u05D5 \u05D9\u05E2\u05E9\u05D4
          \u05D3\u05D1\u05E8 \u05DB\u05D6\u05D4?"
        commands:
        - rid: 2649295605456437581
    - rid: 2649295605456437562
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D5 \u05E0\u05E7\u05D5\u05D3\u05D4 \u05D8\u05D5\u05D1\u05D4.
          \u05DC\u05DE\u05D4 \u05E9\u05DE\u05D9\u05E9\u05D4\u05D5 \u05D9\u05E8\u05E6\u05D4
          \u05DC\u05E2\u05E9\u05D5\u05EA \u05D0\u05EA \u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA?)"
        commands: []

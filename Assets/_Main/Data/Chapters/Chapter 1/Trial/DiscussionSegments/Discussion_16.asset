    - rid: 2649295605456438196
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D0\u05D9\u05D4\u2026 \u05D3\u05D5\u05D5\u05E7\u05D0 \u05DB\u05DF
          \u05D4\u05D9\u05D9\u05EA \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05D3\u05E2\u05EA
          \u05DE\u05EA\u05D9 \u05E8\u05D5\u05E2\u05D9 \u05D4\u05D9\u05D4 \u05D1\u05EA\u05D0."
        commands:
        - rid: 6008430280376320092
    - rid: 2649295605456438197
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 2649295605456438198
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DA \u05D4\u05D9\u05D0 \u05D9\u05DB\u05DC\u05D4 \u05DC\u05D3\u05E2\u05EA?"
        commands: []
    - rid: 2649295605456438199
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05EA\u05D6\u05DB\u05E8\u05D5 \u05E9\u05D5\u05D1 \u05DE\u05D4 \u05E0\u05DE\u05E6\u05D0
          \u05D1\u05EA\u05D0 \u05D4\u05DB\u05D9 \u05E7\u05E8\u05D5\u05D1 \u05DC\u05DB\u05E0\u05D9\u05E1\u05D4\u2026"
        commands: []
    - rid: 2649295605456438200
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05E9 \u05E9\u05DD \u05D7\u05DC\u05D5\u05DF \u05D2\u05D1\u05D5\u05D4.
          \u05D5\u05D9\u05E9 \u05DB\u05D6\u05D4 \u05D2\u05DD \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9
          \u05D1\u05E0\u05D9\u05DD\u2026"
        commands: []
    - rid: 2649295605456438201
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D2\u05DD \u05D0\u05DD \u05D4\u05D7\u05DC\u05D5\u05E0\u05D5\u05EA
          \u05D4\u05D0\u05DC\u05D4 \u05E0\u05DE\u05E6\u05D0\u05D9\u05DD \u05E9\u05DD,
          \u05D1\u05D0\u05DE\u05EA \u05E8\u05D5\u05D0\u05D9\u05DD \u05DE\u05E9\u05D4\u05D5?"
        commands: []
    - rid: 2649295605456438202
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D4\u05E1\u05EA\u05DB\u05DC\u05EA\u05D9 \u05DE\u05D4\u05D7\u05DC\u05D5\u05DF
          \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9 \u05D1\u05E0\u05D9\u05DD, \u05E9\u05E0\u05D9
          \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD \u05DE\u05D0\u05D5\u05D3
          \u05E7\u05E8\u05D5\u05D1\u05D9\u05DD \u05D0\u05D7\u05D3 \u05DC\u05E9\u05E0\u05D9.
          \u05D9\u05DB\u05D5\u05DC\u05EA\u05D9 \u05DC\u05E8\u05D0\u05D5\u05EA \u05DE\u05DE\u05E9
          \u05DE\u05D4 \u05E7\u05D5\u05E8\u05D4 \u05D1\u05EA\u05D0 \u05D4\u05E7\u05E8\u05D5\u05D1
          \u05E9\u05DC \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9 \u05D1\u05E0\u05D5\u05EA."
        commands: []
    - rid: 2649295605456438203
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DE\u05D0\u05DC\u05D4, \u05D6\u05D4 \u05D0\u05E4\u05E9\u05E8\u05D9?
          \u05DE\u05D4, \u05E0\u05D9\u05E1\u05D9\u05EA \u05DC\u05D4\u05E6\u05D9\u05E5
          \u05E2\u05DC \u05D4\u05D1\u05E0\u05D5\u05EA? \u05D0\u05DC\u05D5\u05DF \u05D9\u05D0
          \u05E9\u05D5\u05D1\u05D1!"
        commands: []
    - rid: 2649295605456438204
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05DE\u05DB\u05D1\u05D3 \u05D0\u05D5\u05EA\u05DA
          \u05DE\u05E7\u05E1\u05D9\u05DE\u05D5\u05DD \u05D1\u05E8\u05D2\u05E8."
        commands: []
    - rid: 2649295605456438205
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E7\u05E9\u05D4 \u05DC\u05E8\u05D0\u05D5\u05EA \u05DE\u05DE\u05E9
          \u05D1\u05D1\u05D9\u05E8\u05D5\u05E8 \u05E9\u05DD\u2026 \u05D0\u05D1\u05DC
          \u05D0\u05E4\u05E9\u05E8 \u05DC\u05E8\u05D0\u05D5\u05EA \u05D0\u05DD \u05D9\u05E9
          \u05DE\u05D9\u05E9\u05D4\u05D5 \u05D1\u05E4\u05E0\u05D9\u05DD."
        commands: []
    - rid: 2649295605456438206
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05DE\u05D0\u05D9\u05D4 \u05D4\u05D5\u05E8\u05D9\u05D3\u05D4
          \u05D0\u05EA \u05D4\u05DE\u05D9\u05DD \u05DE\u05D4\u05EA\u05D0 \u05DC\u05D9\u05D3
          \u05D4\u05D7\u05DC\u05D5\u05DF, \u05D4\u05D9\u05D0 \u05D4\u05D9\u05D9\u05EA\u05D4
          \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05D4\u05E1\u05EA\u05DB\u05DC \u05E2\u05DC
          \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9 \u05D1\u05E0\u05D9\u05DD, \u05D5\u05DB\u05DB\u05D4
          \u05DC\u05D3\u05E2\u05EA \u05D0\u05DD \u05E8\u05D5\u05E2\u05D9 \u05E0\u05DB\u05E0\u05E1!"
        commands: []
    - rid: 2649295605456438207
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 2649295605456438208
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05D4 \u05DE\u05DE\u05E9 \u05E0\u05D7\u05D5\u05E9 \u05E9\u05D6\u05D0\u05EA
          \u05D0\u05E0\u05D9, \u05D4\u05D0?"
        commands:
        - rid: 2649295605456438216
    - rid: 2649295605456438209
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D4 \u05DC\u05D0 \u05E9\u05D0\u05E0\u05D9 \u05E8\u05D5\u05E6\u05D4
          \u05E9\u05D6\u05D4 \u05D9\u05D4\u05D9\u05D4 \u05D4\u05DE\u05E6\u05D1\u2026
          \u05D0\u05D1\u05DC \u05D6\u05D0\u05EA \u05D4\u05D0\u05E4\u05E9\u05E8\u05D5\u05EA
          \u05D4\u05D9\u05D7\u05D9\u05D3\u05D4.)"
        commands: []
    - rid: 2649295605456438210
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D5\u05E7\u05D9\u05D9, \u05E0\u05E0\u05D9\u05D7 \u05E9\u05E4\u05D9\u05D6\u05D9\u05EA
          \u05D4\u05D9\u05D9\u05EA\u05D9 \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05D3\u05E2\u05EA
          \u05D0\u05DD \u05D4\u05D5\u05D0 \u05E0\u05DE\u05E6\u05D0 \u05E9\u05DD.
          \u05DE\u05D4 \u05E9\u05D0\u05EA\u05D4 \u05DE\u05EA\u05D0\u05E8 \u05D6\u05D4
          \u05E2\u05D3\u05D9\u05D9\u05DF \u05DC\u05D0 \u05D4\u05D2\u05D9\u05D5\u05E0\u05D9
          \u05D1\u05E2\u05DC\u05D9\u05DC."
        commands: []
    - rid: 2649295605456438211
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E2\u05D3\u05D9\u05D9\u05DF\u2026?"
        commands: []
    - rid: 2649295605456438212
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DC \u05D4\u05EA\u05D5\u05DB\u05E0\u05D9\u05EA \u05D4\u05D6\u05D0\u05EA
          \u05D1\u05D5\u05E0\u05D4 \u05E2\u05DC \u05D6\u05D4 \u05E9\u05D4\u05D0\u05E8\u05D9\u05D7
          \u05D9\u05E4\u05D5\u05DC \u05D1\u05D6\u05DE\u05DF \u05D4\u05E0\u05DB\u05D5\u05DF
          \u05D1\u05DE\u05E7\u05D5\u05DD \u05D4\u05E0\u05DB\u05D5\u05DF. \u05D0\u05EA\u05D4
          \u05D1\u05E2\u05E6\u05DE\u05DA \u05D0\u05DE\u05E8\u05EA, \u05DE\u05D9 \u05E9\u05E2\u05E9\u05D4
          \u05D0\u05EA \u05D6\u05D4 \u05D4\u05D9\u05D4 \u05E6\u05E8\u05D9\u05DA \u05DC\u05E9\u05D7\u05E8\u05E8
          \u05D0\u05EA \u05D4\u05D1\u05E8\u05D2\u05D9\u05DD \u05DE\u05E8\u05D0\u05E9."
        commands: []
    - rid: 2649295605456438213
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05D4 \u05D1\u05D0\u05DE\u05EA \u05D7\u05D5\u05E9\u05D1

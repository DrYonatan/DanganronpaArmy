    - rid: 2649295605456437754
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E2\u05E0\u05D1\u05DC, \u05D0\u05EA \u05D1\u05D8\u05D5\u05D7\u05D4
          \u05E9\u05D0\u05D9\u05DF \u05D0\u05E3 \u05E6\u05D9\u05E0\u05D5\u05E8 \u05E9\u05DE\u05E1\u05E4\u05D9\u05E7
          \u05E7\u05E8\u05D5\u05D1 \u05DC\u05D0\u05E8\u05D9\u05D7?"
        commands:
        - rid: 6008430280376320066
    - rid: 2649295605456437755
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D0\u05D9\u05EA\u05D9 \u05E9\u05D9\u05E9 \u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA
          \u05D1\u05E7\u05D9\u05E8\u05D5\u05EA, \u05D0\u05D1\u05DC \u05D0\u05E0\u05D9
          \u05DC\u05D0 \u05D7\u05D5\u05E9\u05D1\u05EA \u05E9\u05D6\u05D4 \u05D4\u05E8\u05E2\u05D9\u05D3
          \u05D0\u05EA \u05DB\u05DC \u05D4\u05D7\u05D3\u05E8\u2026"
        commands: []
    - rid: 2649295605456437756
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E9\u05D4\u05E1\u05EA\u05DB\u05DC\u05EA\u05D9 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9\u05DD,
          \u05E8\u05D0\u05D9\u05EA\u05D9 \u05E9\u05DE\u05DE\u05E9 \u05DE\u05E2\u05DC
          \u05D4\u05D0\u05D6\u05D5\u05E8 \u05E9\u05DE\u05DE\u05E0\u05D5 \u05E0\u05E4\u05DC
          \u05D4\u05D0\u05E8\u05D9\u05D7, \u05E0\u05E8\u05D0\u05D4 \u05E9\u05E2\u05D5\u05D1\u05E8\u05D9\u05DD
          \u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA."
        commands: []
    - rid: 2649295605456437757
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05D4\u05E8\u05D5\u05E6\u05D7 \u05D2\u05E8\u05DD \u05DC\u05D4\u05DD
          \u05DC\u05E9\u05E7\u05E9\u05E7, \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05E9\u05D6\u05D4 \u05D4\u05D9\u05D4 \u05DE\u05E4\u05D9\u05DC \u05D0\u05EA
          \u05D4\u05D0\u05E8\u05D9\u05D7!"
        commands:
        - rid: 2649295605456437788
    - rid: 2649295605456437758
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D2\u05DD \u05D0\u05DD \u05D4\u05D9\u05D5 \u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA
          \u05DE\u05E2\u05DC, \u05D4\u05DD \u05D1\u05D0\u05DE\u05EA \u05E9\u05E7\u05E9\u05E7\u05D5
          \u05DB\u05DC \u05DB\u05DA \u05D7\u05D6\u05E7 \u05DB\u05D3\u05D9 \u05DC\u05D4\u05E4\u05D9\u05DC
          \u05D0\u05E8\u05D9\u05D7?"
        commands: []
    - rid: 2649295605456437759
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05DB\u05D5\u05DF. \u05DC\u05DE\u05D4 \u05DC\u05D0 \u05E0\u05E4\u05DC\u05D5
          \u05E2\u05D5\u05D3 \u05D0\u05E8\u05D9\u05D7\u05D9\u05DD \u05E2\u05DD \u05D6\u05D4
          \u05E9\u05E7\u05E9\u05E7 \u05DB\u05DC \u05DB\u05DA \u05D7\u05D6\u05E7?
          \u05D0\u05E0\u05D9 \u05D1\u05D8\u05D5\u05D7\u05D4 \u05E9\u05D4\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA
          \u05DC\u05D0 \u05E2\u05D5\u05D1\u05E8\u05D9\u05DD \u05E8\u05E7 \u05DE\u05E2\u05DC
          \u05D4\u05D0\u05E8\u05D9\u05D7 \u05D4\u05D6\u05D4."
        commands: []
    - rid: 2649295605456437760
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D0\u05EA\u05D4 \u05E1\u05EA\u05DD \u05DE\u05D7\u05E8\u05D8\u05D8
          \u05D0\u05D5\u05EA\u05E0\u05D5 \u05D0\u05DC\u05D5\u05DF?"
        commands: []
    - rid: 2649295605456437761
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05DC\u05D0 \u05E6\u05D9\u05E4\u05D9\u05EA\u05D9
          \u05DE\u05DE\u05DA."
        commands: []
    - rid: 2649295605456437762
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0, \u05D4\u05D5\u05D0 \u05DC\u05D0 \u05DE\u05D7\u05E8\u05D8\u05D8.
          \u05D1\u05D1\u05D9\u05E8\u05D5\u05E8, \u05D9\u05E9 \u05E1\u05D9\u05D1\u05D4
          \u05DC\u05DE\u05D4 \u05E9\u05E8\u05E7 \u05D4\u05D0\u05E8\u05D9\u05D7 \u05D4\u05D6\u05D4
          \u05D9\u05E4\u05D5\u05DC.\r"
        commands: []
    - rid: 2649295605456437764
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E6\u05E8\u05D9\u05DA \u05DC\u05D6\u05DB\u05D5\u05E8, \u05E9\u05DE\u05D9\u05E9\u05D4\u05D5
          \u05E9\u05D7\u05E8\u05E8 \u05D0\u05EA \u05D4\u05D1\u05E8\u05D2\u05D9\u05DD
          \u05E9\u05DC \u05D4\u05D0\u05E8\u05D9\u05D7 \u05D4\u05D6\u05D4. \u05D4\u05D5\u05D0
          \u05DB\u05D1\u05E8 \u05D4\u05D9\u05D4 \u05D7\u05E6\u05D9 \u05D1\u05D7\u05D5\u05E5.
          \u05D3\u05D7\u05D9\u05E4\u05D4 \u05E7\u05D8\u05E0\u05D4 \u05DE\u05D4\u05E8\u05D8\u05D8
          \u05E9\u05DC \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8 \u05D9\u05DB\u05DC\u05D4
          \u05DC\u05D4\u05E4\u05D9\u05DC \u05D0\u05D5\u05EA\u05D5."
        commands: []
    - rid: 2649295605456437765
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05E9\u05D0\u05E4\u05D5 \u05DC\u05E8\u05D5\u05E6\u05D7
          \u05D4\u05D6\u05D4, \u05D0\u05E0\u05D9 \u05E0\u05E8\u05D3\u05DD \u05E8\u05E7
          \u05DE\u05DC\u05E9\u05DE\u05D5\u05E2 \u05E2\u05DC \u05DB\u05DC \u05D4\u05E2\u05D1\u05D5\u05D3\u05D4
          \u05D4\u05D6\u05D0\u05EA."
        commands: []
    - rid: 2649295605456437766
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D5\u05E7\u05D9\u05D9, \u05D0\u05D6 \u05D9\u05DB\u05D5\u05DC
          \u05DC\u05D4\u05D9\u05D5\u05EA \u05E9\u05D4\u05D9\u05D4 \u05E2\u05D5\u05DE\u05E1
          \u05DE\u05D9\u05DD \u05D1\u05E6\u05D9\u05E0\u05D5\u05E8, \u05E9\u05D2\u05E8\u05DD
          \u05DC\u05D5 \u05DC\u05E8\u05E2\u05D5\u05D3 \u05D5\u05DC\u05D4\u05E4\u05D9\u05DC
          \u05D0\u05EA \u05D4\u05D0\u05E8\u05D9\u05D7, \u05DE\u05D4 \u05E9\u05D4\u05E8\u05D2
          \u05D0\u05EA \u05E8\u05D5\u05E2\u05D9."
        commands: []
    - rid: 2649295605456437767
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D6\u05D4 \u05DE\u05E9\u05D0\u05D9\u05E8 \u05D0\u05D5\u05EA\u05E0\u05D5
          \u05EA\u05E7\u05D5\u05E2\u05D9\u05DD. \u05DB\u05DC \u05D0\u05D7\u05D3 \u05D4\u05D9\u05D4
          \u05D9\u05DB\u05D5\u05DC \u05DC\u05D0\u05E8\u05D2\u05DF \u05D0\u05EA \u05D6\u05D4
          \u05DB\u05DC \u05E2\u05D5\u05D3 \u05D4\u05D5\u05D0 \u05D4\u05EA\u05D7\u05D9\u05DC
          \u05DE\u05E1\u05E4\u05D9\u05E7 \u05DE\u05E8\u05D0\u05E9."
        commands:
        - rid: 6008430280376320067
    - rid: 2649295605456437768
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D7\u05D6\u05E8\u05E0\u05D5 \u05DC\u05D4\u05EA\u05D7\u05DC\u05D4\u2026?"
        commands: []
    - rid: 2649295605456437769
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E1\u05E2\u05DE\u05E7, \u05E1\u05EA\u05DD \u05D1\u05D6\u05D1\u05D6\u05E0\u05D5
          \u05EA'\u05D6\u05DE\u05DF? \u05D0\u05E0\u05D9 \u05DE\u05D0\u05E9\u05D9\u05DD
          \u05D0\u05D5\u05EA\u05DA \u05D1\u05E8\u05D2\u05E8."
        commands: []
    - rid: 2649295605456437770
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 2649295605456437771
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0. \u05D4\u05EA\u05E7\u05D3\u05DE\u05E0\u05D5 \u05D4\u05E8\u05D1\u05D4.
          \u05D4\u05E9\u05D0\u05DC\u05D4 \u05DC\u05D0\u05DF \u05DE\u05DE\u05E9\u05D9\u05DB\u05D9\u05DD
          \u05DE\u05DB\u05D0\u05DF."
        commands: []
    - rid: 2649295605456437772
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05E9\u05D0\u05DC\u05D4 \u05D4\u05D1\u05D0\u05D4 \u05E9\u05D0\u05E0\u05D7\u05E0\u05D5
          \u05E6\u05E8\u05D9\u05DB\u05D9\u05DD \u05DC\u05E9\u05D0\u05D5\u05DC \u05D0\u05EA
          \u05E2\u05E6\u05DE\u05E0\u05D5, \u05D4\u05D9\u05D0 \u05DE\u05D4 \u05D2\u05E8\u05DD
          \u05DC\u05E4\u05E8\u05E5 \u05DE\u05D9\u05DD \u05D4\u05D6\u05D4."
        commands: []
    - rid: 2649295605456437773
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D6\u05D0\u05EA \u05D0\u05D5\u05DE\u05E8\u05EA, \u05DE\u05D4
          \u05D0\u05EA\u05D4 \u05E1\u05EA\u05D5\u05DD? \u05DB\u05D1\u05E8 \u05D3\u05D9\u05D1\u05E8\u05E0\u05D5
          \u05E2\u05DC \u05D6\u05D4. \u05DE\u05D9\u05E9\u05D4\u05D5 \u05E9\u05D9\u05E0\u05D4
          \u05D0\u05EA \u05D4\u05DB\u05D9\u05D5\u05D5\u05DF \u05E9\u05DC \u05D4\u05D6\u05E8\u05D9\u05DE\u05D4
          \u05D1\u05E8\u05DB\u05D6\u05EA, \u05D5\u05D2\u05E8\u05DD \u05E9\u05D9\u05D4\u05D9\u05D4
          \u05E2\u05D5\u05DE\u05E1 \u05DE\u05D9\u05DD."
        commands: []
    - rid: 2649295605456437774
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05EA\u05D5\u05D3\u05D4 \u05E9\u05D7\u05D6\u05E8\u05EA \u05E2\u05DC
          \u05D4\u05E2\u05D5\u05D1\u05D3\u05D5\u05EA \u05D4\u05DE\u05D5\u05D1\u05E0\u05D5\u05EA
          \u05DE\u05D0\u05DC\u05D9\u05D4\u05DF. \u05D0\u05D1\u05DC \u05D1\u05E1\u05D5\u05E3
          \u05D4\u05D9\u05D4 \u05E6\u05E8\u05D9\u05DA \u05D8\u05E8\u05D9\u05D2\u05E8
          \u05DE\u05E1\u05D5\u05D9\u05DD, \u05DC\u05D4\u05E1\u05D1\u05D9\u05E8 \u05DC\u05DE\u05D4
          \u05D4\u05D2\u05D9\u05E2 \u05D4\u05E4\u05E8\u05E5 \u05DE\u05D9\u05DD \u05D3\u05D5\u05D5\u05E7\u05D0
          \u05D1\u05D0\u05D5\u05EA\u05D5 \u05E8\u05D2\u05E2."
        commands: []
    - rid: 2649295605456437775
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D5\u05D0 \u05E6\u05D5\u05D3\u05E7. \u05D0\u05DD \u05D0\u05E0\u05D7\u05E0\u05D5
          \u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05D4\u05EA\u05E7\u05D3\u05DD, \u05D0\u05E0\u05D7\u05E0\u05D5
          \u05E6\u05E8\u05D9\u05DB\u05D9\u05DD \u05DC\u05D4\u05D1\u05D9\u05DF \u05DE\u05D4
          \u05D1\u05D3\u05D9\u05D5\u05E7 \u05E2\u05E9\u05D5 \u05DC\u05E8\u05DB\u05D6\u05EA,
          \u05D0\u05D9\u05DA \u05D4\u05E9\u05D9\u05E0\u05D5\u05D9 \u05D4\u05D6\u05D4
          \u05D4\u05D5\u05D1\u05D9\u05DC \u05DC\u05E2\u05D5\u05DE\u05E1 \u05DE\u05D9\u05DD."
        commands: []
    - rid: 2649295605456437776
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05D4\u05D9\u05D4 \u05E2\u05D5\u05DE\u05E1 \u05DE\u05D9\u05DD
          \u05D1\u05E6\u05D9\u05E0\u05D5\u05E8 \u05E9\u05DE\u05E2\u05DC \u05D4\u05D0\u05E8\u05D9\u05D7,
          \u05D0\u05D6 \u05D0\u05E0\u05D7\u05E0\u05D5 \u05E6\u05E8\u05D9\u05DB\u05D9\u05DD
          \u05DC\u05E0\u05E1\u05D5\u05EA \u05DC\u05D4\u05D1\u05D9\u05DF \u05DC\u05D0\u05DF
          \u05D4\u05D5\u05D0 \u05DE\u05EA\u05D7\u05D1\u05E8, \u05DC\u05D0?"
        commands: []
    - rid: 2649295605456437777
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF! \u05D0\u05DD \u05E0\u05DE\u05E6\u05D0 \u05D0\u05EA \u05D4\u05DE\u05E7\u05D5\u05E8
          \u05E9\u05DC \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8, \u05E0\u05D5\u05DB\u05DC
          \u05DC\u05E8\u05D0\u05D5\u05EA \u05DE\u05D0\u05D9\u05E4\u05D4 \u05D4\u05D2\u05D9\u05E2\u05D5
          \u05D0\u05DC\u05D9\u05D5 \u05D4\u05DE\u05D9\u05DD \u05E9\u05D2\u05E8\u05DE\u05D5
          \u05DC\u05E8\u05D8\u05D8."
        commands: []
    - rid: 2649295605456437778
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DC\u05D0\u05DF \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8 \u05DE\u05EA\u05D7\u05D1\u05E8\u2026)"
        commands: []
    - rid: 2649295605456437779
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05D5\u05D1 \u05D4\u05E1\u05D9\u05DB\u05D5\u05D9\u05D9\u05DD
          \u05E9\u05D4\u05E6\u05D9\u05E0\u05D5\u05E8 \u05D4\u05D6\u05D4 \u05DE\u05D7\u05D5\u05D1\u05E8
          \u05DC\u05E8\u05DB\u05D6\u05EA \u05DE\u05D9\u05DD. \u05D0\u05DD \u05D0\u05E0\u05D7\u05E0\u05D5
          \u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05E8\u05D0\u05D5\u05EA \u05DC\u05D0\u05DF
          \u05D4\u05E6\u05D9\u05E0\u05D5\u05E8 \u05D4\u05D6\u05D4 \u05DE\u05EA\u05D7\u05D1\u05E8,
          \u05DB\u05D3\u05D0\u05D9 \u05E9\u05E7\u05D5\u05D3\u05DD \u05DB\u05DC \u05E0\u05D1\u05D9\u05DF
          \u05D0\u05D9\u05D6\u05D4 \u05D0\u05D7\u05D3 \u05DE\u05D4\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA
          \u05D1\u05E8\u05DB\u05D6\u05EA \u05D4\u05D5\u05D0 \u05D6\u05D4 \u05E9\u05E2\u05D5\u05D1\u05E8
          \u05DE\u05E2\u05DC \u05D4\u05D0\u05E8\u05D9\u05D7."
        commands: []
    - rid: 2649295605456437780
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05DF, \u05D4\u05D9\u05D0 \u05E6\u05D5\u05D3\u05E7\u05EA.
          \u05D0\u05DD \u05E0\u05D1\u05D9\u05DF \u05D0\u05D9\u05D6\u05D4 \u05E6\u05D9\u05E0\u05D5\u05E8
          \u05D6\u05D4, \u05E0\u05D5\u05DB\u05DC \u05DC\u05E2\u05E7\u05D5\u05D1 \u05D0\u05D7\u05E8\u05D9\u05D5
          \u05DC\u05DE\u05E7\u05D5\u05E8!)"
        commands: []

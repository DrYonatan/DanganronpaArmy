          correctEvidence: {fileID: 0}
    - rid: 2649295605456437304
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "{\u05DB\u05D5\u05DC\u05DD \u05D4\u05D9\u05D5 \u05D1\u05D7\u05D3\u05E8\u05D9\u05DD},\n\u05D1\u05E0\u05E7\u05D9\u05D5\u05E0\u05D5\u05EA
            \u05E9\u05DC \u05D4\u05D0\u05DC\"\u05D1, \u05DC\u05D0?\r"
          textEffects:
          - {fileID: 11400000, guid: 776df99a68a7fa04d9cebde19eafed87, type: 2}
          introEffect: {fileID: 0}
          outroEffect: {fileID: 0}
          spawnOffset: {x: 0, y: 0, z: 0}

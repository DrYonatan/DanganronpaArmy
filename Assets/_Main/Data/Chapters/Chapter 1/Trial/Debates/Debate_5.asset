    RefIds:
    - rid: 2649295605456437297
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05D0\u05DD \u05D1\u05D0\u05DE\u05EA \u05DE\u05D9\u05E9\u05D4\u05D5
            \n\u05D1\u05D0 \u05DE\u05D1\u05D7\u05D5\u05E5\u2026\r"
          textEffects: []
          introEffect: {fileID: 11400000, guid: 6c738300247b4e044bea12b9fa18f612, type: 2}
          outroEffect: {fileID: 11400000, guid: 352a529332a87ef4893531c2f9f6bf2d, type: 2}
          spawnOffset: {x: 0, y: 0, z: 0}
          rotationOffset: {x: 0, y: 0, z: 0}
          scale: {x: 1, y: 1, z: 1}
          ttl: 4
          textLineScrollPosition: {x: 0, y: 0}
          correctEvidence: {fileID: 0}
    - rid: 2649295605456437298
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05DE\u05D9 \u05D6\u05D4 \u05D4\u05D9\u05D4 \u05D9\u05DB\u05D5\u05DC
            \u05DC\u05D4\u05D9\u05D5\u05EA?"
          textEffects:
          - {fileID: 11400000, guid: 78cef4dbf176f274ba273d043b6ea500, type: 2}
          introEffect: {fileID: 11400000, guid: 79d05a79f475ef643a1ecc36ad08d221, type: 2}
          outroEffect: {fileID: 0}
          spawnOffset: {x: 0, y: 0, z: 0}
          rotationOffset: {x: 0, y: 0, z: 0}
          scale: {x: 1, y: 1, z: 1}
          ttl: 3
          textLineScrollPosition: {x: 0, y: 0}
          correctEvidence: {fileID: 0}
    - rid: 2649295605456437299
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05D6\u05D4 {\u05E7\u05E8\u05D4 \u05D1\u05D6\u05DE\u05DF \u05D4\u05D0\u05DC\"\u05D1},\n\u05D0\u05D6
            \u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9 \n\u05E9\u05DC\u05E8\u05D5\u05D1\u05E0\u05D5
            \u05D9\u05E9 \u05D0\u05DC\u05D9\u05D1\u05D9.\r"
          textEffects: []
          introEffect: {fileID: 11400000, guid: 6c738300247b4e044bea12b9fa18f612, type: 2}
          outroEffect: {fileID: 11400000, guid: 352a529332a87ef4893531c2f9f6bf2d, type: 2}
          spawnOffset: {x: 0, y: 0, z: 0}
          rotationOffset: {x: 0, y: 0, z: 0}
          scale: {x: 1, y: 1, z: 1}
          ttl: 4
          textLineScrollPosition: {x: 0, y: 0}
          correctEvidence: {fileID: 0}
    - rid: 2649295605456437300
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05D7\u05D3 \u05DE\u05E9\u05DE\u05E2\u05D9\u05EA.\r"
          textEffects:
          - {fileID: 11400000, guid: 1783f855e5ca44a46918165450f0b808, type: 2}
          introEffect: {fileID: 0}
          outroEffect: {fileID: 0}
          spawnOffset: {x: 0, y: 0, z: 0}
          rotationOffset: {x: 0, y: 0, z: 0}
          scale: {x: 1, y: 1, z: 1}
          ttl: 3
          textLineScrollPosition: {x: 0, y: 0}
          correctEvidence: {fileID: 0}
    - rid: 2649295605456437301
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05D0\u05E0\u05D9 \u05D5\u05E0\u05D9\u05E6\u05DF {\u05D4\u05D9\u05D9\u05E0\u05D5
            \u05D1\u05D2\u05DC\u05E2\u05D3},\n \u05DC\u05D0 \u05D6\u05D6\u05E0\u05D5
            \u05DE\u05D8\u05E8!\r"
          textEffects:
          - {fileID: 11400000, guid: 776df99a68a7fa04d9cebde19eafed87, type: 2}
          introEffect: {fileID: 0}
          outroEffect: {fileID: 0}
          spawnOffset: {x: 0, y: 0, z: 0}
          rotationOffset: {x: 0, y: 0, z: 0}
          scale: {x: 1, y: 1, z: 1}
          ttl: 4
          textLineScrollPosition: {x: 0, y: 0}
          correctEvidence: {fileID: 0}
    - rid: 2649295605456437302
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05DC\u05DB\u05D5\u05DC\u05DD \u05D0\u05DE\u05D5\u05E8 \u05DC\u05D4\u05D9\u05D5\u05EA\n\u05D0\u05DC\u05D9\u05D1\u05D9
            \u05D1\u05E2\u05D9\u05E7\u05E8\u05D5\u05DF,\n\u05D7\u05D5\u05E5 \u05DE\u05D0\u05DC\u05D5\u05DF."
          textEffects:
          - {fileID: 11400000, guid: 78cef4dbf176f274ba273d043b6ea500, type: 2}
          introEffect: {fileID: 11400000, guid: 79d05a79f475ef643a1ecc36ad08d221, type: 2}
          outroEffect: {fileID: 0}
          spawnOffset: {x: 0, y: 0, z: 0}
          rotationOffset: {x: 0, y: 0, z: 0}
          scale: {x: 1, y: 1, z: 1}
          ttl: 4
          textLineScrollPosition: {x: 0, y: 0}
          correctEvidence: {fileID: 0}
    - rid: 2649295605456437303
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05D4\u05E8\u05D9, \u05D7\u05D5\u05E5 \u05DE\u05D0\u05DC\u05D5\u05DF,\n\u05E2\u05E0\u05D1\u05DC
            \u05D5\u05DE\u05D0\u05D9\u05D4\u2026"
          textEffects:
          - {fileID: 11400000, guid: 761882805dcdbd14a93d5d78b9e7c371, type: 2}

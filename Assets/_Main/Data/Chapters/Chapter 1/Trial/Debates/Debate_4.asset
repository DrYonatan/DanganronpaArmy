    - rid: 2649295605456437286
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05D0\u05D6 \u05DE\u05D4 \u05D0\u05EA\u05DD \u05D1\u05D3\u05D9\u05D5\u05E7
            \n\u05D0\u05D5\u05DE\u05E8\u05D9\u05DD \u05E9\u05D4\u05D5\u05D0 \u05E2\u05E9\u05D4?\r"

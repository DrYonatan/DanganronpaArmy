    - rid: 2649295605456437288
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05D5\u05D0\u05D6 \u05D2\u05E8\u05E8 \u05D0\u05EA \u05D2\u05D5\u05E4\u05D4

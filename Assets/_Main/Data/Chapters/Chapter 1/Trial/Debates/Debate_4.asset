    - rid: 2649295605456437287
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05D4\u05D5\u05D0 {\u05E8\u05E6\u05D7 \u05D0\u05EA \u05E8\u05D5\u05E2\u05D9

    - rid: 2649295605456438164
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05DC\u05D0 \u05D4\u05D2\u05D9\u05D5\u05E0\u05D9? \u05EA\u05E4\u05E8\u05D8\u05D9."

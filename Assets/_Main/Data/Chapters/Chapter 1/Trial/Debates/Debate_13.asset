          correctEvidence: {fileID: 0}
    - rid: 2649295605456438167
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05DE\u05D4 \u05D4\u05D1\u05E2\u05D9\u05D4? \u05E8\u05E7\n\u05D4\u05D9\u05D9\u05EA
            \u05E6\u05E8\u05D9\u05DB\u05D4\u2026"

    - rid: 2649295605456438166
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05D0\u05EA\u05DD \u05D1\u05D0\u05DE\u05EA \u05D7\u05D5\u05E9\u05D1\u05D9\u05DD\n{\u05E9\u05D4\u05D9\u05D9\u05EA\u05D9
            \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05D1\u05E6\u05E2\n\u05D0\u05EA
            \u05D4\u05E8\u05E6\u05D7} \u05D4\u05D6\u05D4?"
          textEffects:
          - {fileID: 11400000, guid: 78cef4dbf176f274ba273d043b6ea500, type: 2}

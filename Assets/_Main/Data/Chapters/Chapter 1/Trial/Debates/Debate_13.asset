    - rid: 2649295605456438165
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05D2\u05DD \u05D0\u05DD \u05E0\u05D9\u05E7\u05D9\u05EA\u05D9 \u05D0\u05EA"
          textEffects: []
          introEffect: {fileID: 11400000, guid: c3df132e3e852ae48bee85a7fd774150, type: 2}
          outroEffect: {fileID: 11400000, guid: 9358111a564d302439fb33105c4918c6, type: 2}

      data:
        textLines:
        - text: "\u05DC\u05D4\u05D5\u05E8\u05D9\u05D3 \u05D0\u05EA \u05D4\u05DE\u05D9\u05DD\n{\u05D1\u05D6\u05DE\u05DF

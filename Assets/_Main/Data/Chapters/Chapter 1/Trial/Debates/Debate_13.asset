      data:
        textLines:
        - text: "\u05DE\u05D4 \u05E9\u05D0\u05EA\u05D4 \u05D0\u05D5\u05DE\u05E8 \u05DC\u05D0\n\u05D4\u05D2\u05D9\u05D5\u05E0\u05D9

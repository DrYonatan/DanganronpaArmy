          delay: 0
          ttl: 4
          textLineScrollPosition: {x: 0, y: 0}
          correctEvidence: {fileID: 0}
        - text: "\u05DB\u05D3\u05D9 \u05DC\u05D4\u05E1\u05D9\u05E7 \u05DE\u05D4 \u05E9\u05D9\u05D8\u05EA

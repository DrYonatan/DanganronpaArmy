    - rid: 2649295605456437944
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05D0\u05D1\u05DC \u05D4\u05D0\u05DD \u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA
            \u05DE\u05E1\u05E4\u05D9\u05E7 "

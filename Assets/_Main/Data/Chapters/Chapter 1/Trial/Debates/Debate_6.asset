          correctEvidence: {fileID: 0}
    - rid: 2649295605456437511
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05D0\u05D5\u05DC\u05D9 \u05D4\u05E8\u05D5\u05E6\u05D7\u2026"
          textEffects:
          - {fileID: 11400000, guid: 78cef4dbf176f274ba273d043b6ea500, type: 2}
          introEffect: {fileID: 11400000, guid: 79d05a79f475ef643a1ecc36ad08d221, type: 2}

    - rid: 2649295605456437510
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05DC\u05D0 \u05D4\u05D1\u05E0\u05EA\u05D9, \u05DE\u05D4\n\u05D9\u05E9
            \u05D0\u05D9\u05E0\u05E1\u05D8\u05DC\u05D8\u05D5\u05E8 \u05D1\u05D9\u05E0\u05D9\u05E0\u05D5?"

    - rid: 2649295605456437509
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05D4\u05EA\u05E2\u05E1\u05E7 \u05E2\u05DD {\u05D4\u05E6\u05D9\u05E0\u05D5\u05E8\u05D5\u05EA
            \u05E9\u05D1\u05E8\u05DB\u05D6\u05EA}?"

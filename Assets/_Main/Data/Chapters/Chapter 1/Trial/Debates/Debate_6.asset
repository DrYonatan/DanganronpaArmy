    - rid: 2649295605456437512
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "{\u05D6\u05D9\u05DE\u05DF \u05D0\u05EA \u05D4\u05E7\u05D5\u05E1\u05DD}
            \u05D5\u05D2\u05E8\u05DD\n\u05DC\u05D1\u05E8\u05D6 \u05DC\u05D4\u05E4\u05E1\u05D9\u05E7
            \u05DC\u05E2\u05D1\u05D5\u05D3?\r"

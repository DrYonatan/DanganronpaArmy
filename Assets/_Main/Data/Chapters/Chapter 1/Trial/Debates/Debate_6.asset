    - rid: 2649295605456437513
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05D0\u05D5\u05DC\u05D9 \u05D3\u05D9 \u05DB\u05D1\u05E8 \u05E2\u05DD

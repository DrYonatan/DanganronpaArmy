    - rid: 2649295605456438006
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05D0\u05E0\u05D7\u05E0\u05D5 \u05E6\u05E8\u05D9\u05DB\u05D9\u05DD
            \u05DC\u05D7\u05E9\u05D5\u05D1"
          textEffects: []
          introEffect: {fileID: 11400000, guid: c3df132e3e852ae48bee85a7fd774150, type: 2}

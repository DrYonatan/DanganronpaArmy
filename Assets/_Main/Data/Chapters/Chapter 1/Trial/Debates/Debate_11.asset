      data:
        textLines:
        - text: "\u05E2\u05DC \u05D6\u05D4 \u05D0\u05E0\u05D7\u05E0\u05D5 \u05DE\u05D3\u05D1\u05E8\u05D9\u05DD\n\u05DB\u05D1\u05E8

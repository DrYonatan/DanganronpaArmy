    - rid: 2649295605456438005
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05D0\u05DC \u05EA\u05E0\u05E1\u05D9 \u05DC\u05E2\u05E9\u05D5\u05EA
            \u05DC\u05E0\u05D5\n\u05E2\u05D9\u05E0\u05D9\u05D9\u05DD \u05E2\u05DB\u05E9\u05D9\u05D5
            \u05D7\u05D9\u05D9\u05DD \u05E9\u05DC\u05D9.\r"

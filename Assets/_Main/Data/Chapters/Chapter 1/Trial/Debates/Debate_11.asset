    - rid: 2649295605456438007
      type: {class: DebateTextData, ns: , asm: Assembly-CSharp}
      data:
        textLines:
        - text: "\u05D4\u05D0\u05DD \u05D4\u05E8\u05D5\u05E6\u05D7 \n{\u05D4\u05D9\u05D4
            \u05D7\u05D9\u05D9\u05D1 \u05DC\u05D4\u05D9\u05D5\u05EA \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA\u05D9
            \u05D1\u05E0\u05D5\u05EA}?"

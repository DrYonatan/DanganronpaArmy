          rotationOffset: {x: 0, y: 0, z: 0}
          scale: {x: 1, y: 1, z: 1}
          delay: 0
          ttl: 3
          textLineScrollPosition: {x: 0, y: 0}
          correctEvidence: {fileID: 0}
        - text: "\u05E2\u05DC \u05D6\u05D4 \u05E2\u05D5\u05D3 \u05E4\u05E2\u05DD."
          textEffects: []
          introEffect: {fileID: 11400000, guid: 6c738300247b4e044bea12b9fa18f612, type: 2}
          outroEffect: {fileID: 11400000, guid: 352a529332a87ef4893531c2f9f6bf2d, type: 2}

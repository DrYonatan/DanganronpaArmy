    - rid: 6008430306001682694
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05E2\u05E0\u05D9\u05D9\u05DF \u05D0\u05D5\u05EA\u05D9, \u05DE\u05D4
          \u05E2\u05D5\u05E9\u05D9\u05DD \u05D1\u05D3\u05D5\u05D1\u05E8 \u05E6\u05D4\"\u05DC?"
        commands: []
    - rid: 6008430306001682695
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D6\u05D5\u05DB\u05E8 \u05E9\u05E8\u05D0\u05D9\u05EA\u05D9
          \u05D4\u05D5\u05D3\u05E2\u05D5\u05EA \u05DC\u05D2\u05D1\u05D9 \u05DE\u05D9\u05D5\u05E0\u05D9\u05DD
          \u05DC\u05D3\u05D5\u05D1\u05E8 \u05E6\u05D4\"\u05DC, \u05D1\u05D4\u05EA\u05D7\u05DC\u05D4
          \u05D7\u05E9\u05D1\u05EA\u05D9 \u05E9\u05D6\u05D4 \u05DE\u05DE\u05E9 \u05DC\u05D4\u05EA\u05DE\u05D9\u05D9\u05DF
          \u05DC\u05D4\u05D9\u05D5\u05EA \u05D4\u05D3\u05D5\u05D1\u05E8 \u05E2\u05E6\u05DE\u05D5,
          \u05D6\u05D4 \u05E9\u05DE\u05D3\u05D1\u05E8 \u05D1\u05D8\u05DC\u05D5\u05D5\u05D9\u05D6\u05D9\u05D4."
        commands: []
    - rid: 6008430306001682696
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D8\u05D5\u05D1, \u05D6\u05D5 \u05DE\u05D7\u05E9\u05D1\u05D4 \u05DE\u05E4\u05D2\u05E8\u05EA
          \u05DE\u05D0\u05D5\u05D3. \u05D0\u05EA\u05D4 \u05D1\u05D0\u05DE\u05EA \u05D7\u05D5\u05E9\u05D1
          \u05E9\u05D9\u05EA\u05E0\u05D5 \u05DC\u05D0\u05D9\u05D6\u05D4 \u05E6\u05E2\u05D9\u05E8
          \u05DE\u05D5\u05E9\u05EA\u05DF \u05DC\u05D3\u05D1\u05E8 \u05D1\u05D4\u05D5\u05D3\u05E2\u05D5\u05EA
          \u05E8\u05E9\u05DE\u05D9\u05D5\u05EA \u05E9\u05DC \u05E6\u05D4\"\u05DC?"
        commands: []
    - rid: 6008430306001682697
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D1\u05D3\u05D9\u05E2\u05D1\u05D3 \u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA
          \u05D4\u05D9\u05D4 \u05D8\u05D9\u05E4\u05E9\u05D9 \u05DE\u05E6\u05D9\u05D3\u05D9
          \u05DC\u05D7\u05E9\u05D5\u05D1, \u05D2\u05DD \u05D0\u05D6 \u05D6\u05D4
          \u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9 \u05DE\u05D0\u05D5\u05D3 \u05DE\u05D5\u05D6\u05E8\u2026"
        commands: []
    - rid: 6008430306001682698
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05DE\u05D4 \u05D1\u05D0\u05DE\u05EA \u05D4\u05D7\u05D9\u05D9\u05DC\u05D9\u05DD
          \u05D1\u05D3\u05D5\u05D1\u05E8 \u05E6\u05D4\"\u05DC \u05E2\u05D5\u05E9\u05D9\u05DD?"
        commands: []
    - rid: 6008430306001682699
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05E9 \u05DB\u05DC \u05DE\u05E0\u05D9 \u05D3\u05D1\u05E8\u05D9\u05DD.
          \u05D9\u05E9 \u05E6\u05DC\u05DE\u05D9\u05DD, \u05E9\u05DE\u05E6\u05DC\u05DE\u05D9\u05DD
          \u05D0\u05EA \u05D4\u05D4\u05D5\u05D3\u05E2\u05D5\u05EA, \u05E2\u05D5\u05E8\u05DB\u05D9
          \u05D5\u05D9\u05D3\u05D0\u05D5, \u05E9\u05DE\u05DB\u05D9\u05E0\u05D9\u05DD
          \u05D5\u05E2\u05D5\u05E8\u05DB\u05D9\u05DD \u05D0\u05EA \u05D4\u05E1\u05E8\u05D8\u05D5\u05DF,
          \u05D5\u05D9\u05E9 \u05DB\u05D0\u05DC\u05D4 \u05D2\u05DD \u05E9\u05E2\u05D5\u05D6\u05E8\u05D9\u05DD
          \u05DC\u05E0\u05E1\u05D7 \u05D4\u05D5\u05D3\u05E2\u05D5\u05EA."
        commands: []
    - rid: 6008430306001682700
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E9\u05D0\u05EA\u05D4 \u05E8\u05D5\u05D0\u05D4 \u05D1\u05D7\u05D3\u05E9\u05D5\u05EA
          \"\u05EA\u05D2\u05D5\u05D1\u05EA\u05D5 \u05E9\u05DC \u05D3\u05D5\u05D1\u05E8
          \u05E6\u05D4\"\u05DC\", \u05D9\u05E9 \u05D7\u05D9\u05D9\u05DC\u05D9\u05DD
          \u05E9\u05E2\u05D5\u05D6\u05E8\u05D9\u05DD \u05DC\u05E0\u05E1\u05D7 \u05D0\u05EA
          \u05D4\u05EA\u05D2\u05D5\u05D1\u05D5\u05EA \u05D4\u05D0\u05DC\u05D4."
        commands: []
    - rid: 6008430306001682701
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05E4\u05D7\u05D5\u05EA \u05D1\u05E7\u05D8\u05E2
          \u05E9\u05DC \u05D4\u05E6\u05D9\u05DC\u05D5\u05DE\u05D9\u05DD \u05D5\u05D4\u05E2\u05E8\u05D9\u05DB\u05D4.
          \u05D0\u05E0\u05D9 \u05D0\u05D5\u05D4\u05D1\u05EA \u05DC\u05D4\u05E9\u05EA\u05EA\u05E3
          \u05D1\u05E0\u05D9\u05E1\u05D5\u05D7 \u05E9\"\u05D7 \u05D4\u05D5\u05D3\u05E2\u05D5\u05EA
          \u05D5\u05EA\u05D2\u05D5\u05D1\u05D5\u05EA."
        commands: []
    - rid: 6008430306001682702
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D1\u05EA\u05D5\u05E8 \u05D4\u05E8\u05E2\"\u05E6\u05D9\u05EA,
          \u05D9\u05E9 \u05DC\u05D9 \u05D4\u05E8\u05D1\u05D4 \u05E9\u05DC\u05D9\u05D8\u05D4
          \u05D1\u05E0\u05D9\u05E1\u05D5\u05D7 \u05D4\u05DE\u05D3\u05D5\u05D9\u05E7."
        commands: []
    - rid: 6008430306001682703
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05D5, \u05E0\u05E9\u05DE\u05E2 \u05DE\u05D2\u05E0\u05D9\u05D1
          \u05DC\u05E8\u05D0\u05D5\u05EA \u05DB\u05DB\u05D4 \u05D3\u05D1\u05E8\u05D9\u05DD
          \u05E9\u05D0\u05EA \u05E0\u05D9\u05E1\u05D7\u05EA \u05DE\u05D5\u05E4\u05D9\u05E2\u05D9\u05DD
          \u05D1\u05D8\u05DC\u05D5\u05D5\u05D9\u05D6\u05D9\u05D4\u2026"
        commands: []
    - rid: 6008430306001682704
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D9\u05D5\u05EA\u05E8 \u05DE\u05E8\u05E7 \u05DE\u05D2\u05E0\u05D9\u05D1
          \u05DC\u05E8\u05D0\u05D5\u05EA \u05D0\u05EA \u05D6\u05D4, \u05DC\u05D0\u05D7\u05E8
          \u05D4\u05D4\u05D5\u05D3\u05E2\u05D4 \u05D0\u05EA\u05D4 \u05E8\u05D5\u05D0\u05D4
          \u05D0\u05EA \u05D4\u05D4\u05E9\u05E4\u05E2\u05D4 \u05E9\u05DC\u05D4 \u05E2\u05DC
          \u05D0\u05E0\u05E9\u05D9\u05DD."
        commands: []
    - rid: 6008430306001682705
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DC \u05E0\u05D9\u05E1\u05D5\u05D7, \u05DB\u05DC \u05D1\u05D7\u05D9\u05E8\u05EA
          \u05DE\u05D9\u05DC\u05D9\u05DD\u2026 \u05D9\u05E9 \u05DC\u05D4\u05DF \u05D4\u05E9\u05E4\u05E2\u05D4
          \u05E2\u05DC \u05D0\u05D9\u05DA \u05D0\u05E0\u05E9\u05D9\u05DD \u05E8\u05D5\u05D0\u05D9\u05DD
          \u05D0\u05EA \u05D4\u05E1\u05D9\u05D8\u05D5\u05D0\u05E6\u05D9\u05D4."
        commands: []
    - rid: 6008430306001682706
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05D7\u05E9\u05D1\u05EA\u05D9 \u05E2\u05DC \u05D6\u05D4.
          \u05EA\u05DE\u05D9\u05D3 \u05E9\u05E8\u05D0\u05D9\u05EA\u05D9 \"\u05EA\u05D2\u05D5\u05D1\u05EA\u05D5
          \u05E9\u05DC \u05D3\u05D5\u05D1\u05E8 \u05E6\u05D4\"\u05DC\", \u05D7\u05E9\u05D1\u05EA\u05D9
          \u05E2\u05DC \u05D6\u05D4 \u05DB\u05D0\u05D9\u05DC\u05D5 \u05E4\u05E9\u05D5\u05D8
          \u05DE\u05D9\u05E9\u05D4\u05D5 \u05E9\u05D5\u05D0\u05DC \u05D0\u05D5\u05EA\u05D5
          \u05D1\u05E8\u05D0\u05D9\u05D5\u05DF \u05E2\u05DC \u05D6\u05D4, \u05D5\u05D4\u05D5\u05D0
          \u05E4\u05E9\u05D5\u05D8 \u05E2\u05D5\u05E0\u05D4."
        commands: []
    - rid: 6008430306001682707
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E4\u05D7\u05D7, \u05D4\u05E6\u05D7\u05E7\u05EA \u05D0\u05D5\u05EA\u05D9.
          \u05D6\u05D4 \u05DC\u05D0 \u05DB\u05DB\u05D4 \u05E8\u05E7 \u05D1\u05E6\u05D4\"\u05DC,
          \u05DB\u05DC \u05DE\u05D4 \u05E9\u05D0\u05EA\u05D4 \u05E8\u05D5\u05D0\u05D4
          \u05D1\u05EA\u05E7\u05E9\u05D5\u05E8\u05EA, \u05DB\u05DC \u05DE\u05E9\u05E4\u05D8,
          \u05E0\u05D5\u05E1\u05D7 \u05DB\u05E4\u05D9 \u05E9\u05D4\u05D5\u05D0 \u05E0\u05D5\u05E1\u05D7
          \u05DB\u05D3\u05D9 \u05DC\u05D4\u05E2\u05D1\u05D9\u05E8 \u05D0\u05D2'\u05E0\u05D3\u05D4
          \u05DE\u05E1\u05D5\u05D9\u05DE\u05EA."
        commands: []
    - rid: 6008430306001682708
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05E9 \u05D0\u05E4\u05D9\u05DC\u05D5 \u05E9\u05DD \u05DC\u05DB\u05DC
          \u05D6\u05D4."
        commands: []
    - rid: 6008430306001682711
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D1\u05D3\u05D9\u05D5\u05E7. \u05D4\u05E0\u05D3\u05E1\u05EA
          \u05EA\u05D5\u05D3\u05E2\u05D4\u2026 \u05DE\u05E9\u05EA\u05DE\u05E9\u05D9\u05DD
          \u05D1\u05E0\u05D9\u05E1\u05D5\u05D7\u05D9\u05DD \u05D5\u05DE\u05D9\u05DC\u05D9\u05DD
          \u05DE\u05E1\u05D5\u05D9\u05DE\u05D5\u05EA \u05DB\u05D3\u05D9 \u05DC\u05D4\u05E2\u05D1\u05D9\u05E8
          \u05DE\u05E1\u05E8\u05D9\u05DD\u2026 \u05DC\u05D2\u05E8\u05D5\u05DD \u05DC\u05E6\u05D9\u05D1\u05D5\u05E8
          \u05DC\u05D7\u05E9\u05D5\u05D1 \u05D3\u05D1\u05E8 \u05DE\u05E1\u05D5\u05D9\u05DD."
        commands: []
    - rid: 6008430306001682712
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D0\u05EA \u05D2\u05DD \u05E2\u05D5\u05E9\u05D4 \u05D0\u05EA
          \u05D6\u05D4? \u05EA\u05DE\u05D9\u05D3 \u05D0\u05D5\u05DE\u05E8\u05D9\u05DD
          \u05E2\u05DC \u05D6\u05D4 \u05D1\u05EA\u05D5\u05E8 \u05DE\u05E9\u05D4\u05D5
          \u05E8\u05E2\u2026"
        commands: []
    - rid: 6008430306001682713
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D0\u05E0\u05E9\u05D9\u05DD \u05E9\u05D0\u05D5\u05DE\u05E8\u05D9\u05DD
          \u05E9\u05D6\u05D4 \u05E8\u05E2, \u05E4\u05E9\u05D5\u05D8 \u05DC\u05D0
          \u05DE\u05D1\u05D9\u05E0\u05D9\u05DD \u05D0\u05D9\u05DA \u05D4\u05E2\u05D5\u05DC\u05DD
          \u05E2\u05D5\u05D1\u05D3. \u05D1\u05E1\u05D5\u05E3, \u05D4\u05D0\u05DE\u05EA
          \u05D4\u05D9\u05D0 \u05DE\u05D4 \u05E9\u05E8\u05D5\u05D1 \u05D4\u05D0\u05E0\u05E9\u05D9\u05DD
          \u05DE\u05D0\u05DE\u05D9\u05E0\u05D9\u05DD \u05D1\u05D5."
        commands: []
    - rid: 6008430306001682714
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D7\u05D6\u05E7 \u05D4\u05D5\u05D0 \u05D6\u05D4 \u05E9\u05DE\u05E6\u05DC\u05D9\u05D7
          \u05DC\u05E9\u05DB\u05E0\u05E2 \u05D9\u05D5\u05EA\u05E8 \u05D0\u05E0\u05E9\u05D9\u05DD
          \u05D1\u05D0\u05D2'\u05E0\u05D3\u05D4 \u05E9\u05DC\u05D5, \u05D5\u05D4\u05D5\u05D0
          \u05D6\u05D4 \u05E9\u05E7\u05D5\u05D1\u05E2 \u05D0\u05EA \u05D4\u05D0\u05DE\u05EA."
        commands: []
    - rid: 6008430306001682715
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D4 \u05DE\u05EA\u05D7\u05D9\u05DC \u05DC\u05D4\u05D9\u05E9\u05DE\u05E2
          \u05E7\u05E6\u05EA \u05DB\u05DE\u05D5 \u05D0\u05D9\u05D6\u05D4 \u05E0\u05D0\u05D5\u05DD
          \u05E9\u05DC \u05E0\u05D1\u05DC \u05DE\u05E1\u05E8\u05D8\u2026)"
        commands: []
    - rid: 6008430306001682716
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D0\u05D9\u05E9\u05D9\u05EA \u05E0\u05D4\u05E0\u05EA
          \u05DE\u05D6\u05D4. \u05D0\u05E0\u05D9 \u05E0\u05D4\u05E0\u05EA \u05DC\u05E8\u05D0\u05D5\u05EA
          \u05D0\u05D9\u05DA \u05D1\u05D7\u05D9\u05E8\u05EA \u05D4\u05DE\u05D9\u05DC\u05D9\u05DD
          \u05E9\u05DC\u05D9 \u05E2\u05D5\u05D1\u05D3\u05EA \u05DB\u05DE\u05D5 \u05E7\u05E1\u05DD,
          \u05D0\u05D9\u05DA \u05D0\u05E0\u05E9\u05D9\u05DD \u05DB\u05DE\u05D5 \u05DB\u05D1\u05E9\u05D9\u05DD
          \u05D0\u05D5\u05DB\u05DC\u05D9\u05DD \u05D0\u05EA \u05DE\u05D4 \u05E9\u05D0\u05E0\u05D9
          \u05DE\u05D0\u05DB\u05D9\u05DC\u05D4 \u05D0\u05D5\u05EA\u05DD."
        commands: []
    - rid: 6008430306001682717
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05E0\u05E9\u05DE\u05E2 \u05E7\u05E6\u05EA \u05DE\u05E4\u05D7\u05D9\u05D3\u2026
          \u05DE\u05D4 \u05D0\u05DD \u05D4\u05DE\u05D9\u05DC\u05D9\u05DD \u05E9\u05DC\u05DA
          \u05DE\u05D5\u05D1\u05D9\u05DC\u05D5\u05EA \u05DC\u05D3\u05D1\u05E8\u05D9\u05DD
          \u05E8\u05E2\u05D9\u05DD\u2026? \u05D0\u05DD \u05D4\u05DF \u05D9\u05D2\u05E8\u05DE\u05D5
          \u05DC\u05DE\u05D9\u05E9\u05D4\u05D5 \u05DC\u05E2\u05E9\u05D5\u05EA \u05DE\u05E9\u05D4\u05D5
          \u05E7\u05D9\u05E6\u05D5\u05E0\u05D9\u2026"
        commands: []
    - rid: 6008430306001682718
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DC \u05EA\u05D3\u05D0\u05D2 \u05D1\u05E0\u05D5\u05D2\u05E2
          \u05DC\u05D6\u05D4. \u05D0\u05E0\u05D9 \u05DE\u05D3\u05D1\u05E8\u05EA \u05D1\u05D0\u05D7\u05E8\u05D9\u05D5\u05EA,
          \u05D0\u05EA\u05D4 \u05E6\u05D5\u05D3\u05E7 \u05E9\u05D0\u05DD \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05E8\u05D5\u05E6\u05D4, \u05D4\u05D9\u05D9\u05EA\u05D9 \u05D9\u05DB\u05D5\u05DC\u05D4
          \u05DC\u05D2\u05E8\u05D5\u05DD \u05DC\u05E8\u05E6\u05D7, \u05D0\u05D1\u05DC
          \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05E2\u05D5\u05E9\u05D4 \u05D0\u05EA \u05D6\u05D4."
        commands: []
    - rid: 6008430306001682719
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D7\u05D5\u05E9\u05D1\u05EA \u05D8\u05D5\u05D1
          \u05DE\u05D0\u05D5\u05D3 \u05E2\u05DC \u05DE\u05D4 \u05D0\u05E0\u05D9 \u05E8\u05D5\u05E6\u05D4
          \u05E9\u05D0\u05E0\u05E9\u05D9\u05DD \u05D9\u05D7\u05E9\u05D1\u05D5, \u05DB\u05DB\u05D4
          \u05E9\u05DC\u05E8\u05D0\u05D5\u05EA \u05D0\u05EA \u05D6\u05D4 \u05E7\u05D5\u05E8\u05D4
          \u05D6\u05D4 \u05EA\u05DE\u05D9\u05D3 \u05D3\u05D1\u05E8 \u05D8\u05D5\u05D1."
        commands: []
    - rid: 6008430306001682720
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7 \u05E9\u05D0\u05E0\u05D9
          \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D1\u05D9\u05DF\u2026"
        commands: []
    - rid: 6008430306001682721
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05D0\u05EA\u05D4 \u05DC\u05D0 \u05E8\u05D5\u05E6\u05D4
          \u05DC\u05D4\u05D9\u05D5\u05EA \u05DB\u05D1\u05E9, \u05EA\u05E0\u05EA\u05D7
          \u05D0\u05EA \u05DB\u05DC \u05DE\u05D4 \u05E9\u05D0\u05EA\u05D4 \u05E8\u05D5\u05D0\u05D4,
          \u05E7\u05D5\u05E8\u05D0 \u05D5\u05E9\u05D5\u05DE\u05E2. \u05D0\u05EA\u05D4
          \u05EA\u05DE\u05D9\u05D3 \u05EA\u05D5\u05DB\u05DC \u05DC\u05DE\u05E6\u05D5\u05D0
          \u05DE\u05E1\u05E8\u05D9\u05DD \u05D7\u05D1\u05D5\u05D9\u05D9\u05DD."

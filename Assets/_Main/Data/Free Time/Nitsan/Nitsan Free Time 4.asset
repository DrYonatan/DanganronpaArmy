        commands: []
    - rid: 3680544866628272175
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D0\u05DE\u05EA? \u05D0\u05EA \u05D0\u05D5\u05DE\u05E8\u05EA

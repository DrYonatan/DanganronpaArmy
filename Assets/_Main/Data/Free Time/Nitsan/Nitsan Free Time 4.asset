          \u05D1\u05D4\u05DB\u05E8\u05D7 \u05E0\u05DB\u05D5\u05E0\u05D9\u05DD."
        commands: []
    - rid: 3680544866628272189
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D2\u05D1\u05DC\u05D5\u05EA \u05DE\u05D4\u05D9\u05E8\u05D5\u05EA

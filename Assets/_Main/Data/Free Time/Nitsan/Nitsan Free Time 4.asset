    - rid: 3680544866628272185
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05D1\u05D9\u05E0\u05D4 \u05D0\u05EA \u05D4\u05DE\u05DE\u05E9\u05DC\u05D5\u05EA

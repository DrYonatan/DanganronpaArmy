    - rid: 3680544866628272183
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05EA\u05D7\u05E9\u05D5\u05D1 \u05E9\u05D1\u05DB\u05DC \u05E8\u05D2\u05E2

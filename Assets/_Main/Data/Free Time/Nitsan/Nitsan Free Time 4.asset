    - rid: 3680544866628272181
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05D0\u05DE\u05E8\u05EA\u05D9 \u05E9\u05D0\u05E0\u05D9
          \u05E0\u05D2\u05D3 \u05D6\u05D4. \u05D0\u05EA\u05D4 \u05D9\u05D5\u05D3\u05E2

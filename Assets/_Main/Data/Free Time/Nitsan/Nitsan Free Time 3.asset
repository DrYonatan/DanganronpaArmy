    - rid: 6008430306001682855
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05E0\u05D9\u05E6\u05DF, \u05D0\u05D9\u05DA \u05D0\u05EA
          \u05DE\u05E2\u05D1\u05D9\u05E8\u05D4 \u05D0\u05EA \u05D4\u05D6\u05DE\u05DF
          \u05E4\u05D4 \u05D1\u05D0\u05DE\u05EA?"
        commands: []
    - rid: 6008430306001682856
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D0\u05EA\u05D4 \u05DE\u05EA\u05D7\u05D9\u05DC \u05D0\u05D9\u05EA\u05D9?
          \u05D9\u05E9 \u05DC\u05D9 \u05D7\u05D1\u05E8."
        commands: []
    - rid: 6008430306001682857
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DC\u05D0 \u05D4\u05EA\u05D7\u05DC\u05EA\u05D9 \u05D0\u05D9\u05EA\u05D4\u2026)"
        commands: []
    - rid: 6008430306001682858
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D0\u05DE\u05EA? \u05DE\u05E2\u05E0\u05D9\u05D9\u05DF \u05D0\u05D9\u05D6\u05D4
          \u05DE\u05DF \u05D1\u05DF \u05D0\u05D3\u05DD \u05D4\u05D5\u05D0\u2026"
        commands: []
    - rid: 6008430306001682859
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DF \u05DC\u05D9 \u05D7\u05D1\u05E8. \u05D0\u05EA\u05D4
          \u05D1\u05D0\u05DE\u05EA \u05DE\u05D0\u05DE\u05D9\u05DF \u05DC\u05DB\u05DC
          \u05D3\u05D1\u05E8."
        commands: []
    - rid: 6008430306001682860
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: (...)
        commands: []
    - rid: 6008430306001682861
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D0\u05EA\u05D4 \u05E6\u05D5\u05D3\u05E7 \u05D1\u05D6\u05D4
          \u05E9\u05D0\u05EA\u05D4 \u05EA\u05D5\u05D4\u05D4 \u05D0\u05D9\u05D6\u05D4
          \u05DE\u05DF \u05D1\u05DF \u05D0\u05D3\u05DD \u05D4\u05D9\u05D4 \u05D9\u05DB\u05D5\u05DC
          \u05DC\u05D4\u05D9\u05D5\u05EA \u05D7\u05D1\u05E8 \u05E9\u05DC\u05D9."
        commands: []
    - rid: 6008430306001682862
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D8\u05D5\u05D1, \u05DB\u05E4\u05D9 \u05E9\u05D0\u05D5\u05DC\u05D9
          \u05D4\u05D9\u05D9\u05EA \u05D9\u05DB\u05D5\u05DC \u05DC\u05E6\u05E4\u05D5\u05EA,
          \u05D0\u05E3 \u05D0\u05D7\u05D3 \u05DC\u05D0 \u05DE\u05D5\u05E6\u05D0 \u05D7\u05DF
          \u05D1\u05E2\u05D9\u05E0\u05D9\u05D9."
        commands: []
    - rid: 6008430306001682863
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05D4\u05D9\u05D9\u05EA\u05D9 \u05E8\u05D5\u05E6\u05D4
          \u05DC\u05D4\u05E9\u05D9\u05D2 \u05D0\u05D9\u05D6\u05D4 \u05D0\u05D7\u05D3
          \u05E9\u05D9\u05D1\u05D9\u05D0 \u05DC\u05D9 \u05D1\u05D5\u05D7\u05D8\u05D5\u05EA,
          \u05D0\u05D5 \u05E9\u05D9\u05E2\u05E9\u05D4 \u05D3\u05D1\u05E8\u05D9\u05DD
          \u05D1\u05E9\u05D1\u05D9\u05DC\u05D9, \u05D6\u05D0\u05EA \u05DC\u05D0 \u05D4\u05D9\u05D9\u05EA\u05D4
          \u05D1\u05E2\u05D9\u05D4. \u05DB\u05D0\u05DC\u05D4 \u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC\u05D4
          \u05DC\u05D4\u05D5\u05E6\u05D9\u05D0 \u05DE\u05DE\u05D0\u05D7\u05D5\u05E8\u05D9
          \u05D4\u05D0\u05D5\u05D6\u05DF."
        commands: []
    - rid: 6008430306001682864
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05DC\u05E4\u05E2\u05DE\u05D9\u05DD \u05E7\u05E9\u05D4
          \u05DC\u05D9 \u05E2\u05DD \u05DB\u05DE\u05D4 \u05E9\u05DB\u05D5\u05DC\u05DD
          \u05DB\u05D1\u05E9\u05D9\u05DD."
        commands: []
    - rid: 6008430306001682865
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D0\u05DE\u05EA? \u05D7\u05E9\u05D1\u05EA\u05D9 \u05E9\u05D0\u05EA
          \u05D0\u05D5\u05D4\u05D1\u05EA \u05D0\u05EA \u05D6\u05D4\u2026"
        commands: []
    - rid: 6008430306001682866
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05E6\u05D3 \u05D0\u05D7\u05D3, \u05D0\u05E0\u05D9 \u05E0\u05D4\u05E0\u05EA
          \u05DE\u05D4\u05E9\u05DC\u05D9\u05D8\u05D4 \u05E9\u05D9\u05E9 \u05DC\u05D9
          \u05E2\u05DC \u05D4\u05D4\u05DE\u05D5\u05DF. \u05D0\u05E0\u05D9 \u05D0\u05D5\u05D4\u05D1\u05EA
          \u05DC\u05E2\u05DE\u05D5\u05D3 \u05DE\u05E2\u05DC\u05D9\u05D4\u05DD."
        commands: []
    - rid: 6008430306001682867
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D9\u05D0 \u05DE\u05DE\u05E9 \u05E8\u05D5\u05D0\u05D4 \u05D0\u05EA
          \u05E2\u05E6\u05DE\u05D4 \u05DB\u05E2\u05E8\u05D9\u05E6\u05D4\u2026)"
        commands: []
    - rid: 6008430306001682868
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05DE\u05E6\u05D3 \u05E9\u05E0\u05D9, \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05E8\u05D5\u05E6\u05D4 \u05DE\u05D9\u05E9\u05D4\u05D5 \u05E9\u05D1\u05D0\u05DE\u05EA
          \u05DE\u05D1\u05D9\u05DF \u05D0\u05D5\u05EA\u05D9, \u05DB\u05D6\u05D4 \u05E9\u05D9\u05E9
          \u05DC\u05D5 \u05E8\u05D0\u05D9\u05D4 \u05D9\u05D5\u05EA\u05E8 \u05D7\u05D9\u05E6\u05D5\u05E0\u05D9\u05EA
          \u05E2\u05DC \u05D4\u05E2\u05D5\u05DC\u05DD."
        commands: []
    - rid: 6008430306001682869
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D0\u05D9\u05DF \u05DB\u05D0\u05DC\u05D4."
        commands: []
    - rid: 6008430306001682870
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DC \u05D0\u05D7\u05D3 \u05E9\u05D0\u05E0\u05D9 \u05DE\u05D3\u05D1\u05E8\u05EA
          \u05D0\u05D9\u05EA\u05D5, \u05D0\u05E0\u05D9 \u05DB\u05DE\u05E2\u05D8 \u05D9\u05DB\u05D5\u05DC\u05D4
          \u05DC\u05D4\u05E9\u05DC\u05D9\u05DD \u05D0\u05EA \u05D4\u05DE\u05E9\u05E4\u05D8\u05D9\u05DD
          \u05E9\u05DC\u05D5."
        commands: []
    - rid: 6008430306001682871
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05DB\u05D0\u05D5\u05E8\u05D4 \u05E0\u05E9\u05DE\u05E2 \u05DB\u05DE\u05D5
          \u05D0\u05D4\u05D1\u05D4 \u05DE\u05DE\u05D1\u05D8 \u05E8\u05D0\u05E9\u05D5\u05DF,
          \u05D0\u05E0\u05D7\u05E0\u05D5 \u05DE\u05E9\u05DC\u05D9\u05DE\u05D9\u05DD
          \u05D0\u05D7\u05D3 \u05DC\u05E9\u05E0\u05D9 \u05D0\u05EA \u05D4\u05DE\u05E9\u05E4\u05D8\u05D9\u05DD!"
        commands: []
    - rid: 6008430306001682872
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E8\u05E7 \u05E9\u05D6\u05D4 \u05D7\u05D3 \u05E6\u05D3\u05D3\u05D9.
          \u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05D4\u05E9\u05DC\u05D9\u05DD
          \u05DC\u05D5 \u05D0\u05EA \u05D4\u05DE\u05E9\u05E4\u05D8\u05D9\u05DD, \u05DC\u05D0
          \u05DC\u05D4\u05E4\u05D9\u05DA. \u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC\u05D4
          \u05DC\u05D4\u05D1\u05D9\u05DF \u05D1\u05D3\u05D9\u05D5\u05E7 \u05D0\u05EA
          \u05EA\u05D4\u05DC\u05D9\u05DA \u05D4\u05DE\u05D7\u05E9\u05D1\u05D4 \u05D4\u05E4\u05E9\u05D5\u05D8
          \u05E9\u05DC\u05D5, \u05D5\u05D0\u05D9\u05DF \u05E1\u05D9\u05DB\u05D5\u05D9
          \u05E9\u05D4\u05D5\u05D0 \u05D9\u05D1\u05D9\u05DF \u05D0\u05EA \u05E9\u05DC\u05D9."
        commands: []
    - rid: 6008430306001682873
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05E7\u05E6\u05EA \u05D1\u05D5\u05D3\u05D3 \u05DC\u05E4\u05E2\u05DE\u05D9\u05DD\u2026
          \u05D0\u05E0\u05D9 \u05DE\u05E8\u05D2\u05D9\u05E9\u05D4 \u05DB\u05D0\u05D9\u05DC\u05D5
          \u05D0\u05E0\u05D9 \u05D3\u05DE\u05D5\u05EA \u05D1\u05DE\u05E9\u05D7\u05E7
          \u05D0\u05D5 \u05E1\u05E8\u05D8, \u05D5\u05DB\u05D5\u05DC\u05DD \u05D1\u05D5\u05D8\u05D9\u05DD
          \u05E9\u05E2\u05D5\u05E7\u05D1\u05D9\u05DD \u05D0\u05D7\u05E8\u05D9 \u05D4\u05EA\u05E1\u05E8\u05D9\u05D8
          \u05D4\u05DE\u05EA\u05D5\u05DB\u05E0\u05DF \u05E9\u05DC\u05D4\u05DD."
        commands: []
    - rid: 6008430306001682874
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D0\u05DE\u05EA \u05E9\u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA
          \u05E0\u05E9\u05DE\u05E2 \u05D1\u05D0\u05E1\u05D4\u2026 \u05D0\u05E4\u05D9\u05DC\u05D5
          \u05D0\u05DD \u05D4\u05D9\u05D0 \u05DE\u05E6\u05D9\u05D2\u05D4 \u05D0\u05EA
          \u05D6\u05D4 \u05D1\u05D0\u05D5\u05E4\u05DF \u05DE\u05EA\u05E0\u05E9\u05D0.)"
        commands: []
    - rid: 6008430306001682875
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E3 \u05E4\u05E2\u05DD \u05DC\u05D0 \u05E4\u05D2\u05E9\u05EA
          \u05DE\u05D9\u05E9\u05D4\u05D5 \u05E9\u05DC\u05D0\u2026 \u05DB\u05D1\u05E9,
          \u05DB\u05E4\u05D9 \u05E9\u05D0\u05EA \u05D0\u05D5\u05DE\u05E8\u05EA?"
        commands: []
    - rid: 6008430306001682876
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0. \u05D0\u05E4\u05D9\u05DC\u05D5 \u05D4\u05D7\u05D1\u05E8\u05D5\u05EA
          \u05E9\u05DC\u05D9, \u05DC\u05D0 \u05DE\u05E9\u05E0\u05D4 \u05DB\u05DE\u05D4
          \u05D0\u05E0\u05D9 \u05E9\u05E8\u05D5\u05E4\u05D4 \u05E2\u05DC\u05D9\u05D4\u05DF,
          \u05D4\u05DF \u05DC\u05D0 \u05D1\u05D0\u05DE\u05EA \u05D1\u05E8\u05DE\u05D4
          \u05E9\u05DC\u05D9."
        commands: []
    - rid: 6008430306001682877
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E4\u05D9\u05DC\u05D5 \u05D7\u05D1\u05E8\u05D5\u05EA \u05E9\u05DC\u05DA\u2026?
          \u05DE\u05D4 \u05DC\u05D2\u05D1\u05D9 \u05D4\u05DE\u05E9\u05E4\u05D7\u05D4?"
        commands: []
    - rid: 6008430306001682878
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05DE\u05E9\u05E4\u05D7\u05D4 \u05E9\u05DC\u05D9 \u05D4\u05DD
          \u05D1\u05E2\u05E8\u05DA \u05D4\u05D0\u05E0\u05E9\u05D9\u05DD \u05E9\u05D4\u05DB\u05D9
          \u05DE\u05D1\u05D9\u05E0\u05D9\u05DD, \u05D1\u05DC\u05E2\u05D3\u05D9\u05D4\u05DD
          \u05DB\u05E0\u05E8\u05D0\u05D4 \u05DB\u05D1\u05E8 \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05DE\u05E9\u05EA\u05D2\u05E2\u05EA \u05DE\u05D7\u05D5\u05E1\u05E8 \u05D4\u05DE\u05D7\u05E9\u05D1\u05D4
          \u05E9\u05DC \u05DB\u05D5\u05DC\u05DD. \u05E2\u05DD \u05D6\u05D0\u05EA,
          \u05D0\u05E4\u05D9\u05DC\u05D5 \u05D0\u05E6\u05DC\u05DD \u05D0\u05E0\u05D9
          \u05DE\u05E8\u05D2\u05D9\u05E9\u05D4 \u05E9\u05D0\u05E0\u05D9 \u05DE\u05D1\u05D9\u05E0\u05D4
          \u05D9\u05D5\u05EA\u05E8."
        commands: []
    - rid: 6008430306001682879
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D5\u05D5\u05D0\u05D5\u2026 \u05D4\u05D9\u05D0 \u05D1\u05D0\u05DE\u05EA
          \u05DE\u05E8\u05D2\u05D9\u05E9\u05D4 \u05E9\u05D0\u05E3 \u05D0\u05D7\u05D3
          \u05DC\u05D0 \u05D1\u05E8\u05DE\u05D4 \u05E9\u05DC\u05D4.)"
        commands: []
    - rid: 6008430306001682880
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D1\u05D0\u05DE\u05EA \u05D0\u05EA \u05DC\u05D0 \u05DE\u05DB\u05D9\u05E8\u05D4
          \u05D0\u05E3 \u05D0\u05D7\u05D3 \u05E9\u05D9\u05E9 \u05DC\u05D5 \u05E8\u05D0\u05D9\u05D4
          \u05DE\u05E2\u05D1\u05E8, \u05E9\u05D4\u05D5\u05D0 \u05DC\u05D0 \"\u05DB\u05D1\u05E9\"?"
        commands: []
    - rid: 6008430306001682881
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D8\u05D5\u05D1, \u05D9\u05E9 \u05D0\u05D5\u05EA\u05DA."
        commands: []
    - rid: 6008430306001682882
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DE\u05D4\u2026?)"
        commands: []
    - rid: 6008430306001682883
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E4\u05D7\u05D7\u05D7, \u05D0\u05EA\u05D4 \u05E0\u05E8\u05D0\u05D4
          \u05DB\u05D6\u05D4 \u05D1\u05E9\u05D5\u05E7. \u05D1\u05E8\u05D5\u05E8 \u05E9\u05D0\u05E0\u05D9
          \u05E6\u05D5\u05D7\u05E7\u05EA."
        commands: []
    - rid: 6008430306001682884
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05DF, \u05E0\u05E9\u05DE\u05E2 \u05D9\u05D5\u05EA\u05E8 \u05D4\u05D2\u05D9\u05D5\u05E0\u05D9\u2026)"
        commands: []
    - rid: 6008430306001682885
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D1\u05DB\u05DC \u05D6\u05D0\u05EA, \u05D0\u05E0\u05D9

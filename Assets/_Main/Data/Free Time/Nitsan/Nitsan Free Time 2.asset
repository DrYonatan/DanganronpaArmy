    - rid: 6008430306001682775
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05D6\u05D4 \u05E2\u05E6\u05D1\u05D9\u05DD!"
        commands: []
    - rid: 6008430306001682776
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05E7\u05E8\u05D4?"
        commands: []
    - rid: 6008430306001682777
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D3\u05D9\u05D5\u05E7 \u05D4\u05D9\u05D9\u05EA\u05D4 \u05D0\u05DE\u05D5\u05E8\u05D4
          \u05DC\u05D4\u05D9\u05DB\u05E0\u05E1 \u05DC\u05D9 \u05DE\u05E9\u05DB\u05D5\u05E8\u05EA
          \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05D2\u05E2\u05E0\u05D5 \u05DC\u05E4\u05D4!
          \u05D4\u05D9\u05D5 \u05DC\u05D9 \u05DE\u05DC\u05D0 \u05D3\u05D1\u05E8\u05D9\u05DD
          \u05E9\u05EA\u05DB\u05E0\u05E0\u05EA\u05D9 \u05DC\u05E7\u05E0\u05D5\u05EA."
        commands: []
    - rid: 6008430306001682778
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E2\u05DD \u05D4\u05DE\u05E9\u05DB\u05D5\u05E8\u05EA \u05E9\u05DC\u05E0\u05D5?
          \u05DB\u05DE\u05D4 \u05DB\u05D1\u05E8 \u05D0\u05E4\u05E9\u05E8 \u05DC\u05E7\u05E0\u05D5\u05EA
          \u05D0\u05EA \u05D6\u05D4."
        commands: []
    - rid: 6008430306001682779
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05E2\u05DD \u05D4\u05DE\u05E9\u05DB\u05D5\u05E8\u05EA
          \u05D4\u05E6\u05D1\u05D0\u05D9\u05EA, \u05D9\u05D0 \u05E7\u05D5\u05E3.
          \u05DE\u05D4\u05E2\u05D1\u05D5\u05D3\u05D4."
        commands: []
    - rid: 6008430306001682780
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E9\u05D0\u05E0\u05D9 \u05DE\u05D7\u05D5\u05E5 \u05DC\u05D1\u05E1\u05D9\u05E1
          \u05D0\u05E0\u05D9 \u05E2\u05D5\u05D1\u05D3\u05EA \u05D1\u05DE\u05DC\u05E6\u05E8\u05D5\u05EA."
        commands: []
    - rid: 6008430306001682781
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D4 \u05D1\u05D0\u05DE\u05EA? \u05D9\u05E4\u05D4\u2026 \u05EA\u05DE\u05D9\u05D3
          \u05D0\u05D5\u05DE\u05E8\u05D9\u05DD \u05E9\u05DC\u05DE\u05E6\u05DC\u05E8
          \u05D6\u05D5 \u05E2\u05D1\u05D5\u05D3\u05D4 \u05E7\u05E9\u05D4."
        commands: []
    - rid: 6008430306001682782
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E7\u05E9\u05D4?"
        commands: []
    - rid: 6008430306001682783
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E9\u05DE\u05E2\u05EA\u05D9 \u05E9\u05E6\u05E8\u05D9\u05DA \u05DB\u05DC
          \u05D4\u05D9\u05D5\u05DD \u05DC\u05E4\u05E8\u05E4\u05E8 \u05E2\u05DC \u05D4\u05E8\u05D2\u05DC\u05D9\u05D9\u05DD
          \u05D5\u05DC\u05D4\u05D1\u05D9\u05D0 \u05DC\u05D0\u05E0\u05E9\u05D9\u05DD
          \u05D3\u05D1\u05E8\u05D9\u05DD, \u05D5\u05E2\u05D5\u05D3 \u05DC\u05E0\u05E1\u05D5\u05EA
          \u05DC\u05D4\u05D9\u05D5\u05EA \u05E0\u05D7\u05DE\u05D3\u05D9\u05DD \u05DC\u05DC\u05E7\u05D5\u05D7\u05D5\u05EA
          \u05D1\u05E9\u05D1\u05D9\u05DC \u05D8\u05D9\u05E4\u05D9\u05DD, \u05D2\u05DD
          \u05D0\u05DD \u05D4\u05DD \u05DE\u05E2\u05E6\u05D1\u05E0\u05D9\u05DD\u2026"
        commands: []
    - rid: 6008430306001682784
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D0\u05EA \u05D1\u05E2\u05D9\u05D4 \u05E9\u05DC \u05DE\u05D9
          \u05E9\u05E1\u05D9\u05E4\u05E8 \u05DC\u05DA \u05D0\u05EA \u05D6\u05D4.
          \u05DB\u05E9\u05D0\u05E0\u05D9 \u05DE\u05DE\u05DC\u05E6\u05E8\u05EA, \u05D0\u05E0\u05D9
          \u05E4\u05E9\u05D5\u05D8 \u05D2\u05D5\u05E8\u05DE\u05EA \u05DC\u05D4\u05DD
          \u05DC\u05D4\u05D1\u05D9\u05D0 \u05DC\u05D9 \u05D8\u05D9\u05E4\u05D9\u05DD
          \u05E9\u05DE\u05E0\u05D9\u05DD."
        commands: []
    - rid: 6008430306001682785
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026\u05D2\u05D5\u05E8\u05DE\u05EA? \u05DE\u05D4 \u05D6\u05D4 \u05D0\u05D5\u05DE\u05E8?"
        commands: []
    - rid: 6008430306001682786
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05E9 \u05DB\u05DC \u05DE\u05E0\u05D9 \u05D8\u05DB\u05E0\u05D9\u05E7\u05D5\u05EA.
          \u05EA\u05DC\u05D5\u05D9 \u05D1\u05DC\u05E7\u05D5\u05D7."
        commands: []
    - rid: 6008430306001682787
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E4\u05E2\u05DD \u05D0\u05D7\u05EA, \u05D4\u05D9\u05D4 \u05D0\u05D9\u05D6\u05D4
          \u05D2\u05E8\u05D9\u05D0\u05D8\u05E8 \u05D1\u05DF 07 \u05E9\u05D9\u05E9\u05D1
          \u05D0\u05E6\u05DC\u05D9, \u05DB\u05DC \u05D4\u05D0\u05E8\u05D5\u05D7\u05D4
          \u05E9\u05DC\u05D5 \u05D4\u05D9\u05D9\u05EA\u05D9 \u05DE\u05D2\u05E2\u05D9\u05DC\u05D4
          \u05D0\u05DC\u05D9\u05D5, \u05D1\u05E7\u05D5\u05E9\u05D9 \u05D4\u05D2\u05E2\u05EA\u05D9
          \u05DB\u05E9\u05D4\u05D5\u05D0 \u05D1\u05D9\u05E7\u05E9 \u05D0\u05D5\u05EA\u05D9,
          \u05D5\u05D1\u05E1\u05D5\u05E3 \u05D4\u05D5\u05D0 \u05D4\u05D1\u05D9\u05D0
          \u05DC\u05D9 %04 \u05D8\u05D9\u05E4! "
        commands: []
    - rid: 6008430306001682788
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4? \u05D0\u05D9\u05DA?"
        commands: []
    - rid: 6008430306001682789
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E4\u05D9 \u05E9\u05D0\u05DE\u05E8\u05EA\u05D9 \u05DC\u05DA,
          \u05D0\u05DD \u05D0\u05E0\u05D9 \u05E8\u05D5\u05E6\u05D4 \u05DC\u05E9\u05DB\u05E0\u05E2
          \u05DE\u05D9\u05E9\u05D4\u05D5 \u05DC\u05E2\u05E9\u05D5\u05EA \u05DE\u05E9\u05D4\u05D5,
          \u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC\u05D4 \u05D1\u05DC\u05D9 \u05D1\u05E2\u05D9\u05D4.
          \u05D1\u05DE\u05E7\u05E8\u05D4 \u05E9\u05DC \u05D4\u05D1\u05D7\u05D5\u05E8
          \u05D4\u05D4\u05D5\u05D0, \u05D1\u05D0\u05DE\u05EA \u05DC\u05D0 \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05E6\u05E8\u05D9\u05DB\u05D4 \u05DC\u05E2\u05E9\u05D5\u05EA \u05D4\u05E8\u05D1\u05D4,
          \u05DE\u05E1\u05E4\u05D9\u05E7 \u05DC\u05D4\u05D9\u05E8\u05D0\u05D5\u05EA
          \u05D8\u05D5\u05D1, \u05D5\u05D4\u05D5\u05D0 \u05DB\u05D1\u05E8 \u05E9\u05DC\u05D9."
        commands: []
    - rid: 6008430306001682790
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05E9\u05D9\u05DD \u05DB\u05D0\u05DC\u05D4 \u05E4\u05EA\u05D8\u05D9\u05D9\u05DD
          \u05D1\u05E2\u05D9\u05E0\u05D9\u05D9. \u05D0\u05E0\u05D9 \u05D4\u05D1\u05D0\u05EA\u05D9
          \u05DC\u05D5 \u05D0\u05EA \u05D4\u05D7\u05D5\u05D5\u05D9\u05D4 \u05D4\u05DB\u05D9
          \u05D2\u05E8\u05D5\u05E2\u05D4 \u05E9\u05D0\u05E4\u05E9\u05E8 \u05D1\u05DE\u05E1\u05E2\u05D3\u05D4
          \u05D4\u05D6\u05D0\u05EA, \u05D5\u05D4\u05D5\u05D0 \u05E2\u05D3\u05D9\u05D9\u05DF
          \u05D4\u05D1\u05D9\u05D0 \u05DC\u05D9 \u05D8\u05D9\u05E4 \u05DE\u05D8\u05D5\u05E8\u05E3,
          \u05E8\u05E7 \u05DB\u05D9 \u05D0\u05E0\u05D9 \u05D9\u05E4\u05D4."
        commands: []
    - rid: 6008430306001682791
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D9\u05E9 \u05DE\u05E7\u05E8\u05D9\u05DD \u05E9\u05D6\u05D4
          \u05D9\u05D5\u05EA\u05E8 \u05DE\u05E1\u05D5\u05D1\u05DA\u2026"
        commands: []
    - rid: 6008430306001682792
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA \u05D3\u05D9 \u05DE\u05E8\u05E9\u05D9\u05DD\u2026
          \u05D4\u05D9\u05D0 \u05DE\u05DE\u05E9 \u05D9\u05D5\u05D3\u05E2\u05EA \u05DC\u05E7\u05DC\u05D5\u05D8
          \u05D0\u05EA \u05D4\u05D1\u05DF \u05D0\u05D3\u05DD, \u05D1\u05D3\u05D9\u05D5\u05E7
          \u05DE\u05D4 \u05E7\u05D5\u05E8\u05E5 \u05DC\u05D5.)"
        commands: []
    - rid: 6008430306001682793
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05E4\u05D4, \u05D0\u05D9\u05E4\u05D4 \u05DC\u05DE\u05D3\u05EA
          \u05DC\u05D4\u05D1\u05D9\u05DF \u05D0\u05E0\u05E9\u05D9\u05DD \u05DB\u05DB\u05D4?"
        commands: []
    - rid: 6008430306001682794
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DC \u05D4\u05D7\u05D9\u05D9\u05DD \u05E9\u05DC\u05D9 \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05DB\u05DB\u05D4. \u05DB\u05DE\u05D5\u05D1\u05DF \u05E9\u05D4\u05E9\u05EA\u05E4\u05E8\u05EA\u05D9
          \u05DB\u05DB\u05DC \u05E9\u05D2\u05D3\u05DC\u05EA\u05D9\u2026"
        commands: []
    - rid: 6008430306001682795
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05DB\u05D1\u05E8 \u05D1\u05D1\u05D9\u05EA \u05E1\u05E4\u05E8,
          \u05D9\u05DB\u05D5\u05DC\u05EA\u05D9 \u05DC\u05D2\u05E8\u05D5\u05DD \u05DC\u05DB\u05DC
          \u05D0\u05D7\u05D3 \u05D1\u05DB\u05D9\u05EA\u05D4 \u05E9\u05DC\u05D9 \u05DC\u05E2\u05E9\u05D5\u05EA
          \u05DE\u05D4 \u05E9\u05D0\u05E0\u05D9 \u05E8\u05D5\u05E6\u05D4 \u05D1\u05E0\u05E7\u05D9\u05E9\u05EA
          \u05D0\u05E6\u05D1\u05E2!"
        commands: []
    - rid: 6008430306001682796
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D0\u05DE\u05EA? \u05D0\u05EA \u05DC\u05D0 \u05E7\u05E6\u05EA
          \u05DE\u05D2\u05D6\u05D9\u05DE\u05D4?"
        commands: []
    - rid: 6008430306001682797
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05D4 \u05DC\u05D0 \u05DE\u05D0\u05DE\u05D9\u05DF \u05DC\u05D9?
          \u05DB\u05E9\u05D4\u05D9\u05D9\u05EA\u05D9 \u05D1\u05DB\u05D9\u05EA\u05D4
          \u05D5', \u05E4\u05E9\u05D5\u05D8 \u05D4\u05EA\u05D7\u05DC\u05EA\u05D9
          \u05DC\u05D4\u05D7\u05E8\u05D9\u05DD \u05D0\u05D9\u05D6\u05D4 \u05D9\u05DC\u05D3
          \u05E7\u05E7\u05D4, \u05D5\u05DB\u05D5\u05DC\u05DD \u05D4\u05E6\u05D8\u05E8\u05E4\u05D5."
        commands: []
    - rid: 6008430306001682798
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05D1\u05E8 \u05D1\u05D0\u05D5\u05EA\u05D5 \u05D9\u05D5\u05DD,
          \u05D0\u05E3 \u05D0\u05D7\u05D3 \u05DC\u05D0 \u05D3\u05D9\u05D1\u05E8 \u05D0\u05D9\u05EA\u05D5."
        commands: []
    - rid: 6008430306001682799
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D9\u05D0 \u05D0\u05E8\u05D2\u05E0\u05D4 \u05D7\u05E8\u05DD\u2026?)"
        commands: []
    - rid: 6008430306001682800
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC\u2026 \u05D6\u05D4 \u05DC\u05D0 \u05E7\u05E6\u05EA\u2026
          \u05DC\u05D0 \u05DE\u05D5\u05E1\u05E8\u05D9? \u05EA\u05DE\u05D9\u05D3 \u05D4\u05D9\u05D5
          \u05DE\u05DC\u05DE\u05D3\u05D9\u05DD \u05D0\u05D5\u05EA\u05E0\u05D5 \u05DC\u05D0
          \u05DC\u05E2\u05E9\u05D5\u05EA \u05D7\u05E8\u05DE\u05D5\u05EA \u05E2\u05DC
          \u05D0\u05E3 \u05D0\u05D7\u05D3\u2026"
        commands: []
    - rid: 6008430306001682801
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D6\u05D4 \u05D4\u05D2\u05D9\u05E2 \u05DC\u05D5.
          \u05D4\u05D5\u05D0 \u05D4\u05D9\u05D4 \u05D9\u05DC\u05D3 \u05DE\u05DC\u05E9\u05DF,
          \u05D4\u05D5\u05D0 \u05D0\u05DE\u05E8 \u05D0\u05D5\u05EA\u05D9 \u05DC\u05DE\u05D5\u05E8\u05D4
          \u05DB\u05D9 \u05D4\u05D9\u05D9\u05EA\u05D9 \u05D1\u05D8\u05DC\u05E4\u05D5\u05DF,
          \u05DB\u05D0\u05D9\u05DC\u05D5, \u05DE\u05D4 \u05D0\u05DB\u05E4\u05EA \u05DC\u05D5!"
        commands: []
    - rid: 6008430306001682802
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF\u2026 \u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D1\u05D9\u05DF
          \u05E9\u05D6\u05D4 \u05DE\u05E2\u05E6\u05D1\u05DF\u2026 \u05D0\u05D1\u05DC
          \u05D1\u05DB\u05DC \u05D6\u05D0\u05EA, \u05DC\u05E2\u05E9\u05D5\u05EA \u05D7\u05E8\u05DD?
          \u05D6\u05D4 \u05DC\u05D0 \u05E7\u05E6\u05EA \u05DE\u05D5\u05D2\u05D6\u05DD?"
        commands: []
    - rid: 6008430306001682803
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D5 \u05E1\u05EA\u05DD \u05D4\u05EA\u05D9\u05D9\u05E4\u05D9\u05E4\u05D5\u05EA.
          \u05D4\u05D5\u05D0 \u05D4\u05D9\u05D4 \u05D9\u05DC\u05D3 \u05DE\u05E0\u05D9\u05D0\u05E7,
          \u05DB\u05D5\u05DC\u05DD \u05D4\u05E1\u05DB\u05D9\u05DE\u05D5 \u05E2\u05DC
          \u05D6\u05D4. \u05D0\u05DD \u05DB\u05D1\u05E8 \u05DE\u05E9\u05D4\u05D5,
          \u05E2\u05E9\u05D9\u05EA\u05D9 \u05DC\u05D5 \u05D8\u05D5\u05D1\u05D4. \u05DC\u05D9\u05DE\u05D3\u05EA\u05D9
          \u05D0\u05D5\u05EA\u05D5 \u05DC\u05D0 \u05DC\u05D4\u05D9\u05D5\u05EA \u05DE\u05DC\u05E9\u05DF
          \u05DE\u05E0\u05D9\u05D0\u05E7."
        commands: []
    - rid: 6008430306001682804
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: (...)
        commands: []
    - rid: 6008430306001682805
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4, \u05E2\u05DB\u05E9\u05D9\u05D5 \u05D0\u05EA\u05D4 \u05EA\u05E9\u05E4\u05D5\u05D8
          \u05D0\u05D5\u05EA\u05D9? \u05DE\u05D4, \u05EA\u05E2\u05E9\u05D4 \u05E2\u05DC\u05D9\u05D9
          \u05D7\u05E8\u05DD?"
        commands: []
    - rid: 6008430306001682806
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0\u2026"
        commands: []
    - rid: 6008430306001682807
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E9\u05EA\u05D3\u05E2 \u05D0\u05DC\u05D5\u05DF, \u05D0\u05EA\u05D4
          \u05DC\u05D0 \u05EA\u05E9\u05E8\u05D5\u05D3 \u05D1\u05E2\u05D5\u05DC\u05DD
          \u05D4\u05D6\u05D4 \u05D0\u05DD \u05EA\u05E0\u05E1\u05D4 \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05E1\u05EA\u05DD \u05D0\u05D9\u05D6\u05D4 \u05D9\u05E4\u05D4 \u05E0\u05E4\u05E9.
          \u05D0\u05E0\u05D9 \u05DE\u05D0\u05DE\u05D9\u05E0\u05D4 \u05D1\u05DE\u05D8\u05E8\u05D5\u05EA
          \u05E9\u05DC\u05D9, \u05D5\u05D0\u05E0\u05D9 \u05D0\u05E9\u05EA\u05DE\u05E9
          \u05D1\u05D0\u05D9\u05D6\u05D4 \u05D0\u05DE\u05E6\u05E2\u05D9 \u05E9\u05E6\u05E8\u05D9\u05DA
          \u05DB\u05D3\u05D9 \u05DC\u05DE\u05DE\u05E9 \u05D0\u05D5\u05EA\u05DF."
        commands: []
    - rid: 6008430306001682808
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7."
        commands: []
    - rid: 6008430306001682809
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05DB\u05DC \u05DE\u05E7\u05E8\u05D4, \u05D6\u05D5 \u05D1\u05D0\u05DE\u05EA
          \u05D9\u05DB\u05D5\u05DC\u05EA \u05DE\u05E8\u05E9\u05D9\u05DE\u05D4\u2026
          \u05D6\u05D4 \u05DB\u05DE\u05E2\u05D8 \u05DB\u05DE\u05D5 \u05DB\u05D5\u05D7
          \u05E2\u05DC\u2026"
        commands: []
    - rid: 6008430306001682810
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05DA \u05D6\u05D4 \u05D1\u05D8\u05D7 \u05E0\u05E8\u05D0\u05D4
          \u05DB\u05DE\u05D5 \u05DB\u05D5\u05D7 \u05E2\u05DC. \u05E2\u05D1\u05D5\u05E8\u05D9
          \u05D6\u05D4 \u05D0' \u05D1'."
        commands: []
    - rid: 6008430306001682811
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05DE\u05E8\u05D5\u05EA, \u05E9\u05D0\u05E0\u05D9 \u05DC\u05D0
          \u05EA\u05DE\u05D9\u05D3 \u05DE\u05E6\u05DC\u05D9\u05D7\u05D4."
        commands: []
    - rid: 6008430306001682812
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D0\u05DE\u05EA? \u05D0\u05EA \u05D6\u05D5\u05DB\u05E8\u05EA
          \u05E4\u05E2\u05DD \u05E9\u05DC\u05D0 \u05D4\u05E6\u05DC\u05D7\u05EA \u05DC\u05D2\u05E8\u05D5\u05DD
          \u05DC\u05D0\u05E0\u05E9\u05D9\u05DD \u05DC\u05E2\u05E9\u05D5\u05EA \u05DE\u05D4
          \u05E9\u05D0\u05EA \u05E8\u05D5\u05E6\u05D4?"
        commands: []
    - rid: 6008430306001682813
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D4\u05D0\u05DE\u05EA. \u05DE\u05DE\u05E9 \u05E2\u05DB\u05E9\u05D9\u05D5
          \u05DC\u05D3\u05D5\u05D2\u05DE\u05D4, \u05D0\u05E0\u05D9 \u05DE\u05E0\u05E1\u05D4
          \u05DC\u05D2\u05E8\u05D5\u05DD \u05DC\u05DA \u05DC\u05E2\u05D6\u05D5\u05D1
          \u05D0\u05D5\u05EA\u05D9, \u05D5\u05D0\u05EA\u05D4 \u05DC\u05D0 \u05DE\u05D1\u05D9\u05DF
          \u05D0\u05EA \u05D4\u05E8\u05DE\u05D6."
        commands: []
    - rid: 6008430306001682814
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D4\u2026 \u05D0\u05DE\u2026 \u05E1\u05DC\u05D9\u05D7\u05D4\u2026?"
        commands: []
    - rid: 6008430306001682815
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D0\u05EA \u05D4\u05D9\u05D9\u05EA\u05D4 \u05D1\u05D3\u05D9\u05D7\u05D4!
          \u05D0\u05DC \u05EA\u05D9\u05E7\u05D7 \u05D0\u05EA \u05D6\u05D4 \u05DB\u05D6\u05D4
          \u05D1\u05E8\u05E6\u05D9\u05E0\u05D5\u05EA."
        commands: []
    - rid: 6008430306001682816
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D1\u05DB\u05DC \u05DE\u05E7\u05E8\u05D4, \u05D0\u05E0\u05D9
          \u05D1\u05D0\u05DE\u05EA \u05E8\u05D5\u05E6\u05D4 \u05DC\u05DC\u05DB\u05EA
          \u05DC\u05D2\u05DC\u05E2\u05D3 \u05E9\u05DC\u05D9\u2026 \u05E0\u05EA\u05E8\u05D0\u05D4
          \u05D0\u05D7\u05E8 \u05DB\u05DA \u05D0\u05D5\u05DC\u05D9."
        commands:
        - rid: 6008430325051686912
    - rid: 6008430306001682817
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D9\u05D0 \u05D1\u05DF \u05D0\u05D3\u05DD \u05DE\u05E2\u05E0\u05D9\u05D9\u05DF,

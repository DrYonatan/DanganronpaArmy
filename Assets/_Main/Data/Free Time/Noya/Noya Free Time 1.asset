    - rid: 6299374212228579371
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05E0\u05D5\u05D9\u05D4\u2026 \u05D0\u05D9\u05DA \u05D6\u05D4
          \u05DC\u05D4\u05D9\u05D5\u05EA \u05E8\u05E2\"\u05E6\u05D9\u05EA \u05DE\u05D5\u05D3\u05D9\u05E2\u05D9\u05DF?"
        commands: []
    - rid: 6299374212228579372
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05D7\u05DE\u05D3 \u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7\u05D4.
          \u05DC\u05D0 \u05E9\u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05E1\u05E4\u05E8
          \u05DC\u05DA."
        commands: []
    - rid: 6299374212228579373
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF \u05D0\u05D4? \u05D0\u05EA \u05D1\u05D8\u05D7 \u05D9\u05D5\u05D3\u05E2\u05EA
          \u05DE\u05DC\u05D0 \u05D3\u05D1\u05E8\u05D9\u05DD \u05DE\u05E1\u05D5\u05D5\u05D2\u05D9\u05DD,
          \u05D0\u05E0\u05D9 \u05EA\u05D5\u05D4\u05D4, \u05D6\u05D4 \u05DC\u05D0
          \u05E7\u05E9\u05D4 \u05E9\u05D0\u05EA \u05DC\u05D0 \u05D9\u05DB\u05D5\u05DC\u05D4
          \u05DC\u05D4\u05D2\u05D9\u05D3 \u05DC\u05D0\u05E3 \u05D0\u05D7\u05D3?"
        commands: []
    - rid: 6299374212228579374
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D9\u05DC\u05D3\u05D4 \u05E7\u05D8\u05E0\u05D4.
          \u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05E9\u05DC\u05D5\u05D8
          \u05D1\u05E2\u05E6\u05DE\u05D9."
        commands: []
    - rid: 6299374212228579375
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D9\u05D0 \u05E0\u05E8\u05D0\u05EA \u05DB\u05DE\u05E2\u05D8
          \u05DB\u05D0\u05D9\u05DC\u05D5 \u05D4\u05E2\u05DC\u05D1\u05EA\u05D9 \u05D0\u05D5\u05EA\u05D4\u2026)"
        commands: []
    - rid: 6299374212228579376
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D0\u05EA \u05E0\u05D4\u05E0\u05EA \u05DE\u05D4\u05EA\u05E4\u05E7\u05D9\u05D3?"
        commands: []
    - rid: 6299374212228579377
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05D4\u05E0\u05EA \u05D6\u05D5 \u05DC\u05D0 \u05D1\u05D3\u05D9\u05D5\u05E7
          \u05D4\u05D4\u05D2\u05D3\u05E8\u05D4, \u05D6\u05D5 \u05E2\u05D1\u05D5\u05D3\u05D4.
          \u05D0\u05D1\u05DC \u05DB\u05DF, \u05DC\u05D0 \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05E8\u05D5\u05E6\u05D4 \u05DC\u05E2\u05E9\u05D5\u05EA \u05DE\u05E9\u05D4\u05D5
          \u05D0\u05D7\u05E8."
        commands: []
    - rid: 6299374212228579378
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05E2\u05D5\u05E9\u05D4 \u05D1\u05EA\u05E4\u05E7\u05D9\u05D3
          \u05E9\u05DC\u05D9 \u05D3\u05D1\u05E8\u05D9\u05DD \u05E9\u05D0\u05EA\u05D4
          \u05DC\u05D0 \u05D9\u05DB\u05D5\u05DC \u05D0\u05E4\u05D9\u05DC\u05D5 \u05DC\u05D3\u05DE\u05D9\u05D9\u05DF."
        commands:
        - rid: 6299374212228579412
    - rid: 6299374212228579379
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DE\u05E2\u05E0\u05D9\u05D9\u05DF \u05DE\u05D4 \u05D4\u05D9\u05D0
          \u05E2\u05D5\u05E9\u05D4\u2026)"
        commands: []
    - rid: 6299374212228579380
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05DE\u05E2\u05DF \u05D4\u05D0\u05DE\u05EA, \u05D0\u05E0\u05D9
          \u05D3\u05D9 \u05DE\u05D5\u05D3\u05D0\u05D2\u05EA \u05DB\u05E8\u05D2\u05E2
          \u05DC\u05D2\u05D1\u05D9 \u05D4\u05D2\u05D5\u05E8\u05DC \u05E9\u05DC \u05DE\u05D3\u05D9\u05E0\u05EA
          \u05D9\u05E9\u05E8\u05D0\u05DC, \u05D4\u05D9\u05D5\u05EA \u05D5\u05D0\u05E0\u05D9
          \u05E4\u05D4 \u05D5\u05DC\u05D0 \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05E2\u05D6\u05D5\u05E8
          \u05DC\u05E6\u05D5\u05D5\u05EA \u05E9\u05DC\u05D9."
        commands: []
    - rid: 6299374212228579381
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D9\u05D0 \u05DC\u05D0 \u05DE\u05D2\u05D6\u05D9\u05DE\u05D4?)"
        commands: []
    - rid: 6299374212228579382
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E3 \u05E4\u05E2\u05DD \u05DC\u05D0 \u05D7\u05E9\u05D1\u05EA\u05D9
          \u05E9\u05DC\u05DE\u05D9\u05E9\u05D4\u05D5 \u05D1\u05E1\u05D3\u05D9\u05E8
          \u05D9\u05E9 \u05DB\u05DC \u05DB\u05DA \u05D4\u05E8\u05D1\u05D4 \u05D4\u05E9\u05E4\u05E2\u05D4\u2026"
        commands: []
    - rid: 6299374212228579383
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05D0\u05D9\u05DC\u05D5, \u05EA\u05DE\u05D9\u05D3 \u05D7\u05E9\u05D1\u05EA\u05D9
          \u05E9\u05D4\u05D3\u05D1\u05E8\u05D9\u05DD \u05D4\u05D0\u05DC\u05D4 \u05D7\u05E9\u05D5\u05D1\u05D9\u05DD
          \u05D0\u05D1\u05DC \u05D1\u05E8\u05DE\u05D4 \u05D4\u05D6\u05D0\u05EA?"
        commands: []
    - rid: 6299374212228579384
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05EA\u05EA\u05E4\u05DC\u05D0. \u05D0\u05E0\u05E9\u05D9\u05DD \u05DB\u05D9\u05E9\u05E8\u05D5\u05E0\u05D9\u05D9\u05DD
          \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD \u05DC\u05EA\u05E8\u05D5\u05DD \u05D4\u05E8\u05D1\u05D4
          \u05DC\u05E6\u05D4\"\u05DC."
        commands:
        - rid: 6299374234139099136
    - rid: 6299374212228579385
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05DB\u05D5\u05DC\u05DD \u05DE\u05E9\"\u05E7\u05D9 \u05DE\u05DE\u05D8\u05E8\u05D5\u05EA."
        commands: []
    - rid: 6299374212228579386
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D0 \u05D4\u05D0\u2026 \u05DB\u05DF. \u05D4\u05EA\u05E4\u05E7\u05D9\u05D3
          \u05E9\u05DC\u05D9 \u05D4\u05D5\u05D0 \u05D1\u05D0\u05DE\u05EA \u05DC\u05D0
          \u05DE\u05E9\u05D4\u05D5 \u05DE\u05D9\u05D5\u05D7\u05D3\u2026"
        commands: []
    - rid: 6299374212228579387
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DA \u05D1\u05DB\u05DC\u05DC \u05D4\u05D2\u05E2\u05EA
          \u05DC\u05DE\u05E6\u05D1 \u05E9\u05D6\u05D4 \u05D4\u05EA\u05E4\u05E7\u05D9\u05D3
          \u05E9\u05DC\u05DA? \u05D0\u05EA\u05D4 \u05E2\u05D3 \u05DB\u05D3\u05D9
          \u05DB\u05DA \u05D7\u05E1\u05E8 \u05D9\u05DB\u05D5\u05DC\u05EA?"
        commands: []
    - rid: 6299374212228579388
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D7\u05D5\u05E9\u05D1 \u05E9\u05D4\u05D9\u05D9\u05EA\u05D9
          \u05D9\u05DB\u05D5\u05DC \u05DC\u05E2\u05E9\u05D5\u05EA \u05D9\u05D5\u05EA\u05E8\u2026
          \u05D4\u05EA\u05DE\u05D9\u05D9\u05E0\u05EA\u05D9 \u05D2\u05DD \u05DC\u05DB\u05DC\u05DC
          \u05D7\u05DE\"\u05DF, \u05D0\u05D1\u05DC \u05E0\u05E4\u05DC\u05EA\u05D9
          \u05D1\u05D0\u05D7\u05D3 \u05D4\u05E9\u05DC\u05D1\u05D9\u05DD \u05D5\u05D6\u05D4
          \u05D4\u05E9\u05D9\u05D1\u05D5\u05E5 \u05E9\u05E7\u05D9\u05D1\u05DC\u05EA\u05D9\u2026"
        commands: []
    - rid: 6299374212228579389
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026\u05DE\u05D4?"
        commands:
        - rid: 6299374234139099137
    - rid: 6299374212228579390
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D9\u05D0 \u05E0\u05E8\u05D0\u05EA \u05DE\u05DE\u05E9 \u05DE\u05D5\u05E4\u05EA\u05E2\u05EA
          \u05E4\u05EA\u05D0\u05D5\u05DD!)"
        commands: []
    - rid: 6299374212228579391
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026\u05DB\u05DC\u05DC \u05D7\u05DE\"\u05DF? \u05E9\u05DC\u05D0
          \u05EA\u05D1\u05D9\u05DF \u05D0\u05D5\u05EA\u05D9 \u05DC\u05D0 \u05E0\u05DB\u05D5\u05DF,
          \u05DB\u05DC\u05DC \u05D7\u05DE\"\u05DF \u05D6\u05D4 \u05DC\u05D0 \u05E9\u05D5\u05DD
          \u05D3\u05D1\u05E8 \u05DC\u05DB\u05EA\u05D5\u05D1 \u05E2\u05DC\u05D9\u05D5
          \u05D4\u05D1\u05D9\u05EA\u05D4, \u05D0\u05D1\u05DC \u05D0\u05DD \u05D4\u05EA\u05DE\u05D9\u05D9\u05E0\u05EA
          \u05DC\u05E9\u05DD \u05D5\u05D0\u05E4\u05D9\u05DC\u05D5 \u05E2\u05D1\u05E8\u05EA
          \u05E9\u05DC\u05D1\u2026"
        commands: []
    - rid: 6299374212228579392
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D1\u05D0\u05DE\u05EA \u05EA\u05D5\u05D4\u05D4
          \u05DC\u05DE\u05D4 \u05E9\u05DE\u05D5 \u05D0\u05D5\u05EA\u05DA \u05DB\u05DE\u05E9\"\u05E7
          \u05DE\u05DE\u05D8\u05E8\u05D5\u05EA."
        commands: []
    - rid: 6299374212228579393
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E4\u05EA\u05D0\u05D5\u05DD \u05D4\u05D9\u05D0 \u05E0\u05E8\u05D0\u05EA
          \u05E7\u05E6\u05EA \u05E4\u05D7\u05D5\u05EA \u05E7\u05E8\u05D4\u2026 \u05D4\u05D9\u05D0
          \u05D1\u05D0\u05DE\u05EA \u05D7\u05E9\u05D1\u05D4 \u05E2\u05DC\u05D9\u05D9
          \u05DB\u05D9\u05E6\u05D5\u05E8 \u05DB\u05D6\u05D4 \u05E0\u05D7\u05D5\u05EA?)"
        commands: []
    - rid: 6299374212228579394
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D8\u05D5\u05D1, \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D7\u05D5\u05E9\u05D1
          \u05E9\u05D4\u05E1\u05D5\u05D2 \u05D3\u05D1\u05E8 \u05D4\u05D6\u05D4 \u05DB\u05D6\u05D4
          \u05E0\u05D3\u05D9\u05E8, \u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9 \u05D6\u05D4
          \u05D0\u05E4\u05D9\u05DC\u05D5 \u05D3\u05D9 \u05E0\u05E4\u05D5\u05E5, \u05DC\u05D0?"
        commands: []
    - rid: 6299374212228579395
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E6\u05D4\"\u05DC \u05D3\u05D9 \u05D9\u05D3\u05D5\u05E2 \u05D1\u05D1\u05D6\u05D1\u05D5\u05D6
          \u05DB\u05D7 \u05D0\u05D3\u05DD."
        commands: []
    - rid: 6299374212228579396
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D0\u05EA\u05D4 \u05DC\u05D0 \u05DE\u05E0\u05E1\u05D4
          \u05DC\u05E2\u05E8\u05E2\u05E8? \u05DC\u05E2\u05D1\u05D5\u05E8? \u05DC\u05E2\u05E9\u05D5\u05EA
          \u05DE\u05E9\u05D4\u05D5 \u05D0\u05D7\u05E8 \u05D7\u05D5\u05E5 \u05DE\u05DE\u05E9\"\u05E7
          \u05DE\u05DE\u05D8\u05E8\u05D5\u05EA?"
        commands: []
    - rid: 6299374212228579397
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D4\u05D9\u05D4 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05E0\u05D7\u05DE\u05D3 \u05DC\u05D4\u05E8\u05D2\u05D9\u05E9 \u05E7\u05E6\u05EA
          \u05D9\u05D5\u05EA\u05E8 \u05DE\u05E9\u05DE\u05E2\u05D5\u05EA\u05D9\u2026
          \u05D0\u05D1\u05DC \u05DB\u05DE\u05E9\"\u05E7 \u05DE\u05DE\u05D8\u05E8\u05D5\u05EA
          \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05E2\u05D5\u05E9\u05D4 \u05DB\u05DC\u05D5\u05DD
          \u05D5\u05D9\u05D5\u05E6\u05D0 \u05DB\u05DC \u05D9\u05D5\u05DD \u05D1-13:00."
        commands: []
    - rid: 6299374212228579398
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05E4\u05D7\u05D3\u05EA\u05D9 \u05E9\u05D0\u05DD
          \u05D0\u05E0\u05E1\u05D4 \u05DC\u05E2\u05D1\u05D5\u05E8, \u05D1\u05E1\u05D5\u05E3
          \u05D9\u05E9\u05D9\u05DE\u05D5 \u05D0\u05D5\u05EA\u05D9 \u05D1\u05DE\u05D8\u05D1\u05D7
          \u05D0\u05D5 \u05DE\u05E9\u05D4\u05D5 \u05D5\u05D0\u05E0\u05D9 \u05E1\u05EA\u05DD
          \u05D0\u05D3\u05E4\u05E7."
        commands: []
    - rid: 6299374212228579399
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D0\u05DE\u05EA \u05E9\u05D6\u05D4 \u05E9\u05D9\u05E7\u05D5\u05DC
          \u05D3\u05D9 \u05D4\u05D2\u05D9\u05D5\u05E0\u05D9."
        commands: []
    - rid: 6299374212228579400
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D0\u05E0\u05D9 \u05DE\u05EA\u05E4\u05DC\u05D0\u05EA
          \u05E9\u05D0\u05EA\u05D4 \u05DB\u05D6\u05D4\u2026 \u05D1\u05E1\u05D3\u05E8."
        commands:
        - rid: 6299374234139099139
    - rid: 6299374212228579401
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D0\u05DC\u05DA \u05D5\u05D0\u05D2\u05D9\u05D3
          \u05E9\u05D0\u05EA\u05D4 \u05D7\u05D5\u05D3 \u05D4\u05D7\u05E0\u05D9\u05EA
          \u05E9\u05DC \u05D0\u05E8\u05E5 \u05D9\u05E9\u05E8\u05D0\u05DC, \u05D0\u05D1\u05DC
          \u05EA\u05DE\u05D9\u05D3 \u05DB\u05E9\u05E9\u05DE\u05E2\u05EA\u05D9 \u05E2\u05DC
          \u05D0\u05E0\u05E9\u05D9\u05DD \u05D1\u05EA\u05E4\u05E7\u05D9\u05D3\u05D9
          \u05DB\u05DC\u05D5\u05DD \u05DB\u05D0\u05DC\u05D4 \u05E9\u05D9\u05E2\u05E8\u05EA\u05D9
          \u05E9\u05D4\u05DD \u05D3\u05E4\"\u05E8\u05D9\u05DD\u2026"
        commands: []
    - rid: 6299374212228579402
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D5 \u05DC\u05D0 \u05D2\u05D9\u05E9\u05D4 \u05D8\u05D5\u05D1\u05D4
          \u05DB\u05DC \u05DB\u05DA \u05D1\u05E6\u05D4\"\u05DC\u2026)"
        commands: []
    - rid: 6299374212228579403
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D8\u05D5\u05D1, \u05D0\u05E0\u05D9 \u05D9\u05D5\u05D3\u05E2 \u05E2\u05DC
          \u05D3\u05D9 \u05D4\u05E8\u05D1\u05D4 \u05DB\u05D0\u05DC\u05D4. \u05D1\u05E8\u05D5\u05E8
          \u05E9\u05DE\u05D9 \u05E9\u05DB\u05DF \u05DE\u05D2\u05D9\u05E2 \u05DC\u05D3\u05D1\u05E8\u05D9\u05DD
          \u05D4\u05D7\u05E9\u05D5\u05D1\u05D9\u05DD \u05D4\u05D5\u05D0 \u05DC\u05E8\u05D5\u05D1
          \u05E2\u05DD \u05D9\u05DB\u05D5\u05DC\u05D5\u05EA, \u05D0\u05D1\u05DC \u05D6\u05D4
          \u05DC\u05D0 \u05D0\u05D5\u05DE\u05E8 \u05E9\u05DB\u05DC \u05DE\u05D9 \u05E9\u05DC\u05D0
          \u05D7\u05E1\u05E8 \u05D9\u05DB\u05D5\u05DC\u05EA."
        commands: []
    - rid: 6299374212228579404
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6299374212228579405
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D4 \u05E0\u05E8\u05D0\u05D4 \u05DB\u05D0\u05D9\u05DC\u05D5
          \u05DB\u05DC \u05E2\u05D5\u05DC\u05DE\u05D4 \u05D7\u05E8\u05D1 \u05E2\u05DC\u05D9\u05D4\u2026)"
        commands: []
    - rid: 6299374212228579406
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05E2\u05E0\u05D9\u05D9\u05DF. \u05D0\u05E0\u05D9 \u05D0\u05DB\u05DF
          \u05D0\u05D3\u05E2 \u05D0\u05EA \u05D6\u05D4 \u05DE\u05E2\u05DB\u05E9\u05D9\u05D5."
        commands: []
    - rid: 6299374212228579407
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05E9\u05DE\u05D7 \u05E9\u05D9\u05DB\u05D5\u05DC\u05EA\u05D9
          \u05DC\u05D7\u05D3\u05E9 \u05DC\u05DE\u05D9\u05E9\u05D4\u05D9 \u05DB\u05DE\u05D5\u05DA
          \u05D0\u05EA \u05D4\u05D9\u05D3\u05E2\u2026"
        commands: []
    - rid: 6299374212228579408
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05DE. \u05D0\u05DC \u05EA\u05EA\u05DF \u05DC\u05D6\u05D4 \u05DC\u05E2\u05DC\u05D5\u05EA
          \u05DC\u05DA \u05DC\u05E8\u05D0\u05E9. \u05DC\u05D0 \u05D0\u05DE\u05E8\u05EA\u05D9
          \u05E9\u05D0\u05EA\u05D4 \u05D4\u05D9\u05D9\u05EA \u05D9\u05DB\u05D5\u05DC
          \u05DC\u05D4\u05D9\u05D5\u05EA \u05E8\u05E2\"\u05E6 \u05DE\u05D5\u05D3\u05D9\u05E2\u05D9\u05DF."
        commands: []
    - rid: 6299374212228579409
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D2\u05DD \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D0\u05DE\u05E8\u05EA\u05D9
          \u05D0\u05EA \u05D6\u05D4\u2026)"
        commands: []
    - rid: 6299374212228579410
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05E2\u05D3\u05D9\u05D9\u05DF\u2026 \u05D1\u05D0\u05DE\u05EA
          \u05DC\u05D0 \u05D7\u05E9\u05D1\u05EA\u05D9 \u05E9\u05E6\u05D4\"\u05DC
          \u05DE\u05D1\u05D6\u05D1\u05D6 \u05DB\u05DB\u05D4 \u05D0\u05E0\u05E9\u05D9\u05DD\u2026
          \u05E0\u05EA\u05E8\u05D0\u05D4 \u05D0\u05D7\u05E8 \u05DB\u05DA."
        commands:

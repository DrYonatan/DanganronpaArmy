    - rid: 6299374234139099353
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05DE\u05DE\u2026"
        commands: []
    - rid: 6299374234139099354
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D9\u05D0 \u05E0\u05E8\u05D0\u05D9\u05EA \u05E2\u05DE\u05D5\u05E7\u05D4
          \u05D1\u05DE\u05D7\u05E9\u05D1\u05D5\u05EA\u2026)"
        commands: []
    - rid: 6299374234139099355
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05D5\u05D9\u05D4?"
        commands: []
    - rid: 6299374234139099356
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D4? \u05DB\u05DF?"
        commands:
        - rid: 6299374234139099397
    - rid: 6299374234139099357
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D4, \u05D4\u05E4\u05E8\u05E2\u05EA\u05D9 \u05DC\u05DA?"
        commands: []
    - rid: 6299374234139099358
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0, \u05D6\u05D4 \u05D1\u05E1\u05D3\u05E8. \u05E1\u05EA\u05DD
          \u05DE\u05D7\u05E9\u05D1\u05D4 \u05D8\u05D9\u05E4\u05E9\u05D9\u05EA \u05E9\u05DC\u05D0
          \u05EA\u05E7\u05D3\u05DD \u05D0\u05D5\u05EA\u05D9 \u05DC\u05E9\u05D5\u05DD
          \u05DE\u05E7\u05D5\u05DD."
        commands: []
    - rid: 6299374234139099359
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D8\u05D9\u05E4\u05E9\u05D9\u05EA? \u05DE\u05E2\u05E0\u05D9\u05D9\u05DF
          \u05D0\u05D5\u05EA\u05D9 \u05DE\u05D4 \u05D6\u05D4 \u05D8\u05D9\u05E4\u05E9\u05D9\u05EA
          \u05DE\u05D1\u05D7\u05D9\u05E0\u05EA\u05DA\u2026"
        commands: []
    - rid: 6299374234139099360
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05E6\u05D0 \u05DC\u05DA \u05DC\u05E4\u05E2\u05DE\u05D9\u05DD
          \u05DC\u05D4\u05D9\u05D5\u05EA \u05DE\u05D1\u05D5\u05D0\u05E1 \u05DE\u05D6\u05D4
          \u05E9\u05DC\u05D0 \u05E0\u05D5\u05DC\u05D3\u05EA \u05D1\u05DE\u05E7\u05D5\u05DD
          \u05D0\u05D7\u05E8, \u05DC\u05E1\u05D9\u05D8\u05D5\u05D0\u05E6\u05D9\u05D4
          \u05D0\u05D7\u05E8\u05EA?"
        commands: []
    - rid: 6299374234139099361
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D0\u05D9\u05D6\u05D5 \u05D1\u05D7\u05D9\u05E0\u05D4?"
        commands: []
    - rid: 6299374234139099362
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2\u05EA, \u05DC\u05D0 \u05D9\u05E6\u05D0
          \u05DC\u05DA \u05DC\u05E4\u05E2\u05DE\u05D9\u05DD \u05DC\u05E8\u05D0\u05D5\u05EA
          \u05EA\u05DB\u05E0\u05D9\u05D5\u05EA \u05D8\u05DC\u05D5\u05D5\u05D9\u05D6\u05D9\u05D4
          \u05DE\u05D7\u05D5\"\u05DC, \u05D5\u05DC\u05E8\u05E6\u05D5\u05EA \u05E9\u05D2\u05DD
          \u05DC\u05E0\u05D5 \u05D9\u05D4\u05D9\u05D4 \u05D7\u05D2 \u05D4\u05DE\u05D5\u05DC\u05D3,
          \u05D0\u05D5 \u05E9\u05DC\u05D2?"
        commands: []
    - rid: 6299374234139099363
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05E9\u05D4\u05D9\u05D0 \u05D0\u05D5\u05DE\u05E8\u05EA \u05D0\u05EA
          \u05D6\u05D4, \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA \u05E9\u05DB\u05E9\u05D4\u05D9\u05D9\u05EA\u05D9
          \u05E7\u05D8\u05DF \u05D6\u05D4 \u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9 \u05E7\u05E6\u05EA
          \u05DE\u05D2\u05E0\u05D9\u05D1\u2026 \u05D0\u05D1\u05DC \u05D0\u05E3 \u05E4\u05E2\u05DD
          \u05DC\u05D0 \u05D7\u05E9\u05D1\u05EA\u05D9 \u05E2\u05DC \u05D6\u05D4 \u05D9\u05D5\u05EA\u05E8
          \u05DE\u05D3\u05D9.)"
        commands: []
    - rid: 6299374234139099364
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7 \u05E9\u05D7\u05E9\u05D1\u05EA\u05D9
          \u05E9\u05D6\u05D4 \u05D4\u05D9\u05D4 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05E0\u05D7\u05DE\u05D3, \u05D0\u05D1\u05DC \u05DC\u05D0 \u05D1\u05D3\u05D9\u05D5\u05E7
          \u05D7\u05E9\u05D1\u05EA\u05D9 \u05E2\u05DC \u05D6\u05D4 \u05DB\u05DB\u05D4."
        commands: []
    - rid: 6299374234139099365
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05D5\u05EA\u05E8 \u05D7\u05E9\u05D1\u05EA\u05D9 \u05E9\u05D6\u05D4
          \u05D4\u05D9\u05D4 \u05E0\u05D7\u05DE\u05D3 \u05D0\u05DD \u05D4\u05D9\u05D5
          \u05D2\u05DD \u05DC\u05E0\u05D5 \u05D0\u05EA \u05D4\u05D3\u05D1\u05E8\u05D9\u05DD
          \u05D4\u05D0\u05DC\u05D4, \u05DC\u05D0 \u05D7\u05E9\u05D1\u05EA\u05D9 \u05E2\u05DC
          \u05D4\u05D0\u05E4\u05E9\u05E8\u05D5\u05EA \u05E9\u05D4\u05D9\u05D9\u05EA\u05D9
          \u05E0\u05D5\u05DC\u05D3 \u05D1\u05DE\u05E7\u05D5\u05DD \u05E9\u05D1\u05D5
          \u05DB\u05DF \u05D9\u05E9 \u05D0\u05D5\u05EA\u05DD\u2026"
        commands: []
    - rid: 6299374234139099366
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05D1\u05D9\u05E0\u05D4."
        commands: []
    - rid: 6299374234139099367
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05DC\u05D2\u05D1\u05D9\u05DA? \u05D0\u05EA \u05DE\u05DE\u05E9
          \u05D4\u05EA\u05D1\u05D0\u05E1\u05EA \u05E9\u05DC\u05D0 \u05E0\u05D5\u05DC\u05D3\u05EA
          \u05D1\u05DE\u05E7\u05D5\u05DD \u05E9\u05D9\u05E9 \u05D1\u05D5 \u05E9\u05DC\u05D2
          \u05D5\u05DB\u05D0\u05DC\u05D4?"
        commands: []
    - rid: 6299374234139099368
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2\u05EA \u05D0\u05DD \u05E1\u05E4\u05E6\u05D9\u05E4\u05D9\u05EA
          \u05D6\u05D4 \u05D4\u05E2\u05E1\u05D9\u05E7 \u05D0\u05D5\u05EA\u05D9 \u05E2\u05D3
          \u05DB\u05D3\u05D9 \u05DB\u05DA, \u05D0\u05D1\u05DC \u05D1\u05DB\u05DC\u05DC\u05D9
          \u05D4\u05D9\u05D5 \u05DC\u05D9 \u05DC\u05E4\u05E2\u05DE\u05D9\u05DD \u05EA\u05D4\u05D9\u05D5\u05EA
          \u05DB\u05D0\u05DC\u05D4."
        commands: []
    - rid: 6299374234139099369
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05EA\u05DE\u05D9\u05D3 \u05D4\u05E8\u05D2\u05E9\u05EA\u05D9 \u05E7\u05E6\u05EA
          \u05E8\u05E2 \u05E2\u05DD \u05D6\u05D4, \u05DB\u05D9 \u05D4\u05D9\u05D5
          \u05DC\u05D9 \u05D7\u05D9\u05D9\u05DD \u05D8\u05D5\u05D1\u05D9\u05DD, \u05D0\u05D6
          \u05D4\u05E8\u05D2\u05E9\u05EA\u05D9 \u05E9\u05D0\u05D9\u05DF \u05DC\u05D9
          \u05D1\u05D3\u05D9\u05D5\u05E7 \u05D6\u05DB\u05D5\u05EA \u05DC\u05D4\u05EA\u05DC\u05D5\u05E0\u05DF.
          \u05D0\u05D1\u05DC \u05D1\u05DB\u05DC \u05D6\u05D0\u05EA\u2026 \u05EA\u05DE\u05D9\u05D3
          \u05DE\u05E1\u05EA\u05DB\u05DC\u05D9\u05DD \u05E2\u05DC \u05DE\u05D4 \u05E9\u05D0\u05D9\u05DF
          \u05DC\u05DA."
        commands: []
    - rid: 6299374234139099370
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D6\u05D4 \u05E4\u05E9\u05D5\u05D8 \u05EA\u05DE\u05D9\u05D3
          \u05D3\u05D9\u05DB\u05D0 \u05D0\u05D5\u05EA\u05D9 \u05DC\u05D7\u05E9\u05D5\u05D1
          \u05E2\u05DC \u05D4\u05D3\u05D1\u05E8\u05D9\u05DD \u05D4\u05D0\u05DC\u05D4\u2026
          \u05EA\u05DE\u05D9\u05D3 \u05D0\u05D5\u05DE\u05E8\u05D9\u05DD \u05DC\u05E0\u05D5
          \u05E9\u05D0\u05E0\u05D7\u05E0\u05D5 \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD
          \u05DC\u05D4\u05E9\u05D9\u05D2 \u05D4\u05DB\u05DC \u05E2\u05DD \u05DE\u05E1\u05E4\u05D9\u05E7
          \u05DE\u05D0\u05DE\u05E5, \u05D0\u05D1\u05DC \u05D6\u05D4 \u05E4\u05E9\u05D5\u05D8
          \u05DC\u05D0 \u05E0\u05DB\u05D5\u05DF."
        commands: []
    - rid: 6299374234139099371
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D6\u05D0\u05EA \u05D0\u05D5\u05DE\u05E8\u05EA?"
        commands: []
    - rid: 6299374234139099372
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05EA\u05DB\u05D5\u05D5\u05E0\u05EA, \u05D0\u05DD
          \u05D9\u05E9 \u05DC\u05DA \u05D7\u05DC\u05D5\u05DD, \u05D0\u05D5 \u05DB\u05DC
          \u05E8\u05E6\u05D5\u05DF \u05DB\u05DC\u05E9\u05D4\u05D5\u2026 \u05D1\u05D3\u05E8\u05DA
          \u05DB\u05DC\u05DC, \u05D6\u05D4 \u05E0\u05DB\u05D5\u05DF \u05E9\u05D2\u05DD
          \u05D0\u05DD \u05D6\u05D4 \u05E7\u05E9\u05D4, \u05D0\u05D5 \u05E0\u05E8\u05D0\u05D4
          \u05DC\u05D0 \u05D0\u05E4\u05E9\u05E8\u05D9, \u05EA\u05D0\u05D5\u05E8\u05D8\u05D9\u05EA,
          \u05D0\u05EA\u05D4 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05E9\u05D9\u05D2
          \u05D0\u05EA \u05D6\u05D4."
        commands: []
    - rid: 6299374234139099373
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05E2\u05D5\u05DE\u05EA \u05D6\u05D0\u05EA, \u05D3\u05D1\u05E8\u05D9\u05DD
          \u05DB\u05DE\u05D5 \u05DC\u05D4\u05D9\u05D5\u05D5\u05DC\u05D3 \u05DC\u05E1\u05D9\u05D8\u05D5\u05D0\u05E6\u05D9\u05D4
          \u05D0\u05D7\u05E8\u05EA, \u05DC\u05D0 \u05DE\u05E9\u05E0\u05D4 \u05DE\u05D4
          \u05EA\u05E2\u05E9\u05D4, \u05DB\u05D1\u05E8 \u05DE\u05D0\u05D5\u05D7\u05E8
          \u05DE\u05D3\u05D9 \u05DE\u05DB\u05D3\u05D9 \u05DC\u05E7\u05D1\u05DC."
        commands: []
    - rid: 6299374234139099374
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D3\u05D5\u05D2\u05DE\u05D4, \u05D0\u05DD \u05D0\u05EA\u05D4
          \u05DE\u05D0\u05D5\u05D3 \u05E8\u05D5\u05E6\u05D4 \u05DC\u05E2\u05D1\u05D5\u05E8
          *\u05DC\u05D2\u05D5\u05E8 \u05D1\u05E9\u05D5\u05D5\u05D9\u05E5*, \u05D0\u05EA\u05D4
          \u05D9\u05DB\u05D5\u05DC \u05DC\u05D1\u05D3\u05D5\u05E7 \u05D0\u05D9\u05DA
          \u05D0\u05EA\u05D4 \u05DE\u05E9\u05D9\u05D2 \u05D3\u05E8\u05DB\u05D5\u05DF
          \u05E9\u05D5\u05D5\u05D9\u05E6\u05E8\u05D9, \u05DC\u05E2\u05E9\u05D5\u05EA
          \u05D0\u05EA \u05D4\u05E4\u05E2\u05D5\u05DC\u05D5\u05EA \u05D4\u05E0\u05D3\u05E8\u05E9\u05D5\u05EA
          \u05D5\u05DC\u05E2\u05D1\u05D5\u05E8 \u05DC\u05E9\u05DD."
        commands: []
    - rid: 6299374234139099375
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05E2\u05D5\u05DE\u05EA \u05D6\u05D0\u05EA, \u05D0\u05DD \u05D4\u05D7\u05DC\u05D5\u05DD
          \u05E9\u05DC\u05DA \u05D4\u05D5\u05D0 *\u05DC\u05D7\u05D5\u05D5\u05EA \u05D9\u05DC\u05D3\u05D5\u05EA
          \u05D1\u05E9\u05D5\u05D5\u05D9\u05E5*..."
        commands: []
    - rid: 6299374234139099376
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D0\u05E0\u05D9 \u05DE\u05D1\u05D9\u05DF \u05DC\u05D0\u05DF
          \u05D0\u05EA \u05D4\u05D5\u05DC\u05DB\u05EA \u05E2\u05DD \u05D6\u05D4\u2026"
        commands: []
    - rid: 6299374234139099377
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D6\u05D4 \u05DC\u05D0 \u05E8\u05E7 \u05DC\u05D4\u05D9\u05D5\u05D5\u05DC\u05D3
          \u05D1\u05DE\u05E7\u05D5\u05DE\u05D5\u05EA \u05D0\u05D7\u05E8\u05D9\u05DD.
          \u05D6\u05D4 \u05D9\u05DB\u05D5\u05DC \u05DC\u05E4\u05D2\u05D5\u05E9 \u05D0\u05D5\u05EA\u05DA
          \u05D1\u05DB\u05DC \u05DE\u05E7\u05D5\u05DD. \u05D0\u05DD \u05D0\u05EA\u05D4
          \u05E8\u05D5\u05E6\u05D4 *\u05D7\u05D1\u05E8\u05D9\u05DD*, \u05EA\u05DE\u05D9\u05D3
          \u05D9\u05D4\u05D9\u05D4 \u05D0\u05E4\u05E9\u05E8\u05D9 \u05DC\u05D4\u05DB\u05D9\u05E8
          \u05D0\u05E0\u05E9\u05D9\u05DD \u05D5\u05DC\u05D4\u05EA\u05D7\u05D1\u05E8."
        commands: []
    - rid: 6299374234139099378
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D0\u05DD \u05D0\u05EA\u05D4 \u05E8\u05D5\u05E6\u05D4
          *\u05D7\u05D1\u05E8\u05D9 \u05D9\u05DC\u05D3\u05D5\u05EA* \u05E9\u05D2\u05D3\u05DC\u05D5
          \u05D0\u05D9\u05EA\u05DA \u05DB\u05DC \u05D4\u05D7\u05D9\u05D9\u05DD, \u05DB\u05D1\u05E8
          \u05DE\u05D0\u05D5\u05D7\u05E8 \u05DE\u05D3\u05D9 \u05D0\u05DD \u05D0\u05D9\u05DF
          \u05DC\u05DA \u05DB\u05D0\u05DC\u05D4. \u05D0\u05EA\u05D4 \u05DC\u05E2\u05D5\u05DC\u05DD
          \u05DC\u05D0 \u05EA\u05D5\u05DB\u05DC \u05DC\u05D4\u05E9\u05D9\u05D2 \u05D0\u05EA
          \u05D6\u05D4."
        commands: []
    - rid: 6299374234139099379
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05E9\u05D4\u05D9\u05D0 \u05D0\u05D5\u05DE\u05E8\u05EA \u05D0\u05EA
          \u05D6\u05D4 \u05DB\u05DB\u05D4, \u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA
          \u05E7\u05E6\u05EA \u05DE\u05D3\u05DB\u05D0\u2026)"
        commands: []
    - rid: 6299374234139099380
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D0\u05E0\u05D9 \u05DE\u05D1\u05D9\u05DF \u05DE\u05D4
          \u05D0\u05EA \u05D0\u05D5\u05DE\u05E8\u05EA. \u05DC\u05D0 \u05D9\u05E6\u05D0
          \u05DC\u05D9 \u05DC\u05D7\u05E9\u05D5\u05D1 \u05E2\u05DC \u05D6\u05D4 \u05DC\u05E2\u05D5\u05DE\u05E7
          \u05E2\u05D3 \u05E2\u05DB\u05E9\u05D9\u05D5, \u05D0\u05D1\u05DC \u05D0\u05E0\u05D9
          \u05D7\u05D5\u05E9\u05D1 \u05E9\u05D4\u05E8\u05D2\u05E9\u05EA\u05D9 \u05D4\u05E8\u05D2\u05E9\u05D4
          \u05D3\u05D5\u05DE\u05D4 \u05DC\u05E4\u05E2\u05DE\u05D9\u05DD."
        commands: []
    - rid: 6299374234139099381
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D2\u05DD \u05E2\u05DB\u05E9\u05D9\u05D5 \u05D7\u05E9\u05D1\u05EA
          \u05E2\u05DC \u05DE\u05E9\u05D4\u05D5 \u05DB\u05D6\u05D4? \u05DE\u05E9\u05D4\u05D5
          \u05E9\u05D4\u05D9\u05D9\u05EA \u05E8\u05D5\u05E6\u05D4 \u05D0\u05D1\u05DC
          \u05DB\u05D1\u05E8 \u05DE\u05D0\u05D5\u05D7\u05E8 \u05DE\u05D3\u05D9 \u05DE\u05DB\u05D3\u05D9
          \u05DC\u05D7\u05D5\u05D5\u05EA?"
        commands: []
    - rid: 6299374234139099382
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05D0\u05EA\u05D4 \u05D7\u05D9\u05D9\u05D1 \u05DC\u05D3\u05E2\u05EA,
          \u05D7\u05E9\u05D1\u05EA\u05D9 \u05E2\u05DB\u05E9\u05D9\u05D5 \u05E2\u05DC
          *\u05E7\u05D5\u05DC\u05D2'*."
        commands:
        - rid: 6299374234139099398
    - rid: 6299374234139099383
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E7\u05D5\u05DC\u05D2'?)"
        commands: []
    - rid: 6299374234139099384
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05E2\u05E8\u05D9\u05DB\u05D4 \u05D0\u05EA
          \u05D4\u05EA\u05E4\u05E7\u05D9\u05D3 \u05E9\u05DC\u05D9 \u05D1\u05E6\u05D1\u05D0,
          \u05D0\u05D1\u05DC \u05DC\u05E4\u05E2\u05DE\u05D9\u05DD \u05D0\u05E0\u05D9
          \u05E8\u05D5\u05D0\u05D4 \u05D0\u05D9\u05DA \u05D1\u05D0\u05E8\u05E6\u05D5\u05EA
          \u05D0\u05D7\u05E8\u05D5\u05EA \u05D4\u05DD \u05D4\u05D5\u05DC\u05DB\u05D9\u05DD
          \u05DC\u05D0\u05D5\u05E0\u05D9\u05D1\u05E8\u05E1\u05D9\u05D8\u05D4 \u05D0\u05D5
          \u05DC\u05E7\u05D5\u05DC\u05D2' \u05D9\u05E9\u05E8 \u05D0\u05D7\u05E8\u05D9
          \u05D4\u05EA\u05D9\u05DB\u05D5\u05DF, \u05D5\u05D4\u05D9\u05D9\u05EA\u05D9
          \u05E8\u05D5\u05E6\u05D4 \u05DC\u05D7\u05D5\u05D5\u05EA \u05D0\u05EA \u05D6\u05D4
          \u05D2\u05DD."
        commands: []
    - rid: 6299374234139099385
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05E1\u05D5\u05E3 \u05D2\u05DD \u05D0\u05DD \u05D0\u05E0\u05D9
          \u05D0\u05DC\u05DA \u05DC\u05D0\u05D5\u05E0\u05D9\u05D1\u05E8\u05E1\u05D9\u05D8\u05D4
          \u05D0\u05D7\u05E8\u05D9 \u05D4\u05E6\u05D1\u05D0, \u05D6\u05D4 \u05DC\u05D0
          \u05D1\u05D0\u05DE\u05EA \u05D0\u05D5\u05EA\u05D4 \u05D7\u05D5\u05D5\u05D9\u05D4
          \u05DB\u05DE\u05D5 \u05DC\u05DC\u05DB\u05EA \u05DC\u05D0\u05D5\u05E7\u05E1\u05E4\u05D5\u05E8\u05D3
          \u05D0\u05D5 TIM \u05D1\u05D2\u05D9\u05DC 81."
        commands: []
    - rid: 6299374234139099386
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05DB\u05DE\u05D5 \u05E9\u05D0\u05DE\u05E8\u05EA\u05D9
          \u05E7\u05D5\u05D3\u05DD, \u05D4\u05D7\u05DC\u05D5\u05DD \u05D4\u05D6\u05D4
          \u05E4\u05E9\u05D5\u05D8 \u05DC\u05D0 \u05D0\u05E4\u05E9\u05E8\u05D9 \u05D9\u05D5\u05EA\u05E8.
          \u05D0\u05E0\u05D9 \u05DB\u05D1\u05E8 \u05E2\u05D1\u05E8\u05EA\u05D9 \u05D0\u05EA
          \u05D2\u05D9\u05DC 81, \u05D5\u05D2\u05D3\u05DC\u05EA\u05D9 \u05D1\u05D0\u05E8\u05E5."
        commands: []
    - rid: 6299374234139099387
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF\u2026 \u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA \u05DE\u05D1\u05D0\u05E1."
        commands: []
    - rid: 6299374234139099388
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7 \u05E9\u05D4\u05D3\u05D1\u05E8
          \u05E9\u05D9\u05DB\u05D5\u05DC \u05DC\u05E2\u05D6\u05D5\u05E8 \u05E2\u05DD
          \u05DE\u05D7\u05E9\u05D1\u05D5\u05EA \u05DB\u05D0\u05DC\u05D4 \u05D6\u05D4
          \u05DC\u05D4\u05D9\u05D6\u05DB\u05E8 \u05D1\u05DE\u05D4 \u05E9\u05DB\u05DF
          \u05D7\u05D5\u05D5\u05D9\u05E0\u05D5\u2026"
        commands: []
    - rid: 6299374234139099389
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05D1\u05E7\u05D8\u05E2 \u05DB\u05D6\u05D4 \u05E9\u05DC
          \"\u05DC\u05D4\u05E2\u05E8\u05D9\u05DA \u05D0\u05EA \u05DE\u05D4 \u05E9\u05D9\u05E9
          \u05DC\u05E0\u05D5\", \u05D0\u05DC\u05D0 \u05DC\u05D4\u05D9\u05D6\u05DB\u05E8
          \u05D1\u05D7\u05D5\u05D5\u05D9\u05D5\u05EA \u05E9\u05D0\u05D4\u05D1\u05E0\u05D5,
          \u05D5\u05DC\u05D7\u05E9\u05D5\u05D1 \u05E2\u05DC\u05D9\u05D4\u05D9\u05DF
          \u05D1\u05EA\u05D5\u05E8 \u05DE\u05E9\u05D4\u05D5 \u05E9\u05D4\u05D9\u05D9\u05E0\u05D5
          \u05E8\u05D5\u05E6\u05D9\u05DD \u05DC\u05D7\u05D5\u05D5\u05EA, \u05D0\u05DD
          \u05D6\u05D4 \u05D4\u05D2\u05D9\u05D5\u05E0\u05D9."
        commands: []
    - rid: 6299374234139099390
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D0\u05D6 \u05D1\u05DE\u05E7\u05D5\u05DD \u05DC\u05D4\u05E8\u05D2\u05D9\u05E9
          \u05D9\u05D0\u05D5\u05E9 \u05DE\u05D6\u05D4 \u05E9\u05DC\u05E2\u05D5\u05DC\u05DD
          \u05DC\u05D0 \u05E0\u05E7\u05D1\u05DC \u05D4\u05D6\u05D3\u05DE\u05E0\u05D5\u05EA
          \u05DC\u05D7\u05D5\u05D5\u05EA \u05D0\u05EA \u05D6\u05D4\u2026 \u05D0\u05E4\u05E9\u05E8
          \u05DC\u05D4\u05E8\u05D2\u05D9\u05E9 \u05E9\u05DE\u05D7\u05D4 \u05D5\u05E9\u05DC\u05D5\u05D5\u05D4
          \u05DE\u05D6\u05D4 \u05E9\u05D0\u05EA \u05D4\u05D7\u05D5\u05D5\u05D9\u05D4
          \u05D4\u05D6\u05D0\u05EA *\u05D4\u05E1\u05E4\u05E7\u05E0\u05D5 \u05DC\u05D7\u05D5\u05D5\u05EA*."
        commands: []
    - rid: 6299374234139099391
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"

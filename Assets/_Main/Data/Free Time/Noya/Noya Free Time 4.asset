    - rid: 6299374234139099392
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D5\u05DC\u05D9 \u05D6\u05D4 \u05E0\u05E9\u05DE\u05E2 \u05DC\u05D4

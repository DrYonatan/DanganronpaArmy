    - rid: 6299374234139099393
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D0\u05DE\u05EA \u05E9\u05D6\u05D5 \u05D2\u05D9\u05E9\u05D4
          \u05D3\u05D9 \u05D8\u05D5\u05D1\u05D4\u2026 \u05D0\u05E0\u05D9 \u05D0\u05D6\u05DB\u05D5\u05E8
          \u05D0\u05EA \u05D4\u05D8\u05D9\u05E4 \u05D4\u05D6\u05D4. \u05D0\u05D5\u05DC\u05D9

    - rid: 6299374234139099265
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DC\u05D5\u05DF, \u05D9\u05E9 \u05DC\u05D9 \u05E9\u05D0\u05DC\u05D4
          \u05D1\u05E9\u05D1\u05D9\u05DC\u05DA."
        commands:
        - rid: 6008430325051686946
    - rid: 6299374234139099266
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF?"
        commands: []
    - rid: 6299374234139099267
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D0\u05EA\u05D4 \u05E2\u05D5\u05E9\u05D4 \u05D1\u05D9\u05D5\u05DD
          \u05D9\u05D5\u05DD \u05E9\u05DC\u05DA? \u05D0\u05DE\u05E8\u05EA \u05E9\u05D0\u05EA\u05D4
          \u05D9\u05D5\u05E6\u05D0 \u05DE\u05D4\u05D1\u05E1\u05D9\u05E1 \u05DE\u05D5\u05E7\u05D3\u05DD.
          \u05D0\u05EA\u05D4 \u05D1\u05D8\u05D7 \u05E2\u05D5\u05E9\u05D4 \u05DE\u05E9\u05D4\u05D5
          \u05E9\u05D0\u05EA\u05D4 \u05D7\u05D5\u05D6\u05E8 \u05D4\u05D1\u05D9\u05EA\u05D4,
          \u05D7\u05D5\u05E5 \u05DE\u05E1\u05D3\u05E8\u05D5\u05EA, \u05DC\u05D0?"
        commands: []
    - rid: 6299374234139099268
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D8\u05D5\u05D1, \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05E2\u05D5\u05E9\u05D4
          \u05DB\u05D6\u05D4 \u05D4\u05E8\u05D1\u05D4\u2026 \u05D0\u05E0\u05D9 \u05E2\u05D5\u05E9\u05D4
          \u05D0\u05EA \u05D4\u05EA\u05D7\u05D1\u05D9\u05D1\u05D9\u05DD \u05E9\u05DC\u05D9,
          \u05DE\u05E9\u05D7\u05E7 \u05D1\u05DE\u05D7\u05E9\u05D1 \u05D5\u05DB\u05D0\u05DC\u05D4\u2026
          \u05DC\u05E4\u05E2\u05DE\u05D9\u05DD \u05E0\u05E4\u05D2\u05E9 \u05E2\u05DD
          \u05DB\u05DE\u05D4 \u05D7\u05D1\u05E8\u05D9\u05DD \u05E9\u05D2\u05DD \u05D6\u05DE\u05D9\u05E0\u05D9\u05DD\u2026"
        commands: []
    - rid: 6299374234139099269
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05D4\u05E8\u05D1\u05D4 \u05D9\u05D5\u05EA\u05E8 \u05DE\u05D6\u05D4."
        commands: []
    - rid: 6299374234139099270
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D0\u05DE\u05EA? \u05D0\u05EA\u05D4 \u05DC\u05D0 \u05DE\u05E8\u05D2\u05D9\u05E9
          \u05E7\u05E6\u05EA\u2026 \u05DC\u05D0 \u05DE\u05E0\u05D5\u05E6\u05DC?"
        commands: []
    - rid: 6299374234139099271
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D4 \u05D3\u05D9 \u05DE\u05D7\u05DE\u05D9\u05D0 \u05E9\u05D6\u05D4
          \u05D1\u05D0 \u05DE\u05E0\u05D5\u05D9\u05D4\u2026)"
        commands: []
    - rid: 6299374234139099272
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05D4 \u05DC\u05D0 \u05D7\u05D5\u05E9\u05D1 \u05E9\u05D9\u05DB\u05D5\u05DC\u05EA
          \u05DC\u05E2\u05E9\u05D5\u05EA \u05DE\u05E9\u05D4\u05D5 \u05D9\u05D5\u05EA\u05E8
          \u05D2\u05D3\u05D5\u05DC \u05D1\u05E2\u05D5\u05DC\u05DD \u05D4\u05D6\u05D4?"
        commands: []
    - rid: 6299374234139099273
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E0\u05E8\u05D0\u05D4 \u05E9\u05D4\u05D9\u05D9\u05EA\u05D9
          \u05D9\u05DB\u05D5\u05DC\u2026 \u05D0\u05D1\u05DC \u05D9\u05D4\u05D9\u05D5
          \u05DC\u05D9 \u05D0\u05EA \u05DB\u05DC \u05D4\u05D7\u05D9\u05D9\u05DD \u05DC\u05E2\u05E9\u05D5\u05EA
          \u05DE\u05E9\u05D4\u05D5 \u05D2\u05D3\u05D5\u05DC \u05D9\u05D5\u05EA\u05E8,
          \u05DC\u05D0?"
        commands: []
    - rid: 6299374234139099274
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05EA\u05DB\u05DC\u05E1 \u05D6\u05D4 \u05E8\u05E7 \u05D0\u05E6\u05DC\u05E0\u05D5
          \u05D1\u05D2\u05DC\u05DC \u05D4\u05E6\u05D1\u05D0 \u05E9\u05DE\u05E6\u05E4\u05D9\u05DD
          \u05DE\u05D0\u05E0\u05E9\u05D9\u05DD \u05D1\u05E0\u05D9 02 \u05DC\u05E2\u05E9\u05D5\u05EA
          \u05D3\u05D1\u05E8\u05D9\u05DD \u05D2\u05D3\u05D5\u05DC\u05D9\u05DD."
        commands: []
    - rid: 6299374234139099275
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05E9\u05D0\u05E8 \u05D4\u05E2\u05D5\u05DC\u05DD \u05D9\u05DC\u05D3\u05D9\u05DD
          \u05D1\u05D2\u05D9\u05DC\u05E0\u05D5 \u05E2\u05D3\u05D9\u05D9\u05DF \u05E8\u05E7
          \u05DC\u05D5\u05DE\u05D3\u05D9\u05DD."
        commands: []
    - rid: 6299374234139099276
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D5 \u05D2\u05D9\u05E9\u05D4 \u05DE\u05E2\u05E0\u05D9\u05D9\u05E0\u05EA.
          \u05D0\u05D6 \u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7\u05D4 \u05E9\u05D9\u05E9
          \u05DC\u05DA \u05EA\u05D5\u05DB\u05E0\u05D9\u05D5\u05EA \u05DC\u05E2\u05EA\u05D9\u05D3?
          \u05DE\u05D4 \u05E9\u05EA\u05E2\u05E9\u05D4 \u05D0\u05D7\u05E8\u05D9 \u05D4\u05E9\u05D7\u05E8\u05D5\u05E8?"
        commands: []
    - rid: 6299374234139099277
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: (...)
        commands: []
    - rid: 6299374234139099278
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E2\u05D5\u05D3 \u05DC\u05D0 \u05DE\u05DE\u05E9\u2026 \u05D0\u05D1\u05DC
          \u05E2\u05D5\u05D1\u05D3\u05D9\u05DD \u05E2\u05DC \u05D6\u05D4\u2026 \u05D0\u05E0\u05D9
          \u05DE\u05E0\u05E1\u05D4 \u05DC\u05D7\u05E9\u05D5\u05D1 \u05DC\u05E4\u05E2\u05DE\u05D9\u05DD
          \u05DE\u05D4 \u05D4\u05D9\u05D9\u05EA\u05D9 \u05E8\u05D5\u05E6\u05D4 \u05DC\u05E2\u05E9\u05D5\u05EA
          \u05D1\u05D7\u05D9\u05D9\u05DD, \u05D0\u05D1\u05DC \u05DC\u05D0 \u05E0\u05E8\u05D0\u05D4
          \u05DC\u05D9 \u05E9\u05D0\u05E0\u05D9 \u05E2\u05D5\u05D3 \u05D9\u05D5\u05D3\u05E2."
        commands: []
    - rid: 6299374234139099279
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026\u05D0\u05EA\u05D4 \u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2?"
        commands:
        - rid: 6299374234139099302
    - rid: 6299374234139099280
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D4 \u05DB\u05D6\u05D4 \u05DE\u05D5\u05D6\u05E8\u2026?)"
        commands: []
    - rid: 6299374234139099281
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05DE\u05DE\u05E9\u2026 \u05DE\u05D4 \u05DC\u05D2\u05D1\u05D9\u05DA,
          \u05D0\u05EA \u05D9\u05D5\u05D3\u05E2\u05EA \u05DE\u05D4 \u05EA\u05E8\u05E6\u05D9
          \u05DC\u05E2\u05E9\u05D5\u05EA \u05D0\u05D7\u05E8\u05D9 \u05D6\u05D4?"
        commands: []
    - rid: 6299374234139099282
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6299374234139099283
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D0\u05DE\u05EA \u05E9\u05DC\u05D0."
        commands: []
    - rid: 6299374234139099284
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D2\u05DD \u05D4\u05D9\u05D0?)"
        commands: []
    - rid: 6299374234139099285
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D7\u05E9\u05D1\u05EA\u05D9 \u05D0\u05D5\u05DC\u05D9 \u05E4\u05E9\u05D5\u05D8
          \u05DC\u05D4\u05D9\u05E9\u05D0\u05E8 \u05D1\u05E7\u05D1\u05E2 \u05D5\u05DB\u05D1\u05E8
          \u05DC\u05E2\u05E9\u05D5\u05EA \u05E7\u05E8\u05D9\u05D9\u05E8\u05D4 \u05E6\u05D1\u05D0\u05D9\u05EA\u2026
          \u05D0\u05D1\u05DC \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D1\u05D8\u05D5\u05D7\u05D4
          \u05E9\u05D0\u05E0\u05D9 \u05E8\u05D5\u05E6\u05D4 \u05DC\u05D4\u05D9\u05E9\u05D0\u05E8
          \u05D1\u05E6\u05D1\u05D0 \u05DB\u05DC \u05D4\u05D7\u05D9\u05D9\u05DD \u05E9\u05DC\u05D9."
        commands:
        - rid: 6299374234139099303
    - rid: 6299374234139099286
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05E6\u05D3 \u05E9\u05E0\u05D9\u2026 \u05E2\u05DD \u05DB\u05DC
          \u05D4\u05E9\u05D9\u05E8\u05D5\u05EA \u05E9\u05DC\u05D9 \u05D0\u05D9\u05DF
          \u05DC\u05D9 \u05D4\u05E8\u05D1\u05D4 \u05D6\u05DE\u05DF \u05DC\u05D7\u05E9\u05D5\u05D1
          \u05DE\u05D4 \u05D1\u05D0\u05DE\u05EA \u05D4\u05D9\u05D9\u05EA\u05D9 \u05E8\u05D5\u05E6\u05D4
          \u05DC\u05E2\u05E9\u05D5\u05EA\u2026"
        commands: []
    - rid: 6299374234139099287
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05E9\u05D4\u05D9\u05D0 \u05D0\u05D5\u05DE\u05E8\u05EA \u05D0\u05EA
          \u05D6\u05D4 \u05DB\u05DB\u05D4 \u05D6\u05D4 \u05D2\u05D5\u05E8\u05DD \u05DC\u05D9
          \u05DC\u05D4\u05D9\u05E9\u05DE\u05E2 \u05DC\u05D5\u05D6\u05E8 \u05E9\u05D0\u05E0\u05D9
          \u05E2\u05D5\u05D3 \u05DC\u05D0 \u05D7\u05E9\u05D1\u05EA\u05D9\u2026)"
        commands: []
    - rid: 6299374234139099288
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D1\u05DC \u05D0\u05E0\u05D9 \u05DE\u05D5\u05E4\u05EA\u05E2,
          \u05D4\u05D9\u05D0 \u05E0\u05E8\u05D0\u05EA\u05D4 \u05DC\u05D9 \u05DE\u05D4\u05E1\u05D5\u05D2
          \u05E9\u05D9\u05D5\u05D3\u05E2 \u05DE\u05D4 \u05D4\u05D5\u05D0 \u05E8\u05D5\u05E6\u05D4
          \u05DC\u05E2\u05E9\u05D5\u05EA \u05DE\u05D2\u05D9\u05DC \u05D0\u05E4\u05E1\u2026)"
        commands: []
    - rid: 6299374234139099289
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D1\u05EA\u05D5\u05E8 \u05E8\u05E2\"\u05E6\u05D9\u05EA
          \u05DE\u05D5\u05D3\u05D9\u05E2\u05D9\u05DF, \u05D1\u05D8\u05D7 \u05D9\u05E9
          \u05DE\u05DC\u05D0 \u05D3\u05D1\u05E8\u05D9\u05DD \u05E9\u05EA\u05D5\u05DB\u05DC\u05D9
          \u05DC\u05E2\u05D1\u05D5\u05D3 \u05D1\u05D4\u05DD! \u05D2\u05DD \u05D8\u05DB\u05E0\u05D5\u05DC\u05D5\u05D2\u05D9\u05D4,
          \u05D2\u05DD \u05D3\u05D1\u05E8\u05D9\u05DD \u05DE\u05DE\u05E9\u05DC\u05EA\u05D9\u05D9\u05DD,
          \u05D0\u05D5 \u05D1\u05DE\u05D5\u05E1\u05D3 \u05D0\u05D5 \u05DE\u05E9\u05D4\u05D5\u2026"
        commands: []
    - rid: 6299374234139099290
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D6\u05D4 \u05E4\u05D5\u05EA\u05D7 \u05D0\u05E4\u05E9\u05E8\u05D5\u05D9\u05D5\u05EA...
          \u05D0\u05D1\u05DC \u05D1\u05E1\u05D5\u05E3 \u05E2\u05D3\u05D9\u05D9\u05DF
          \u05E6\u05E8\u05D9\u05DA \u05DC\u05DE\u05E6\u05D5\u05D0 \u05D1\u05E2\u05E6\u05DE\u05DA
          \u05D1\u05DE\u05D4 \u05DC\u05E2\u05E1\u05D5\u05E7."
        commands: []
    - rid: 6299374234139099291
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D0\u05D6 \u05D4\u05EA\u05D9\u05DB\u05D5\u05DF, \u05EA\u05DE\u05D9\u05D3
          \u05D4\u05D9\u05D4 \u05D4\u05DE\u05D5\u05DF \u05E4\u05D9\u05E7\u05D5\u05E1
          \u05E2\u05DC \u05DC\u05D4\u05EA\u05E7\u05D1\u05DC \u05DC\u05D9\u05D7\u05D9\u05D3\u05D5\u05EA
          \u05D9\u05D5\u05E7\u05E8\u05EA\u05D9\u05D5\u05EA, \u05D5\u05E9\u05DB\u05E0\u05E2\u05D5
          \u05D0\u05D5\u05EA\u05E0\u05D5 \u05E9\u05D6\u05D4 \u05DE\u05D4 \u05E9\u05D0\u05E0\u05D7\u05E0\u05D5
          \u05D0\u05DE\u05D5\u05E8\u05D9\u05DD \u05DC\u05E8\u05E6\u05D5\u05EA."
        commands: []
    - rid: 6299374234139099292
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05DE\u05DE\u05E9 \u05E2\u05D5\u05D3\u05D3\u05D5 \u05D0\u05D5\u05EA\u05E0\u05D5
          \u05DC\u05D7\u05E9\u05D5\u05D1 \u05E2\u05DC \u05DE\u05D4 \u05D1\u05D0\u05DE\u05EA
          \u05E0\u05E8\u05E6\u05D4 \u05DC\u05E2\u05E9\u05D5\u05EA \u05D1\u05E9\u05D0\u05E8\u05D9\u05EA
          \u05D4\u05D7\u05D9\u05D9\u05DD\u2026"
        commands: []
    - rid: 6299374234139099293
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC\u2026 \u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7\u05D4
          \u05E9\u05D0\u05DD \u05DE\u05D9\u05E9\u05D4\u05D5 \u05DB\u05DE\u05D5\u05DA,
          \u05E9\u05E2\u05D5\u05D3 \u05DC\u05D0 \u05D4\u05E9\u05D9\u05D2 \u05DB\u05DC\u05D5\u05DD
          \u05D1\u05D7\u05D9\u05D9\u05DD, \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05DB\u05D6\u05D4 \u05E8\u05D2\u05D5\u05E2 \u05DC\u05D2\u05D1\u05D9 \u05DC\u05D4\u05D1\u05D9\u05DF
          \u05DE\u05D4 \u05D4\u05D5\u05D0 \u05E8\u05D5\u05E6\u05D4 \u05DC\u05E2\u05E9\u05D5\u05EA,
          \u05D2\u05DD \u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05D4\u05D9\u05E8\u05D2\u05E2
          \u05E7\u05E6\u05EA\u2026"
        commands: []
    - rid: 6299374234139099294
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: (...)
        commands: []
    - rid: 6299374234139099295
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E9\u05DE\u05D7\u05EA\u05D9 \u05DC\u05E2\u05D6\u05D5\u05E8\u2026)"
        commands: []
    - rid: 6299374234139099296
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D7\u05D5\u05E9\u05D1
          \u05E9\u05D0\u05EA \u05E6\u05E8\u05D9\u05DB\u05D4 \u05DC\u05DE\u05D4\u05E8
          \u05DC\u05E9\u05D5\u05DD \u05DE\u05E7\u05D5\u05DD\u2026 \u05DB\u05E0\u05E8\u05D0\u05D4
          \u05E9\u05DB\u05D1\u05E8 \u05E2\u05E9\u05D9\u05EA \u05D9\u05D5\u05EA\u05E8
          \u05DE99 \u05D0\u05D7\u05D5\u05D6 \u05DE\u05D4\u05D0\u05E0\u05E9\u05D9\u05DD
          \u05D1\u05D2\u05D9\u05DC\u05E0\u05D5."
        commands: []
    - rid: 6299374234139099297
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05DE. \u05EA\u05D5\u05D3\u05D4."
        commands: []
    - rid: 6299374234139099298
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D2\u05DD \u05D0\u05EA\u05D4 \u05D0\u05DC\u05D5\u05DF\u2026 \u05D0\u05E0\u05D9
          \u05D7\u05D9\u05D9\u05D1\u05EA \u05DC\u05D4\u05D5\u05D3\u05D5\u05EA, \u05E9\u05D0\u05EA\u05D4
          \u05DC\u05D0 \u05DE\u05D8\u05D5\u05DE\u05D8\u05DD. \u05D0\u05EA\u05D4 \u05E2\u05D5\u05D3
          \u05EA\u05E2\u05E9\u05D4 \u05D3\u05D1\u05E8\u05D9\u05DD \u05D9\u05E4\u05D9\u05DD
          \u05D1\u05D7\u05D9\u05D9\u05DD \u05E9\u05DC\u05DA."
        commands: []
    - rid: 6299374234139099299
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DC\u05D0 \u05DE\u05D8\u05D5\u05DE\u05D8\u05DD \u05D4\u05D0\u2026
          \u05D9\u05E4\u05D4 \u05E9\u05D4\u05D9\u05D0 \u05DB\u05DC \u05DB\u05DA \u05EA\u05D5\u05E4\u05E1\u05EA
          \u05DE\u05DE\u05E0\u05D9\u2026)"
        commands: []
    - rid: 6299374234139099300
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D5\u05DC\u05D9 \u05DB\u05D0\u05DF, \u05E9\u05D0\u05E0\u05D7\u05E0\u05D5
          \u05DC\u05D0 \u05DE\u05DE\u05E9 \u05E2\u05D5\u05E9\u05D9\u05DD \u05DB\u05DC\u05D5\u05DD,
          \u05D0\u05E0\u05D9 \u05D0\u05D7\u05E9\u05D5\u05D1 \u05E2\u05DC \u05D6\u05D4
          \u05E7\u05E6\u05EA. \u05E0\u05EA\u05E8\u05D0\u05D4."
        commands:
        - rid: 6299374234139099306
    - rid: 6299374234139099301
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E0\u05D9 \u05DE\u05E8\u05D2\u05D9\u05E9 \u05E7\u05E6\u05EA
          \u05D9\u05D5\u05EA\u05E8 \u05E7\u05E8\u05D5\u05D1 \u05DC\u05E0\u05D5\u05D9\u05D4.)"

      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D1\u05DB\u05DC \u05D6\u05D0\u05EA, \u05D1\u05D6\u05DE\u05DF
          \u05E9\u05DB\u05DF \u05D9\u05E9 \u05DC\u05DA\u2026 \u05D9\u05E9 \u05DE\u05E9\u05D4\u05D5
          \u05E9\u05D0\u05EA \u05D0\u05D5\u05D4\u05D1\u05EA \u05DC\u05E2\u05E9\u05D5\u05EA?
          \u05D0\u05D9\u05D6\u05D5 \u05E1\u05D3\u05E8\u05D4 \u05E9\u05D0\u05D4\u05D1\u05EA
          \u05D0\u05D5\u05DC\u05D9?"
        commands: []
    - rid: 6299374234139099181
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05E9 \u05E1\u05D3\u05E8\u05D4 \u05E9\u05D0\u05EA\u05D4 \u05D0\u05D5\u05D4\u05D1?"
        commands: []
    - rid: 6299374234139099182
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF \u05D9\u05E9 \u05DB\u05DE\u05D4\u2026 \u05D0\u05D1\u05DC
          \u05D6\u05D4 \u05DC\u05D0 \u05DB\u05D6\u05D4 \u05DE\u05E2\u05E0\u05D9\u05D9\u05DF,
          \u05E1\u05EA\u05DD \u05DB\u05DC \u05DE\u05E0\u05D9 \u05E1\u05D3\u05E8\u05D5\u05EA
          \u05E9\u05E9\u05DE\u05E2\u05EA\u05D9 \u05E2\u05DC\u05D9\u05D4\u05DF \u05DB\u05D9
          \u05D4\u05DF \u05D4\u05D9\u05D5 \u05E4\u05D5\u05E4\u05D5\u05DC\u05E8\u05D9\u05D5\u05EA
          \u05DE\u05EA\u05D9\u05E9\u05D4\u05D5."
        commands: []
    - rid: 6299374234139099183
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E2\u05D7. \u05D0\u05D6 \u05D1\u05D8\u05D7 \u05E9\u05D0\u05E0\u05D9
          \u05DC\u05D0 \u05D0\u05D1\u05D6\u05D1\u05D6 \u05D0\u05EA \u05D4\u05D6\u05DE\u05DF
          \u05E9\u05DC\u05D9 \u05E2\u05DC \u05D0\u05DC\u05D4."
        commands: []
    - rid: 6299374234139099184
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D9\u05D0 \u05E9\u05E4\u05D8\u05D4 \u05D0\u05EA \u05D6\u05D4
          \u05E2\u05D5\u05D3 \u05DC\u05E4\u05E0\u05D9 \u05E9\u05D4\u05D9\u05D0 \u05E9\u05DE\u05E2\u05D4
          \u05DE\u05D4 \u05D1\u05DB\u05DC\u05DC?)"
        commands: []
    - rid: 6299374234139099185
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05DE\u05D4\u2026?"
        commands: []
    - rid: 6299374234139099186
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05DE\u05E9\u05D4\u05D5 *\u05E4\u05D5\u05E4\u05D5\u05DC\u05E8\u05D9*,
          \u05D0\u05EA\u05D4 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D3\u05E2\u05EA \u05D1\u05D5\u05D5\u05D3\u05D0\u05D5\u05EA
          \u05E9\u05D4\u05D5\u05D0 \u05D9\u05D4\u05D9\u05D4 \u05D1\u05E8\u05DE\u05D4
          \u05E0\u05DE\u05D5\u05DB\u05D4."
        commands: []
    - rid: 6299374234139099187
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05E1\u05D5\u05E3, \u05D4\u05D0\u05D3\u05DD \u05D4\u05DE\u05DE\u05D5\u05E6\u05E2
          \u05DE\u05D8\u05D5\u05DE\u05D8\u05DD. \u05D0\u05D9\u05DF \u05D3\u05E8\u05DA
          \u05D0\u05D7\u05E8\u05EA \u05DC\u05D4\u05E1\u05EA\u05DB\u05DC \u05E2\u05DC
          \u05D6\u05D4."
        commands: []
    - rid: 6299374234139099188
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D4 \u05E7\u05E6\u05EA \u05E0\u05D5\u05E7\u05E9\u05D4\u2026)"
        commands: []
    - rid: 6299374234139099189
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D0\u05DD \u05D6\u05D4 \u05EA\u05E4\u05E1 \u05D0\u05E6\u05DC
          \u05DB\u05DC \u05DB\u05DA \u05D4\u05E8\u05D1\u05D4 \u05D0\u05E0\u05E9\u05D9\u05DD,
          \u05D6\u05D4 \u05DC\u05D0 \u05D0\u05D5\u05DE\u05E8 \u05E9\u05D9\u05E9 \u05D1\u05D6\u05D4
          \u05DE\u05E9\u05D4\u05D5\u2026?"
        commands: []
    - rid: 6299374234139099190
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D4\u05E4\u05D9\u05DA, \u05D0\u05DD \u05DE\u05E9\u05D4\u05D5
          \u05EA\u05E4\u05E1 \u05DB\u05DC \u05DB\u05DA \u05D4\u05E8\u05D1\u05D4 \u05D0\u05E0\u05E9\u05D9\u05DD
          \u05DE\u05D8\u05D5\u05DE\u05D8\u05DE\u05D9\u05DD, \u05DB\u05E0\u05E8\u05D0\u05D4
          \u05E9\u05D4\u05D5\u05D0 \u05E0\u05D5\u05E6\u05E8 \u05E2\u05D1\u05D5\u05E8
          \u05D0\u05E0\u05E9\u05D9\u05DD \u05DE\u05D8\u05D5\u05DE\u05D8\u05DE\u05D9\u05DD."
        commands: []
    - rid: 6299374234139099191
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05DE\u05E9\u05D4\u05D5 \u05D1\u05D0\u05DE\u05EA \u05D8\u05D5\u05D1,
          \u05D4\u05D5\u05D0 \u05DC\u05D0 \u05D9\u05EA\u05E4\u05D5\u05E1. \u05DB\u05DB\u05D4
          \u05D6\u05D4."
        commands: []
    - rid: 6299374234139099192
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D2\u05DD \u05D0\u05DD \u05D1\u05D0\u05DE\u05EA
          \u05DB\u05D5\u05DC\u05DD \u05DB\u05D0\u05DC\u05D4 \u05DE\u05D8\u05D5\u05DE\u05D8\u05DE\u05D9\u05DD,
          \u05D0\u05D9\u05DA \u05D0\u05EA \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05D3\u05E2\u05EA
          \u05D1\u05D5\u05D5\u05D3\u05D0\u05D5\u05EA \u05E9\u05DE\u05D4 \u05E9\u05D4\u05DD
          \u05D0\u05D5\u05D4\u05D1\u05D9\u05DD \u05D1\u05D4\u05DB\u05E8\u05D7 \u05D2\u05E8\u05D5\u05E2?"
        commands: []
    - rid: 6299374234139099193
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA \u05E9\u05D9\u05E9
          \u05D3\u05D1\u05E8\u05D9\u05DD \u05E9\u05DE\u05D3\u05D1\u05E8\u05D9\u05DD
          \u05D0\u05DC \u05D4\u05D4\u05DE\u05D5\u05E0\u05D9\u05DD, \u05D0\u05D1\u05DC
          \u05D9\u05E9 \u05DC\u05D4\u05DD \u05D2\u05DD \u05E9\u05DB\u05D1\u05D4 \u05DE\u05E2\u05D1\u05E8,
          \u05E9\u05DB\u05DC \u05D4\"\u05DE\u05D8\u05D5\u05DE\u05D8\u05DE\u05D9\u05DD\"
          \u05D4\u05D0\u05DC\u05D4 \u05DC\u05D0 \u05DE\u05D1\u05D9\u05E0\u05D9\u05DD."
        commands: []
    - rid: 6299374234139099194
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DA \u05D1\u05D3\u05D9\u05D5\u05E7 \u05D0\u05E4\u05E9\u05E8
          \u05DC\u05E2\u05E9\u05D5\u05EA \u05DE\u05E9\u05D4\u05D5 \u05DB\u05D6\u05D4?"
        commands: []
    - rid: 6299374234139099198
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D0\u05EA \u05D9\u05D5\u05D3\u05E2\u05EA, \u05D9\u05E9
          \u05D4\u05E8\u05D1\u05D4 \u05E1\u05D3\u05E8\u05D5\u05EA \u05E9\u05DB\u05D5\u05DC\u05E0\u05D5
          \u05E8\u05D0\u05D9\u05E0\u05D5 \u05DB\u05D9\u05DC\u05D3\u05D9\u05DD, \u05D5\u05D4\u05DF
          \u05E2\u05D3\u05D9\u05D9\u05DF \u05E0\u05D7\u05E9\u05D1\u05D5\u05EA \u05E7\u05DC\u05E1\u05D9\u05E7\u05D5\u05EA
          \u05D2\u05DD \u05D1\u05E7\u05E8\u05D1 \u05DE\u05D1\u05D5\u05D2\u05E8\u05D9\u05DD."
        commands: []
    - rid: 6299374234139099199
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05D9 \u05D6\u05D4 \u05E9\u05D4\u05DF \u05DE\u05E6\u05D5\u05D9\u05E8\u05D5\u05EA
          \u05D5\u05DB\u05D9\u05E4\u05D9\u05D5\u05EA \u05D6\u05D4 \u05DE\u05D4 \u05E9\u05D4\u05D5\u05E4\u05DA
          \u05D0\u05D5\u05EA\u05DF \u05DC\u05E4\u05D5\u05E4\u05D5\u05DC\u05E8\u05D9\u05D5\u05EA
          \u05E2\u05DD \u05D4\u05D9\u05DC\u05D3\u05D9\u05DD, \u05D5\u05D1\u05DB\u05DC
          \u05D6\u05D0\u05EA, \u05D9\u05E9 \u05D1\u05D4\u05DF \u05D3\u05D1\u05E8\u05D9\u05DD
          \u05DE\u05EA\u05D5\u05D7\u05DB\u05DE\u05D9\u05DD \u05E9\u05D4\u05D9\u05DC\u05D3\u05D9\u05DD
          \u05D1\u05DB\u05DC\u05DC \u05DC\u05D0 \u05DE\u05D1\u05D9\u05E0\u05D9\u05DD."
        commands: []
    - rid: 6299374234139099200
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DE\u05D5 \u05DB\u05DC \u05DE\u05D9\u05E0\u05D9 \u05D1\u05D3\u05D9\u05D7\u05D5\u05EA
          \u05D0\u05D5 \u05DE\u05D8\u05D0\u05E4\u05D5\u05E8\u05D5\u05EA \u05D1\u05D5\u05D2\u05E8\u05D5\u05EA\u2026"
        commands: []
    - rid: 6299374234139099201
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7\u05D4\u2026"
        commands:
        - rid: 6299374234139099224
    - rid: 6299374234139099202
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D1\u05D3\u05D9\u05D5\u05E7 \u05DB\u05DB\u05D4, \u05D2\u05DD
          \u05D3\u05D1\u05E8\u05D9\u05DD \u05E9\u05DE\u05D3\u05D1\u05E8\u05D9\u05DD
          \u05D0\u05DC \u05D4\u05D4\u05DE\u05D5\u05E0\u05D9\u05DD \u05D4\"\u05DE\u05D8\u05D5\u05DE\u05D8\u05DE\u05D9\u05DD\",
          \u05DC\u05D0 \u05D1\u05D4\u05DB\u05E8\u05D7 \u05D2\u05E8\u05D5\u05E2\u05D9\u05DD,
          \u05DC\u05D0?"
        commands: []
    - rid: 6299374234139099203
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA \u05E9\u05D9\u05E9
          \u05D1\u05D4\u05DD \u05DE\u05E9\u05D4\u05D5 \u05E9\u05D2\u05D5\u05E8\u05DD
          \u05DC\u05D4\u05DD \u05DC\u05EA\u05E4\u05D5\u05E1 \u05E4\u05D5\u05E4\u05D5\u05DC\u05E8\u05D9\u05D5\u05EA,
          \u05D0\u05D1\u05DC \u05D2\u05DD \u05E0\u05D9\u05E9\u05D5\u05EA \u05E9\u05D2\u05DD
          \u05D0\u05E0\u05E9\u05D9\u05DD \u05DB\u05DE\u05D5\u05DA \u05D9\u05D5\u05DB\u05DC\u05D5
          \u05DC\u05D0\u05D4\u05D5\u05D1."
        commands: []
    - rid: 6299374234139099204
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6299374234139099205
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2\u05EA\u2026 \u05D0\u05E3 \u05E4\u05E2\u05DD
          \u05DC\u05D0 \u05E8\u05D0\u05D9\u05EA\u05D9 \u05E1\u05D3\u05E8\u05D4, \u05E1\u05E8\u05D8,
          \u05E9\u05D9\u05E8 \u05D0\u05D5 \u05DE\u05E9\u05D7\u05E7 \u05E9\u05D4\u05D9\u05D5
          \u05E4\u05D5\u05E4\u05D5\u05DC\u05E8\u05D9\u05D9\u05DD \u05D5\u05D2\u05DD
          \u05D8\u05D5\u05D1\u05D9\u05DD."
        commands: []
    - rid: 6299374234139099206
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DE\u05D4 \u05E4\u05E2\u05DE\u05D9\u05DD \u05E0\u05EA\u05EA
          \u05DC\u05DE\u05E9\u05D4\u05D5 \u05DB\u05D6\u05D4 \u05E6'\u05D0\u05E0\u05E1\u2026?"
        commands: []
    - rid: 6299374234139099207
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6299374234139099208
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DC\u05E4\u05D9 \u05D4\u05DE\u05D1\u05D8 \u05E9\u05DC\u05D4, \u05DC\u05D0
          \u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9 \u05E9\u05D1\u05E2\u05D1\u05E8 \u05D4\u05E0\u05E8\u05D0\u05D4
          \u05DC\u05E2\u05D9\u05DF\u2026)"
        commands: []
    - rid: 6299374234139099209
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2\u05EA. \u05D0\u05D5\u05DC\u05D9
          \u05D9\u05E9 \u05DB\u05DE\u05D4 \u05D9\u05D4\u05DC\u05D5\u05DE\u05D9\u05DD
          \u05E9\u05DE\u05EA\u05D7\u05D1\u05D0\u05D9\u05DD \u05E9\u05DD, \u05D0\u05D1\u05DC
          \u05E8\u05D5\u05D1 \u05D4\u05D6\u05DE\u05DF\u2026 \u05E8\u05D5\u05D1 \u05D4\u05D6\u05DE\u05DF
          \u05D6\u05D4 \u05D6\u05D1\u05DC."
        commands: []
    - rid: 6299374234139099210
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D5\u05DC\u05D9\u2026 \u05D0\u05D1\u05DC \u05D0\u05E0\u05D9
          \u05D7\u05D5\u05E9\u05D1 \u05E9\u05DB\u05D3\u05D0\u05D9 \u05DC\u05DA \u05DC\u05EA\u05EA
          \u05DC\u05D3\u05D1\u05E8\u05D9\u05DD \u05D4\u05D0\u05DC\u05D4 \u05D4\u05D6\u05D3\u05DE\u05E0\u05D5\u05EA!
          \u05D0\u05EA \u05EA\u05E9\u05E4\u05D8\u05D9 \u05D0\u05D5\u05EA\u05DD \u05E8\u05E7
          \u05D1\u05D2\u05DC\u05DC \u05E9\u05D4\u05DD \u05E4\u05D5\u05E4\u05D5\u05DC\u05E8\u05D9\u05D9\u05DD\u2026"
        commands: []
    - rid: 6299374234139099211
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05E1\u05D3\u05E8. \u05D4\u05E0\u05D4, \u05D0\u05E0\u05D9 \u05D0\u05DC\u05DA
          \u05DC\u05D2\u05DC\u05E2\u05D3 \u05DC\u05E9\u05DE\u05D5\u05E2 \u05E7\u05E6\u05EA
          \u05E2\u05D5\u05DE\u05E8 \u05D0\u05D3\u05DD."
        commands:
        - rid: 6299374234139099225
    - rid: 6299374234139099212
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E0\u05D9 \u05D9\u05D5\u05D3\u05E2 \u05E9\u05D4\u05D9\u05D0

    - rid: 6299374324604207304
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DF \u05E4\u05D4 \u05D4\u05E8\u05D1\u05D4 \u05DE\u05D4
          \u05DC\u05E2\u05E9\u05D5\u05EA\u2026 \u05D7\u05D1\u05DC \u05E9\u05D0\u05D9\u05DF
          \u05D0\u05D9\u05D6\u05D5 \u05E1\u05E4\u05E8\u05D9\u05D9\u05D4 \u05E4\u05D4
          \u05D0\u05D5 \u05DE\u05E9\u05D4\u05D5."
        commands: []
    - rid: 6299374324604207305
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05DE\u05E8\u05D5\u05EA \u05E9\u05D1\u05DE\u05D7\u05E9\u05D1\u05D4
          \u05E9\u05E0\u05D9\u05D9\u05D4, \u05D2\u05DD \u05D0\u05DD \u05D4\u05D9\u05D9\u05EA\u05D4,
          \u05DB\u05E0\u05E8\u05D0\u05D4 \u05D4\u05D9\u05D5 \u05E8\u05E7 \u05E1\u05E4\u05E8\u05D9\u05DD
          *\u05D1\u05E2\u05D1\u05E8\u05D9\u05EA*\u2026"
        commands: []
    - rid: 6299374324604207306
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA \u05DC\u05D0 \u05E8\u05D5\u05E6\u05D4 \u05E1\u05E4\u05E8\u05D9\u05DD
          \u05D1\u05E2\u05D1\u05E8\u05D9\u05EA?"
        commands: []
    - rid: 6299374324604207307
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05DD \u05D1\u05E1\u05D3\u05E8\u2026 \u05D0\u05D1\u05DC \u05D0\u05E0\u05D9
          \u05DE\u05E2\u05D3\u05D9\u05E4\u05D4 \u05E1\u05E4\u05E8\u05D9\u05DD \u05D1\u05DB\u05DC
          \u05DE\u05E0\u05D9 \u05E9\u05E4\u05D5\u05EA."
        commands: []
    - rid: 6299374324604207308
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D4, \u05D1\u05D0\u05DE\u05EA \u05D0\u05DE\u05E8\u05EA \u05E9\u05D0\u05EA
          \u05D0\u05D5\u05D4\u05D1\u05EA \u05E9\u05E4\u05D5\u05EA."
        commands: []
    - rid: 6299374324604207309
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DE\u05D4 \u05E9\u05E4\u05D5\u05EA \u05D0\u05EA \u05D9\u05D5\u05D3\u05E2\u05EA?"
        commands: []
    - rid: 6299374324604207310
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05D5\u05DC\u05DC \u05E2\u05D1\u05E8\u05D9\u05EA\u2026 \u05DE\u05E9\u05D4\u05D5
          \u05DB\u05DE\u05D5 \u05E9\u05D1\u05E2."
        commands: []
    - rid: 6299374324604207311
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E9\u05D1\u05E2?!)"
        commands: []
    - rid: 6299374324604207312
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D4\u05DE\u05D5\u05DF \u05E9\u05E4\u05D5\u05EA!"
        commands: []
    - rid: 6299374324604207313
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05E2\u05D3 \u05DB\u05D3\u05D9 \u05DB\u05DA \u05D4\u05E8\u05D1\u05D4\u2026
          \u05D0\u05E0\u05D9 \u05D2\u05DD \u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2\u05EA
          \u05D0\u05EA \u05DB\u05D5\u05DC\u05DF \u05DC\u05D2\u05DE\u05E8\u05D9 \u05E9\u05D5\u05D8\u05E3."
        commands: []
    - rid: 6299374324604207314
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D9\u05D5\u05D3\u05E2\u05EA \u05E2\u05D1\u05E8\u05D9\u05EA,
          \u05D0\u05E0\u05D2\u05DC\u05D9\u05EA, \u05D2\u05E8\u05DE\u05E0\u05D9\u05EA,
          \u05E6\u05E8\u05E4\u05EA\u05D9\u05EA, \u05D9\u05E4\u05E0\u05D9\u05EA, \u05E2\u05E8\u05D1\u05D9\u05EA
          \u05D5\u05D0\u05D9\u05D8\u05DC\u05E7\u05D9\u05EA."
        commands: []
    - rid: 6299374324604207315
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D4 \u05E0\u05E9\u05DE\u05E2 \u05DB\u05DE\u05D5 \u05D0\u05E4\u05D9\u05DC\u05D5
          \u05D9\u05D5\u05EA\u05E8 \u05DB\u05E9\u05D4\u05D9\u05D0 \u05E1\u05D5\u05E4\u05E8\u05EA
          \u05D0\u05D5\u05EA\u05DF \u05D0\u05D7\u05EA \u05D0\u05D7\u05EA\u2026)"
        commands: []
    - rid: 6299374324604207316
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05D5\u2026 \u05D0\u05EA \u05D1\u05D0\u05DE\u05EA
          \u05D9\u05D5\u05D3\u05E2\u05EA \u05D4\u05DE\u05D5\u05DF. \u05DC\u05D0 \u05D4\u05D1\u05E0\u05EA\u05D9
          \u05E2\u05D3 \u05DB\u05DE\u05D4 \u05D0\u05EA \u05D0\u05D5\u05D4\u05D1\u05EA
          \u05E9\u05E4\u05D5\u05EA."
        commands: []
    - rid: 6299374324604207317
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA \u05E4\u05E9\u05D5\u05D8 \u05DE\u05DE\u05E9
          \u05DE\u05E2\u05E0\u05D9\u05D9\u05DF \u05D0\u05D5\u05EA\u05D9, \u05DC\u05E8\u05D0\u05D5\u05EA
          \u05D0\u05EA \u05D4\u05D4\u05D1\u05D3\u05DC\u05D9\u05DD \u05D1\u05D9\u05DF
          \u05D4\u05E9\u05E4\u05D5\u05EA, \u05D0\u05D9\u05DC\u05D5 \u05D9\u05D5\u05EA\u05E8
          \u05D3\u05D5\u05DE\u05D5\u05EA \u05D0\u05D7\u05EA \u05DC\u05E9\u05E0\u05D9\u05D9\u05D4,
          \u05D5\u05DB\u05DE\u05D4 \u05E9\u05E4\u05D5\u05EA \u05E9\u05D4\u05EA\u05E4\u05EA\u05D7\u05D5
          \u05D1\u05DE\u05E7\u05D5\u05DE\u05D5\u05EA \u05E8\u05D7\u05D5\u05E7\u05D9\u05DD
          \u05E4\u05D9\u05D6\u05D9\u05EA \u05D9\u05D4\u05D9\u05D5 \u05E9\u05D5\u05E0\u05D5\u05EA."
        commands: []
    - rid: 6299374324604207318
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05E9\u05E4\u05D5\u05EA \u05DB\u05DE\u05D5 \u05D9\u05E4\u05E0\u05D9\u05EA,
          \u05D4\u05E1\u05D3\u05E8 \u05E9\u05D1\u05D5 \u05D1\u05D5\u05E0\u05D9\u05DD
          \u05D0\u05EA \u05D4\u05DE\u05E9\u05E4\u05D8 \u05D1\u05DB\u05DC\u05DC \u05E9\u05D5\u05E0\u05D4."
        commands: []
    - rid: 6299374324604207319
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D2\u05DD \u05D7\u05D5\u05E9\u05D1\u05EA \u05E9\u05EA\u05E8\u05D2\u05D5\u05DE\u05D9\u05DD
          \u05D6\u05D4 \u05DE\u05E2\u05E0\u05D9\u05D9\u05DF."
        commands: []
    - rid: 6299374324604207320
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E1\u05E4\u05E8\u05D9\u05DD, \u05E1\u05D3\u05E8\u05D5\u05EA, \u05D0\u05D5
          \u05DB\u05DC \u05E6\u05D5\u05E8\u05EA \u05DE\u05D3\u05D9\u05D4\u2026 \u05D0\u05E0\u05D9
          \u05E0\u05D4\u05E0\u05EA \u05DC\u05E8\u05D0\u05D5\u05EA \u05E1\u05E8\u05D8\u05D5\u05E0\u05D9\u05DD
          \u05E9\u05DE\u05E9\u05D5\u05D5\u05D9\u05DD \u05D1\u05D9\u05DF \u05D4\u05DE\u05E7\u05D5\u05E8\u05D9
          \u05DC\u05D2\u05E8\u05E1\u05D4 \u05DE\u05EA\u05D5\u05E8\u05D2\u05DE\u05EA."
        commands: []
    - rid: 6299374324604207321
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05DE\u05E8\u05EA\u05E7 \u05D1\u05E2\u05D9\u05E0\u05D9\u05D9,
          \u05D4\u05D4\u05D1\u05D3\u05DC\u05D9\u05DD \u05D1\u05D9\u05DF \u05D4\u05D2\u05E8\u05E1\u05D0\u05D5\u05EA,
          \u05DB\u05DE\u05D4 \u05D4\u05D2\u05E8\u05E1\u05D4 \u05D4\u05DE\u05EA\u05D5\u05E8\u05D2\u05DE\u05EA
          \u05DE\u05D3\u05D5\u05D9\u05E7\u05EA, \u05DE\u05D4 \u05D4\u05D9\u05D5 \u05D4\u05E1\u05D9\u05D1\u05D5\u05EA
          \u05DC\u05E9\u05D9\u05E0\u05D5\u05D9\u05D9\u05DD \u05E9\u05D4\u05D9\u05D5\u2026"
        commands: []
    - rid: 6299374324604207322
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05EA\u05D9 \u05DC\u05E9\u05E0\u05D5\u05EA \u05E7\u05E6\u05EA
          \u05D0\u05EA \u05DE\u05E9\u05DE\u05E2\u05D5\u05EA \u05D4\u05DE\u05E9\u05E4\u05D8
          \u05DE\u05E2\u05D1\u05D9\u05E8 \u05D9\u05D5\u05EA\u05E8 \u05D8\u05D5\u05D1
          \u05D0\u05EA \u05D4\u05E4\u05D5\u05D0\u05E0\u05D8\u05D4 \u05D4\u05DE\u05E7\u05D5\u05E8\u05D9\u05EA
          \u05DE\u05D0\u05E9\u05E8 \u05EA\u05E8\u05D2\u05D5\u05DD \u05D9\u05E9\u05D9\u05E8\u2026"
        commands: []
    - rid: 6299374324604207323
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF \u05D4\u05D0\u05DE\u05EA, \u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA
          \u05D3\u05D9 \u05DE\u05E2\u05E0\u05D9\u05D9\u05DF. \u05D6\u05D5 \u05DE\u05DE\u05E9
          \u05EA\u05D5\u05E8\u05D4 \u05E9\u05DC\u05DE\u05D4."
        commands: []
    - rid: 6299374324604207324
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D0\u05E0\u05D9 \u05D0\u05D5\u05D4\u05D1\u05EA \u05DC\u05D1\u05D7\u05D5\u05DF
          \u05D0\u05EA \u05D4\u05D3\u05DE\u05D9\u05D5\u05DF \u05D5\u05D4\u05E9\u05D5\u05E0\u05D9
          \u05D1\u05D9\u05DF \u05D4\u05E9\u05E4\u05D5\u05EA."
        commands: []
    - rid: 6299374324604207325
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05DE\u05D3\u05D4\u05D9\u05DD, \u05D0\u05D9\u05DA \u05E9\u05D4\u05E9\u05E4\u05D5\u05EA
          \u05D4\u05D0\u05DC\u05D4 \u05DB\u05DC \u05DB\u05DA \u05D4\u05EA\u05E4\u05EA\u05D7\u05D5
          \u05D1\u05E6\u05D3\u05D3\u05D9\u05DD \u05D0\u05D7\u05E8\u05D9\u05DD \u05E9\u05DC
          \u05D4\u05E2\u05D5\u05DC\u05DD, \u05D5\u05D4\u05DF \u05DB\u05DC \u05DB\u05DA
          \u05E9\u05D5\u05E0\u05D5\u05EA, \u05D5\u05DC\u05DE\u05E8\u05D5\u05EA \u05D6\u05D0\u05EA,
          \u05E0\u05D3\u05D9\u05E8 \u05DB\u05E9\u05D0\u05D9 \u05D0\u05E4\u05E9\u05E8
          \u05DC\u05EA\u05E8\u05D2\u05DD \u05DE\u05D9\u05DC\u05D4 \u05D0\u05D5 \u05DE\u05E9\u05E4\u05D8
          \u05D9\u05E9\u05D9\u05E8\u05D5\u05EA \u05D1\u05D9\u05E0\u05D9\u05D4\u05DF."
        commands: []
    - rid: 6299374324604207326
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05EA\u05E8\u05D2\u05DD \u05D9\u05E9\u05D9\u05E8\u05D5\u05EA?"
        commands: []
    - rid: 6299374324604207327
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05EA\u05D9\u05E7\u05D7 \u05DC\u05D3\u05D5\u05D2\u05DE\u05D4
          \u05DE\u05D9\u05DC\u05D4 \u05DB\u05DE\u05D5 *\u05D0\u05D1\u05D3\u05D5\u05DF*.
          \u05D6\u05D5 \u05DE\u05D9\u05DC\u05D4 \u05D3\u05D9 \u05E1\u05E4\u05E6\u05D9\u05E4\u05D9\u05EA,
          \u05E9\u05DE\u05EA\u05D0\u05E8\u05EA \u05DE\u05E9\u05D4\u05D5 \u05DE\u05D0\u05D5\u05D3
          \u05DE\u05E1\u05D5\u05D9\u05DD, \u05D5\u05E2\u05D5\u05D3 \u05D9\u05D7\u05E1\u05D9\u05EA
          \u05DE\u05D5\u05E4\u05E9\u05D8\u2026"
        commands: []
    - rid: 6299374324604207328
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D1\u05D3\u05D5\u05DF?! \u05D6\u05D5 \u05DE\u05D9\u05DC\u05D4
          \u05D3\u05D9 \u05DE\u05E4\u05D7\u05D9\u05D3\u05D4 \u05DC\u05D4\u05D1\u05D9\u05D0
          \u05DB\u05D3\u05D5\u05D2\u05DE\u05D4\u2026)"
        commands: []
    - rid: 6299374324604207329
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D5 \u05DE\u05D9\u05DC\u05D4 \u05D3\u05D9 \u05E1\u05E4\u05E6\u05D9\u05E4\u05D9\u05EA,
          \u05E9\u05DE\u05EA\u05D0\u05E8\u05EA \u05DE\u05E9\u05D4\u05D5 \u05DE\u05D0\u05D5\u05D3
          \u05DE\u05E1\u05D5\u05D9\u05DD, \u05D5\u05E2\u05D5\u05D3 \u05D9\u05D7\u05E1\u05D9\u05EA
          \u05DE\u05D5\u05E4\u05E9\u05D8\u2026 \u05D6\u05D4 \u05DC\u05D0 \u05D3\u05D1\u05E8
          \u05E4\u05D9\u05D6\u05D9 \u05E9\u05E0\u05D9\u05EA\u05DF \u05DC\u05D4\u05D2\u05D3\u05D9\u05E8
          \u05D1\u05E6\u05D5\u05E8\u05D4 \u05D7\u05D3 \u05DE\u05E9\u05DE\u05E2\u05D9\u05EA."
        commands: []
    - rid: 6299374324604207330
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05DC\u05DE\u05E8\u05D5\u05EA \u05D6\u05D0\u05EA, \u05D1\u05E8\u05D5\u05D1
          \u05D4\u05E9\u05E4\u05D5\u05EA \u05EA\u05D5\u05DB\u05DC \u05DC\u05DE\u05E6\u05D5\u05D0
          \u05DE\u05D9\u05DC\u05D4 \u05E9\u05D0\u05D5\u05DE\u05E8\u05EA \u05D1\u05D3\u05D9\u05D5\u05E7
          \u05D0\u05EA \u05D6\u05D4."
        commands: []
    - rid: 6299374324604207331
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E9\u05D0\u05EA \u05DE\u05E6\u05D9\u05D2\u05D4 \u05D0\u05EA
          \u05D6\u05D4 \u05DB\u05DB\u05D4, \u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA
          \u05D3\u05D9 \u05DE\u05E8\u05E9\u05D9\u05DD."
        commands: []
    - rid: 6299374324604207332
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D3\u05D9\u05D5\u05E7. \u05D6\u05D4 \u05DE\u05E8\u05D0\u05D4
          \u05D0\u05D9\u05DA \u05E9\u05DB\u05DC \u05D1\u05E0\u05D9 \u05D4\u05D0\u05D3\u05DD
          \u05D7\u05D5\u05E9\u05D1\u05D9\u05DD \u05D3\u05D5\u05DE\u05D4, \u05D5\u05DE\u05DB\u05D9\u05E8\u05D9\u05DD
          \u05D0\u05EA \u05D0\u05D5\u05EA\u05DD \u05E7\u05D5\u05E0\u05E1\u05E4\u05D8\u05D9\u05DD."
        commands: []
    - rid: 6299374324604207333
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05DB\u05DE\u05D5\u05D1\u05DF, \u05DC\u05D0 \u05DB\u05DC
          \u05D4\u05DE\u05D9\u05DC\u05D9\u05DD \u05DB\u05DB\u05D4. \u05D9\u05E9 \u05DE\u05D9\u05DC\u05D9\u05DD
          \u05E9\u05D0\u05D9\u05DF \u05DC\u05D4\u05DF \u05EA\u05E8\u05D2\u05D5\u05DD
          \u05D9\u05E9\u05D9\u05E8 \u05D1\u05E9\u05E4\u05D5\u05EA \u05DE\u05E1\u05D5\u05D9\u05DE\u05D5\u05EA."
        commands: []
    - rid: 6299374324604207334
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05DF, \u05DB\u05E9\u05D4\u05D9\u05D0 \u05D0\u05D5\u05DE\u05E8\u05EA
          \u05D0\u05EA \u05D6\u05D4, \u05D6\u05DB\u05D5\u05E8 \u05DC\u05D9 \u05E9\u05E9\u05DE\u05E2\u05EA\u05D9
          \u05E2\u05DC \u05D0\u05D9\u05D6\u05D5 \u05DE\u05D9\u05DC\u05D4 \u05E9\u05D9\u05E9
          \u05E8\u05E7 \u05D1\u05E2\u05D1\u05E8\u05D9\u05EA\u2026)"
        commands: []
    - rid: 6299374324604207338
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05DB\u05D5\u05DF! \u05D6\u05D5 \u05D1\u05D0\u05DE\u05EA \u05D3\u05D5\u05D2\u05DE\u05D4
          \u05E7\u05DC\u05D0\u05E1\u05D9\u05EA. \u05D6\u05D5 \u05DE\u05D9\u05DC\u05D4
          \u05E9\u05DE\u05E9\u05EA\u05DE\u05E9\u05D9\u05DD \u05D1\u05D4 \u05D4\u05DE\u05D5\u05DF
          \u05D1\u05E2\u05D1\u05E8\u05D9\u05EA, \u05D0\u05D1\u05DC \u05D0\u05D9\u05DF
          \u05DC\u05D4 \u05D1\u05D0\u05DE\u05EA \u05D0\u05DC\u05D8\u05E8\u05E0\u05D8\u05D9\u05D1\u05D4
          \u05D1\u05D0\u05E0\u05D2\u05DC\u05D9\u05EA, \u05D0\u05D5 \u05D1\u05DB\u05DE\u05E2\u05D8
          \u05D0\u05E3 \u05E9\u05E4\u05D4."
        commands:
        - rid: 6299374324604207363
    - rid: 6299374324604207339
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E4\u05E9\u05E8 \u05DC\u05D7\u05E9\u05D5\u05D1 \u05E2\u05DC
          \u05D3\u05E8\u05DB\u05D9\u05DD \u05D0\u05D7\u05E8\u05D5\u05EA \u05DC\u05D5\u05DE\u05E8
          \u05D1\u05E2\u05E8\u05DA \u05D0\u05EA \u05D0\u05D5\u05EA\u05D5 \u05D3\u05D1\u05E8,
          \u05D0\u05D1\u05DC \u05D4\u05DF \u05D9\u05D4\u05D9\u05D5 \u05E9\u05D5\u05E0\u05D5\u05EA
          \u05D1\u05DB\u05DC \u05DE\u05E9\u05E4\u05D8 \u05D5\u05E8\u05D5\u05D1 \u05D4\u05D6\u05DE\u05DF
          \u05D9\u05DB\u05DC\u05DC\u05D5 \u05D3\u05D9 \u05D4\u05E8\u05D1\u05D4 \u05DE\u05D9\u05DC\u05D9\u05DD,
          \u05DB\u05E9\u05D1\u05E2\u05D1\u05E8\u05D9\u05EA \u05D6\u05D5 \u05DE\u05D9\u05DC\u05D4
          \u05D0\u05D7\u05EA \u05E9\u05DE\u05EA\u05D0\u05E8\u05EA \u05D0\u05EA \u05D6\u05D4
          \u05EA\u05DE\u05D9\u05D3."
        commands:
        - rid: 6299374324604207365
    - rid: 6299374324604207340
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA \u05DE\u05E2\u05E0\u05D9\u05D9\u05DF.
          \u05DB\u05DC \u05D4\u05D3\u05D9\u05D1\u05D5\u05E8\u05D9\u05DD \u05D4\u05D0\u05DC\u05D4
          \u05D1\u05D0\u05DE\u05EA \u05E2\u05D5\u05E9\u05D9\u05DD \u05D7\u05E9\u05E7
          \u05DC\u05DC\u05DE\u05D5\u05D3 \u05D0\u05D9\u05D6\u05D5 \u05E9\u05E4\u05D4\u2026"
        commands: []
    - rid: 6299374324604207341
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DB\u05D4 \u05D1\u05D3\u05D9\u05D5\u05E7 \u05D0\u05E0\u05D9
          \u05D4\u05E8\u05D2\u05E9\u05EA\u05D9 \u05E2\u05DD \u05DB\u05DC \u05E9\u05E4\u05D4
          \u05E9\u05DC\u05DE\u05D3\u05EA\u05D9. \u05DE\u05E1\u05E4\u05D9\u05E7 \u05E9\u05E8\u05D0\u05D9\u05EA\u05D9
          \u05E1\u05E8\u05D8\u05D5\u05DF \u05D0\u05D7\u05D3 \u05E9\u05DE\u05E9\u05D5\u05D5\u05D4
          \u05D1\u05D9\u05DF \u05D4\u05D2\u05E8\u05E1\u05D4 \u05D4\u05DE\u05E7\u05D5\u05E8\u05D9\u05EA
          \u05E9\u05DC \u05E1\u05E6\u05E0\u05D4 \u05D1\u05E1\u05D3\u05E8\u05D4 \u05E6\u05E8\u05E4\u05EA\u05D9\u05EA,
          \u05DC\u05D2\u05E8\u05E1\u05D4 \u05DE\u05EA\u05D5\u05E8\u05D2\u05DE\u05EA,
          \u05D5\u05D4\u05EA\u05D7\u05DC\u05EA\u05D9 \u05DC\u05DC\u05DE\u05D5\u05D3
          \u05E6\u05E8\u05E4\u05EA\u05D9\u05EA."
        commands: []
    - rid: 6299374324604207342
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D1\u05D6\u05DB\u05D5\u05EA \u05D9\u05DB\u05D5\u05DC\u05D5\u05EA
          \u05D4\u05E7\u05E9\u05D1 \u05E9\u05DC\u05D9, \u05D2\u05DD \u05D9\u05DB\u05D5\u05DC\u05EA\u05D9
          \u05DC\u05DC\u05DE\u05D5\u05D3 \u05E9\u05E4\u05D5\u05EA \u05DB\u05D0\u05DC\u05D4
          \u05D3\u05D9 \u05DE\u05D4\u05E8."
        commands: []
    - rid: 6299374324604207343
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E8\u05D2\u05E2 \u05D0\u05E0\u05D9 \u05D9\u05D5\u05D3\u05E2\u05EA
          \u05D1\u05E2\u05D9\u05E7\u05E8 \u05E9\u05E4\u05D5\u05EA \u05D0\u05D9\u05E8\u05D5\u05E4\u05D0\u05D9\u05D5\u05EA.
          \u05D4\u05D9\u05D9\u05EA\u05D9 \u05E9\u05DE\u05D7\u05D4 \u05DC\u05DC\u05DE\u05D5\u05D3
          \u05E2\u05D5\u05D3 \u05E9\u05E4\u05D5\u05EA \u05DE\u05DE\u05E7\u05D5\u05DE\u05D5\u05EA
          \u05D0\u05D7\u05E8\u05D9\u05DD."
        commands: []
    - rid: 6299374324604207344
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D0\u05DD \u05D4\u05D9\u05D5 \u05E4\u05D4 \u05E1\u05E4\u05E8\u05D9\u05DD
          \u05D1\u05E2\u05D5\u05D3 \u05E9\u05E4\u05D5\u05EA, \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05DE\u05E6\u05D9\u05E2\u05D4 \u05DC\u05DA \u05DC\u05DC\u05DE\u05D5\u05D3
          \u05D1\u05D9\u05D7\u05D3 \u05E7\u05E6\u05EA."
        commands: []
    - rid: 6299374324604207345
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D0\u05DE\u05EA, \u05D6\u05D4 \u05E0\u05E9\u05DE\u05E2 \u05D3\u05D9
          \u05DB\u05D9\u05E3\u2026)"
        commands: []
    - rid: 6299374324604207346
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D0\u05EA \u05D9\u05DB\u05D5\u05DC\u05D4 \u05D0\u05D5\u05DC\u05D9
          \u05DE\u05EA\u05D9\u05E9\u05D4\u05D5 \u05DC\u05DC\u05DE\u05D3 \u05D0\u05D5\u05EA\u05D9
          \u05D0\u05EA \u05D0\u05D7\u05EA \u05D4\u05E9\u05E4\u05D5\u05EA \u05E9\u05D0\u05EA
          \u05DB\u05D1\u05E8 \u05D9\u05D5\u05D3\u05E2\u05EA, \u05DC\u05D0? \u05D0\u05E0\u05D9
          \u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2 \u05D0\u05E3 \u05E9\u05E4\u05D4 \u05D7\u05D5\u05E5
          \u05DE\u05E2\u05D1\u05E8\u05D9\u05EA \u05D5\u05D0\u05E0\u05D2\u05DC\u05D9\u05EA\u2026"
        commands: []
    - rid: 6299374324604207347
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05D0\u05EA\u05D4 \u05E8\u05D5\u05E6\u05D4, \u05D0\u05E0\u05D9
          \u05D0\u05E9\u05DE\u05D7."
        commands: []
    - rid: 6299374324604207348
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D6\u05D4 \u05E0\u05E9\u05DE\u05E2 \u05E0\u05D7\u05DE\u05D3."
        commands: []
    - rid: 6299374324604207349
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DD \u05DB\u05DA, \u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9 \u05E9\u05DB\u05D3\u05D0\u05D9
          \u05E9\u05D0\u05E0\u05D9 \u05DB\u05D1\u05E8 \u05D0\u05E2\u05D1\u05D5\u05D3
          \u05E2\u05DC \u05D7\u05D5\u05DE\u05E8\u05D9\u05DD \u05DC\u05E9\u05D9\u05E2\u05D5\u05E8
          \u05E9\u05DC\u05E0\u05D5."
        commands: []
    - rid: 6299374324604207350
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05DC\u05DB\u05D9 \u05E2\u05DC \u05D6\u05D4\u2026"
        commands: []
    - rid: 6299374324604207351
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D8\u05D5\u05D1, \u05D1\u05D9\u05D9 \u05D1\u05D9\u05E0\u05EA\u05D9\u05D9\u05DD."
        commands:
        - rid: 6299374324604207366
    - rid: 6299374324604207352
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DE\u05D0\u05D9\u05D4 \u05E0\u05E8\u05D0\u05EA\u05D4 \u05D4\u05E8\u05D1\u05D4
          \u05D9\u05D5\u05EA\u05E8 \u05E9\u05DE\u05D7\u05D4 \u05D4\u05E4\u05E2\u05DD\u2026
          \u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA \u05E0\u05E8\u05D0\u05D4 \u05E9\u05D4\u05D9\u05D0
          \u05D4\u05D9\u05D9\u05EA\u05D4 \u05E6\u05E8\u05D9\u05DB\u05D4 \u05DC\u05E9\u05EA\u05E3
          \u05D1\u05D1\u05E2\u05D9\u05D5\u05EA \u05E9\u05DC\u05D4.)"
        commands: []

    - rid: 6299374324604207138
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05DE\u05D0\u05D9\u05D4\u2026 \u05D0\u05D9\u05DA \u05D6\u05D4
          \u05DC\u05D4\u05D9\u05D5\u05EA \u05E8\u05E2\"\u05E6\u05D9\u05EA \u05E9\u05DC
          \u05EA\u05E6\u05E4\u05D9\u05EA\u05E0\u05D9\u05D5\u05EA?"
        commands: []
    - rid: 6299374324604207139
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026\u05D1\u05E1\u05D3\u05E8, \u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7\u05D4."
        commands: []
    - rid: 6299374324604207140
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D5 \u05DC\u05D0 \u05E0\u05E9\u05DE\u05E2\u05D4 \u05DB\u05DE\u05D5
          \u05EA\u05E9\u05D5\u05D1\u05D4 \u05DE\u05D0\u05D5\u05D3 \u05E0\u05E8\u05D2\u05E9\u05EA\u2026)"
        commands: []
    - rid: 6299374324604207141
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA \u05E9\u05D5\u05E0\u05D4
          \u05DE\u05EA\u05E6\u05E4\u05D9\u05EA\u05E0\u05D9\u05EA \u05E8\u05D2\u05D9\u05DC\u05D4?"
        commands: []
    - rid: 6299374324604207142
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05E2\u05D1\u05D5\u05D3\u05D4 \u05D1\u05E2\u05E8\u05DA \u05D0\u05D5\u05EA\u05D5
          \u05D3\u05D1\u05E8. \u05DC\u05EA\u05E6\u05E4\u05EA. \u05D4\u05D4\u05D1\u05D3\u05DC
          \u05D4\u05D5\u05D0, \u05E9\u05D1\u05E2\u05D5\u05D3 \u05E9\u05EA\u05E6\u05E4\u05D9\u05EA\u05E0\u05D9\u05EA
          \u05E8\u05D2\u05D9\u05DC\u05D4 \u05E2\u05D5\u05E9\u05D4 \u05DE\u05E9\u05DE\u05E8\u05D5\u05EA
          \u05E9\u05DC 4 \u05E9\u05E2\u05D5\u05EA, \u05E2\u05DC \u05DE\u05E7\u05D5\u05DD
          \u05E9\u05E2\u05D5\u05D3 \u05DE\u05EA\u05E6\u05E4\u05EA\u05D5\u05EA \u05E2\u05DC\u05D9\u05D5,
          \u05D4\u05DE\u05E9\u05DE\u05E8\u05D5\u05EA \u05E9\u05DC\u05D9 \u05D9\u05DB\u05D5\u05DC\u05D5\u05EA
          \u05DC\u05D4\u05D2\u05D9\u05E2 \u05DC8, \u05D0\u05D5 \u05D0\u05E4\u05D9\u05DC\u05D5
          12 \u05E9\u05E2\u05D5\u05EA. \u05E2\u05DC \u05DE\u05E7\u05D5\u05DE\u05D5\u05EA
          \u05E9\u05D1\u05D4\u05DD \u05D0\u05E1\u05D5\u05E8 \u05DC\u05D0\u05D1\u05D3
          \u05E7\u05E9\u05D1 \u05D0\u05E4\u05D9\u05DC\u05D5 \u05DC\u05E9\u05E0\u05D9\u05D9\u05D4."
        commands: []
    - rid: 6299374324604207143
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D4 \u05E0\u05E9\u05DE\u05E2 \u05E7\u05E9\u05D4\u2026)"
        commands: []
    - rid: 6299374324604207144
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05D5\u2026 \u05D1\u05D8\u05D7 \u05D9\u05E9 \u05DC\u05DA
          \u05E8\u05D9\u05DB\u05D5\u05D6 \u05DE\u05DE\u05E9 \u05D8\u05D5\u05D1\u2026"
        commands: []
    - rid: 6299374324604207145
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF. \u05DB\u05E9\u05D0\u05E0\u05D9 \u05DE\u05EA\u05E8\u05DB\u05D6\u05EA
          \u05E2\u05DC \u05DE\u05E9\u05D4\u05D5, \u05E7\u05E9\u05D4 \u05DE\u05D0\u05D5\u05D3
          \u05DC\u05D4\u05E1\u05D9\u05D7 \u05D0\u05EA \u05D3\u05E2\u05EA\u05D9."
        commands: []
    - rid: 6299374324604207146
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DC \u05D4\u05D7\u05D9\u05D9\u05DD \u05E9\u05DC\u05D9 \u05D0\u05DE\u05E8\u05D5
          \u05DC\u05D9 \u05D0\u05EA \u05D6\u05D4. \u05DB\u05E9\u05D4\u05D9\u05D9\u05EA\u05D9
          \u05D1\u05D1\u05D9\u05EA \u05E1\u05E4\u05E8 \u05EA\u05DE\u05D9\u05D3 \u05D7\u05E9\u05D1\u05D5
          \u05E9\u05D0\u05E0\u05D9 \u05D2\u05D0\u05D5\u05E0\u05D4 \u05DB\u05D9 \u05E7\u05D9\u05D1\u05DC\u05EA\u05D9
          \u05DE\u05D0\u05D9\u05D5\u05EA \u05D1\u05D4\u05DB\u05DC \u05D1\u05DC\u05D9
          \u05DC\u05DC\u05DE\u05D5\u05D3 \u05D4\u05E8\u05D1\u05D4."
        commands: []
    - rid: 6299374324604207147
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05DE\u05E6\u05D9\u05D0\u05D5\u05EA, \u05E8\u05D5\u05D1 \u05D4\u05D0\u05E0\u05E9\u05D9\u05DD
          \u05E4\u05E9\u05D5\u05D8 \u05DE\u05E4\u05E1\u05E4\u05E1\u05D9\u05DD 70
          \u05D0\u05D7\u05D5\u05D6 \u05DE\u05D4\u05EA\u05D5\u05DB\u05DF \u05E9\u05DC
          \u05D4\u05E9\u05D9\u05E2\u05D5\u05E8\u05D9\u05DD, \u05D5\u05D0\u05D6 \u05DC\u05D5\u05E7\u05D7
          \u05DC\u05D4\u05DD 3 \u05E9\u05E2\u05D5\u05EA \u05DC\u05E2\u05D1\u05D5\u05E8
          \u05D7\u05D5\u05DE\u05E8 \u05E9\u05D4\u05DD \u05D9\u05DB\u05DC\u05D5 \u05DC\u05DC\u05DE\u05D5\u05D3
          \u05D1\u05E2\u05E9\u05E8\u05D9\u05DD \u05D3\u05E7\u05D5\u05EA."
        commands: []
    - rid: 6299374324604207148
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D4 \u05E0\u05E9\u05DE\u05E2 \u05E7\u05E9\u05D5\u05D7 \u05DB\u05E9\u05D4\u05D9\u05D0
          \u05D0\u05D5\u05DE\u05E8\u05EA \u05D0\u05EA \u05D6\u05D4 \u05DB\u05DB\u05D4,
          \u05D0\u05D1\u05DC \u05D4\u05D0\u05DE\u05EA \u05E9\u05D0\u05E0\u05D9 \u05DE\u05D6\u05D3\u05D4\u05D4
          \u05E2\u05DD \u05D6\u05D4 \u05E7\u05E6\u05EA \u05D9\u05D5\u05EA\u05E8 \u05DE\u05D3\u05D9\u2026)"
        commands: []
    - rid: 6299374324604207149
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05E1\u05D5\u05E3, \u05DC\u05E8\u05D5\u05D1 \u05D4\u05D0\u05E0\u05E9\u05D9\u05DD
          \u05D9\u05E9 \u05E7\u05E6\u05EA \u05D4\u05E4\u05E8\u05E2\u05EA \u05E7\u05E9\u05D1.
          \u05D4\u05DD \u05DE\u05D0\u05D1\u05D3\u05D9\u05DD \u05E8\u05D9\u05DB\u05D5\u05D6
          \u05D1\u05E7\u05DC\u05D5\u05EA \u05DB\u05E9\u05DE\u05E9\u05D4\u05D5 \u05DC\u05D0
          \u05DE\u05E2\u05E0\u05D9\u05D9\u05DF, \u05D5\u05DC\u05D5\u05E7\u05D7 \u05DC\u05D4\u05DD
          \u05D4\u05DE\u05D5\u05DF \u05D6\u05DE\u05DF \u05DC\u05D4\u05EA\u05D9\u05D9\u05E9\u05D1
          \u05E2\u05DC \u05DE\u05E9\u05D9\u05DE\u05D4."
        commands: []
    - rid: 6299374324604207150
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D1\u05E8\u05DE\u05D4 \u05E9\u05D0\u05E0\u05E9\u05D9\u05DD
          \u05D9\u05DB\u05D5\u05DC\u05D9\u05DD \u05DC\u05D0\u05D1\u05D3 \u05E8\u05D9\u05DB\u05D5\u05D6
          \u05D5\u05DC\u05D4\u05E4\u05E1\u05D9\u05E7 \u05DC\u05D4\u05E7\u05E9\u05D9\u05D1
          \u05D1\u05D0\u05DE\u05E6\u05E2 \u05E9\u05D9\u05D7\u05D4 \u05DB\u05E9\u05D6\u05D4
          \u05E8\u05E7 \u05D4\u05DD \u05D5\u05E2\u05D5\u05D3 \u05DE\u05D9\u05E9\u05D4\u05D5\u2026"
        commands: []
    - rid: 6299374324604207151
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05E2\u05D5\u05DC\u05DD \u05DC\u05D0 \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05DB\u05DB\u05D4. \u05DE\u05E2\u05D5\u05DC\u05DD \u05DC\u05D0 \u05D0\u05D9\u05D1\u05D3\u05EA\u05D9
          \u05E8\u05D9\u05DB\u05D5\u05D6 \u05D1\u05E9\u05D9\u05E2\u05D5\u05E8\u05D9\u05DD,
          \u05D5\u05DB\u05DC \u05DE\u05E9\u05D9\u05DE\u05D4 \u05E9\u05D4\u05D9\u05D9\u05EA\u05D9
          \u05E6\u05E8\u05D9\u05DB\u05D4 \u05DC\u05E2\u05E9\u05D5\u05EA, \u05E4\u05E9\u05D5\u05D8
          \u05E0\u05D9\u05D2\u05E9\u05EA\u05D9 \u05D5\u05E2\u05E9\u05D9\u05EA\u05D9
          \u05D0\u05D5\u05EA\u05D4."
        commands: []
    - rid: 6299374324604207152
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05D5, \u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA \u05D3\u05D9
          \u05DE\u05E8\u05E9\u05D9\u05DD\u2026"
        commands: []
    - rid: 6299374324604207153
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05E7\u05D8\u05E2 \u05D6\u05D4, \u05E9\u05DC\u05D9 \u05D6\u05D4
          \u05DC\u05D0 \u05DE\u05E8\u05D2\u05D9\u05E9 \u05DE\u05E8\u05E9\u05D9\u05DD.
          \u05DC\u05DE\u05E2\u05DF \u05D4\u05D0\u05DE\u05EA \u05D4\u05E7\u05D5\u05E0\u05E1\u05E4\u05D8
          \u05E9\u05DD \u05DC\u05D0 \u05DC\u05D4\u05D9\u05D5\u05EA \u05DB\u05DB\u05D4
          \u05D3\u05D9 \u05D6\u05E8 \u05DC\u05D9. \u05DE\u05E2\u05D5\u05DC\u05DD
          \u05DC\u05D0 \u05D4\u05D1\u05E0\u05EA\u05D9 \u05DC\u05DE\u05D4 \u05D0\u05E0\u05E9\u05D9\u05DD
          \u05D3\u05D5\u05D7\u05D9\u05DD \u05DE\u05E9\u05D9\u05DE\u05D5\u05EA, \u05D0\u05D5
          \u05DE\u05EA\u05DE\u05E2\u05DE\u05E2\u05D9\u05DD \u05D1\u05D6\u05DE\u05DF
          \u05E9\u05D4\u05DD \u05E2\u05D5\u05E9\u05D9\u05DD \u05D0\u05D5\u05EA\u05DF."
        commands: []
    - rid: 6299374324604207154
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D7\u05E8\u05D9 \u05D4\u05DB\u05DC, \u05D4\u05DD \u05EA\u05DE\u05D9\u05D3
          \u05E2\u05D5\u05E9\u05D9\u05DD \u05D0\u05D5\u05EA\u05DF \u05D1\u05E1\u05D5\u05E3,
          \u05D0\u05D6 \u05DE\u05D4 \u05D4\u05D1\u05D6\u05D1\u05D5\u05D6 \u05D6\u05DE\u05DF
          \u05E2\u05D5\u05D6\u05E8?"
        commands: []
    - rid: 6299374324604207155
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05DE\u05D4 \u05D0\u05DD \u05D6\u05D5 \u05DE\u05E9\u05D9\u05DE\u05D4
          \u05DE\u05D9\u05D9\u05D2\u05E2\u05EA, \u05DE\u05E9\u05D4\u05D5 \u05E9\u05D0\u05D9\u05DF
          \u05DC\u05DA \u05DB\u05D5\u05D7 \u05DC\u05E2\u05E9\u05D5\u05EA? \u05E8\u05D5\u05D1
          \u05D4\u05D0\u05E0\u05E9\u05D9\u05DD \u05D3\u05D5\u05D7\u05D9\u05DD \u05D3\u05D1\u05E8\u05D9\u05DD
          \u05DB\u05E9\u05D0\u05D9\u05DF \u05DC\u05D4\u05DD \u05DB\u05D5\u05D7 \u05E2\u05DC\u05D9\u05D4\u05DD\u2026"
        commands: []
    - rid: 6299374324604207156
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D9\u05E9 \u05D3\u05D1\u05E8\u05D9\u05DD \u05E9\u05D4\u05D9\u05D9\u05EA\u05D9
          \u05E6\u05E8\u05D9\u05DB\u05D4 \u05DC\u05E2\u05E9\u05D5\u05EA, \u05D5\u05DC\u05D0
          \u05E8\u05E6\u05D9\u05EA\u05D9, \u05D0\u05D1\u05DC \u05D0\u05E3 \u05E4\u05E2\u05DD
          \u05DC\u05D0 \u05D7\u05D5\u05D5\u05D9\u05EA\u05D9 \u05D0\u05EA \u05D4\"\u05D0\u05D9\u05DF
          \u05DC\u05D9 \u05DB\u05D5\u05D7\" \u05D4\u05D6\u05D4 \u05E9\u05DB\u05D5\u05DC\u05DD
          \u05DE\u05D3\u05D1\u05E8\u05D9\u05DD \u05E2\u05DC\u05D9\u05D5."
        commands: []
    - rid: 6299374324604207157
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D0\u05DE\u05EA?! \u05D0\u05E3 \u05E4\u05E2\u05DD?"
        commands:
        - rid: 6299374324604207171
    - rid: 6299374324604207158
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D9\u05D0 \u05D1\u05EA \u05D0\u05E0\u05D5\u05E9\u2026?)"
        commands: []
    - rid: 6299374324604207159
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05EA\u05D7\u05E9\u05D5\u05D1 \u05DB\u05E9\u05D0\u05EA\u05D4 \u05E2\u05D5\u05E9\u05D4
          \u05DE\u05D1\u05D7\u05DF, \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05E9\u05D0\u05EA\u05D4 \u05DC\u05D0 \u05E0\u05D4\u05E0\u05D4, \u05D5\u05EA\u05E9\u05DE\u05D7
          \u05DC\u05E1\u05D9\u05D9\u05DD \u05DB\u05D1\u05E8, \u05D0\u05D1\u05DC \u05D4\u05D0\u05D3\u05E8\u05E0\u05DC\u05D9\u05DF
          \u05E0\u05D5\u05EA\u05DF \u05DC\u05DA \u05D0\u05EA \u05D4\u05E8\u05D9\u05DB\u05D5\u05D6
          \u05D5\u05D4\u05D7\u05D3\u05D5\u05EA \u05DC\u05D4\u05EA\u05D7\u05D9\u05DC
          \u05D1\u05DB\u05DC \u05D6\u05D0\u05EA, \u05D1\u05DC\u05D9 \u05DC\u05D3\u05D7\u05D5\u05EA."
        commands: []
    - rid: 6299374324604207160
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E9\u05D0\u05EA \u05D0\u05D5\u05DE\u05E8\u05EA \u05D0\u05EA
          \u05D6\u05D4 \u05DB\u05DB\u05D4\u2026 \u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC
          \u05DC\u05D4\u05D1\u05D9\u05DF. \u05D0\u05D1\u05DC \u05D1\u05D6\u05DE\u05DF
          \u05DE\u05D1\u05D7\u05DF \u05D6\u05D5 \u05E1\u05D9\u05D8\u05D5\u05D0\u05E6\u05D9\u05D4
          \u05DE\u05DC\u05D7\u05D9\u05E6\u05D4, \u05D0\u05D6 \u05D0\u05D9\u05DF \u05D0\u05EA
          \u05D4\u05E9\u05D1\u05D9\u05D6\u05D5\u05EA \u05D4\u05D6\u05D0\u05EA\u2026
          \u05D0\u05EA \u05E4\u05E9\u05D5\u05D8 \u05DB\u05DB\u05D4 \u05DB\u05DC \u05D4\u05D6\u05DE\u05DF?"
        commands: []
    - rid: 6299374324604207161
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF. \u05D4\u05DE\u05D5\u05D7 \u05E9\u05DC \u05EA\u05DE\u05D9\u05D3
          \u05E0\u05DE\u05E6\u05D0 \u05D1\u05DE\u05E6\u05D1 \u05E8\u05D9\u05DB\u05D5\u05D6."
        commands: []
    - rid: 6299374324604207162
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA \u05D1\u05D0\u05DE\u05EA \u05E0\u05E9\u05DE\u05E2\u05EA
          \u05DB\u05DE\u05D5 \u05D4\u05D1\u05DF \u05D0\u05D3\u05DD \u05D4\u05DE\u05D5\u05E9\u05DC\u05DD
          \u05DC\u05D4\u05D9\u05D5\u05EA \u05EA\u05E6\u05E4\u05D9\u05EA\u05E0\u05D9\u05EA\u2026"
        commands: []
    - rid: 6299374324604207163
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D0\u05D4\u2026?"
        commands:
        - rid: 6299374324604207172
    - rid: 6299374324604207164
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D9\u05D0 \u05E0\u05E8\u05D0\u05EA \u05DB\u05DE\u05E2\u05D8\u2026
          \u05DE\u05D0\u05D5\u05DB\u05D6\u05D1\u05EA.)"
        commands: []
    - rid: 6299374324604207165
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05DB\u05DC \u05DE\u05E7\u05E8\u05D4 \u05D0\u05DC\u05D5\u05DF,
          \u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9 \u05E9\u05D0\u05E0\u05D9 \u05D0\u05DC\u05DA
          \u05DC\u05D1\u05D9\u05E0\u05EA\u05D9\u05D9\u05DD. \u05D4\u05D9\u05D4 \u05E0\u05D7\u05DE\u05D3
          \u05DC\u05D3\u05D1\u05E8, \u05D9\u05E4\u05D4 \u05E9\u05DC\u05D0 \u05D0\u05D9\u05D1\u05D3\u05EA
          \u05E8\u05D9\u05DB\u05D5\u05D6\u2026"
        commands: []
    - rid: 6299374324604207166
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF \u05D0\u05D4? \u05D0\u05D5\u05DC\u05D9 \u05D4\u05E7\u05E9\u05D1

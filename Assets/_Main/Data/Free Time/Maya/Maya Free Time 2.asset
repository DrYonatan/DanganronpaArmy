    - rid: 6299374324604207212
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D1\u05E1\u05D5\u05E3 \u05DC\u05D0 \u05D1\u05D3\u05D9\u05D5\u05E7
          \u05D4\u05D1\u05E0\u05EA\u05D9, \u05DE\u05D4 \u05D0\u05EA \u05D7\u05D5\u05E9\u05D1\u05EA
          \u05E2\u05DC \u05D4\u05EA\u05E4\u05E7\u05D9\u05D3?"
        commands: []
    - rid: 6299374324604207213
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E2\u05DC \u05D4\u05EA\u05E4\u05E7\u05D9\u05D3? \u05D4\u05D5\u05D0
          \u05D1\u05E1\u05D3\u05E8\u2026"
        commands: []
    - rid: 6299374324604207214
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05D4\u05D2\u05D9\u05D3
          \u05E9\u05D6\u05D0\u05EA \u05EA\u05E9\u05D5\u05E7\u05EA \u05D7\u05D9\u05D9."
        commands: []
    - rid: 6299374324604207215
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D6\u05D4 \u05D1\u05D8\u05D7 \u05DE\u05E8\u05D2\u05D9\u05E9
          \u05DC\u05DA \u05DB\u05D0\u05D9\u05DC\u05D5 \u05D4\u05EA\u05E4\u05E7\u05D9\u05D3
          \u05E0\u05D5\u05E6\u05E8 \u05D1\u05E9\u05D1\u05D9\u05DC\u05DA."
        commands: []
    - rid: 6299374324604207216
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026"
        commands: []
    - rid: 6299374324604207217
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05E7\u05E6\u05EA \u05D4\u05E4\u05D5\u05DA\u2026 \u05DC\u05E4\u05E2\u05DE\u05D9\u05DD
          \u05D0\u05E0\u05D9 \u05DE\u05E8\u05D2\u05D9\u05E9\u05D4 \u05DB\u05D0\u05D9\u05DC\u05D5
          *\u05D0\u05E0\u05D9* \u05E0\u05D5\u05E6\u05E8\u05EA\u05D9 \u05D1\u05E9\u05D1\u05D9\u05DC
          \u05D4\u05EA\u05E4\u05E7\u05D9\u05D3."
        commands:
        - rid: 6299374324604207248
    - rid: 6299374324604207218
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7 \u05E9\u05D0\u05E4\u05E9\u05E8
          \u05DC\u05D7\u05E9\u05D5\u05D1 \u05E2\u05DC \u05D6\u05D4 \u05DB\u05DB\u05D4\u2026)"
        commands: []
    - rid: 6299374324604207219
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D1\u05D0\u05DE\u05EA, \u05D6\u05D4 \u05DC\u05D0
          \u05E9\u05D4\u05EA\u05E9\u05D5\u05E7\u05D4 \u05E9\u05DC\u05D9 \u05D1\u05D7\u05D9\u05D9\u05DD
          \u05D4\u05D9\u05D0 \u05DC\u05E6\u05E4\u05D5\u05EA \u05D1\u05DE\u05E6\u05DC\u05DE\u05D5\u05EA
          \u05D1\u05DE\u05E9\u05DA 12 \u05E9\u05E2\u05D5\u05EA\u2026 \u05D0\u05D1\u05DC
          \u05D1\u05D2\u05DC\u05DC \u05E9\u05D0\u05E0\u05D9 \u05DB\u05DC \u05DB\u05DA
          \u05D8\u05D5\u05D1\u05D4 \u05D1\u05D6\u05D4, \u05DC\u05E2\u05D5\u05DC\u05DD
          \u05DC\u05D0 \u05D9\u05EA\u05E0\u05D5 \u05DC\u05D9 \u05DC\u05E2\u05E9\u05D5\u05EA
          \u05DE\u05E9\u05D4\u05D5 \u05D0\u05D7\u05E8."
        commands: []
    - rid: 6299374324604207220
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4\u05E8\u05D2\u05E2 \u05E9\u05E2\u05E9\u05D9\u05EA\u05D9
          \u05E6\u05D5 \u05E8\u05D0\u05E9\u05D5\u05DF \u05D5\u05D9\u05D5\u05DD \u05D4\u05DE\u05D0\u05D4,
          \u05E6\u05D4\"\u05DC \u05DB\u05D1\u05E8 \u05D4\u05D7\u05DC\u05D9\u05D8
          \u05DE\u05D4 \u05D4\u05D5\u05D0 \u05E8\u05D5\u05E6\u05D4 \u05DC\u05E2\u05E9\u05D5\u05EA
          \u05D0\u05D9\u05EA\u05D9\u2026"
        commands: []
    - rid: 6299374324604207221
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05D1\u05E8 \u05D1\u05E8\u05D0\u05D9\u05D5\u05DF \u05D4\u05E8\u05D0\u05E9\u05D5\u05E0\u05D9,
          \u05D4\u05DD \u05E8\u05D0\u05D5 \u05DB\u05DE\u05D4 \u05DE\u05E4\u05D5\u05E7\u05E1\u05EA
          \u05D4\u05D9\u05D9\u05EA\u05D9, \u05D5\u05D4\u05EA\u05DC\u05D4\u05D1\u05D5."
        commands: []
    - rid: 6299374324604207222
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D0\u05D7\u05E8\u05D9 \u05E9\u05D1\u05D9\u05D5\u05DD \u05D4\u05DE\u05D0\u05D4
          \u05E7\u05D9\u05D1\u05DC\u05EA\u05D9 \u05E6\u05D9\u05D5\u05DF \u05DE\u05D5\u05E9\u05DC\u05DD
          \u05D1\u05DB\u05DC \u05D4\u05D3\u05D1\u05E8\u05D9\u05DD \u05D4\u05D8\u05DB\u05E0\u05D9\u05D9\u05DD,
          \u05DB\u05D5\u05DC\u05DC \u05E7\u05E9\u05D1 \u05D5\u05E8\u05D9\u05DB\u05D5\u05D6
          \u05DB\u05DE\u05D5\u05D1\u05DF, \u05D1\u05DB\u05DC\u05DC\u2026"
        commands: []
    - rid: 6299374324604207223
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D0\u05D5\u05EA\u05D5 \u05E8\u05D2\u05E2 \u05D1\u05D9\u05D8\u05DC\u05D5
          \u05DC\u05D9 \u05DB\u05DC \u05DE\u05D9\u05D5\u05DF \u05E4\u05D5\u05D8\u05E0\u05E6\u05D9\u05D0\u05DC\u05D9,
          \u05D5\u05E0\u05EA\u05E0\u05D5 \u05DC\u05D9 \u05E9\u05D9\u05D1\u05D5\u05E5
          \u05D9\u05E9\u05E8 \u05DC\u05EA\u05E6\u05E4\u05D9\u05EA\u05E0\u05D9\u05EA."
        commands: []
    - rid: 6299374324604207224
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05E9\u05E8 \u05D0\u05D7\u05E8\u05D9 \u05D9\u05D5\u05DD \u05D4\u05DE\u05D0\u05D4?!"
        commands:
        - rid: 6008430306001682575
    - rid: 6299374324604207225
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF\u2026 \u05D0\u05E0\u05D9 \u05D4\u05D1\u05DF \u05D0\u05D3\u05DD
          \u05E9\u05E7\u05D9\u05D1\u05DC \u05E9\u05D9\u05D1\u05D5\u05E5 \u05D4\u05DB\u05D9
          \u05DE\u05D5\u05E7\u05D3\u05DD \u05E9\u05D0\u05E0\u05D9 \u05DE\u05DB\u05D9\u05E8\u05D4."
        commands:
        - rid: 6299374324604207249
    - rid: 6299374324604207226
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05DB\u05DB\u05D4 \u05E0\u05D4\u05D9\u05D9\u05EA\u05D9 \u05EA\u05E6\u05E4\u05D9\u05EA\u05E0\u05D9\u05EA,
          \u05D5\u05DE\u05E9\u05DD \u05D3\u05D9 \u05DE\u05D4\u05E8 \u05E8\u05E2\"\u05E6\u05D9\u05EA\u2026
          \u05DC\u05DE\u05E8\u05D5\u05EA \u05E9\u05D0\u05E0\u05D9 \u05D1\u05DB\u05DC\u05DC
          \u05DC\u05D0 \u05DB\u05D6\u05D4 \u05D0\u05D5\u05D4\u05D1\u05EA \u05D0\u05EA
          \u05D6\u05D4."
        commands: []
    - rid: 6299374324604207227
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF \u05D0\u05E0\u05D9 \u05DE\u05D1\u05D9\u05DF\u2026 \u05DE\u05E6\u05D3
          \u05D0\u05D7\u05D3 \u05D9\u05E9 \u05DC\u05DA \u05DB\u05D9\u05E9\u05E8\u05D5\u05DF
          \u05DE\u05D8\u05D5\u05E8\u05E3, \u05D0\u05D6 \u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC
          \u05DC\u05D4\u05D1\u05D9\u05DF \u05DC\u05DE\u05D4 \u05E6\u05D4\"\u05DC
          \u05DB\u05DC \u05DB\u05DA \u05E8\u05E6\u05D5 \u05D0\u05D5\u05EA\u05DA \u05DC\u05D6\u05D4,
          \u05D0\u05D1\u05DC \u05DE\u05E6\u05D3 \u05E9\u05E0\u05D9\u2026"
        commands: []
    - rid: 6299374324604207228
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D3\u05DE\u05D9\u05D9\u05DF
          \u05D4\u05E8\u05D1\u05D4 \u05D3\u05D1\u05E8\u05D9\u05DD \u05E9\u05E8\u05D9\u05DB\u05D5\u05D6
          \u05DB\u05DE\u05D5 \u05E9\u05DC\u05DA \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05E9\u05D9\u05DE\u05D5\u05E9\u05D9 \u05D1\u05D4\u05DD. \u05D1\u05D0\u05DE\u05EA
          \u05DC\u05D0 \u05E0\u05EA\u05E0\u05D5 \u05DC\u05DA \u05E9\u05D5\u05DD \u05D1\u05D7\u05D9\u05E8\u05D4?"
        commands: []
    - rid: 6299374324604207229
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05E1\u05D5\u05E3, \u05D9\u05E9 \u05D2\u05DD \u05D0\u05EA \u05DE\u05D4
          \u05E9\u05E6\u05D4\"\u05DC \u05E8\u05D5\u05E6\u05D9\u05DD. \u05E6\u05E8\u05D9\u05DA
          \u05EA\u05E6\u05E4\u05D9\u05EA\u05E0\u05D9\u05D5\u05EA, \u05D5\u05D6\u05D4
          \u05D1\u05D9\u05DF \u05D4\u05EA\u05E4\u05E7\u05D9\u05D3\u05D9\u05DD \u05E9\u05D1\u05D4\u05DD
          \u05D6\u05D4 \u05D4\u05DB\u05D9 \u05D7\u05E9\u05D5\u05D1."
        commands: []
    - rid: 6299374324604207230
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA \u05D3\u05D9 \u05DE\u05EA\u05E1\u05DB\u05DC
          \u05E9\u05DC\u05D0 \u05E0\u05D5\u05EA\u05E0\u05D9\u05DD \u05DC\u05DA \u05D4\u05D6\u05D3\u05DE\u05E0\u05D5\u05EA
          \u05DC\u05DE\u05E9\u05D4\u05D5 \u05D0\u05D7\u05E8\u2026"
        commands: []
    - rid: 6299374324604207231
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF\u2026 \u05DC\u05E4\u05E2\u05DE\u05D9\u05DD \u05D0\u05E0\u05D9
          \u05DE\u05E8\u05D2\u05D9\u05E9\u05D4 \u05E9\u05D4\u05DB\u05E9\u05E8\u05D5\u05DF
          \u05D4\u05D0\u05D7\u05D3 \u05D4\u05D6\u05D4 \u05D7\u05D5\u05E1\u05DD \u05DC\u05D9
          \u05DB\u05DC \u05DB\u05E9\u05E8\u05D5\u05DF \u05D0\u05D7\u05E8\u2026"
        commands: []
    - rid: 6299374324604207232
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D8\u05D5\u05D1, \u05D6\u05D4 \u05E8\u05E7 \u05D1\u05E6\u05D1\u05D0,
          \u05DC\u05D0? \u05D0\u05D7\u05E8 \u05DB\u05DA \u05EA\u05D5\u05DB\u05DC\u05D9
          \u05DC\u05E2\u05E9\u05D5\u05EA \u05DE\u05E9\u05D4\u05D5 \u05E9\u05D0\u05EA
          \u05D1\u05D0\u05DE\u05EA \u05D0\u05D5\u05D4\u05D1\u05EA."
        commands: []
    - rid: 6299374324604207233
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7\u05D4 \u05E9\u05DB\u05DF\u2026"
        commands:
        - rid: 6299374324604207250
    - rid: 6299374324604207234
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D4\u05D9\u05D9\u05EA \u05E8\u05D5\u05E6\u05D4 \u05DC\u05E2\u05E9\u05D5\u05EA?
          \u05D1\u05E6\u05D1\u05D0 \u05D0\u05D5 \u05D1\u05DB\u05DC\u05DC\u05D9?"
        commands: []
    - rid: 6299374324604207235
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026\u05D0\u05E0\u05D9 \u05D0\u05D5\u05D4\u05D1\u05EA *\u05E9\u05E4\u05D5\u05EA*\u2026
          \u05D4\u05D9\u05D4 \u05DC\u05D9 \u05D0\u05D9\u05D6\u05E9\u05D4\u05D5 \u05D7\u05DC\u05D5\u05DD
          \u05DC\u05D4\u05D9\u05D5\u05EA \u05DE\u05EA\u05E8\u05D2\u05DE\u05EA \u05DE\u05D5\u05D3\u05D9\u05E2\u05D9\u05DF
          \u05DB\u05D6\u05D0\u05EA\u2026"
        commands:
        - rid: 6299374324604207251
    - rid: 6299374324604207236
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D0\u05D5\u05D5 \u05D1\u05D0\u05DE\u05EA? \u05D5\u05D0\u05EA
          \u05D9\u05D5\u05D3\u05E2\u05EA \u05E2\u05E8\u05D1\u05D9\u05EA?"
        commands: []
    - rid: 6299374324604207237
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D9\u05E9 \u05DC\u05D9 \u05E2\u05D5\u05D3 \u05DC\u05D0\u05DF
          \u05DC\u05D4\u05E9\u05EA\u05E4\u05E8\u2026 \u05D0\u05D1\u05DC \u05D0\u05DD
          \u05D4\u05D9\u05D5 \u05E0\u05D5\u05EA\u05E0\u05D9\u05DD \u05DC\u05D9 \u05DC\u05D4\u05EA\u05DE\u05D9\u05D9\u05DF
          \u05DC\u05D6\u05D4 \u05D4\u05D9\u05D9\u05EA\u05D9 \u05D9\u05DB\u05D5\u05DC\u05D4
          \u05DC\u05D4\u05E9\u05EA\u05DE\u05E9 \u05D1\u05D9\u05DB\u05D5\u05DC\u05EA
          \u05E9\u05DC\u05D9 \u05DB\u05D3\u05D9 \u05DC\u05DC\u05DE\u05D5\u05D3 \u05E9\u05D5\u05D8\u05E3
          \u05D1\u05DE\u05D4\u05D9\u05E8\u05D5\u05EA."
        commands: []
    - rid: 6299374324604207238
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D6\u05D4 \u05D0\u05E0\u05D9 \u05DE\u05EA\u05DB\u05D5\u05D5\u05E0\u05EA\u2026
          \u05D4\u05DB\u05D9\u05E9\u05E8\u05D5\u05DF \u05D4\u05D6\u05D4 \u05D9\u05DB\u05D5\u05DC
          \u05DC\u05E9\u05DE\u05E9 \u05D0\u05D5\u05EA\u05D9 \u05DC\u05D4\u05E8\u05D1\u05D4
          \u05D3\u05D1\u05E8\u05D9\u05DD, \u05D0\u05D1\u05DC \u05D1\u05D2\u05DC\u05DC
          \u05E9\u05E6\u05D4\"\u05DC \u05E6\u05E8\u05D9\u05DA \u05DE\u05E9\u05D4\u05D5
          \u05D0\u05D7\u05D3 \u05D9\u05D5\u05EA\u05E8, \u05D0\u05E4\u05D9\u05DC\u05D5
          \u05DC\u05D0 \u05E0\u05D5\u05EA\u05E0\u05D9\u05DD \u05DC\u05D9 \u05D4\u05D6\u05D3\u05DE\u05E0\u05D5\u05EA\u2026"
        commands: []
    - rid: 6299374324604207239
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05DF, \u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA \u05DE\u05D1\u05D0\u05E1\u2026)"
        commands: []
    - rid: 6299374324604207240
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D8\u05D5\u05D1\u2026 \u05D6\u05D4 \u05E6\u05D4\"\u05DC \u05D0\u05E0\u05D9
          \u05DE\u05E0\u05D9\u05D7\u2026 \u05DB\u05E0\u05E8\u05D0\u05D4 \u05E9\u05D4\u05DD
          \u05D2\u05DD \u05D4\u05D9\u05D5 \u05E6\u05E8\u05D9\u05DB\u05D9\u05DD \u05DE\u05E9\u05D8\u05E8\u05D4
          \u05DE\u05DE\u05D8\u05E8\u05D5\u05EA \u05D9\u05D5\u05EA\u05E8 \u05DE\u05DB\u05DC
          \u05D3\u05D1\u05E8 \u05D0\u05D7\u05E8 \u05E9\u05D4\u05D9\u05D4 \u05D0\u05E4\u05E9\u05E8
          \u05DC\u05E2\u05E9\u05D5\u05EA \u05D0\u05D9\u05EA\u05D9."
        commands: []
    - rid: 6299374324604207241
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05E4\u05D7\u05D5\u05EA \u05D0\u05D9\u05EA\u05DA \u05D4\u05DD
          \u05D4\u05D7\u05DC\u05D9\u05D8\u05D5 \u05DC\u05E2\u05E9\u05D5\u05EA \u05DE\u05E9\u05D4\u05D5
          \u05E9\u05D1\u05D0\u05DE\u05EA \u05E6\u05E8\u05D9\u05DA\u2026"
        commands: []
    - rid: 6299374324604207242
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D0\u05EA \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05D4\u05DE\u05E9\u05D9\u05DA
          \u05D5\u05DC\u05E2\u05E9\u05D5\u05EA \u05D0\u05EA \u05DE\u05D4 \u05E9\u05D0\u05EA
          \u05D0\u05D5\u05D4\u05D1\u05EA, \u05D1\u05D9\u05DF \u05D0\u05DD \u05D6\u05D4
          \u05E9\u05E4\u05D5\u05EA, \u05D0\u05D5 \u05DE\u05E9\u05D4\u05D5 \u05D0\u05D7\u05E8.
          \u05D5\u05DB\u05E9\u05EA\u05E9\u05EA\u05D7\u05E8\u05E8\u05D9, \u05DB\u05DC\u05D5\u05DD
          \u05DB\u05D1\u05E8 \u05DC\u05D0 \u05E2\u05D5\u05E6\u05E8 \u05D0\u05D5\u05EA\u05DA."
        commands: []
    - rid: 6299374324604207243
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF\u2026 \u05D6\u05D4 \u05DE\u05D4 \u05E9\u05D0\u05E0\u05D9
          \u05EA\u05DE\u05D9\u05D3 \u05D0\u05D5\u05DE\u05E8\u05EA \u05DC\u05E2\u05E6\u05DE\u05D9.
          \u05D0\u05D1\u05DC \u05E0\u05D7\u05DE\u05D3 \u05DC\u05E9\u05DE\u05D5\u05E2
          \u05D0\u05EA \u05D6\u05D4 \u05D1\u05D0 \u05DE\u05DE\u05D9\u05E9\u05D4\u05D5
          \u05D0\u05D7\u05E8."
        commands: []
    - rid: 6299374324604207244
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7\u05D4 \u05E9\u05D0\u05EA\u05D4
          \u05E6\u05D5\u05D3\u05E7 \u05D1\u05D6\u05D4 \u05E9\u05DC\u05E4\u05D7\u05D5\u05EA
          \u05D9\u05E9 \u05DE\u05E9\u05DE\u05E2\u05D5\u05EA \u05DC\u05DE\u05D4 \u05E9\u05E6\u05D4\u05DC
          \u05DB\u05DF \u05D4\u05D7\u05DC\u05D9\u05D8 \u05DC\u05E2\u05E9\u05D5\u05EA
          \u05D0\u05D9\u05EA\u05D9\u2026"
        commands: []
    - rid: 6299374324604207245
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05EA\u05D5\u05D3\u05D4 \u05D0\u05DC\u05D5\u05DF. \u05E0\u05EA\u05E8\u05D0\u05D4
          \u05D0\u05D7\u05E8 \u05DB\u05DA."
        commands:
        - rid: 6299374324604207252
    - rid: 6299374324604207246
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05EA\u05DE\u05D9\u05D3 \u05E9\u05D9\u05E2\u05E8\u05EA\u05D9 \u05E9\u05DB\u05DC
          \u05D4\u05E8\u05E2\"\u05E6\u05D9\u05DD \u05DE\u05EA\u05D9\u05DD \u05E2\u05DC
          \u05D4\u05EA\u05E4\u05E7\u05D9\u05D3 \u05E9\u05DC\u05D4\u05DD\u2026 \u05D0\u05E3
          \u05E4\u05E2\u05DD \u05DC\u05D0 \u05D7\u05E9\u05D1\u05EA\u05D9 \u05E9\u05EA\u05D4\u05D9\u05D4
          \u05DE\u05D9\u05E9\u05D4\u05D9 \u05DB\u05DE\u05D5\u05D4\u05D4.)"
        commands: []
    - rid: 6299374324604207247

    - rid: 6299374324604207420
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D0\u05D9\u05D6\u05D5 \u05E9\u05E4\u05D4 \u05EA\u05E8\u05E6\u05D4
          \u05DC\u05DC\u05DE\u05D5\u05D3?"
        commands: []
    - rid: 6299374324604207421
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D4 \u05E0\u05DB\u05D5\u05DF... \u05D3\u05D9\u05D1\u05E8\u05E0\u05D5
          \u05E2\u05DC \u05DC\u05DC\u05DE\u05D5\u05D3 \u05E9\u05E4\u05D4.)"
        commands: []
    - rid: 6299374324604207422
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7 \u05E9\u05D0\u05E4\u05E9\u05E8
          \u05D0\u05EA \u05D0\u05D7\u05EA \u05DE\u05D4\u05D0\u05D9\u05E8\u05D5\u05E4\u05D0\u05D9\u05D5\u05EA,
          \u05D0\u05D1\u05DC \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2
          \u05D0\u05DD \u05D0\u05E3 \u05D0\u05D7\u05EA \u05DE\u05D4\u05DF \u05D1\u05DE\u05D9\u05D5\u05D7\u05D3
          \u05E7\u05D5\u05E8\u05E6\u05EA \u05DC\u05D9\u2026"
        commands: []
    - rid: 6299374324604207423
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E4\u05E9\u05E8 \u05D0\u05D5\u05DC\u05D9 \u05D2\u05DD \u05D9\u05E4\u05E0\u05D9\u05EA,
          \u05E2\u05DD \u05DB\u05DC \u05D4\u05D0\u05E0\u05D9\u05DE\u05D4 \u05D5\u05D6\u05D4
          \u05D6\u05D4 \u05D4\u05D9\u05D4 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05DE\u05D2\u05E0\u05D9\u05D1\u2026 \u05D0\u05D1\u05DC \u05D0\u05D5\u05DC\u05D9
          \u05D9\u05D7\u05E9\u05D1\u05D5 \u05E9\u05D0\u05E0\u05D9 \u05D5\u05D5\u05D9\u05D1\u2026"
        commands: []
    - rid: 6299374324604207424
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05DC\u05D0 \u05E6\u05E8\u05D9\u05DA \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05E9\u05D9\u05E7\u05D5\u05DC. \u05EA\u05D7\u05DC\u05D9\u05D8 \u05D0\u05D9\u05D6\u05D5
          \u05E9\u05E4\u05D4 \u05D0\u05EA\u05D4 \u05E8\u05D5\u05E6\u05D4 \u05DC\u05E4\u05D9
          \u05DE\u05D4 \u05E9\u05D0\u05EA\u05D4 \u05E8\u05D5\u05E6\u05D4."
        commands:
        - rid: 6299374324604207471
    - rid: 6299374324604207425
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF \u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7\u2026 \u05DE\u05E6\u05D3
          \u05E9\u05E0\u05D9, \u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2 \u05D0\u05DD
          \u05D9\u05E9 \u05DC\u05D9 \u05DB\u05D5\u05D7 \u05E2\u05DC \u05DB\u05DC
          \u05D4\u05E1\u05DE\u05DC\u05D9\u05DD \u05D4\u05D0\u05DC\u05D4\u2026"
        commands: []
    - rid: 6299374324604207426
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05E9 \u05DC\u05DA \u05DB\u05D9\u05D5\u05D5\u05DF\u2026?"
        commands: []
    - rid: 6299374324604207427
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7 \u05E9\u05E9\u05E4\u05D4
          \u05D9\u05D7\u05E1\u05D9\u05EA \u05E7\u05DC\u05D4, \u05DC\u05D0 \u05D0\u05D6\u05D5\u05D8\u05E8\u05D9\u05EA
          \u05DE\u05D3\u05D9\u2026"
        commands: []
    - rid: 6299374324604207428
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05D4 \u05DC\u05D0 \u05D0\u05D5\u05D4\u05D1 \u05E9\u05E4\u05D5\u05EA
          \u05DB\u05D0\u05DC\u05D4?"
        commands: []
    - rid: 6299374324604207429
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2\u2026 \u05D0\u05D1\u05DC \u05D1\u05D3\u05E8\u05DA
          \u05DB\u05DC\u05DC \u05D0\u05E0\u05E9\u05D9\u05DD \u05DE\u05EA\u05D7\u05D9\u05DC\u05D9\u05DD
          \u05E2\u05DD \u05E9\u05E4\u05D5\u05EA \u05D9\u05D5\u05EA\u05E8 \u05E7\u05DC\u05D5\u05EA
          \u05DB\u05D0\u05DC\u05D4, \u05DC\u05D0?"
        commands: []
    - rid: 6299374324604207430
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05D4 \u05DC\u05D0 \u05DE\u05E8\u05D2\u05D9\u05E9 \u05DC\u05E4\u05E2\u05DE\u05D9\u05DD
          \u05E9\u05E7\u05E6\u05EA \u05DE\u05DB\u05D5\u05D5\u05E0\u05D9\u05DD \u05D0\u05D5\u05EA\u05DA
          \u05DC\u05DB\u05D9\u05D5\u05D5\u05DF \u05E1\u05E4\u05E6\u05D9\u05E4\u05D9
          \u05D1\u05D7\u05D9\u05D9\u05DD?"
        commands:
        - rid: 6299374324604207472
    - rid: 6299374324604207431
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DE\u05D0\u05D9\u05E4\u05D4 \u05D6\u05D4 \u05D4\u05D2\u05D9\u05E2?)"
        commands:
        - rid: 6299374324604207473
    - rid: 6299374324604207432
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D6\u05D0\u05EA \u05D0\u05D5\u05DE\u05E8\u05EA?"
        commands: []
    - rid: 6299374324604207433
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05D4 \u05DC\u05D0 \u05DE\u05E8\u05D2\u05D9\u05E9 \u05DC\u05E4\u05E2\u05DE\u05D9\u05DD
          \u05DB\u05D0\u05D9\u05DC\u05D5 \u05DE\u05D4 \u05E9\u05D0\u05EA\u05D4 \u05E2\u05D5\u05E9\u05D4
          \u05D1\u05D7\u05D9\u05D9\u05DD \u05D6\u05D4 \u05DB\u05D9 \u05D0\u05E0\u05E9\u05D9\u05DD
          \u05D0\u05D7\u05E8\u05D9\u05DD \u05D4\u05DB\u05D5\u05D5\u05D9\u05E0\u05D5
          \u05D0\u05D5\u05EA\u05DA \u05DC\u05D6\u05D4?"
        commands: []
    - rid: 6299374324604207434
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9 \u05E9\u05D0\u05E3
          \u05D0\u05D7\u05D3 \u05D4\u05DB\u05D5\u05D5\u05D9\u05DF \u05D0\u05D5\u05EA\u05D9
          \u05DC\u05D4\u05D9\u05D5\u05EA \u05DE\u05E9\"\u05E7 \u05DE\u05DE\u05D8\u05E8\u05D5\u05EA\u2026"
        commands: []
    - rid: 6299374324604207435
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05E1\u05D3\u05E8, \u05DC\u05D0 \u05D6\u05D4\u2026 \u05D0\u05E0\u05D9
          \u05D0\u05E9\u05D0\u05DC \u05D0\u05D5\u05EA\u05DA \u05DB\u05DB\u05D4. \u05D0\u05EA\u05D4
          \u05D4\u05D9\u05D9\u05EA \u05E8\u05D5\u05E6\u05D4 \u05DC\u05D4\u05E4\u05D5\u05DA
          \u05DC\u05DE\u05E7\u05E2\u05E7\u05E2?"
        commands: []
    - rid: 6299374324604207436
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DE\u05D4?)"
        commands:
        - rid: 6299374324604207474
    - rid: 6299374324604207437
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0\u2026"
        commands: []
    - rid: 6299374324604207438
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05E9\u05D0\u05D5\u05DC
          \u05D0\u05D5\u05EA\u05DA \u05DC\u05DE\u05D4?"
        commands: []
    - rid: 6299374324604207439
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9 \u05E9\u05D4\u05D4\u05D5\u05E8\u05D9\u05DD
          \u05E9\u05DC\u05D9 \u05D9\u05DE\u05D5\u05EA\u05D5 \u05E2\u05DC \u05D6\u05D4\u2026"
        commands: []
    - rid: 6299374324604207440
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D7\u05D5\u05E5 \u05DE\u05D6\u05D4, \u05DE\u05D4 \u05DC\u05D9 \u05D5\u05DC\u05D6\u05D4?
          \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05DE\u05E2\u05D5\u05E0\u05D9\u05D9\u05DF
          \u05DB\u05DC \u05DB\u05DA \u05D1\u05E2\u05E9\u05D5\u05EA \u05E7\u05E2\u05E7\u05D5\u05E2
          \u05E2\u05DC \u05E2\u05E6\u05DE\u05D9, \u05D1\u05D8\u05D7 \u05E9\u05DC\u05D0
          \u05DC\u05E7\u05E2\u05E7\u05E2\u2026"
        commands: []
    - rid: 6299374324604207441
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05E0\u05D4, \u05D6\u05D5 \u05EA\u05E9\u05D5\u05D1\u05D4 \u05D4\u05D2\u05D9\u05D5\u05E0\u05D9\u05EA.
          \u05D4\u05EA\u05E9\u05D5\u05D1\u05D4 \u05D4\u05D6\u05D0\u05EA \u05DE\u05E1\u05E4\u05D9\u05E7\u05D4
          \u05DC\u05D2\u05DE\u05E8\u05D9, \u05D0\u05D1\u05DC \u05DC\u05E4\u05E0\u05D9
          \u05E9\u05D4\u05D6\u05DB\u05E8\u05EA \u05D0\u05EA \u05D6\u05D4\u2026 \u05D4\u05D6\u05DB\u05E8\u05EA
          \u05E9\u05D4\u05D4\u05D5\u05E8\u05D9\u05DD \u05E9\u05DC\u05DA \u05DC\u05D0
          \u05D9\u05E9\u05DE\u05D7\u05D5 \u05DE\u05D6\u05D4."
        commands: []
    - rid: 6299374324604207442
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA\u2026)"
        commands: []
    - rid: 6299374324604207443
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05DC \u05EA\u05EA\u05DF \u05DC\u05D0\u05E0\u05E9\u05D9\u05DD
          \u05D0\u05D7\u05E8\u05D9\u05DD \u05DC\u05D4\u05DB\u05D5\u05D5\u05D9\u05DF
          \u05D0\u05D5\u05EA\u05DA. \u05E2\u05DD \u05E6\u05D4\"\u05DC \u05D0\u05D9\u05DF
          \u05DC\u05DA \u05D1\u05D7\u05D9\u05E8\u05D4, \u05D0\u05D1\u05DC \u05D0\u05D9\u05DF
          \u05E1\u05D9\u05D1\u05D4 \u05E9\u05DC\u05D0 \u05EA\u05E2\u05E9\u05D4 \u05DE\u05D4
          \u05E9\u05D0\u05EA\u05D4 \u05E8\u05D5\u05E6\u05D4 \u05D1\u05D7\u05D9\u05D9\u05DD."
        commands: []
    - rid: 6299374324604207444
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D7\u05E8\u05D9 \u05D4\u05DB\u05DC, \u05D0\u05EA\u05D4 \u05DC\u05D9\u05DE\u05D3\u05EA
          \u05D0\u05D5\u05EA\u05D9 \u05D0\u05EA \u05D6\u05D4\u2026"
        commands:
        - rid: 6299374324604207475
    - rid: 6299374324604207445
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D0\u05E0\u05D9 \u05DE\u05E0\u05D9\u05D7\u2026"
        commands: []
    - rid: 6299374324604207446
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA \u05D4\u05E8\u05D2\u05E9\u05EA \u05E9\u05DE\u05DB\u05D5\u05D5\u05E0\u05D9\u05DD
          \u05D0\u05D5\u05EA\u05DA \u05E4\u05E2\u05DD? \u05DC\u05E4\u05E0\u05D9 \u05E6\u05D4\"\u05DC
          \u05D0\u05E0\u05D9 \u05DE\u05EA\u05DB\u05D5\u05D5\u05DF."
        commands: []
    - rid: 6299374324604207447
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05D4\u05E8\u05D2\u05E9\u05EA\u05D9 \u05E9\u05DE\u05DE\u05E9
          \u05DE\u05DB\u05E8\u05D9\u05D7\u05D9\u05DD \u05D0\u05D5\u05EA\u05D9 \u05DC\u05E2\u05E9\u05D5\u05EA
          \u05DB\u05DC\u05D5\u05DD, \u05D0\u05D1\u05DC \u05DB\u05DF\u2026 \u05DC\u05E4\u05E2\u05DE\u05D9\u05DD
          \u05D4\u05E8\u05D2\u05E9\u05EA\u05D9 \u05E9\u05DE\u05DB\u05D5\u05D5\u05E0\u05D9\u05DD
          \u05D0\u05D5\u05EA\u05D9."
        commands:
        - rid: 6299374324604207476
    - rid: 6299374324604207448
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DE\u05D5 \u05E9\u05D0\u05DE\u05E8\u05EA\u05D9, \u05D1\u05D1\u05D9\u05EA
          \u05E1\u05E4\u05E8 \u05D4\u05D9\u05D9\u05EA\u05D9 \u05EA\u05DE\u05D9\u05D3
          \u05DE\u05E6\u05DC\u05D9\u05D7\u05D4, \u05D1\u05D2\u05DC\u05DC \u05D4\u05E8\u05D9\u05DB\u05D5\u05D6
          \u05E9\u05DC\u05D9."
        commands: []
    - rid: 6299374324604207449
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D2\u05DC\u05DC \u05D6\u05D4, \u05EA\u05DE\u05D9\u05D3 \u05DC\u05D7\u05E6\u05D5
          \u05E2\u05DC\u05D9\u05D9 \u05DC\u05DC\u05DB\u05EA \u05DC\u05DB\u05D9\u05EA\u05D5\u05EA
          \u05DE\u05E6\u05D5\u05D9\u05E0\u05D5\u05EA, \u05EA\u05D7\u05E8\u05D5\u05D9\u05D5\u05EA,
          \u05DB\u05DC \u05DE\u05E0\u05D9\u2026 \u05D4\u05E8\u05D1\u05D4 \u05DE\u05D4\u05D6\u05DE\u05DF,
          \u05D1\u05EA\u05D7\u05D5\u05DE\u05D9\u05DD \u05E9\u05DC\u05D0 \u05E2\u05E0\u05D9\u05D9\u05E0\u05D5
          \u05D0\u05D5\u05EA\u05D9 \u05D1\u05DB\u05DC\u05DC."
        commands: []
    - rid: 6299374324604207450
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D3\u05DE\u05D9\u05D9\u05DF\u2026"
        commands: []
    - rid: 6299374324604207451
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D4\u05EA\u05D7\u05DC\u05D4 \u05D2\u05DD \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05D1\u05D0\u05DE\u05EA \u05E2\u05D5\u05E9\u05D4 \u05D0\u05EA \u05D4\u05D3\u05D1\u05E8\u05D9\u05DD
          \u05D4\u05D0\u05DC\u05D4\u2026 \u05D0\u05D1\u05DC \u05D1\u05D0\u05D9\u05D6\u05D4
          \u05E9\u05DC\u05D1 \u05D4\u05D1\u05E0\u05EA\u05D9 \u05E9\u05D0\u05E0\u05D9
          \u05DC\u05D0 \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05D7\u05D9\u05D5\u05EA
          \u05DB\u05DB\u05D4."
        commands: []
    - rid: 6299374324604207452
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05EA\u05D9\u05DB\u05D5\u05DF \u05D4\u05D9\u05D4 \u05D0\u05D9\u05E4\u05D4
          \u05E9\u05D1\u05D0\u05DE\u05EA \u05D4\u05E4\u05E1\u05E7\u05EA\u05D9 \u05DC\u05EA\u05EA
          \u05DC\u05D0\u05E0\u05E9\u05D9\u05DD \u05DC\u05D4\u05DB\u05D5\u05D5\u05D9\u05DF
          \u05D0\u05D5\u05EA\u05D9. \u05D6\u05D0\u05EA \u05D4\u05E1\u05D9\u05D1\u05D4
          \u05E9\u05DB\u05DC \u05DB\u05DA \u05D4\u05EA\u05D0\u05DB\u05D6\u05D1\u05EA\u05D9
          \u05E9\u05E6\u05D4\"\u05DC \u05DB\u05DB\u05D4 \u05D4\u05D7\u05DC\u05D9\u05D8\u05D5
          \u05D9\u05E9\u05E8 \u05D1\u05D3\u05D9\u05D5\u05E7 \u05DE\u05D4 \u05D4\u05DD
          \u05E8\u05D5\u05E6\u05D9\u05DD \u05E9\u05D0\u05E0\u05D9 \u05D0\u05E2\u05E9\u05D4."
        commands: []
    - rid: 6299374324604207453
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D0\u05EA \u05D4\u05D9\u05D9\u05EA\u05D4 \u05D4\u05DE\u05E1\u05D2\u05E8\u05EA
          \u05D4\u05E8\u05D0\u05E9\u05D5\u05E0\u05D4 \u05E9\u05D4\u05E8\u05D2\u05E9\u05EA\u05D9
          \u05E9\u05D0\u05E0\u05D9 \u05DE\u05D7\u05DC\u05D9\u05D8\u05D4 \u05DC\u05DE\u05D4
          \u05D0\u05E0\u05D9 \u05DE\u05DB\u05D5\u05D5\u05E0\u05EA, \u05D0\u05D1\u05DC
          \u05D1\u05E2\u05E6\u05DD \u05D6\u05D0\u05EA \u05D4\u05D9\u05D9\u05EA\u05D4
          \u05D4\u05D0\u05D7\u05EA \u05E9\u05D4\u05D9\u05D9\u05EA\u05D4 \u05DC\u05D9
          \u05D4\u05DB\u05D9 \u05E4\u05D7\u05D5\u05EA \u05D4\u05D7\u05DC\u05D8\u05D4."
        commands: []
    - rid: 6299374324604207454
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DC\u05D0 \u05D4\u05D9\u05D9\u05EA\u05D9 \u05DE\u05E6\u05E4\u05D4
          \u05D3\u05D5\u05D5\u05E7\u05D0 \u05DE\u05D4\u05E6\u05D1\u05D0 \u05DC\u05D4\u05D1\u05D9\u05D0
          \u05DC\u05D9 \u05D1\u05D7\u05D9\u05E8\u05D4\u2026)"
        commands: []
    - rid: 6299374324604207455
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D9\u05D5\u05DD \u05D0\u05E0\u05D9 \u05DE\u05D1\u05D9\u05E0\u05D4
          \u05DB\u05DE\u05D5\u05D1\u05DF \u05E9\u05D4\u05D9\u05D9\u05EA\u05D9 \u05EA\u05DE\u05D9\u05DE\u05D4.
          \u05D0\u05D1\u05DC \u05D1\u05EA\u05E7\u05D5\u05E4\u05D4 \u05D4\u05D4\u05D9\u05D0,
          \u05D4\u05D9\u05D9\u05EA\u05D9 \u05E0\u05D7\u05E9\u05D1\u05EA \u05DE\u05D0\u05D5\u05D3
          \u05DE\u05D5\u05E6\u05DC\u05D7\u05EA, \u05D5\u05D0\u05E0\u05E9\u05D9\u05DD
          \u05EA\u05DE\u05D9\u05D3 \u05EA\u05D9\u05D0\u05E8\u05D5 \u05D0\u05EA \u05D6\u05D4
          \u05DB\u05D0\u05D9\u05DC\u05D5 \u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC\u05D4
          \u05DC\u05E2\u05E9\u05D5\u05EA \u05DE\u05D4 \u05E9\u05D0\u05E0\u05D9 \u05E8\u05D5\u05E6\u05D4
          \u05D1\u05E6\u05D4\"\u05DC\u2026"
        commands: []
    - rid: 6299374324604207456
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E4\u05D9\u05DC\u05D5 \u05DB\u05E9\u05D4\u05D2\u05E2\u05EA\u05D9
          \u05DC\u05EA\u05E4\u05E7\u05D9\u05D3, \u05DC\u05E4\u05E0\u05D9 \u05E9\u05E0\u05D4\u05D9\u05D9\u05EA\u05D9
          \u05E8\u05E2\"\u05E6\u05D9\u05EA, \u05DB\u05E9\u05E1\u05D9\u05E4\u05E8\u05EA\u05D9
          \u05DC\u05D1\u05E0\u05D5\u05EA \u05E9\u05D4\u05D9\u05D5 \u05D0\u05D9\u05EA\u05D9
          \u05E2\u05DC \u05D4\u05E8\u05E7\u05E2 \u05E9\u05DC\u05D9, \u05D4\u05DF
          \u05EA\u05DE\u05D9\u05D3 \u05E9\u05D0\u05DC\u05D5 \"\u05DC\u05DE\u05D4
          \u05DC\u05D0 \u05D4\u05DC\u05DB\u05EA \u05DC\u05DE\u05D5\u05D3\u05D9\u05E2\u05D9\u05DF?\".
          \u05D0\u05D5 \u05DE\u05E9\u05D4\u05D5 \u05DB\u05D6\u05D4."
        commands: []
    - rid: 6299374324604207457
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05D0\u05D9\u05DC\u05D5 \u05D0\u05E0\u05D9 \u05DE\u05D7\u05DC\u05D9\u05D8\u05D4
          \u05D0\u05DD \u05DC\u05DC\u05DB\u05EA \u05DC\u05D6\u05D4 \u05D0\u05D5 \u05DC\u05D0."
        commands: []
    - rid: 6299374324604207458
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05DF, \u05D4\u05D0\u05DE\u05EA \u05E9\u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC
          \u05DC\u05D4\u05D6\u05D3\u05D4\u05D5\u05EA\u2026)"
        commands: []
    - rid: 6299374324604207459
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D2\u05DD \u05DC\u05D9 \u05D9\u05E6\u05D0 \u05DC\u05D7\u05D5\u05D5\u05EA
          \u05D0\u05EA \u05D6\u05D4 \u05E7\u05E6\u05EA \u05D0\u05E6\u05DC\u05D9\u2026
          \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D7\u05D5\u05E9\u05D1 \u05E9\u05D0\u05E0\u05D9
          \u05D0\u05D9\u05D6\u05D4 \u05D2\u05D0\u05D5\u05DF, \u05D0\u05D1\u05DC \u05D4\u05E8\u05D1\u05D4
          \u05D0\u05E0\u05E9\u05D9\u05DD \u05DE\u05D1\u05E1\u05D9\u05E1 \u05E9\u05DC\u05D9
          \u05D7\u05E9\u05D1\u05D5 \u05E9\u05D0\u05E0\u05D9 \u05DB\u05DF."
        commands: []
    - rid: 6299374324604207460
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D2\u05DD, \u05D4\u05E8\u05D1\u05D4 \u05E4\u05E2\u05DE\u05D9\u05DD
          \u05E9\u05D0\u05DC\u05D5 \u05D0\u05D5\u05EA\u05D9 \"\u05DC\u05D0 \u05E8\u05E6\u05D9\u05EA
          \u05DC\u05DC\u05DB\u05EA \u05DC\u05DE\u05E9\u05D4\u05D5 \u05D0\u05D7\u05E8?\",
          \u05DB\u05D0\u05D9\u05DC\u05D5 \u05D6\u05D5 \u05D1\u05D7\u05D9\u05E8\u05D4
          \u05E9\u05DC\u05D9."
        commands: []
    - rid: 6299374324604207461
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF\u2026 \u05D1\u05DB\u05DC \u05DE\u05E7\u05E8\u05D4, \u05D0\u05E0\u05D9
          \u05E9\u05DE\u05D7\u05D4 \u05E9\u05E4\u05D2\u05E9\u05EA\u05D9 \u05D0\u05D5\u05EA\u05DA
          \u05D0\u05DC\u05D5\u05DF."
        commands:

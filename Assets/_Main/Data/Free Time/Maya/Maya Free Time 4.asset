    - rid: 6299374324604207462
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D4 \u05D4\u05D2\u05D9\u05E2 \u05DE\u05D0\u05DE\u05E6\u05E2
          \u05E9\u05D5\u05DD \u05DE\u05E7\u05D5\u05DD\u2026)"
        commands: []
    - rid: 6299374324604207463
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D0\u05DE\u05EA! \u05D4\u05D9\u05D9\u05EA\u05D9 \u05DE\u05D5\u05E9\u05D7\u05E8\u05EA
          \u05DE\u05DB\u05DC \u05D6\u05D4\u2026 \u05D5\u05D0\u05EA\u05D4 \u05E2\u05D6\u05E8\u05EA
          \u05DC\u05D9 \u05DC\u05D4\u05D1\u05D9\u05DF \u05E9\u05D6\u05D4 \u05D1\u05D0\u05DE\u05EA
          \u05DC\u05D0 \u05DB\u05D6\u05D4 \u05E0\u05D5\u05E8\u05D0. \u05DB\u05DC
          \u05E2\u05D5\u05D3 \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05E0\u05D5\u05EA\u05E0\u05EA
          \u05DC\u05D0\u05E3 \u05D0\u05D7\u05D3 \u05DC\u05EA\u05EA \u05DC\u05D9 \u05DC\u05D4\u05D7\u05DC\u05D9\u05D8
          \u05DE\u05D4 \u05D0\u05E0\u05D9 \u05D0\u05D5\u05D4\u05D1\u05EA, \u05D0\u05E0\u05D9
          \u05D9\u05DB\u05D5\u05DC\u05D4 \u05DC\u05D4\u05DE\u05E9\u05D9\u05DA \u05DC\u05D0\u05D4\u05D5\u05D1
          \u05D0\u05EA \u05DE\u05D4 \u05E9\u05D0\u05E0\u05D9 \u05E8\u05D5\u05E6\u05D4."
        commands:
        - rid: 6299374324604207480
    - rid: 6299374324604207464
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D2\u05DD \u05D0\u05EA\u05D4 \u05D0\u05DC\u05D5\u05DF\u2026
          \u05D0\u05DC \u05EA\u05EA\u05DF \u05DC\u05D0\u05E0\u05E9\u05D9\u05DD \u05DC\u05D4\u05DB\u05D5\u05D5\u05D9\u05DF
          \u05D0\u05D5\u05EA\u05DA. \u05EA\u05DE\u05D9\u05D3 \u05DB\u05E9\u05D0\u05EA\u05D4
          \u05DE\u05EA\u05D7\u05D9\u05DC \u05DE\u05E9\u05D4\u05D5, \u05EA\u05E9\u05D0\u05DC
          \u05D0\u05EA \u05D4\u05E9\u05D0\u05DC\u05D4 \"\u05D4\u05D0\u05DD \u05D1\u05D0\u05DE\u05EA
          \u05D0\u05E0\u05D9 \u05D4\u05D7\u05DC\u05D8\u05EA\u05D9 \u05DC\u05E2\u05E9\u05D5\u05EA
          \u05D0\u05EA \u05D6\u05D4?\"."
        commands: []
    - rid: 6299374324604207465
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF. \u05D0\u05E0\u05D9 \u05D0\u05E9\u05D9\u05DD \u05DC\u05D1
          \u05DC\u05D6\u05D4."
        commands: []
    - rid: 6299374324604207466
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05E0\u05D5\u05D2\u05E2 \u05DC\u05E9\u05E4\u05D5\u05EA\u2026
          \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2 \u05D0\u05DD \u05DB\u05D1\u05E8
          \u05E0\u05E1\u05E4\u05D9\u05E7 \u05D4\u05D9\u05D5\u05DD."
        commands: []
    - rid: 6299374324604207467
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D4 \u05E0\u05DB\u05D5\u05DF! \u05E9\u05DB\u05D7\u05EA\u05D9
          \u05DE\u05D6\u05D4 \u05DC\u05D2\u05DE\u05E8\u05D9. \u05DB\u05DF, \u05DB\u05D1\u05E8
          \u05E2\u05D1\u05E8 \u05D4\u05E8\u05D1\u05D4 \u05D6\u05DE\u05DF \u05D0\u05D4\u2026
          \u05D8\u05D5\u05D1 \u05E0\u05D5. \u05E4\u05E2\u05DD \u05D4\u05D1\u05D0\u05D4."
        commands: []
    - rid: 6299374324604207468
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF."
        commands: []
    - rid: 6299374324604207469
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D8\u05D5\u05D1, \u05D0\u05E0\u05D9 \u05D0\u05D7\u05D6\u05D5\u05E8
          \u05DC\u05D2\u05DC\u05E2\u05D3, \u05D0\u05D1\u05DC \u05E4\u05E2\u05DD \u05D4\u05D1\u05D0\u05D4
          \u05D1\u05D0\u05DE\u05EA \u05E0\u05DC\u05DE\u05D3 \u05DE\u05E9\u05D4\u05D5.
          \u05D5\u05EA\u05D7\u05DC\u05D9\u05D8 \u05E2\u05D3 \u05D0\u05D6 \u05D0\u05D9\u05D6\u05D5
          \u05E9\u05E4\u05D4, \u05D1\u05E2\u05E6\u05DE\u05DA."
        commands:
        - rid: 6299374324604207481
    - rid: 6299374324604207470

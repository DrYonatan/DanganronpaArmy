    - rid: 2649295838973526059
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05D5 \u05DE\u05D4 \u05D1\u05E8\u05D2\u05E8, \u05D0\u05EA\u05D4
          \u05D4\u05D5\u05DC\u05DA \u05DC\u05DE\u05D5\u05E2\u05D3\u05D5\u05E0\u05D9\u05DD?"
        commands: []
    - rid: 2649295838973526060
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05D4 \u05DE\u05EA\u05DB\u05D5\u05D5\u05DF \u05DC\u05DE\u05D5\u05E2\u05D3\u05D5\u05E0\u05D9
          \u05DC\u05D9\u05DC\u05D4 \u05DB\u05D0\u05DC\u05D4? \u05D4\u05D0\u05DE\u05EA
          \u05E9\u05DC\u05D0 \u05DB\u05DC \u05DB\u05DA\u2026"
        commands: []
    - rid: 2649295838973526061
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05D7\u05D5\u05D1\u05D4 \u05DC\u05D4\u05D1\u05D9\u05D0
          \u05D0\u05D5\u05EA\u05DA \u05DC\u05DE\u05E1\u05D9\u05D1\u05D4."
        commands: []
    - rid: 2649295838973526062
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2\u2026 \u05D0\u05EA\u05D4
          \u05D7\u05D5\u05E9\u05D1 \u05E9\u05D0\u05E0\u05D9 \u05D0\u05D5\u05D4\u05D1
          \u05D0\u05EA \u05D6\u05D4?"
        commands: []
    - rid: 2649295838973526063
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D9\u05E9 \u05DC\u05D0 \u05DC\u05D0\u05D4\u05D5\u05D1?
          \u05D0\u05EA\u05D4 \u05D4\u05D5\u05DC\u05DA \u05E2\u05DD \u05D7\u05D1\u05E8\u05D9\u05DD,
          \u05D9\u05E9 \u05D0\u05DC\u05DB\u05D5\u05D4\u05D5\u05DC, \u05DE\u05D5\u05D6\u05D9\u05E7\u05D4,
          \u05DB\u05D5\u05E1\u05D9\u05D5\u05EA."
        commands: []
    - rid: 2649295838973526064
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D2\u05DD \u05DC\u05D0 \u05D9\u05E2\u05E9\u05D5 \u05DC\u05DA \u05D1\u05E2\u05D9\u05D5\u05EA
          \u05D1\u05DB\u05E0\u05D9\u05E1\u05D4."
        commands: []
    - rid: 2649295838973526065
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D3\u05E8\u05DA \u05DB\u05DC\u05DC \u05E2\u05D5\u05E9\u05D9\u05DD?"
        commands:
        - rid: 2649295838973526100
    - rid: 2649295838973526066
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05D1\u05D3\u05E8\u05DA \u05DB\u05DC\u05DC
          \u05DC\u05D0. \u05D0\u05D1\u05DC \u05DC\u05E4\u05E2\u05DE\u05D9\u05DD \u05D4\u05DD
          \u05E9\u05E8\u05DE\u05D5\u05D8\u05D5\u05EA, \u05E1\u05EA\u05DD. \u05D0\u05E0\u05D9
          \u05D6\u05D5\u05DB\u05E8 \u05D4\u05D9\u05D4 \u05DC\u05D9 \u05D0\u05D9\u05D6\u05D4
          \u05DE\u05E7\u05E8\u05D4."
        commands: []
    - rid: 2649295838973526067
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2 \u05DE\u05D4
          \u05D6\u05D4 \"\u05DE\u05E7\u05E8\u05D4\" \u05DE\u05D1\u05D7\u05D9\u05E0\u05EA\u05D5\u2026)"
        commands: []
    - rid: 2649295838973526068
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E7\u05D9\u05E6\u05E8 \u05DE\u05D4 \u05D0\u05E0\u05D9 \u05D0\u05D5\u05DE\u05E8
          \u05DC\u05DA? \u05D4\u05DC\u05DB\u05E0\u05D5 \u05DC\u05D0\u05D9\u05D6\u05D4
          \u05DE\u05D5\u05E2\u05D3\u05D5\u05DF \u05D1\u05EA\u05DC \u05D0\u05D1\u05D9\u05D1,
          \u05D0\u05E0\u05D9 \u05D5\u05E9\u05E0\u05D9 \u05D7\u05D1\u05E8\u05D9\u05DD."
        commands: []
    - rid: 2649295838973526069
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D0\u05E0\u05D5 \u05DC\u05EA\u05D5\u05E8 \u05DC\u05D4\u05D9\u05DB\u05E0\u05E1,
          \u05D5\u05D5\u05D0\u05DC\u05D4 \u05D4\u05D9\u05D4 \u05E0\u05E8\u05D0\u05D4
          \u05D0\u05D5\u05D5\u05D9\u05E8\u05D4."
        commands: []
    - rid: 2649295838973526070
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E2\u05DB\u05E9\u05D9\u05D5 \u05DB\u05D1\u05E8 \u05E9\u05E2\u05D5\u05D3
          \u05D7\u05D9\u05DB\u05D9\u05E0\u05D5, \u05D0\u05E0\u05D9 \u05E9\u05DD \u05DC\u05D1
          \u05E9\u05D4\u05E1\u05DC\u05E7\u05D8\u05D5\u05E8\u05D9\u05EA \u05E0\u05E8\u05D0\u05D9\u05EA
          \u05E4\u05E8\u05E6\u05D5\u05E3 \u05EA\u05D7\u05EA, \u05D7\u05DE\u05D5\u05E6\u05D4
          \u05DB\u05D6\u05D0\u05EA."
        commands: []
    - rid: 2649295838973526071
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D0\u05DE\u05E8\u05EA\u05D9 \u05D5\u05D5\u05D0\u05DC\u05D4
          \u05DE\u05D4 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA, \u05D4\u05D9\u05D0
          \u05DC\u05D0 \u05EA\u05E2\u05E9\u05D4 \u05DC\u05D9 \u05D1\u05E2\u05D9\u05D5\u05EA,
          \u05DE\u05D4 \u05D0\u05E0\u05D9 \u05E2\u05E8\u05D1\u05D9?"
        commands: []
    - rid: 2649295838973526072
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05D1\u05D9\u05DF \u05E9\u05D4\u05D9\u05D5
          \u05D1\u05E2\u05D9\u05D5\u05EA?"
        commands: []
    - rid: 2649295838973526073
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D7\u05D5\u05E9\u05E8\u05DE\u05D5\u05D8\u05D4. \u05D7\u05D9\u05DB\u05D9\u05E0\u05D5
          \u05D1\u05EA\u05D5\u05E8 \u05D0\u05D9\u05D6\u05D4 \u05E9\u05E2\u05D4, \u05D4\u05D9\u05D4
          \u05D0\u05D9\u05D6\u05D4 \u05E9\u05D1\u05D5\u05E8 \u05D0\u05D7\u05D3 \u05E9\u05E0\u05D9\u05E1\u05D4
          \u05DC\u05E2\u05E7\u05D5\u05E3 \u05D0\u05D5\u05EA\u05E0\u05D5, \u05D0\u05DE\u05E8\u05EA\u05D9
          \u05DC\u05D5 \u05E9\u05D9\u05DC\u05DA \u05DC\u05D4\u05D6\u05D3\u05D9\u05D9\u05DF."
        commands: []
    - rid: 2649295838973526074
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D5\u05D0 \u05D0\u05D5\u05DE\u05E8 \u05DC\u05D9 \"\u05DC\u05DE\u05D4
          \u05DE\u05D4 \u05E7\u05E8\u05D4?\"."
        commands: []
    - rid: 2649295838973526075
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \"\u05DE\u05D4 \u05E7\u05E8\u05D4\" \u05D9\u05D0 \u05DE\u05D6\u05D3\u05D9\u05D9\u05DF
          \u05D1\u05EA\u05D7\u05EA? \u05D7\u05E9\u05D1 \u05E9\u05E2\u05E9\u05D5 \u05D0\u05D5\u05EA\u05D9
          \u05D1\u05D0\u05E6\u05D1\u05E2. \u05D1\u05E1\u05D5\u05E3 \u05D0\u05DE\u05E8\u05EA\u05D9
          \u05DC\u05D5 \u05DC\u05E2\u05D5\u05E3 \u05D0\u05D7\u05D5\u05E8\u05D4, \u05D4\u05D5\u05D0
          \u05D4\u05EA\u05E7\u05E4\u05DC. \u05D9\u05E9 \u05DC\u05D5 \u05DE\u05D6\u05DC
          \u05E9\u05D4\u05D5\u05D0 \u05DC\u05D0 \u05E8\u05D0\u05D4 \u05D0\u05D5\u05EA\u05D9
          \u05E2\u05E6\u05D1\u05E0\u05D9, \u05D4\u05D9\u05D9\u05EA\u05D9 \u05D4\u05D5\u05E4\u05DA
          \u05D0\u05EA \u05DB\u05DC \u05D4\u05DE\u05E7\u05D5\u05DD \u05E2\u05DC\u05D9\u05D5."
        commands:
        - rid: 2649295838973526412
    - rid: 2649295838973526076
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05E1\u05D5\u05E3 \u05D4\u05D2\u05E2\u05E0\u05D5 \u05DC\u05DB\u05E0\u05D9\u05E1\u05D4,
          \u05D5\u05D5\u05D0\u05DC\u05D4 \u05D7\u05D3\u05D3 \u05D5\u05D0\u05D1\u05D9\u05E8\u05DD
          \u05E2\u05D1\u05E8\u05D5, \u05DC\u05D0 \u05E2\u05E9\u05EA\u05D4 \u05DC\u05D4\u05DD
          \u05D1\u05E2\u05D9\u05D5\u05EA."
        commands: []
    - rid: 2649295838973526077
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DB\u05D5\u05DC\u05D9 \u05D1\u05D0 \u05DC\u05D4\u05D9\u05DB\u05E0\u05E1,
          \u05E4\u05EA\u05D0\u05D5\u05DD \u05D4\u05D9\u05D0 \u05E2\u05D5\u05E6\u05E8\u05EA
          \u05D0\u05D5\u05EA\u05D9 \u05E2\u05DD \u05D4\u05D9\u05D3 \u05E9\u05DC\u05D4,
          \u05D5\u05D0\u05D5\u05DE\u05E8\u05EA \"\u05E8\u05D2\u05E2\"."
        commands: []
    - rid: 2649295838973526078
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E2\u05DB\u05E9\u05D9\u05D5 \u05D4\u05D9\u05D0, \u05D2\u05DD \u05DB\u05DF
          \u05D6\u05D0\u05EA\u05D9, \u05DE\u05E1\u05EA\u05DB\u05DC\u05EA \u05E2\u05DC\u05D9\u05D9
          \u05DB\u05DE\u05D4 \u05E9\u05E0\u05D9\u05D5\u05EA, \u05D5\u05D0\u05D5\u05DE\u05E8\u05EA
          \"\u05DC\u05D0\" \u05D5\u05DE\u05E1\u05DE\u05E0\u05EA \u05DC\u05D9 \u05DC\u05DC\u05DB\u05EA."
        commands: []
    - rid: 2649295838973526079
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D0\u05D5\u05DE\u05E8 \u05DC\u05D4 \"\u05DC\u05DE\u05D4
          \u05DB\u05DB\u05D4?\"."
        commands: []
    - rid: 2649295838973526080
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05DE\u05D4 \u05D4\u05D9\u05D0 \u05D0\u05D5\u05DE\u05E8\u05EA
          \u05DC\u05D9 \u05D4\u05E9\u05DE\u05D0\u05DC\u05E0\u05D9\u05EA \u05D4\u05E9\u05E8\u05DE\u05D5\u05D8\u05D4?
          \u05D4\u05D9\u05D0 \u05D0\u05D5\u05DE\u05E8\u05EA \u05DC\u05D9 \"\u05DC\u05DA
          \u05D0\u05D5 \u05E9\u05D0\u05E0\u05D9 \u05E7\u05D5\u05E8\u05D0\u05EA \u05DC\u05D0\u05D1\u05D8\u05D7\u05D4\"."
        commands: []
    - rid: 2649295838973526081
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E2\u05DB\u05E9\u05D9\u05D5 \u05E7\u05D5\u05D3\u05DD \u05DB\u05DC
          \u05D0\u05E0\u05D9 \u05DE\u05E4\u05E8\u05E7 \u05D0\u05EA \u05D4\u05D0\u05D1\u05D8\u05D7\u05D4
          \u05D4\u05D0\u05DC\u05D4 \u05D0\u05DD \u05E6\u05E8\u05D9\u05DA, \u05D0\u05D1\u05DC
          \u05DE\u05D4 \u05D0\u05D1\u05D8\u05D7\u05D4 \u05E2\u05DB\u05E9\u05D9\u05D5
          \u05D9\u05D0 \u05D7\u05EA\u05D9\u05DB\u05EA \u05D6\u05D5\u05E0\u05D4?"
        commands:
        - rid: 2649295838973526413
    - rid: 2649295838973526082
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D4\u05D9\u05D0 \u05D7\u05D5\u05E9\u05D1\u05EA \u05D0\u05E0\u05D9
          \u05D0\u05E2\u05E9\u05D4 \u05DC\u05D4 \u05D1\u05E2\u05D9\u05D5\u05EA \u05D1\u05E4\u05E0\u05D9\u05DD?
          \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05E0\u05DB\u05E0\u05E1 \u05DC\u05E8\u05D9\u05D1\u05D9\u05DD
          \u05D0\u05E3 \u05E4\u05E2\u05DD \u05D7\u05D5\u05E5 \u05DE\u05D4\u05D1\u05DF
          \u05D6\u05D5\u05E0\u05D4 \u05E9\u05E0\u05D9\u05E1\u05D4 \u05DC\u05E2\u05E7\u05D5\u05E3
          \u05D0\u05D5\u05EA\u05D9 \u05D1\u05EA\u05D5\u05E8."
        commands: []
    - rid: 2649295838973526083
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D0\u05E0\u05D9 \u05D1\u05E9\u05DC\u05D1 \u05D4\u05D6\u05D4
          \u05E2\u05D5\u05D3 \u05D1\u05D0\u05EA\u05D9 \u05D1\u05D8\u05D5\u05D1, \u05D0\u05E0\u05D9
          \u05D0\u05D5\u05DE\u05E8 \u05DC\u05D4 \u05E9\u05D4\u05D7\u05D1\u05E8'\u05D4
          \u05E9\u05DC\u05D9 \u05DB\u05D1\u05E8 \u05D1\u05E4\u05E0\u05D9\u05DD, \u05E9\u05EA\u05D4\u05D9\u05D4
          \u05D2\u05D1\u05E8\u05EA \u05D5\u05EA\u05DB\u05E0\u05D9\u05E1 \u05D0\u05D5\u05EA\u05D9."
        commands: []
    - rid: 2649295838973526084
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D5\u05D5\u05D0\u05DC\u05D4 \u05D4\u05E9\u05E8\u05DE\u05D5\u05D8\u05D4
          \u05DC\u05D0 \u05D4\u05E1\u05DB\u05D9\u05DE\u05D4 \u05DC\u05DB\u05DC\u05D5\u05DD.
          \u05E2\u05D5\u05D3 \u05E9\u05E0\u05D9\u05D9\u05D4 \u05D4\u05D1\u05D0\u05EA\u05D9
          \u05DC\u05D4 \u05D0\u05D9\u05D6\u05D5 \u05D0\u05D7\u05EA, \u05D9\u05E9
          \u05DC\u05D4 \u05DE\u05D6\u05DC \u05E9\u05D4\u05D9\u05D0 \u05D4\u05D9\u05D9\u05EA\u05D4
          \u05DB\u05D5\u05E1\u05D9\u05EA."
        commands: []
    - rid: 2649295838973526085
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D9\u05E9 \u05DC\u05D9 \u05EA\u05D7\u05D5\u05E9\u05D4 \u05E9\u05D2\u05DD
          \u05DC\u05D5 \u05D9\u05E9 \u05DE\u05D6\u05DC \u05E9\u05D4\u05D5\u05D0 \u05DC\u05D0
          \u05D4\u05D1\u05D9\u05D0 \u05DC\u05D4 \u05D0\u05D9\u05D6\u05D5 \u05D0\u05D7\u05EA\u2026)"
        commands: []
    - rid: 2649295838973526086
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05D0\u05E0\u05D9 \u05DB\u05D1\u05E8
          \u05D4\u05EA\u05D7\u05DC\u05EA\u05D9 \u05DC\u05D4\u05EA\u05E2\u05E6\u05D1\u05DF.
          \u05D7\u05D3\u05D3 \u05D5\u05D0\u05D1\u05D9\u05E8\u05DD \u05DB\u05D1\u05E8
          \u05D1\u05E4\u05E0\u05D9\u05DD \u05E9\u05E2\u05D4, \u05D1\u05D8\u05D7 \u05DE\u05D6\u05E8\u05D9\u05DE\u05D9\u05DD
          \u05DB\u05D5\u05E1\u05D9\u05D5\u05EA \u05D5\u05D0\u05E0\u05D9 \u05EA\u05E7\u05D5\u05E2
          \u05D1\u05D7\u05D5\u05E5 \u05DB\u05DE\u05D5 \u05D1\u05DF \u05D6\u05D5\u05E0\u05D4."
        commands: []
    - rid: 2649295838973526087
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05E2\u05D5\u05D3 \u05D1\u05D0\u05EA\u05D9 \u05E8\u05D2\u05D5\u05E2
          \u05D1\u05D0\u05D5\u05EA\u05D5 \u05D9\u05D5\u05DD, \u05EA\u05D0\u05DE\u05D9\u05DF
          \u05DC\u05D9 \u05D1\u05D9\u05D5\u05DD \u05D0\u05D7\u05E8 \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05DE\u05E4\u05E8\u05E7 \u05E9\u05DD \u05D0\u05EA \u05D4\u05DB\u05DC."
        commands: []
    - rid: 2649295838973526088
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05DE\u05D4 \u05E2\u05E9\u05D9\u05EA \u05D1\u05E1\u05D5\u05E3?"
        commands: []
    - rid: 2649295838973526089
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05DB\u05D1\u05E8 \u05D4\u05D5\u05E6\u05D9\u05D0\u05D4
          \u05DC\u05D9 \u05D0\u05EA \u05D4\u05D7\u05E9\u05E7 \u05D4\u05E9\u05E8\u05DE\u05D5\u05D8\u05D4.
          \u05D4\u05DC\u05DB\u05EA\u05D9 \u05DC\u05E6\u05D3 \u05D5\u05D4\u05EA\u05E7\u05E9\u05E8\u05EA\u05D9
          \u05DC\u05D7\u05D3\u05D3. \u05D4\u05D5\u05D0 \u05D1\u05D3\u05D9\u05D5\u05E7
          \u05D3\u05D9\u05D1\u05E8 \u05E2\u05DD \u05D0\u05D9\u05D6\u05D4 \u05DE\u05D9\u05E9\u05D4\u05D9,
          \u05E9\u05DB\u05E0\u05E2\u05EA\u05D9 \u05D0\u05D5\u05EA\u05D5 \u05E9\u05D9\u05D6\u05E8\u05D9\u05DD
          \u05D0\u05D5\u05EA\u05D4 \u05D4\u05D7\u05D5\u05E6\u05D4."
        commands: []
    - rid: 2649295838973526090
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05D9\u05E8\u05DD \u05E0\u05E9\u05D0\u05E8, \u05D4\u05DE\u05E1\u05DB\u05DF
          \u05D4\u05D6\u05D4. \u05D0\u05D1\u05DC \u05D0\u05E0\u05D9 \u05D5\u05D7\u05D3\u05D3
          \u05D4\u05DC\u05DB\u05E0\u05D5 \u05D0\u05D9\u05EA\u05D4 \u05DC\u05D0\u05D9\u05D6\u05D4
          \u05DE\u05D5\u05E2\u05D3\u05D5\u05DF \u05D1\u05E8\u05D0\u05E9\u05D5\u05DF.
          \u05D5\u05D5\u05D0\u05DC\u05D4 \u05D4\u05D9\u05D4 \u05D4\u05E6\u05D2\u05D4."
        commands: []
    - rid: 2649295838973526091
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D0\u05E0\u05D9 \u05DE\u05D1\u05D9\u05DF \u05E9\u05D4\u05E1\u05EA\u05D3\u05E8\u05EA\u05DD
          \u05D1\u05E1\u05D5\u05E3?"
        commands: []
    - rid: 2649295838973526092
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05DB\u05DF. \u05D1\u05D0\u05DE\u05D0
          \u05E9\u05DC\u05D9 \u05D6\u05D4 \u05D4\u05D9\u05D4 \u05D7\u05E8\u05D0 \u05DE\u05E7\u05D5\u05DD
          \u05D4\u05DE\u05D5\u05E2\u05D3\u05D5\u05DF \u05D4\u05D6\u05D4 \u05E2\u05DD
          \u05D4\u05E9\u05E8\u05DE\u05D5\u05D8\u05D4. \u05D0\u05D1\u05D9\u05E8\u05DD
          \u05D0\u05DE\u05E8 \u05E9\u05D4\u05D5\u05D0 \u05D4\u05D9\u05D4 \u05E6\u05E8\u05D9\u05DA
          \u05DC\u05D1\u05D5\u05D0 \u05D0\u05D9\u05EA\u05E0\u05D5."
        commands: []
    - rid: 2649295838973526093
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D5\u05D0 \u05E0\u05E9\u05D0\u05E8 \u05E9\u05DD \u05D1\u05E9\u05D1\u05D9\u05DC
          \u05D0\u05D9\u05D6\u05D4 \u05DE\u05D9\u05E9\u05D4\u05D9, \u05E9\u05DC\u05D7
          \u05DC\u05E0\u05D5 \u05EA\u05DE\u05D5\u05E0\u05D4, \u05E1\u05EA\u05DD \u05DE\u05D2\u05E2\u05D9\u05DC\u05D4.
          \u05D9\u05E6\u05D0 \u05D9\u05DC\u05D3."
        commands: []
    - rid: 2649295838973526094
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05E8\u05D0\u05E9\u05D5\u05DF \u05D4\u05D9\u05D4 \u05D0\u05D7\u05DC\u05D4,
          \u05D5\u05D7\u05E6\u05D9 \u05DE\u05D7\u05D9\u05E8. \u05D5\u05D5\u05D0\u05DC\u05D4
          \u05D0\u05D9\u05DB\u05D5\u05EA."
        commands: []
    - rid: 2649295838973526095
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E1\u05D5\u05E3 \u05D8\u05D5\u05D1 \u05D4\u05DB\u05DC \u05D8\u05D5\u05D1\u2026.)"
        commands: []
    - rid: 2649295838973526096
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D1\u05E8\u05D2\u05E8, \u05D0\u05EA\u05D4 \u05D7\u05D9\u05D9\u05D1
          \u05DC\u05D1\u05D5\u05D0 \u05DE\u05EA\u05D9\u05E9\u05D4\u05D5. \u05DB\u05E9\u05D9\u05D5\u05E6\u05D0\u05D9\u05DD
          \u05DE\u05E4\u05D4, \u05D0\u05EA\u05D4 \u05D1\u05D0 \u05D0\u05D9\u05EA\u05D9
          \u05D5\u05E2\u05DD \u05D7\u05D3\u05D3 \u05DC\u05DE\u05D5\u05E2\u05D3\u05D5\u05DF."
        commands: []
    - rid: 2649295838973526097
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05E9\u05D0\u05E0\u05D7\u05E0\u05D5 \u05D9\u05D5\u05E6\u05D0\u05D9\u05DD
          \u05DE\u05E4\u05D4, \u05DE\u05D4 \u05E9\u05D0\u05EA\u05D4 \u05E8\u05D5\u05E6\u05D4\u2026"
        commands: []
    - rid: 2649295838973526098
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05D0\u05DC\u05DC\u05D4."

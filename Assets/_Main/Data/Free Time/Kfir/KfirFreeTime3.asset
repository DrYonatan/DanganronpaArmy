        - rid: 2649295838973526318
    - rid: 2649295838973526292
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05E4\u05D4 \u05DC\u05E9\u05DD \u05DE\u05E6\u05D0\u05EA\u05D9
          \u05D0\u05EA \u05E2\u05E6\u05DE\u05D9 \u05E2\u05DD \u05D0\u05D9\u05D6\u05D5
          \u05E9\u05D1\u05D5\u05E8\u05D4 \u05D0\u05D7\u05EA \u05D1\u05EA \u05E9\u05DC\u05D5\u05E9\u05D9\u05DD."
        commands: []
    - rid: 2649295838973526293
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2 \u05D0\u05D9\u05DA \u05D4\u05D2\u05E2\u05EA\u05D9
          \u05DC\u05E9\u05DD, \u05D0\u05D1\u05DC \u05E0\u05E8\u05D0\u05D4 \u05E9\u05D4\u05D9\u05D9\u05EA\u05D9
          \u05D1\u05D1\u05D9\u05EA \u05E9\u05DC\u05D4 \u05DB\u05DE\u05D4 \u05E9\u05E2\u05D5\u05EA,
          \u05E0\u05E8\u05D0\u05D4 \u05DB\u05D0\u05D9\u05DC\u05D5 \u05EA\u05DB\u05E0\u05E0\u05D5
          \u05DC\u05D4\u05D6\u05D3\u05D9\u05D9\u05DF. \u05D0\u05E0\u05D9 \u05DE\u05E7\u05D5\u05D5\u05D4
          \u05E9\u05DC\u05D0 \u05DB\u05D1\u05E8 \u05E2\u05E9\u05D9\u05E0\u05D5 \u05D0\u05EA
          \u05D6\u05D4."
        commands: []
    - rid: 2649295838973526294
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D4 \u05E0\u05D4\u05D9\u05D4 \u05D2\u05E8\u05D5\u05E2 \u05DE\u05E8\u05D2\u05E2

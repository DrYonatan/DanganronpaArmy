        commands: []
    - rid: 2649295838973526304
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D5\u05DC\u05D9 \u05D1\u05D0\u05DE\u05EA \u05D4\u05D9\u05D9\u05EA

        commands: []
    - rid: 2649295838973526295
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05D1\u05D3\u05E8\u05DA \u05DB\u05DC\u05DC
          \u05DC\u05D0 \u05D4\u05D9\u05D9\u05EA\u05D4 \u05DC\u05D9 \u05D1\u05E2\u05D9\u05D4.
          \u05EA\u05D0\u05E8 \u05DC\u05DA \u05DE\u05D4 \u05D6\u05D4 \u05DC\u05D6\u05D9\u05D9\u05DF
          \u05D1\u05EA \u05E9\u05DC\u05D5\u05E9\u05D9\u05DD \u05DC\u05D9\u05DC\u05D3
          \u05D1\u05DB\u05D9\u05EA\u05D4 \u05D9\"\u05D0."
        commands: []
    - rid: 2649295838973526296
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D5\u05D5\u05D0\u05DC\u05D4 \u05D4\u05D9\u05D0
          \u05D4\u05D9\u05D9\u05EA\u05D4 \u05DB\u05D5\u05E0\u05D0\u05E4\u05D4 \u05DE\u05E9\u05D4\u05D5
          \u05D3\u05E4\u05D5\u05E7."
        commands: []
    - rid: 2649295838973526297
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05D9\u05E1\u05D9\u05EA\u05D9 \u05DC\u05E6\u05D0\u05EA \u05DE\u05D6\u05D4
          \u05D1\u05D3\u05D9\u05D1\u05D5\u05E8\u05D9\u05DD. \u05D0\u05DE\u05E8\u05EA\u05D9
          \u05DC\u05D4 \u05E9\u05D0\u05E0\u05D9 \u05E8\u05D5\u05E6\u05D4 \u05DC\u05DC\u05DB\u05EA."
        commands: []
    - rid: 2649295838973526298
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D0\u05D6 \u05D4\u05D9\u05D0 \u05D0\u05D5\u05DE\u05E8\u05EA
          \u05DC\u05D9 \"\u05DE\u05D4?\". \u05D0\u05DE\u05E8\u05EA\u05D9 \u05DC\u05D4
          \u05E9\u05D5\u05D1 \u05E9\u05D0\u05E0\u05D9 \u05E8\u05D5\u05E6\u05D4 \u05DC\u05DC\u05DB\u05EA,
          \u05D5\u05D4\u05D9\u05D0 \u05D0\u05DE\u05E8\u05D4 \"\u05DE\u05D4?\"..."
        commands: []
    - rid: 2649295838973526299
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05E9\u05DC\u05D1 \u05D4\u05D6\u05D4 \u05DB\u05D1\u05E8 \u05D4\u05EA\u05D7\u05DC\u05EA\u05D9
          \u05DC\u05D4\u05EA\u05E2\u05E6\u05D1\u05DF, \u05DE\u05D4 \u05D9\u05E9 \u05DC\u05D4
          \u05D6\u05D0\u05EA\u05D9, \u05D2\u05DD \u05DB\u05D5\u05E0\u05D0\u05E4\u05D4
          \u05D5\u05D2\u05DD \u05DE\u05E4\u05D2\u05E8\u05EA?"
        commands: []
    - rid: 2649295838973526300
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05D0\u05D6 \u05E7\u05DC\u05D8\u05EA\u05D9 \u05E9\u05D1\u05E2\u05E6\u05DD
          \u05D0\u05DE\u05E8\u05EA\u05D9 \u05DC\u05D4 \u05E9\u05D0\u05E0\u05D9 \u05E8\u05D5\u05E6\u05D4
          \u05E8\u05D2\u05D6\u05EA. \u05D4\u05D9\u05D9\u05EA\u05D9 \u05DE\u05E1\u05D8\u05D5\u05DC
          \u05DE\u05EA, \u05DC\u05D0 \u05E7\u05DC\u05D8\u05EA\u05D9 \u05DE\u05D4
          \u05D0\u05E0\u05D9 \u05D0\u05D5\u05DE\u05E8 \u05D1\u05DB\u05DC\u05DC."
        commands: []
    - rid: 2649295838973526301
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D4\u05E1\u05D1\u05E8\u05EA\u05D9 \u05DC\u05D4 \u05DE\u05D4
          \u05D0\u05E0\u05D9 \u05E8\u05D5\u05E6\u05D4, \u05D5\u05D4\u05E4\u05E2\u05DD
          \u05D4\u05D9\u05D0 \u05D4\u05D1\u05D9\u05E0\u05D4. \u05D0\u05D1\u05DC \u05D5\u05D5\u05D0\u05DC\u05D4
          \u05D4\u05D9\u05D0 \u05DC\u05D0 \u05D4\u05D9\u05D9\u05EA\u05D4 \u05DE\u05E8\u05D5\u05E6\u05D4."
        commands: []
    - rid: 2649295838973526302
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E4\u05EA\u05D0\u05D5\u05DD \u05D4\u05D9\u05D0 \u05D0\u05D5\u05DE\u05E8\u05EA

    - rid: 2649295838973526308
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D9\u05E0\u05EA\u05D9\u05D9\u05DD \u05D4\u05E9\u05E8\u05DE\u05D5\u05D8\u05D4
          \u05D4\u05D6\u05D0\u05EA \u05DE\u05EA\u05D7\u05D9\u05DC\u05D4 \u05DC\u05D4\u05EA\u05E4\u05E7\u05E2
          \u05DE\u05E6\u05D7\u05D5\u05E7. \u05E2\u05D5\u05D3 \u05E8\u05D2\u05E2 \u05D4\u05D5\u05E8\u05D3\u05EA\u05D9
          \u05DC\u05D4 \u05D0\u05D9\u05D6\u05D5 \u05D0\u05D7\u05EA \u05D1\u05E8\u05D0\u05E9."
        commands: []
    - rid: 2649295838973526309
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05E1\u05D5\u05E3 \u05D0\u05D7\u05E8\u05D9 \u05DB\u05DE\u05D4
          \u05E9\u05E2\u05D5\u05EA \u05D4\u05E6\u05DC\u05D7\u05EA\u05D9 \u05DC\u05DC\u05DB\u05EA
          \u05D4\u05D1\u05D9\u05EA\u05D4 \u05D5\u05E0\u05D8\u05E8\u05E7\u05EA\u05D9
          \u05E2\u05DC \u05D4\u05DE\u05D9\u05D8\u05D4."
        commands: []
    - rid: 2649295838973526310
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05DE\u05D4 \u05E9\u05E2\u05D5\u05EA?!)"
        commands:
        - rid: 2649295838973526321
    - rid: 2649295838973526311
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05D0\u05D7\u05E8\u05D9 \u05D6\u05D4
          \u05D4\u05D9\u05D4 \u05DC\u05D9 \u05D4\u05D0\u05E0\u05D2\u05D0\u05D5\u05D1\u05E8
          \u05E9\u05DC \u05D4\u05D7\u05D9\u05D9\u05DD. \u05D0\u05D9\u05D6\u05D4 \u05E1\u05D8\u05DC\u05D4
          \u05E8\u05E2\u05D4\u2026"
        commands: []
    - rid: 2649295838973526312
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05D5\u05D3\u05E8 \u05E9\u05D7\u05E9\u05D1\u05EA\u05D9 \u05E9\u05D0\u05E0\u05D9
          \u05DC\u05D0 \u05D0\u05E9\u05EA\u05D4 \u05D0\u05DC\u05DB\u05D5\u05D4\u05D5\u05DC
          \u05D0\u05D7\u05E8\u05D9 \u05D6\u05D4."
        commands: []
    - rid: 2649295838973526313
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9 \u05E9\u05D4\u05D5\u05D0 \u05D9\u05E8\u05D3
          \u05DE\u05D4\u05E8\u05E2\u05D9\u05D5\u05DF \u05D4\u05D6\u05D4 \u05D3\u05D9
          \u05DE\u05D4\u05E8\u2026)"
        commands: []
    - rid: 2649295838973526314
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05D0\u05DC\u05DC\u05D4 \u05D1\u05E8\u05D2\u05E8, \u05E0\u05E8\u05D0\u05D4
          \u05D0\u05D5\u05EA\u05DA."

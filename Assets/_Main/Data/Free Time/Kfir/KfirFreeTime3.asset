    - rid: 2649295838973526264
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05EA\u05D2\u05D9\u05D3 \u05D1\u05E8\u05D2\u05E8, \u05D0\u05EA\u05D4
          \u05DE\u05E2\u05E9\u05DF?"
        commands:
        - rid: 2649295838973526316
    - rid: 2649295838973526265
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0, \u05DC\u05DE\u05D4 \u05D0\u05E0\u05D9 \u05E0\u05E8\u05D0\u05D4
          \u05DB\u05DE\u05D5 \u05DB\u05D6\u05D4 \u05E9\u05DE\u05E2\u05E9\u05DF\u2026?"
        commands: []
    - rid: 2649295838973526266
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2, \u05E9\u05D0\u05DC\u05EA\u05D9
          \u05DE\u05E0\u05D9\u05DE\u05D5\u05E1. \u05DE\u05D4, \u05D0\u05E4\u05D9\u05DC\u05D5
          \u05DC\u05D0 \u05E0\u05E8\u05D2\u05D9\u05DC\u05D4 \u05D1\u05D9\u05E9\u05D9\u05D1\u05D5\u05EA,
          \u05DB\u05DC\u05D5\u05DD?"
        commands: []
    - rid: 2649295838973526267
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DF \u05E0\u05E8\u05D2\u05D9\u05DC\u05D5\u05EA \u05D1\u05D9\u05E9\u05D9\u05D1\u05D5\u05EA
          \u05E9\u05D0\u05E0\u05D9 \u05DE\u05D2\u05D9\u05E2 \u05D0\u05DC\u05D9\u05D4\u05DF\u2026"
        commands: []
    - rid: 2649295838973526268
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D0\u05EA\u05D4 \u05DE\u05D6\u05D9\u05D9\u05DF. \u05D0\u05D6
          \u05DE\u05D4 \u05D9\u05D5\u05E9\u05D1\u05D9\u05DD \u05E8\u05E7 \u05E2\u05DC
          \u05D0\u05DC\u05DB\u05D5\u05D4\u05D5\u05DC?"
        commands: []
    - rid: 2649295838973526269
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D2\u05DD \u05D6\u05D4 \u05D1\u05D3\u05E8\u05DA \u05DB\u05DC\u05DC
          \u05DC\u05D0\u2026"
        commands: []
    - rid: 2649295838973526270
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05D5\u05D3\u05E8 \u05D0\u05D9\u05D6\u05D4 \u05D0\u05E9\u05DB\u05E0\u05D6\u05D9
          \u05D0\u05EA\u05D4 \u05D1\u05E8\u05D2\u05E8. \u05D5\u05D5\u05D0\u05DC\u05D4
          \u05D7\u05D9\u05D9\u05D1 \u05DC\u05DE\u05E1\u05D8\u05DC \u05D0\u05D5\u05EA\u05DA."
        commands: []
    - rid: 2649295838973526271
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05EA\u05E7\u05E9\u05D9\u05D1 \u05DC\u05D9, \u05DB\u05E9\u05D0\u05E0\u05D7\u05E0\u05D5
          \u05D9\u05D5\u05E6\u05D0\u05D9\u05DD \u05DE\u05E4\u05D4 \u05D0\u05E0\u05D9
          \u05DC\u05D5\u05E7\u05D7 \u05D0\u05D5\u05EA\u05DA \u05DC\u05D1\u05E8 \u05D1\u05E8\u05D0\u05E9\u05D5\u05DF,
          \u05DE\u05E9\u05D4\u05D5 \u05DE\u05DC\u05D7\u05D9\u05E5. \u05D0\u05EA\u05D4
          \u05D4\u05D5\u05DC\u05DA \u05DC\u05D0\u05DB\u05D5\u05DC \u05E9\u05DD \u05E1\u05D8\u05DC\u05D4
          \u05D7\u05E8\u05D1\u05D5\u05EA \u05DB\u05DE\u05D5 \u05E9\u05DC\u05D0 \u05D4\u05DB\u05E8\u05EA."
        commands: []
    - rid: 2649295838973526272
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05D7\u05DB\u05D4 \u05D1\u05E7\u05D5\u05E6\u05E8
          \u05E8\u05D5\u05D7\u2026"
        commands: []
    - rid: 2649295838973526273
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05DE\u05E7\u05D5\u05DD \u05D0\u05D9\u05DB\u05D5\u05EA,
          \u05E0\u05D5\u05D3\u05E8. \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05DC\u05D5\u05E7\u05D7
          \u05D0\u05D5\u05EA\u05DA \u05DC\u05DE\u05E7\u05D5\u05DD \u05E9\u05DC \u05D7\u05D5\u05E8\u05D0\u05E0\u05D9\u05DD.
          \u05E9\u05DE\u05E2 \u05D4\u05D9\u05D4 \u05DC\u05D9 \u05DC\u05D0 \u05DE\u05D6\u05DE\u05DF
          \u05DE\u05E7\u05E8\u05D4 \u05DC\u05D0 \u05E0\u05E2\u05D9\u05DD \u05D1\u05D0\u05D9\u05D6\u05D4
          \u05D7\u05D5\u05E8 \u05D1\u05D0\u05E9\u05D3\u05D5\u05D3 \u05E9\u05D7\u05D1\u05E8
          \u05E9\u05DC\u05D9 \u05D2\u05E8\u05E8 \u05D0\u05D5\u05EA\u05D9. \u05D0\u05DB\u05DC\u05EA\u05D9
          \u05E9\u05DD \u05E1\u05D8\u05DC\u05D4 \u05DE\u05E9\u05D4\u05D5 \u05DC\u05D0
          \u05E0\u05E2\u05D9\u05DD."
        commands: []
    - rid: 2649295838973526274
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05E7\u05D0\u05EA\u05D9 \u05E9\u05DD \u05E2\u05DC \u05DB\u05DC
          \u05D4\u05DE\u05E7\u05D5\u05DD, \u05E7\u05E8\u05E1\u05EA\u05D9. \u05DC\u05D0
          \u05D4\u05D9\u05D4 \u05DB\u05D9\u05E3."
        commands: []
    - rid: 2649295838973526275
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05D6\u05D4 \u05D4\u05E1\u05D8\u05DC\u05D4
          \u05D4\u05DB\u05D9 \u05E8\u05E2\u05D4 \u05E9\u05D4\u05D9\u05D9\u05EA\u05D4
          \u05DC\u05D9 \u05E9\u05E0\u05D9\u05DD, \u05DE\u05D0\u05D6 \u05D9\"\u05D0.
          \u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9 \u05D4\u05E9\u05E8\u05DE\u05D5\u05D8\u05D5\u05EA
          \u05D4\u05D1\u05D9\u05D0\u05D5 \u05DC\u05E0\u05D5 \u05D0\u05DC\u05DB\u05D5\u05D4\u05D5\u05DC
          \u05DE\u05D6\u05D5\u05D9\u05E3 \u05D0\u05D5 \u05DE\u05E9\u05D4\u05D5."
        commands: []
    - rid: 2649295838973526276
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E9\u05DE\u05D5 \u05DC\u05E0\u05D5 \u05D6\u05E4\u05EA \u05D0\u05D5
          \u05DE\u05E9\u05D4\u05D5 \u05D4\u05D6\u05D5\u05E0\u05D5\u05EA."
        commands: []
    - rid: 2649295838973526277
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05D4\u05D9\u05D4 \u05D1\u05D9\"\u05D0?"
        commands:
        - rid: 2649295838973526317
    - rid: 2649295838973526278
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05DE\u05E9\u05D4\u05D5 \u05E8\u05E2."
        commands: []
    - rid: 2649295838973526279
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D9\u05D9\u05EA\u05D9 \u05D1\u05D0\u05D9\u05D6\u05D4 \u05DE\u05E1\u05D9\u05D1\u05D4
          \u05E2\u05DD \u05D4\u05D7\u05D1\u05E8'\u05D4, \u05D5\u05D5\u05D0\u05DC\u05D4
          \u05D4\u05D9\u05D4 \u05D1\u05DF \u05D6\u05D5\u05E0\u05D4. \u05D0\u05D1\u05DC
          \u05D4\u05D9\u05D4 \u05E9\u05DD \u05DE\u05DC\u05D0 \u05D0\u05DC\u05DB\u05D5\u05D4\u05D5\u05DC,
          \u05D5\u05D0\u05E0\u05D9 \u05D4\u05D9\u05D9\u05EA\u05D9 \u05D9\u05DC\u05D3
          \u05D0\u05D6."
        commands: []
    - rid: 2649295838973526280
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E9\u05EA\u05D9\u05EA\u05D9 \u05DB\u05DE\u05D5\u05D9\u05D5\u05EA,
          \u05DC\u05D0 \u05E9\u05DE\u05EA\u05D9 \u05DC\u05D1 \u05D1\u05DB\u05DC\u05DC
          \u05DE\u05D4 \u05D0\u05E0\u05D9 \u05E9\u05D5\u05EA\u05D4."
        commands: []
    - rid: 2649295838973526281
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D4\u05EA\u05D7\u05DC\u05D4 \u05D4\u05D9\u05D4 \u05E4\u05E0\u05D0\u05DF,
          \u05D5\u05D5\u05D0\u05DC\u05D4 \u05E6\u05D7\u05E7\u05EA\u05D9, \u05E8\u05E7\u05D3\u05EA\u05D9,
          \u05E2\u05D9\u05E9\u05E0\u05EA\u05D9, \u05DE\u05D4 \u05DC\u05D0 \u05E2\u05E9\u05D9\u05EA\u05D9.
          \u05D0\u05D1\u05DC \u05D1\u05D0\u05D9\u05D6\u05D4 \u05E9\u05DC\u05D1, \u05D0\u05D9\u05D1\u05D3\u05EA\u05D9
          \u05D0\u05EA \u05D6\u05D4 \u05DC\u05D2\u05DE\u05E8\u05D9."
        commands: []
    - rid: 2649295838973526282
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D6\u05D5\u05DB\u05E8 \u05D1\u05DB\u05DC\u05DC
          \u05DE\u05D4 \u05E7\u05E8\u05D4 \u05D0\u05D9\u05D6\u05D4 \u05E9\u05E2\u05EA\u05D9\u05D9\u05DD,
          \u05D3\u05D1\u05E8 \u05D4\u05D1\u05D0 \u05E9\u05D0\u05E0\u05D9 \u05D6\u05D5\u05DB\u05E8,
          \u05D4\u05D9\u05D9\u05EA\u05D9 \u05D1\u05DE\u05E8\u05E4\u05E1\u05EA \u05E2\u05DD
          \u05D0\u05D9\u05D6\u05D4 \u05D7\u05D1\u05E8, \u05DE\u05E7\u05D9\u05D0 \u05EA'\u05E0\u05E9\u05DE\u05D4."
        commands: []
    - rid: 2649295838973526283
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05E4\u05D7\u05D5\u05EA \u05D4\u05D9\u05D4 \u05D0\u05D9\u05EA\u05DA
          \u05D7\u05D1\u05E8\u2026"
        commands: []
    - rid: 2649295838973526284
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05D0\u05D7 \u05D9\u05E7\u05E8. \u05D4\u05D5\u05D0
          \u05E2\u05DE\u05D3 \u05DC\u05D9\u05D3\u05D9 \u05DC\u05D5\u05D5\u05D3\u05D0
          \u05E9\u05D0\u05E0\u05D9 \u05D1\u05E1\u05D3\u05E8. \u05D4\u05E8\u05D2\u05E9\u05EA\u05D9
          \u05DB\u05DE\u05D5 \u05DB\u05D5\u05E1\u05D9\u05EA, \u05DE\u05E7\u05D9\u05D0
          \u05DE\u05D0\u05DC\u05DB\u05D5\u05D4\u05D5\u05DC."
        commands: []
    - rid: 2649295838973526285
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D7\u05E8\u05D9 \u05D6\u05D4 \u05DC\u05D0 \u05D9\u05D3\u05E2\u05EA\u05D9
          \u05DE\u05D9 \u05D0\u05E0\u05D9 \u05D5\u05DE\u05D4 \u05D0\u05E0\u05D9."
        commands: []
    - rid: 2649295838973526286
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05E0\u05E2\u05D9\u05DD\u2026"
        commands: []
    - rid: 2649295838973526287
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D7\u05D5\u05E9\u05E8\u05DE\u05D5\u05D8\u05D4. \u05D0\u05D1\u05DC
          \u05D0\u05D7\u05E8\u05D9 \u05D0\u05D9\u05D6\u05D4 \u05E9\u05E2\u05EA\u05D9\u05D9\u05DD
          \u05D4\u05EA\u05D7\u05DC\u05EA\u05D9 \u05DC\u05D4\u05E8\u05D2\u05D9\u05E9
          \u05D9\u05D5\u05EA\u05E8 \u05D8\u05D5\u05D1, \u05D5\u05D5\u05D0\u05DC\u05D4
          \u05D7\u05E9\u05D1\u05EA\u05D9 \u05D6\u05D4 \u05DE\u05D0\u05D7\u05D5\u05E8\u05D9\u05D9."
        commands: []
    - rid: 2649295838973526288
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u2026\u05D6\u05D4 \u05DC\u05D0 \u05D4\u05D9\u05D4?"

      data:
        text: "\u05D1\u05E9\u05DC\u05D1 \u05D4\u05D6\u05D4 \u05D6\u05D4 \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05E8\u05E7 \u05D0\u05E0\u05D9 \u05DE\u05D5\u05DC \u05D4\u05DB\u05D5\u05E1\u05D9\u05EA,
          \u05D4\u05DB\u05DC\u05D1\u05D4 \u05D4\u05D7\u05D1\u05E8\u05D4 \u05E9\u05DC\u05D4,
          \u05D4\u05D7\u05D1\u05E8\u05D4 \u05D4\u05E9\u05DC\u05D9\u05E9\u05D9\u05EA
          \u05E9\u05E9\u05D5\u05EA\u05E7\u05EA \u05DB\u05DE\u05D5 \u05D3\u05D2, \u05D5\u05D4\u05E7\u05D5\u05E7\u05E1\u05D9\u05E0\u05DC."
        commands: []
    - rid: 2649295838973526193
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DE\u05E2\u05D8\u05D9\u05DD \u05DE\u05D5\u05DC \u05E8\u05D1\u05D9\u05DD\u2026)"
        commands: []
    - rid: 2649295838973526194
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E2\u05DB\u05E9\u05D9\u05D5 \u05E9\u05D4\u05D9\u05D0 \u05DE\u05E6\u05DC\u05DE\u05EA,
          \u05DC\u05D0 \u05D4\u05D9\u05D4 \u05DC\u05D9 \u05D4\u05E8\u05D1\u05D4 \u05DE\u05D4
          \u05DC\u05E2\u05E9\u05D5\u05EA. \u05E9\u05D4\u05D9\u05D0 \u05DC\u05D0 \u05EA\u05E2\u05E8\u05D5\u05DA
          \u05D0\u05EA \u05D6\u05D4 \u05D5\u05EA\u05E8\u05D0\u05D4 \u05DC\u05D0\u05D9\u05D6\u05D4
          \u05E9\u05D5\u05E4\u05D8 \u05D5\u05D9\u05E2\u05E9\u05D5 \u05DC\u05D9 \u05D1\u05E2\u05D9\u05D5\u05EA."
        commands: []
    - rid: 2649295838973526195
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D4\u05D7\u05DC\u05D8\u05EA\u05D9 \u05DC\u05E0\u05E1\u05D5\u05EA
          \u05DC\u05D4\u05E8\u05D2\u05D9\u05E2 \u05D0\u05EA \u05D4\u05E1\u05D9\u05D8\u05D5\u05D0\u05E6\u05D9\u05D4.
          \u05D0\u05DE\u05E8\u05EA\u05D9 \u05DC\u05D4\u05DD, \"\u05EA\u05E7\u05E9\u05D9\u05D1\u05D5,
          \u05D0\u05E0\u05D9 \u05D7\u05D9\u05D9\u05DC, \u05D9\u05D0\u05DC\u05DC\u05D4
          \u05D1\u05D5\u05D0 \u05E0\u05D7\u05DC\u05D9\u05E3 \u05E4\u05E8\u05D8\u05D9\u05DD
          \u05D5\u05E0\u05D2\u05DE\u05D5\u05E8 \u05E2\u05DD \u05D6\u05D4\"."
        commands: []
    - rid: 2649295838973526196
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D4\u05D0\u05DE\u05EA \u05E9\u05D6\u05D4 \u05D3\u05D9 \u05D1\u05D5\u05D2\u05E8
          \u05DE\u05E6\u05D3\u05D5\u2026)"
        commands: []
    - rid: 2649295838973526197
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D2\u05DD \u05DB\u05DF \u05D4\u05E7\u05D5\u05E7\u05E1\u05D9\u05E0\u05DC
          \u05DE\u05E0\u05E1\u05D4 \u05DC\u05D4\u05D9\u05E8\u05D0\u05D5\u05EA \u05D2\u05D1\u05E8,
          \u05DC\u05D5\u05DE\u05E8 \u05D0\u05EA \u05D4\u05DE\u05D9\u05DC\u05D4 \u05D4\u05D0\u05D7\u05E8\u05D5\u05E0\u05D4.
          \u05DE\u05EA\u05D7\u05D9\u05DC \u05DC\u05D5\u05DE\u05E8 \u05DC\u05D9, \"\u05D9\u05D5\u05E4\u05D9,
          \u05E9\u05DC\u05D0 \u05E0\u05D6\u05DE\u05D9\u05DF \u05DC\u05DA \u05DE\u05E9\u05D8\u05E8\u05D4
          \u05D5\u05D4\u05DD \u05D9\u05E2\u05E9\u05D5 \u05DC\u05DA \u05D1\u05D3\u05D9\u05E7\u05EA
          \u05D9\u05E0\u05E9\u05D5\u05E3\"."
        commands: []
    - rid: 2649295838973526198
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05D0 \u05D6\u05D9\u05DF, \u05E9\u05D9\u05E2\u05E9\u05D5 \u05E2\u05DC\u05D9\u05D9
          \u05E2\u05E9\u05E8\u05D9\u05DD \u05D9\u05E0\u05E9\u05D5\u05E4\u05D9\u05DD
          \u05D2\u05DD, \u05DE\u05D4 \u05D0\u05DB\u05E4\u05EA \u05DC\u05D9."
        commands: []
    - rid: 2649295838973526199
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E0\u05D9 \u05D7\u05D5\u05E9\u05D1 \u05E9\u05D3\u05D5\u05D5\u05E7\u05D0
          \u05D4\u05D9\u05D4 \u05E6\u05E8\u05D9\u05DA \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05DC\u05D5 \u05D0\u05DB\u05E4\u05EA\u2026)"
        commands: []
    - rid: 2649295838973526200
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D6 \u05D4\u05D7\u05DC\u05E4\u05E0\u05D5 \u05E4\u05E8\u05D8\u05D9\u05DD
          \u05D5\u05D4\u05D6\u05D3\u05D9\u05D9\u05E0\u05D5 \u05DE\u05E9\u05DD. \u05E9\u05DE\u05E2,
          \u05DC\u05D0\u05E0\u05E9\u05D9\u05DD \u05D4\u05D9\u05D5\u05DD \u05D0\u05D9\u05DF
          \u05D1\u05D5\u05E9\u05D4. \u05DB\u05DC \u05D3\u05D1\u05E8 \u05DE\u05E0\u05E1\u05D9\u05DD
          \u05DC\u05E1\u05D5\u05D1\u05D1 \u05E2\u05DC\u05D9\u05DA \u05D1\u05E1\u05D5\u05E3.
          \u05E9\u05E8\u05DE\u05D5\u05D8\u05D5\u05EA."
        commands: []
    - rid: 2649295838973526201
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05E2\u05D9\u05E7\u05E8 \u05E9\u05DB\u05D5\u05DC\u05DD \u05D9\u05E6\u05D0\u05D5
          \u05DE\u05D6\u05D4 \u05D1\u05E9\u05DC\u05D5\u05DD, \u05E9\u05DC\u05D0 \u05D4\u05D9\u05D9\u05EA\u05D4
          \u05EA\u05D0\u05D5\u05E0\u05D4 \u05D9\u05D5\u05EA\u05E8 \u05D7\u05DE\u05D5\u05E8\u05D4\u2026"
        commands: []
    - rid: 2649295838973526202
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D8\u05D7, \u05D1\u05E8\u05D5\u05DA \u05D4\u05E9\u05DD."
        commands: []
    - rid: 2649295838973526203
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05D1\u05E8\u05D2\u05E8, \u05EA\u05D4\u05D9\u05D4
          \u05D0\u05D7\u05E8\u05D0\u05D9 \u05DB\u05E9\u05D0\u05EA\u05D4 \u05E0\u05D5\u05D4\u05D2."
        commands: []
    - rid: 2649295838973526204
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D9\u05E4\u05D4 \u05E9\u05D6\u05D4 \u05DE\u05D2\u05D9\u05E2 \u05DE\u05DE\u05E0\u05D5\u2026)"
        commands: []
    - rid: 2649295838973526205
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05D0\u05DC\u05DC\u05D4 \u05D4\u05DC\u05DB\u05EA\u05D9 \u05DC\u05D2\u05DC\u05E2\u05D3."
        commands:
        - rid: 2649295838973526208
    - rid: 2649295838973526206
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05E0\u05E9\u05DE\u05E2 \u05E9\u05D4\u05D7\u05D9\u05D9\u05DD \u05E9\u05DC
          \u05DB\u05E4\u05D9\u05E8 \u05D4\u05D9\u05D5 \u05DE\u05DC\u05D0\u05D9 \u05E8\u05D9\u05D2\u05D5\u05E9\u05D9\u05DD\u2026)"
        commands: []

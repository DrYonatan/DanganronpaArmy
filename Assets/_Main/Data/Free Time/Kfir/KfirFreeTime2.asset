    - rid: 2649295838973526179
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D5\u05D0 \u05D4\u05D9\u05D4 \u05E9\u05DD \u05D0\u05D7\u05E8\u05D9

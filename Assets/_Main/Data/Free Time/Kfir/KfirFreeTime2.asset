    - rid: 2649295838973526155
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05D6\u05D4 \u05E9\u05D7\u05D5\u05E8\u05D4\u2026 \u05DE\u05D4
          \u05D4\u05D9\u05D9\u05EA\u05D9 \u05E0\u05D5\u05EA\u05DF \u05DB\u05D3\u05D9
          \u05DC\u05E7\u05D7\u05EA \u05EA'\u05D0\u05D5\u05D8\u05D5 \u05D5\u05DC\u05E0\u05E1\u05D5\u05E2
          \u05DE\u05E4\u05D4."
        commands: []
    - rid: 2649295838973526156
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05EA\u05D2\u05E2\u05D2\u05E2 \u05DC\u05DC\u05E0\u05E1\u05D5\u05E2
          \u05D1\u05D0\u05D5\u05D8\u05D5 \u05E2\u05DD \u05E9\u05D9\u05E8\u05D9\u05DD,
          \u05D1\u05E4\u05E0\u05D0\u05DF."
        commands: []
    - rid: 2649295838973526157
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05D4 \u05D0\u05D5\u05D4\u05D1 \u05DC\u05E0\u05D4\u05D5\u05D2?"
        commands: []
    - rid: 2649295838973526158
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4 \u05E0\u05E8\u05D0\u05D4 \u05DC\u05DA? \u05D0\u05E0\u05D9
          \u05E0\u05D4\u05D2 \u05DE\u05DC\u05D9\u05D3\u05D4. \u05D8\u05E1\u05D8 \u05E8\u05D0\u05E9\u05D5\u05DF
          \u05D182 \u05E9\u05D9\u05E2\u05D5\u05E8\u05D9\u05DD \u05D5\u05D2\u05DD
          \u05D6\u05D4 \u05E8\u05E7 \u05DB\u05D9 \u05D7\u05D9\u05D9\u05D1."
        commands: []
    - rid: 2649295838973526159
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D4 \u05D5\u05D5\u05D0\u05D5, \u05D0\u05EA\u05D4 \u05D1\u05D0\u05DE\u05EA
          \u05DE\u05DE\u05E9 \u05D8\u05D1\u05E2\u05D9 \u05D1\u05D6\u05D4."
        commands: []
    - rid: 2649295838973526160
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05D0\u05E0\u05D9 \u05E0\u05D5\u05E1\u05E2
          \u05DE\u05DC\u05D0. \u05E4\u05E2\u05DD \u05D0\u05D7\u05EA \u05E8\u05E7
          \u05D4\u05D9\u05D4 \u05D0\u05D9\u05D6\u05D4 \u05DE\u05E9\u05D4\u05D5 \u05E9\u05D4\u05D1\u05D9\u05D0
          \u05DC\u05D9 \u05D0\u05EA \u05D4\u05E1\u05E2\u05D9\u05E3."
        commands: []
    - rid: 2649295838973526161
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05D4\u05D2\u05EA\u05D9 \u05D4\u05D1\u05D9\u05EA\u05D4, \u05D4\u05D9\u05D9\u05E0\u05D5
          \u05D1\u05D0\u05D5\u05D8\u05D5 \u05D0\u05E0\u05D9, \u05DC\u05D2\u05D6\u05D9\u05D0\u05DC
          \u05D5\u05D7\u05D3\u05D3. \u05D4\u05D9\u05D9\u05E0\u05D5 \u05D1\u05D3\u05E8\u05DA
          \u05D7\u05D6\u05E8\u05D4 \u05DE\u05D0\u05D9\u05D6\u05D4 \u05D1\u05E8."
        commands: []
    - rid: 2649295838973526162
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05EA\u05D4 \u05D4\u05D9\u05D9\u05EA \u05E0\u05D4\u05D2 \u05EA\u05D5\u05E8\u05DF?"
        commands: []
    - rid: 2649295838973526163
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DB\u05DF, \u05DE\u05D4 \u05E0\u05E2\u05E9\u05D4. \u05D3\u05E4\u05E7\u05EA\u05D9
          \u05E8\u05E7 \u05D0\u05D9\u05D6\u05D4 \u05E9\u05E0\u05D9 \u05E9\u05D5\u05D8\u05D9\u05DD
          \u05D8\u05E7\u05D9\u05DC\u05D4, \u05D0\u05D7\u05D3 \u05E2\u05E8\u05E7 \u05D5\u05D0\u05D7\u05D3
          \u05D5\u05D5\u05D3\u05E7\u05D4 \u05E8\u05D3\u05D1\u05D5\u05DC."
        commands: []
    - rid: 2649295838973526164
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D7\u05D5\u05E9\u05D1 \u05E9\u05D6\u05D4
          \u05D7\u05D5\u05E7\u05D9\u2026)"
        commands: []
    - rid: 2649295838973526165
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05D4\u05D9\u05D4 \u05D1\u05DF \u05D6\u05D5\u05E0\u05D4.
          \u05E9\u05DE\u05E2 \u05DC\u05D2\u05D6\u05D9\u05D0\u05DC \u05D4\u05D9\u05D4
          \u05DB\u05DC \u05DB\u05DA \u05E9\u05D9\u05DB\u05D5\u05E8, \u05D4\u05D5\u05D0
          \u05D4\u05EA\u05D7\u05D9\u05DC \u05E2\u05DD \u05D0\u05D9\u05D6\u05D5 \u05DE\u05D9\u05E9\u05D4\u05D9
          \u05E2\u05DD \u05DE\u05D9\u05E0\u05D9 \u05D5\u05D4\u05E7\u05D9\u05D0 \u05DC\u05D4
          \u05E2\u05DC \u05DB\u05DC \u05D4\u05E0\u05E2\u05DC."
        commands: []
    - rid: 2649295838973526166
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05D4\u05D9\u05D0 \u05D4\u05EA\u05E4\u05DC\u05E4\u05D4
          \u05E2\u05DC\u05D9\u05D5. \u05D4\u05D9\u05D0 \u05DE\u05EA\u05D7\u05D9\u05DC\u05D4
          \u05DC\u05E6\u05E2\u05D5\u05E7 \u05E2\u05DC\u05D9\u05D5, \"\u05D9\u05D0
          \u05D1\u05DF \u05D6\u05D5\u05E0\u05D4, \u05D6\u05D4 \u05E0\u05E2\u05DC
          \u05D1\u05E9\u05DE\u05D5\u05E0\u05D4 \u05DE\u05D0\u05D5\u05EA \u05E9\u05E7\u05DC\",
          \u05D4\u05D9\u05D9\u05EA\u05D9 \u05E6\u05E8\u05D9\u05DA \u05D1\u05E1\u05D5\u05E3
          \u05DC\u05D4\u05EA\u05E2\u05E8\u05D1 \u05DB\u05D3\u05D9 \u05DC\u05D4\u05E8\u05D2\u05D9\u05E2
          \u05D0\u05D5\u05EA\u05D4."
        commands: []
    - rid: 2649295838973526167
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E7\u05D9\u05E6\u05E8 \u05D0\u05D6 \u05DE\u05D4 \u05D4\u05D9\u05D4?
          \u05D0\u05E0\u05D9 \u05DB\u05D5\u05DC\u05D9 \u05E0\u05D5\u05E1\u05E2 \u05D1\u05E1\u05D1\u05D1\u05D4
          \u05E2\u05DD \u05D7\u05D3\u05D3 \u05D5\u05D2\u05D6\u05D9\u05D0\u05DC, \u05DB\u05E9\u05E4\u05EA\u05D0\u05D5\u05DD
          \u05D0\u05D9\u05D6\u05D4 \u05D4\u05D5\u05DE\u05D5 \u05D0\u05D7\u05D3 \u05D7\u05D5\u05EA\u05DA
          \u05DC\u05D9 \u05DC\u05EA\u05D5\u05DA \u05D4\u05E0\u05EA\u05D9\u05D1 \u05D5\u05E2\u05D5\u05E6\u05E8."
        commands: []
    - rid: 2649295838973526168
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E2\u05DB\u05E9\u05D9\u05D5 \u05D0\u05E0\u05D9 \u05D3\u05D5\u05E4\u05E7
          \u05D1\u05E8\u05E7\u05E1 \u05E9\u05DC \u05D4\u05D7\u05D9\u05D9\u05DD, \u05D0\u05D1\u05DC
          \u05E2\u05D3\u05D9\u05D9\u05DF \u05E0\u05DB\u05E0\u05E1\u05EA\u05D9 \u05D1\u05D1\u05DF
          \u05D6\u05D5\u05E0\u05D4."
        commands: []
    - rid: 2649295838973526169
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DB\u05D1\u05E8 \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05DE\u05D5\u05DB\u05DF \u05DC\u05E6\u05D0\u05EA \u05DE\u05D4\u05D0\u05D5\u05D8\u05D5
          \u05DC\u05D4\u05E8\u05D0\u05D5\u05EA \u05DC\u05D5 \u05DE\u05D4 \u05D6\u05D4.
          \u05D0\u05D1\u05DC \u05E4\u05EA\u05D0\u05D5\u05DD \u05D9\u05D5\u05E6\u05D0\u05D5\u05EA
          \u05DE\u05D4\u05D0\u05D5\u05D8\u05D5 \u05D0\u05D9\u05D6\u05D4 \u05E9\u05DC\u05D5\u05E9
          \u05D1\u05D7\u05D5\u05E8\u05D5\u05EA."
        commands: []
    - rid: 2649295838973526170
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05D1\u05D0 \u05D0\u05DC\u05D9\u05D4\u05DF, \u05D1\u05D4\u05EA\u05D7\u05DC\u05D4
          \u05D1\u05D8\u05D5\u05D1 \u05DB\u05DF? \u05D0\u05E0\u05D9 \u05E9\u05D5\u05D0\u05DC,
          \u05DE\u05D4 \u05E7\u05E8\u05D4, \u05DC\u05DE\u05D4 \u05D4\u05DF \u05E2\u05E6\u05E8\u05D5
          \u05DB\u05DB\u05D4."
        commands: []
    - rid: 2649295838973526171
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05DE\u05D4 \u05D4\u05DF \u05D0\u05DE\u05E8\u05D5?"
        commands: []
    - rid: 2649295838973526172
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E2\u05DB\u05E9\u05D9\u05D5 \u05D4\u05E0\u05D4\u05D2\u05EA \u05D4\u05D9\u05D9\u05EA\u05D4
          \u05DB\u05D5\u05E1\u05D9\u05EA, \u05D0\u05D1\u05DC \u05D7\u05D1\u05E8\u05D4
          \u05E9\u05DC\u05D4 \u05E9\u05E8\u05DE\u05D5\u05D8\u05D4. \u05D4\u05D9\u05D0
          \u05DE\u05EA\u05D7\u05D9\u05DC\u05D4 \u05DC\u05D5\u05DE\u05E8 \u05DC\u05D9,
          \"\u05DE\u05D4 \u05D9\u05E9 \u05DC\u05DA, \u05DC\u05DE\u05D4 \u05D0\u05EA\u05D4
          \u05DC\u05D0 \u05E9\u05D5\u05DE\u05E8 \u05DE\u05E8\u05D7\u05E7?\"."
        commands: []
    - rid: 2649295838973526173
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D5\u05D0\u05E0\u05D4 \u05D9\u05D0 \u05E9\u05E8\u05DE\u05D5\u05D8\u05D4,
          \u05DE\u05D4 \u05D0\u05EA \u05E2\u05D5\u05E6\u05E8\u05EA \u05DC\u05D9 \u05D1\u05D0\u05DE\u05E6\u05E2
          \u05D4\u05E0\u05EA\u05D9\u05D1? \u05E2\u05D6\u05D5\u05D1 \u05E9\u05E0\u05E1\u05E2\u05EA\u05D9
          \u05D0\u05D9\u05D6\u05D4 071 \u05E7\u05DE\"\u05E9, \u05D0\u05D9\u05DA \u05D0\u05EA
          \u05DE\u05E6\u05E4\u05D4 \u05E9\u05D0\u05E0\u05D9 \u05D0\u05E1\u05E4\u05D9\u05E7
          \u05DC\u05D4\u05D2\u05D9\u05D1?"
        commands:
        - rid: 2649295838973526414
    - rid: 2649295838973526174
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D6\u05D4 \u05DC\u05D0 \u05E2\u05D5\u05D6\u05E8 \u05DC\u05E0\u05E7\u05D5\u05D3\u05D4

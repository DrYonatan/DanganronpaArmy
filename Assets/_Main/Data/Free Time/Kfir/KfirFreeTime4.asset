    - rid: 2649295838973526365
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05EA\u05D2\u05D9\u05D3 \u05D1\u05E8\u05D2\u05E8 \u05D9\u05D0 \u05D2\u05D1\u05E8,
          \u05D0\u05D9\u05DA \u05D6\u05D4 \u05E9\u05D4\u05D2\u05E2\u05EA \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05DE\u05E9\"\u05E7 \u05DE\u05DE\u05D8\u05E8\u05D5\u05EA? \u05D0\u05EA\u05D4
          \u05E0\u05E8\u05D0\u05D4 \u05DC\u05D9 \u05E6\u05E8\u05D9\u05DA \u05DC\u05D4\u05D9\u05D5\u05EA
          \u05D1\u05D0\u05D9\u05D6\u05D4 0028."
        commands: []
    - rid: 2649295838973526366
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05E6\u05E8\u05D9\u05DA \u05DC\u05D4\u05D2\u05D6\u05D9\u05DD\u2026"
        commands: []
    - rid: 2649295838973526367
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4, \u05D0\u05EA\u05D4 \u05D2\u05D0\u05D5\u05DF \u05DB\u05D6\u05D4.
          \u05D4\u05D9\u05D9\u05EA \u05DE\u05D6\u05D9\u05D9\u05DF \u05D0\u05D5\u05EA\u05DD
          \u05EA\u05D0\u05DE\u05D9\u05DF \u05DC\u05D9. \u05D0\u05D9\u05DA \u05DC\u05D0
          \u05DC\u05E7\u05D7\u05D5 \u05D0\u05D5\u05EA\u05DA?"
        commands: []
    - rid: 2649295838973526368
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2, \u05D4\u05D9\u05D5 \u05DC\u05D9
          \u05D1\u05E2\u05D9\u05D5\u05EA \u05E2\u05DD \u05D4\u05DE\u05D9\u05D5\u05E0\u05D9\u05DD,
          \u05D0\u05D9\u05DB\u05E9\u05D4\u05D5 \u05E0\u05E4\u05DC\u05EA\u05D9 \u05D1\u05D9\u05DF
          \u05D4\u05DB\u05E1\u05D0\u05D5\u05EA\u2026"
        commands: []
    - rid: 2649295838973526369
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4, \u05D0\u05D1\u05DC \u05DB\u05DB\u05D4 \u05D2'\u05D5\u05D1?
          \u05DE\u05D4 \u05E7\u05E8\u05D4?"
        commands: []
    - rid: 2649295838973526370
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D9\u05D5 \u05DC\u05D9 \u05DB\u05DE\u05D4 \u05E1\u05E2\u05D9\u05E4\u05D9\u05DD
          \u05D1\u05E4\u05E8\u05D5\u05E4\u05D9\u05DC, \u05E1\u05D9\u05E4\u05D5\u05E8
          \u05D0\u05E8\u05D5\u05DA\u2026 \u05D0\u05E0\u05D9 \u05D2\u05DD \u05DC\u05D0
          \u05D1\u05D8\u05D5\u05D7 \u05E9\u05D4\u05D9\u05D9\u05EA\u05D9 \u05E8\u05D5\u05E6\u05D4
          \u05E7\u05E8\u05D1\u05D9 \u05DB\u05DC \u05DB\u05DA."
        commands: []
    - rid: 2649295838973526371
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D9\u05DF. \u05D5\u05D5\u05D0\u05DC\u05D4 \u05DC\u05D3\u05E2\u05EA\u05D9
          \u05D4\u05D9\u05D9\u05EA \u05E0\u05D4\u05E0\u05D4 \u05D1\u05E7\u05E8\u05D1\u05D9
          \u05D1\u05E8\u05D2\u05E8."
        commands: []
    - rid: 2649295838973526372
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D9 \u05D9\u05D5\u05D3\u05E2\u2026"
        commands: []
    - rid: 2649295838973526373
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D0\u05DE\u05EA \u05D2\u05DD \u05DC\u05D9 \u05D4\u05D9\u05D5
          \u05D1\u05E2\u05D9\u05D5\u05EA \u05DB\u05D0\u05DC\u05D4 \u05D1\u05D4\u05EA\u05D7\u05DC\u05D4."
        commands: []
    - rid: 2649295838973526374
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D0\u05DE\u05EA? \u05DE\u05D4 \u05D6\u05D0\u05EA \u05D0\u05D5\u05DE\u05E8\u05EA?"
        commands:
        - rid: 2649295838973526407
    - rid: 2649295838973526375
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05D1\u05D4\u05EA\u05D7\u05DC\u05D4
          \u05D4\u05DE\u05E8\u05D0\u05D9\u05D9\u05E0\u05EA \u05D4\u05D1\u05EA \u05E9\u05E8\u05DE\u05D5\u05D8\u05D4
          \u05D1\u05E6\u05D5 \u05E8\u05D0\u05E9\u05D5\u05DF \u05E9\u05DC\u05D7\u05D4
          \u05D0\u05D5\u05EA\u05D9 \u05DC\u05E7\u05D1\"\u05DF."
        commands: []
    - rid: 2649295838973526376
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D4? \u05DC\u05DE\u05D4?"
        commands: []
    - rid: 2649295838973526377
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D5\u05E0\u05D4, \u05DB\u05EA\u05D1\u05D4 \u05DC\u05D9 \u05D1\u05E1\u05E2\u05D9\u05E3
          \u05E9\u05D9\u05E9 \u05DC\u05D9 \u05D1\u05E2\u05D9\u05D5\u05EA \u05D6\u05E2\u05DD."
        commands: []
    - rid: 2649295838973526378
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D9\u05DA \u05D4\u05D9\u05D0 \u05D4\u05D2\u05D9\u05E2\u05D4
          \u05DC\u05DE\u05E1\u05E7\u05E0\u05D4 \u05D4\u05D6\u05D0\u05EA\u2026?"
        commands: []
    - rid: 2649295838973526379
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D0 \u05E2\u05D0\u05E8\u05E3, \u05DE\u05E4\u05D2\u05E8\u05EA.
          \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05D9\u05D5\u05EA \u05D6\u05D4 \u05DB\u05D9
          \u05E1\u05D9\u05E4\u05E8\u05EA\u05D9 \u05DC\u05D4 \u05E9\u05D0\u05D9\u05D6\u05D4
          \u05E4\u05E2\u05DD \u05D6\u05E8\u05E7\u05EA\u05D9 \u05DB\u05D9\u05E1\u05D0
          \u05E2\u05DC \u05D0\u05D9\u05D6\u05D4 \u05DE\u05D5\u05E8\u05D4 \u05D1\u05DF
          \u05E9\u05E8\u05DE\u05D5\u05D8\u05D4 \u05E9\u05D0\u05DE\u05E8 \u05DC\u05D9
          \u05DC\u05D0 \u05DC\u05E2\u05E9\u05DF \u05D1\u05DB\u05D9\u05EA\u05D4."
        commands: []
    - rid: 2649295838973526380
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05DD \u05D6\u05D4 \u05D4\u05DE\u05D9\u05E0\u05D5\u05D7 \u05E9\u05D4\u05D5\u05D0
          \u05D4\u05E9\u05EA\u05DE\u05E9 \u05D1\u05D5 \u05DB\u05D3\u05D9 \u05DC\u05E1\u05E4\u05E8
          \u05D0\u05EA \u05D6\u05D4, \u05D0\u05E0\u05D9 \u05DC\u05D0 \u05DE\u05D5\u05E4\u05EA\u05E2\u2026)"
        commands: []
    - rid: 2649295838973526381
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D2\u05DD \u05D0\u05DD \u05DB\u05DF, \u05DE\u05D4 \u05D4\u05E7\u05E9\u05E8
          \u05E7\u05D1\"\u05DF, \u05D7\u05EA\u05D9\u05DB\u05EA \u05D6\u05D5\u05E0\u05D4
          \u05E9\u05DE\u05D0\u05DC\u05E0\u05D9\u05EA. \u05DE\u05D4 \u05D2\u05DD \u05E9\u05D4\u05D9\u05D9\u05EA\u05D9
          \u05D1\u05DB\u05D9\u05EA\u05D4 \u05D8' \u05E9\u05D6\u05E8\u05E7\u05EA\u05D9
          \u05D0\u05EA \u05D4\u05DB\u05D9\u05E1\u05D0 \u05D4\u05D6\u05D4, \u05D1\u05E6\u05D5
          \u05E8\u05D0\u05E9\u05D5\u05DF \u05DB\u05D1\u05E8 \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05D1\u05D9\"\u05D0."
        commands: []
    - rid: 2649295838973526382
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05D9\u05D6\u05D4 \u05D4\u05D1\u05D3\u05DC\u2026)"
        commands: []
    - rid: 2649295838973526383
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D6\u05D4 \u05D0\u05E0\u05E9\u05D9\u05DD \u05E9\u05D4\u05DD \u05E4\u05E9\u05D5\u05D8
          \u05E9\u05E8\u05DE\u05D5\u05D8\u05D5\u05EA. \u05E1\u05EA\u05DD \u05D1\u05D0\u05D9\u05DD
          \u05DC\u05D7\u05E4\u05E9 \u05D0\u05D5\u05EA\u05DA \u05D1\u05E9\u05D1\u05D9\u05DC
          \u05D4\u05DB\u05D9\u05E3 \u05E9\u05DC\u05D4\u05DD. \u05E2\u05D5\u05E9\u05D4
          \u05DC\u05D4 \u05D0\u05EA \u05D6\u05D4 \u05DC\u05D3\u05E2\u05EA \u05E9\u05D4\u05D9\u05D0
          \u05D6\u05D9\u05D9\u05E0\u05D4 \u05D0\u05D9\u05D6\u05D4 \u05D9\u05DC\u05D3
          \u05E9\u05D1\u05D0 \u05DC\u05D4\u05EA\u05D2\u05D9\u05D9\u05E1."
        commands: []
    - rid: 2649295838973526384
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D8\u05D5\u05D1 \u05E9\u05D4\u05D9\u05D0 \u05DC\u05D0 \u05D0\u05DE\u05E8\u05D4
          \u05DC\u05D9 \u05E9\u05D4\u05D9\u05D0 \u05EA\u05E9\u05DC\u05D7 \u05D0\u05D5\u05EA\u05D9
          \u05DC\u05E7\u05D1\"\u05DF \u05D1\u05D0\u05D5\u05EA\u05D5 \u05E8\u05D2\u05E2,
          \u05E8\u05E7 \u05D0\u05D7\u05E8 \u05DB\u05DA \u05E9\u05DC\u05D7\u05D5 \u05DC\u05D9
          \u05D4\u05D5\u05D3\u05E2\u05D4. \u05D5\u05D5\u05D0\u05DC\u05D4 \u05D4\u05D9\u05D9\u05EA\u05D9
          \u05DE\u05E4\u05E0\u05E6'\u05E8 \u05D0\u05D5\u05EA\u05D4."
        commands: []
    - rid: 2649295838973526385
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05DB\u05DC \u05DE\u05E9\u05E4\u05D8 \u05E9\u05D4\u05D5\u05D0 \u05D0\u05D5\u05DE\u05E8
          \u05D2\u05D5\u05E8\u05DD \u05DC\u05D6\u05D4 \u05DC\u05D4\u05D9\u05E9\u05DE\u05E2
          \u05D9\u05D5\u05EA\u05E8 \u05D5\u05D9\u05D5\u05EA\u05E8 \u05DB\u05D0\u05D9\u05DC\u05D5
          \u05D4\u05D9\u05D0 \u05E6\u05D3\u05E7\u05D4\u2026)"
        commands:
        - rid: 2649295838973526408
    - rid: 2649295838973526386
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D0\u05D6 \u05D4\u05E7\u05D1\"\u05DF \u05D4\u05D6\u05D4,
          \u05D2\u05DD \u05DB\u05DF \u05D1\u05DF \u05E9\u05E8\u05DE\u05D5\u05D8\u05D4,
          \u05DE\u05EA\u05D7\u05D9\u05DC \u05DC\u05D5\u05DE\u05E8 \u05DC\u05D9, \"\u05D9\u05E9
          \u05D3\u05D1\u05E8\u05D9\u05DD \u05E9\u05DE\u05E7\u05E4\u05D9\u05E6\u05D9\u05DD
          \u05D0\u05D5\u05EA\u05DA? \u05D0\u05D9\u05DA \u05D0\u05EA\u05D4 \u05DE\u05D2\u05D9\u05D1
          \u05DB\u05E9\u05DE\u05E9\u05D4\u05D5 \u05DB\u05D6\u05D4 \u05E7\u05D5\u05E8\u05D4?\"."
        commands: []
    - rid: 2649295838973526387
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05D5\u05D0\u05DC\u05D4 \u05DE\u05D0\u05D9\u05E4\u05D4 \u05E0\u05E4\u05DC\u05EA
          \u05E2\u05DC\u05D9\u05D9, \u05D7\u05EA\u05D9\u05DB\u05EA \u05E9\u05DE\u05DF
          \u05E7\u05D9\u05E8\u05D7. \u05D8\u05D5\u05D1 \u05E9\u05DC\u05D0 \u05D4\u05EA\u05D7\u05DC\u05EA\u05D9
          \u05DC\u05E4\u05EA\u05D5\u05D7 \u05E2\u05DC \u05D4\u05DE\u05E8\u05D0\u05D9\u05D9\u05E0\u05EA
          \u05D4\u05E9\u05E8\u05DE\u05D5\u05D8\u05D4 \u05E9\u05E9\u05DC\u05D7\u05D4
          \u05D0\u05D5\u05EA\u05D9 \u05D0\u05DC\u05D9\u05D5, \u05D6\u05D4 \u05D5\u05D5\u05D0\u05D7\u05D3
          \u05D3\u05D1\u05E8 \u05E9\u05DE\u05E7\u05E4\u05D9\u05E5 \u05D0\u05D5\u05EA\u05D9.
          \u05E0\u05E9\u05D1\u05E2 \u05D1\u05E1\u05D5\u05E3 \u05D4\u05D9\u05D5 \u05DE\u05E9\u05D7\u05E8\u05E8\u05D9\u05DD
          \u05D0\u05D5\u05EA\u05D9 \u05E2\u05DC \u05E0\u05E4\u05E9\u05D9."
        commands: []
    - rid: 2649295838973526388
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D5\u05DE\u05D4 \u05D1\u05E1\u05D5\u05E3 \u05D4\u05D9\u05D4 \u05D0\u05D9\u05EA\u05D5?"
        commands: []
    - rid: 2649295838973526389
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D4\u05D5\u05D0 \u05D1\u05D0 \u05D0\u05DC\u05D9\u05D9 \u05E2\u05DD
          \u05DB\u05DC \u05DE\u05D9\u05E0\u05D9 \u05E9\u05D0\u05DC\u05D5\u05EA \u05D0\u05D1\u05DC
          \u05D1\u05D0\u05EA\u05D9 \u05E8\u05D2\u05D5\u05E2 \u05D9\u05D5\u05EA\u05E8
          \u05D1\u05D0\u05D5\u05EA\u05D4 \u05E4\u05E2\u05DD, \u05DB\u05D1\u05E8 \u05DC\u05DE\u05D3\u05EA\u05D9
          \u05D0\u05EA \u05D4\u05DC\u05E7\u05D7. \u05E2\u05E0\u05D9\u05EA\u05D9 \u05DC\u05D5
          \u05DB\u05DE\u05D5 \u05D9\u05DC\u05D3 \u05D8\u05D5\u05D1. \u05D1\u05E1\u05D5\u05E3
          \u05DB\u05DE\u05D5 \u05D2\u05D3\u05D5\u05DC \u05D4\u05D5\u05E6\u05D9\u05D0
          \u05D0\u05D5\u05EA\u05D9 \u05D1\u05DC\u05D9 \u05E1\u05E2\u05D9\u05E4\u05D9\u05DD
          \u05E0\u05E4\u05E9\u05D9\u05D9\u05DD."
        commands: []
    - rid: 2649295838973526390
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D4, \u05D0\u05D6 \u05E0\u05E9\u05DE\u05E2 \u05E9\u05D4\u05DB\u05DC
          \u05D4\u05DC\u05DA \u05D1\u05E1\u05D3\u05E8."
        commands: []
    - rid: 2649295838973526391
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E9\u05DE\u05E2 \u05D0\u05D7\u05D9, \u05E2\u05D3 \u05E9\u05E7\u05D9\u05D1\u05DC\u05EA\u05D9
          \u05D0\u05EA \u05D4\u05EA\u05D5\u05E8 \u05DC\u05E7\u05D1\"\u05DF \u05D4\u05DE\u05D6\u05D3\u05D9\u05D9\u05DF
          \u05D4\u05D6\u05D4 \u05DC\u05E7\u05D7 \u05D0\u05D9\u05D6\u05D4 \u05D7\u05E6\u05D9
          \u05E9\u05E0\u05D4, \u05D4\u05E4\u05E1\u05D3\u05EA\u05D9 \u05DE\u05DC\u05D0
          \u05DE\u05D9\u05D5\u05E0\u05D9\u05DD \u05D1\u05D9\u05E0\u05EA\u05D9\u05D9\u05DD."
        commands: []
    - rid: 2649295838973526392
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05DE\u05D9\u05D5\u05E0\u05D9\u05DD \u05DC\u05DE\u05D4?"
        commands: []
    - rid: 2649295838973526393
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E1\u05D9\u05D9\u05E8\u05D5\u05EA, \u05D8\u05D9\u05E1\u2026"
        commands: []
    - rid: 2649295838973526394
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05E0\u05D9 \u05DE\u05D1\u05D9\u05DF \u05E9\u05DB\u05D9\u05D5\u05D5\u05E0\u05EA
          \u05E8\u05E7 \u05DC\u05E7\u05E8\u05D1\u05D9."
        commands: []
    - rid: 2649295838973526395
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D1\u05D8\u05D7, \u05DC\u05DE\u05D4 \u05DE\u05D4 \u05D0\u05E0\u05D9
          \u05D0\u05DC\u05DA \u05DC\u05D4\u05D9\u05D5\u05EA \u05D2'\u05D5\u05D1\u05E0\u05D9\u05E7?
          \u05DE\u05D4 \u05D0\u05E0\u05D9 \u05DB\u05D5\u05E1\u05D9\u05EA?"
        commands:
        - rid: 2649295838973526409
    - rid: 2649295838973526396
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u2026)"
        commands: []
    - rid: 2649295838973526397
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D0\u05D1\u05DC \u05E9\u05DE\u05E2, \u05D0\u05E0\u05D9 \u05DE\u05D1\u05E1\u05D5\u05D8
          \u05E9\u05D4\u05D2\u05E2\u05EA\u05D9 \u05DC\u05D2\u05D5\u05DC\u05E0\u05D9
          \u05D1\u05E1\u05D5\u05E3. \u05D6\u05D4 \u05D1\u05D3\u05D9\u05D5\u05E7 \u05DE\u05D4
          \u05E9\u05D0\u05E0\u05D9 \u05D7\u05D9\u05E4\u05E9\u05EA\u05D9 \u05D1\u05E9\u05D9\u05E8\u05D5\u05EA,
          \u05DC\u05D4\u05D2\u05DF \u05E2\u05DC \u05D4\u05DE\u05D3\u05D9\u05E0\u05D4
          \u05D5\u05DC\u05D4\u05D9\u05DB\u05E0\u05E1 \u05D1\u05E2\u05E8\u05D1\u05D9\u05DD."
        commands: []
    - rid: 2649295838973526398
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D2\u05DD \u05D4\u05D7\u05D1\u05E8'\u05D4 \u05D1\u05D0\u05DE\u05EA
          \u05D2\u05D1\u05E8\u05D9\u05DD \u05D0\u05D7\u05D3 \u05D0\u05D7\u05D3, \u05D7\u05D5\u05E5
          \u05DE\u05D4\u05DE\u05E4\u05E7\u05D3\u05D9\u05DD \u05E9\u05DC\u05E4\u05E2\u05DE\u05D9\u05DD
          \u05D4\u05DD \u05D6\u05D5\u05E0\u05D5\u05EA. \u05E0\u05D5\u05D3\u05E8 \u05E9\u05D0\u05D9\u05DF
          \u05D4\u05E8\u05D1\u05D4 \u05DE\u05E7\u05D5\u05DE\u05D5\u05EA \u05DB\u05D0\u05DC\u05D4."
        commands: []
    - rid: 2649295838973526399
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05E9\u05DE\u05E2 \u05E9\u05DE\u05E6\u05D0\u05EA \u05D0\u05EA
          \u05D4\u05DE\u05E7\u05D5\u05DD \u05E9\u05DC\u05DA\u2026 \u05D0\u05E0\u05D9
          \u05DE\u05E0\u05D9\u05D7 \u05E9\u05D0\u05EA\u05D4 \u05D2\u05DD \u05DE\u05EA\u05D0\u05D9\u05DD
          \u05DC\u05E9\u05DD \u05DC\u05E4\u05D9 \u05D6\u05D4 \u05E9\u05D1\u05D7\u05E8\u05D5
          \u05D1\u05DA \u05DC\u05D4\u05D9\u05D5\u05EA \u05E8\u05E2\"\u05E6."
        commands: []
    - rid: 2649295838973526400
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05EA\u05E9\u05DE\u05E2, \u05D0\u05E0\u05D9 \u05E2\u05D5\u05E9\u05D4
          \u05DE\u05D4 \u05E9\u05E6\u05E8\u05D9\u05DA. \u05D0\u05E0\u05D9 \u05DE\u05D0\u05DE\u05D9\u05DF
          \u05E9\u05DC\u05D0 \u05DE\u05E9\u05E0\u05D4 \u05DB\u05DE\u05D4 \u05E2\u05E8\u05D1\u05D9\u05DD
          \u05D9\u05D1\u05D5\u05D0\u05D5 \u05E2\u05DC\u05D9\u05E0\u05D5, \u05D0\u05DD
          \u05D9\u05E9 \u05DC\u05DA \u05E8\u05E2\u05DC \u05D1\u05E2\u05D9\u05E0\u05D9\u05D9\u05DD
          \u05D5\u05D0\u05EA \u05D4\u05D7\u05D1\u05E8'\u05D4 \u05E9\u05DC\u05DA \u05D0\u05D9\u05EA\u05DA,
          \u05D0\u05EA\u05D4 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D6\u05D9\u05D9\u05DF
          \u05D0\u05EA \u05DB\u05D5\u05DC\u05DD."
        commands: []
    - rid: 2649295838973526401
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "(\u05D0\u05E0\u05D9 \u05DC\u05D0 \u05D9\u05D5\u05D3\u05E2 \u05D0\u05DD
          \u05D0\u05DC\u05D4 \u05D1\u05D3\u05D9\u05D5\u05E7 \u05D4\u05DE\u05D9\u05DC\u05D9\u05DD
          \u05E9\u05D4\u05D9\u05D9\u05EA\u05D9 \u05D1\u05D5\u05D7\u05E8, \u05D0\u05D1\u05DC
          \u05D0\u05E0\u05D9 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05E2\u05E8\u05D9\u05DA
          \u05D0\u05EA \u05D4\u05E1\u05E0\u05D8\u05D9\u05DE\u05E0\u05D8\u2026)"
        commands: []
    - rid: 2649295838973526402
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05D9\u05D0\u05DC\u05DC\u05D4, \u05D9\u05D4\u05D9\u05D4 \u05D8\u05D5\u05D1.
          \u05DE\u05D4 \u05E9\u05D7\u05E9\u05D5\u05D1 \u05D6\u05D4 \u05DC\u05E2\u05E9\u05D5\u05EA
          \u05D0\u05EA \u05DE\u05D4 \u05E9\u05D0\u05EA\u05D4 \u05E6\u05E8\u05D9\u05DA,
          \u05D5\u05DC\u05EA\u05EA \u05D1\u05E8\u05D1\u05D0\u05E7."
        commands: []
    - rid: 2649295838973526403
      type: {class: VNTextData, ns: , asm: Assembly-CSharp}
      data:
        text: "\u05E0\u05E8\u05D0\u05D4 \u05D0\u05D5\u05EA\u05DA \u05D1\u05E8\u05D2\u05E8."
